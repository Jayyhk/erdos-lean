    (sigma : Gal(L/k)) (a : L) :
    crossedTransportFn i g hi c (CProduc.single c sigma a) =
      CProduc.single (transportedGaloisCocycle i g hi c)
        (g sigma) (i a) := by
  apply CProduc.sum_single_index
  simp


    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (slot : CWord Atom)
    (coefficient : ℤ) :
    Int.toNat
        ((strictSlotExpansion cutoff slot).eval coefficient) =
      Multiset.count slot
        (cutoffProfile cutoff
          (PSTail.strictTrace
            coefficient)) := by
  rw [eval_slot_expansion
    cutoff hcutoff slot coefficient]
  simp


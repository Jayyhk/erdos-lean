instance (f : G × G → M) : Mul (CExt f) :=
  ⟨fun x y ↦ (x.1 * (x.2 • y.1) * f (x.2, y.2), x.2 * y.2)⟩

instance (f : G × G → M) : One (CExt f) :=
  ⟨((f (1, 1))⁻¹, 1)⟩

instance (f : G × G → M) : Inv (CExt f) :=
  ⟨fun x ↦ ((f (1, 1))⁻¹ * (x.2⁻¹ • x.1⁻¹) *
      (f (x.2⁻¹, x.2))⁻¹, x.2⁻¹)⟩


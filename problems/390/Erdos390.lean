            hface (q : Real)
          _ = fourFiveMovingFaceKernel A y u
                (fourFiveRealLogCoordinate y x) q :=
            fourFiveRealMovingFaceKernel_natCast
      have hintegral :
          (∫ z in (((q - 1 : Nat) : Real))..(q : Real),

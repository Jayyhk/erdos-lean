    rw [hchoose] at hoff
    have hqR : (0 : ℝ) < q := by positivity
    rw [div_mul_eq_mul_div, div_add', le_div_iff₀] at ht <;>
      nlinarith [show (2 : ℝ) ≤ q by exact_mod_cast hq]
  apply offTuran_raw_average_arith (n : ℝ) (q : ℝ) δ η
    (r : ℝ) (a : ℝ) (N : ℝ) (e : ℝ)
  · exact_mod_cast hq
  · exact hδ
  · exact hη
  · exact hηδ
  · positivity
  · positivity
  · exact_mod_cast hnN
  · exact_mod_cast ha
  · exact hr
  · exact_mod_cast hNdef
  · exact hlarge
  · exact hedge

end


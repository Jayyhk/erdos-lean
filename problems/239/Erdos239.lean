                B +
                    ((Nat.log 2 H - (Nat.log 2 M + 1) + 1 : ℕ) : ℝ) * B =
                    ((1 + (Nat.log 2 H - (Nat.log 2 M + 1) + 1) : ℕ) : ℝ) *
                      B := by push_cast; ring
                _ = ((Nat.log 2 H - Nat.log 2 M + 1 : ℕ) : ℝ) * B := by
                  rw [hn]


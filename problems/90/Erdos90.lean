      ⁅later.value (n := n), earlier.value (n := n)⁆ ^ Nat.choose q 2 := by
  have hleft :
      n ≤
        2 * later.factor.word.weight PEAddres.weight +
          earlier.factor.word.weight PEAddres.weight := by

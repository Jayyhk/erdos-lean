    intro y
    obtain ⟨c, hc⟩ := hQ y
    obtain ⟨z, rfl⟩ := Coinvariants.mk_surjective
      (A.ρ.quotientToInvariants H) c
    exact ⟨z, hc⟩
  have hraw := invariants_surjective_normal A H hHraw hQraw
  intro y
  obtain ⟨z, hz⟩ := hraw y

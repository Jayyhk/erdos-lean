      2 * Real.log ((q : ℝ) * (T + 2)) := by
  have hq : (1 : ℝ) ≤ q := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr (NeZero.ne q)
  have hq0 : (0 : ℝ) ≤ q :=
    (show (0 : ℝ) ≤ 1 by norm_num).trans hq
  have hm : 0 ≤ T + 1 / 2 := by linarith
  have harg : 0 < r * (|T + 1 / 2| + 2) := by positivity
  have hle : r * (|T + 1 / 2| + 2) ≤

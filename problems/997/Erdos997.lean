theorem natural_maynard_tao
    (m : ℕ) (hm : 2 ≤ m) (H : Finset ℕ)
    (hH : BoundedGaps.IsAdmissible H)
    (hthreshold : Real.exp (8 * (m : ℝ) + 4) <

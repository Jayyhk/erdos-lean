theorem exists_card_intervalMissingPrimeBlockSet_beta_bound :
    ∃ A : ℝ, 1 ≤ A ∧
      ∀ L U P Q S : ℕ, L ≤ U → 3 ≤ P → P ≤ Q → 101 ≤ S →

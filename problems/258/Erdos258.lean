        ((tinyCutoff K + 1 : ℕ) : ℝ) := by
  calc
    (∑ p ∈ mediumPrimes K m,
        ((K : ℝ) / ((p - 1 : ℕ) : ℝ)) ^ 2 / (p : ℝ)) =
        (K : ℝ) ^ 2 *
          (∑ p ∈ mediumPrimes K m,
            (1 : ℝ) /
              ((p : ℝ) * (((p - 1 : ℕ) : ℝ) ^ 2))) := by
      rw [Finset.mul_sum]

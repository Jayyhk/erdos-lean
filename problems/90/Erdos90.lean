    RestrictedQuotientBridge.{u} := by
  intro K L _ _ _ _ _ _ _ S hgenerate
  exact ⟨(restrictedCokernelExplicit
      (K := K) (L := L) S hgenerate) ≪≫
    (cokernelIsoExplicit (K := K) (L := L)).symm⟩


      ACFtry
        d n inputWeight (concreteBasicCommutators.{u} d))
    (packet :
      PFSubsti.TAPkt.{u}
        d n)
    (hinputWeight : 0 < inputWeight) where
  comparisonRecollection :
    ∀
      (factor :
        SPFactora
          (concreteBasicCommutators.{u} d) inputWeight)
      (innerWord rightWord :

          mul_le_mul_of_nonneg_left hhalfSqrt hc0.le
    have hdecay : Real.exp (-c0 * Real.sqrt l) ≤
        Real.exp (-c * Real.sqrt L) := by
      apply Real.exp_monotone
      linarith
    have hyCast : (y : ℝ) ≤ (x : ℝ) := by exact_mod_cast hyx
    have hC0C : C0 ≤ C := by
      dsimp [C]
      exact le_max_right _ _
    calc

sieve. -/
theorem weighted_sum_norm_sq_primitiveTwists_le_unitAdditiveSums
    {q : ℕ} [NeZero q] (s : Finset ℕ) (c : ℕ → ℂ) :
    (q : ℝ) / (q.totient : ℝ) *
        ∑ ψ : primitiveCharacters q,
          ‖∑ n ∈ s, c n * ψ.1 n‖ ^ 2 ≤
      ∑ u : (ZMod q)ˣ,
        ‖∑ n ∈ s,
          c n * ZMod.stdAddChar ((u : ZMod q) * (n : ZMod q))‖ ^ 2 := by

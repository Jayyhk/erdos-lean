    have hnInterval := Finset.mem_Icc.mp hnData.1
    have hnPos : 0 < n := hnInterval.1
    have hndvd := hnData.2.2.2
    have hmDvd : n / p ∣ n := Nat.div_dvd_of_dvd hndvd
    have hmPos : 0 < n / p := Nat.div_pos (Nat.le_of_dvd hnPos hndvd)

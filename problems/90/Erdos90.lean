/-!
# Plain depth-sum polynomial bounds for bounded strict-depth subsequences

The recursive depth-plus-length grade is convenient for triangularity, but
the actual polynomial degree is smaller.  Every proper predecessor lowers
the plain sum of its depths.  Coordinates of depth sum zero are constant,
and partial summation restores exactly one unit after each strict decrease.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace DSSum

open DSRec
open BSRec
open BSPoly
open DSSem
open ODSubseq
open DSSeed

/-- Every predecessor weakly lowers the plain sum of depths. -/
lemma strict_predecessor_patterns :
    ∀ (target previous : List ℕ),
      previous ∈ strictPredecessorPatterns target →
        previous.sum ≤ target.sum
  | [], previous, hprevious => by
      simp [strictPredecessorPatterns] at hprevious
      subst previous
      simp
  | targetHead :: targetTail, previous, hprevious => by
      rw [strictPredecessorPatterns.eq_def] at hprevious
      simp only [List.mem_append, List.mem_map] at hprevious
      rcases hprevious with (hprevious | hprevious) | hprevious
      · rcases hprevious with ⟨prior, hprior, rfl⟩
        simp only [List.sum_cons]
        exact
          Nat.add_le_add_left
            (strict_predecessor_patterns targetTail prior
              hprior)
            targetHead
      · by_cases htargetHeadPos : 0 < targetHead
        · simp only [htargetHeadPos, ↓reduceIte, List.mem_map] at hprevious
          rcases hprevious with ⟨prior, hprior, rfl⟩
          have hprior :=
            strict_predecessor_patterns targetTail prior
              hprior
          simp only [List.sum_cons]
          omega
        · simp [htargetHeadPos] at hprevious
      · cases targetTail with
        | nil =>
            simp at hprevious
        | cons nextDepth tail =>
            by_cases hnextDepth : targetHead = nextDepth + 1
            · simp only [hnextDepth, ↓reduceIte, List.mem_map] at hprevious
              rcases hprevious with ⟨prior, hprior, rfl⟩
              have hprior :=
                strict_predecessor_patterns tail prior hprior
              simp only [List.sum_cons]
              omega
            · simp [hnextDepth] at hprevious
termination_by target _previous => target.length

/-- Every proper predecessor strictly lowers the plain sum of depths. -/
lemma sum_predecessor_patterns :
    ∀ (target previous : List ℕ),
      previous ∈ properPredecessorPatterns target →
        previous.sum < target.sum
  | [], previous, hprevious => by
      simp [properPredecessorPatterns,
        strictPredecessorPatterns] at hprevious
  | depth :: depths, previous, hprevious => by
      rw [proper_patterns_cons] at hprevious
      simp only [List.mem_append, List.mem_map] at hprevious
      rcases hprevious with (hprevious | hprevious) | hprevious
      · rcases hprevious with ⟨prior, hprior, rfl⟩
        simp only [List.sum_cons]
        exact
          Nat.add_lt_add_left
            (sum_predecessor_patterns depths prior
              hprior)
            depth
      · by_cases hdepth : 0 < depth
        · simp only [hdepth, ↓reduceIte, List.mem_map] at hprevious
          rcases hprevious with ⟨prior, hprior, rfl⟩
          have hprior :=
            strict_predecessor_patterns depths prior hprior
          simp only [List.sum_cons]
          omega
        · simp [hdepth] at hprevious
      · cases depths with
        | nil =>
            simp at hprevious
        | cons nextDepth tail =>
            by_cases hnextDepth : depth = nextDepth + 1
            · simp only [hnextDepth, ↓reduceIte, List.mem_map] at hprevious
              rcases hprevious with ⟨prior, hprior, rfl⟩
              have hprior :=
                strict_predecessor_patterns tail prior hprior
              simp only [List.sum_cons]
              omega
            · simp [hnextDepth] at hprevious
termination_by target _previous => target.length

/-- A depth word of sum zero has no proper predecessor. -/
lemma predecessor_patterns_nil
    (target : List ℕ)
    (htarget : target.sum = 0) :
    properPredecessorPatterns target = [] := by
  apply List.eq_nil_iff_forall_not_mem.mpr
  intro previous hprevious
  have :=
    sum_predecessor_patterns target previous
      hprevious
  omega

/-- Iterating the triangular strict-depth operator from any fixed state has
polynomial coordinates of degree at most the plain depth sum. -/
lemma iterate_subsequence_sum
    (initial : StrictSubsequenceState) :
    ∀ target : List ℕ,
      IVMost
        (fun steps : ℕ =>
          iterateSubsequenceState initial steps target)
        target.sum
  | target => by
      by_cases hsum : target.sum = 0
      · have hproper :
            properPredecessorPatterns target = [] :=
          predecessor_patterns_nil target

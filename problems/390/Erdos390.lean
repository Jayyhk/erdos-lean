theorem weightedGaugeProjection_norm_le_of_scaled_moment_ratio
    [Nonempty Band]
    (H alpha x : Band → ℝ) {alphaMax C R : ℝ}
    (hH : ∀ i, 0 ≤ H i)
    (hAlpha : ∀ i, 0 ≤ alpha i)
    (hAlphaUpper : ∀ i, alpha i ≤ alphaMax)
    (hTotal : 0 < sharpWeightTotal H alpha)
    (hC : 0 ≤ C) (hR : 0 ≤ R)

namespace BoundedGaps.BombieriVinogradov

open Filter
open scoped BigOperators

noncomputable section

private theorem exists_weighted_one_exp_envelope :
    ∃ C c : ℝ, 0 < C ∧ 0 < c ∧
      ∃ X0 : ℕ, 4 ≤ X0 ∧
        ∀ x : ℕ, X0 ≤ x →
          ∀ y : ℕ, 2 ≤ y → y ≤ x →

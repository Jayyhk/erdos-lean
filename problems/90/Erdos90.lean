    completion_centered_smul
      (K := K) (L := L) P sigma⁻¹ w
  let xlocal := completionPlaceAdic
    (K := K) (L := L) P (sigma⁻¹ • w) (alpha (sigma⁻¹ • w))
  have himage : adicPrimesAbove
      (K := K) (L := L) P alpha (e (sigma⁻¹ • w)) = xlocal :=
    adic_above_image
      (K := K) (L := L) P alpha (sigma⁻¹ • w)

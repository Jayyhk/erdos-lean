      atTop (𝓝 a₀))
    (hsum : ∀ s : ℝ, 1 < s → LSeriesSummable f s) :
    Tendsto (fun s : ℝ ↦ (s - 1) * LSeries f s)
      (𝓝[>] 1) (𝓝 a₀) :=
  LSeries_tendsto_sub_mul_nhds_one_of_tendsto_sum_div hmean hsum


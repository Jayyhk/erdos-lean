    (A : Matrix (Fin (N + 1)) (Fin (N + 1)) ℂ) (p : ℕ) :
    Integrable (fun q => ‖randomBilinearFourier A q‖ ^ p) (fourierMeasure N) := by
  apply (integrable_prod_iff
    ((measurable_randomBilinearFourier A).norm.pow_const p).aestronglyMeasurable).mpr

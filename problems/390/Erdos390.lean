        _ ≤ R * z + R * (R * z) := by
          apply add_le_add
          · simpa [R, add_sub_cancel_left] using hLipShift
          · rw [abs_mul]
            have hzeroDiff : |1 - fourMarkProfile z| ≤ R * z := by
              rw [← fourMarkProfile_zero]

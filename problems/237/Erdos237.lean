local instance s2WeightedMainFaceDecidable (p : Prop) : Decidable p :=
  Classical.propDecidable p

def IsMaynardS2MainFace {H : Finset ℕ}
    (m : H) (r a : H → ℕ) : Prop :=
  ∀ h : H, h ≠ m → a h = r h

noncomputable def maynardS2WeightedMainFaceSum
    (H : Finset ℕ) (R W : ℕ) (y : (H → ℕ) → ℝ)

    squarefreeInvNatTotientSum Q ≤ 4 := by
  unfold squarefreeInvNatTotientSum
  calc
    (∑ d ∈ Finset.Icc 1 Q,
        if Squarefree d then (1 : ℝ) / ((d : ℝ) * Nat.totient d) else 0) ≤
        ∑ d ∈ Finset.Icc 1 Q,

    _ ≤ (2 * N) * ((N : ℝ) ^ 2 * Real.exp (K + 1)) ^ 2 := by gcongr; linarith
    _ = _ := by rw [mul_pow, heq]; ring

/-- A deterministic third derivative bound on the enlarged disk. -/
theorem third_derivative_bound {N : ℕ} (hN : 1 ≤ N) (ω : LogMoments.SignVector N)

            maynardS2OuterWeightAF W p := by ring
      _ = maynardS2OuterWeightAF W p := by rw [hmu, one_mul]
      _ = if p ∣ W then 0 else maynardS2OuterScalarWeight p :=
        maynardS2OuterWeightAF_apply_prime W hp

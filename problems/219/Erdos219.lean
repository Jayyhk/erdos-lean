    eventually_uniform_selectedCFZFiniteFourierCorrection_sieveLevel
    {k w : ℕ} (hk : 3 ≤ k)
    (hw :
      wTrickedCFZComplexExceptionalBound k ≤ w)
    {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ N : ℕ in atTop,

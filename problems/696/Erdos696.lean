      -- |T| ≤ K (since T : Finset (Fin K), |T| ≤ Fin K.card = K).
      have hT_actual_card : T_actual.card ≤ K := by
        rw [hT_actual]
        have h1 := Finset.card_image_le (s := T)
          (f := fun i => selectedPrimeInBlock S y (extract_idx i))

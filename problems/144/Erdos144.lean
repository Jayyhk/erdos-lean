    hsum hxPos halpha halphaTwo hUPos
  have hxPow : (x : ℝ) ^ alpha ≤ 3 * x := by
    simpa [alpha] using rpow_perronAbscissa_le_three_mul hxOne
  have hfactor : 32 * (x : ℝ) ^ alpha / U ≤ 96 * x / U := by
    exact div_le_div_of_nonneg_right

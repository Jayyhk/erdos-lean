      simpa only [base, ξ] using htriple
    _ = ∫ z, ∫ a, ∫ u, full z a u ∂volume ∂base ∂τ := by
      apply integral_congr_ae
      filter_upwards with z
      apply integral_congr_ae
      filter_upwards with a
      exact htranslate z a


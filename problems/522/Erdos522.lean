      μHE[Module.finrank ℝ U] (e '' s) := by
    simpa using e.toLinearMap.euclideanHausdorffMeasure_image_eq_normDet_mul_volume s |>.symm
  rw [← continuousLinearEquivRange_normDet A hA, hemeasure, ht]
  simpa [e, g, hg] using hmeasure


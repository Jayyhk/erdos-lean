      (Sum.inl P : NumberFieldPlace K) ∈ S} := by
  apply Set.Finite.of_finite_image
      (f := fun P : FinitePrime K ↦ (Sum.inl P : NumberFieldPlace K))
  · apply S.finite_toSet.subset
    rintro _ ⟨P, hP, rfl⟩
    exact hP
  · exact Set.injOn_of_injective Sum.inl_injective


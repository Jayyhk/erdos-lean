    {k N : ℕ}
    (ν : ZMod N → ℝ) (j : Fin k)
    (face : BooleanCube (DeletedCube k j))
    (other : LinearFormsExponent k)
    (hother : ∀ ω, other j ω = false)
    (x : CubePoint k N) :

structure _root_.ProbabilityTheory.BentkusInduction.bentkusNontrivialTaylorEstimate (K C : ℝ) : Prop where
  bound : ∀ {n d : ℕ} (_hd : 0 < d)
    {Ω : Type u} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]

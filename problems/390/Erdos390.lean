    div_le_div_of_nonneg_left (by positivity) (sq_pos_of_pos hlogM) hdenomTwo
  calc
    |∑ m ∈ Finset.Ico M Z,
        roughSaiasFullyRealBuchstabCellRemainder X m| ≤
      (X : ℝ) / ((M : ℝ) * Real.log (M : ℝ)) +
        2 * (X : ℝ) /

@[simp] theorem relators_union_symm
    (P : Presentation.{u}) (S T : Set P.Free)
    (hT : ∀ ⦃t : P.Free⦄, t ∈ T → t ∈ (P.withRelators S).rNClos)
    (w : P.Free) :
    (relatorsSubsetClosure P S T hT).symm
        ((P.withRelators (S ∪ T)).quotientMap w) =

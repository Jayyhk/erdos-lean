      intro hsCandidate
      exact hsP
        (mem_dirichletExplicitFormulaCandidateSingularitiesFinset_iff.mpr
          hsCandidate)
    · intro rho _hrho
      exact
        tendsto_sub_mul_dirichletExplicitFormulaIntegrand_eq_candidateContribution
          chi x rho

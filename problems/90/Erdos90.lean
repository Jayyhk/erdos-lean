    piIntegersAlgebra (K := K) (L := L) P hP
  letI : Algebra C (∀ Q, E Q) := Pi.algebra _ _
  letI : Algebra F (∀ Q, E Q) :=
    piCompletionsAlgebra (K := K) (L := L) P hP
  let e₀ : A ≃ₐ[C] (∀ Q, B Q) :=
    integersPiDifferent
      (K := K) (L := L) P hP

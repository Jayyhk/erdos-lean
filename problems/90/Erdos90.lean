    {M N : ℕ}
    {G : Type*}
    [Group G]
    (f : LabelledAtom M N → G)
    (expand :
      CWord (LabelledAtom M N) →
        List (CWord (LabelledAtom M N))) :
    ∀ L : List (CWord (LabelledAtom M N)),
      labelledEval f (L.flatMap expand) =
        (L.map fun word => labelledEval f (expand word)).prod

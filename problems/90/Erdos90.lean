  apply CWord.eval_lower_series
    (HPAtom.eval x y)
    (HPAtom.weight leftWeight rightWeight)
    (HPAtom.weight_pos hleftWeight hrightWeight)
  intro a
  cases a with
  | left =>
      simpa [HPAtom.eval, HPAtom.weight] using hx
  | right =>
      simpa [HPAtom.eval, HPAtom.weight] using hy


        Real.exp (-((j + 1 : ℕ) : ℝ)) := by
    rw [Real.rpow_def_of_pos hpR]
    apply Real.exp_le_exp.mpr
    have hinv : 0 < (Real.log (y : ℝ))⁻¹ := inv_pos.mpr hlogy
    calc
      Real.log (p : ℝ) * (-(Real.log (y : ℝ))⁻¹) ≤

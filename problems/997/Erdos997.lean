      exact_mod_cast (by linarith : (2 : ℝ) * N + 1 = 4 * n)
    omega
  · rw [hodd.gammaFactor_def, ne_eq, Gammaℝ_eq_zero_iff, not_exists]
    intro n hn
    have hre := congrArg Complex.re hn
    norm_num at hre
    rw [hs] at hre

theorem vaughanTwistedSumThreeLargeEndpointMaximum_le_sum_dyadicBlockMaximum
    {U V : ℝ} (hU : 1 ≤ U) (hV : 1 ≤ V)
    {x q : ℕ} (hx : 1 ≤ x)
    (chi : DirichletCharacter ℂ q) :

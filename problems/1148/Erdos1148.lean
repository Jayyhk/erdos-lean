      _ ≤ Ko * (10 * Y * Real.exp (T / 2)) :=
        mul_le_mul_of_nonneg_left (exp_le_ten_height_mul_exp_half hYpos hsmall) hKo.le
      _ = (10 * Ko) * Y * Real.exp (T / 2) := by ring

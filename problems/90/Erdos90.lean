    change x.1.1 ^ n = 1
    have hx := x.property
    change x.1 ^ n = 1 at hx
    exact congrArg Units.val hx⟩
  left_inv _ := rfl
  right_inv _ := by
    apply Subtype.ext
    exact toUnits_val_apply _
  map_mul' _ _ := by
    apply Subtype.ext
    apply Units.ext
    rfl


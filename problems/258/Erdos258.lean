      calc
        |R + (A - T) + (T - U)| ≤
        |R + (A - T)| + |T - U| := abs_add_le _ _
        _ ≤ |R| + |A - T| + |T - U| := by
          calc
            |R + (A - T)| + |T - U| =
                |T - U| + |R + (A - T)| := by ring
            _ ≤ |T - U| + (|R| + |A - T|) := by
              linarith [abs_add_le R (A - T)]

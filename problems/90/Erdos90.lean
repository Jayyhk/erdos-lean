      (b : Module.Basis i (ZMod p) (Additive Gal(M/L))),
      Function.Bijective indexPrime ∧
        (∀ q : FinitePrime K, q ∈ T →
          (Sum.inl q : NumberFieldPlace K) ∉ S) ∧
        (∀ j, (w j).under (OK_v85 K) = (indexPrime j : FinitePrime K)) ∧

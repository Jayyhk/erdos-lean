      (1 + (4 * A / 3) * (1 / 4 : ℝ) ^ (S - 100)) *
        localEulerProduct oneShiftDensity (P - 1) Q at hmUpper
  calc
    ((intervalMissingPrimeBlockSet (P, Q) L U).card : ℝ) ≤
        ((U - L : ℕ) : ℝ) *
            upperMainTerm stop oneShiftDensity primes + (D : ℝ) ^ 2 := hb
    _ ≤ ((U - L : ℕ) : ℝ) *
          ((1 + (4 * A / 3) * (1 / 4 : ℝ) ^ (S - 100)) *
            localEulerProduct oneShiftDensity (P - 1) Q) +
          (D : ℝ) ^ 2 := by

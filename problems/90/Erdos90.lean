lemma presented_free_difference
    {p d r : ℕ} [Fact p.Prime]
    (rels : Fin r → FreeGroup (Fin d))
    (g : FreeGroup (Fin d)) :
    GShafar.presentedAlgebra (R := ZMod p) (Set.range rels)
        (augmentationDifference (ZMod p) (FreeGroup (Fin d)) g) =

        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hdCast (by norm_num)) (by positivity)
      _ =
          (100 * |C|) * ((n : ℝ) ^ (120 * L - 2)) *
            ((n : ℝ) ^ (120 * L)) := by

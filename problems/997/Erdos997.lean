private theorem sqrt_vaughanCubeRoot (x : ℕ) :
    Real.sqrt (vaughanCubeRoot x) = vaughanSixthRoot x := by
  rw [← vaughanSixthRoot_sq x]
  exact Real.sqrt_sq (vaughanSixthRoot_nonneg x)


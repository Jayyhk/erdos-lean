def finiteAdeleUnits : (FiniteAdeleRing R K)ˣ ≃* FiniteIdeles R K :=
  RestrictedProduct.unitsEquiv (fun v : HeightOneSpectrum R ↦ v.adicCompletion K)

/-- Algebraically, ideles are the units of the adele ring.  This is not a

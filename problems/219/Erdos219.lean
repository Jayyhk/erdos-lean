      ∏ p ∈ smallPrimeFinset w,
        (1 - (p : ℂ)⁻¹) := by
  have hW : primorial w ≠ 0 :=
    (primorial_pos w).ne'
  have hq :
      (((primorial w).totient : ℚ) /
          (primorial w : ℚ)) =
        ∏ p ∈ Nat.primesLE w,
          (1 - (p : ℚ)⁻¹) := by
    rw [Nat.totient_eq_mul_prod_factors (primorial w),
      primeFactors_primorial]
    have hWq : (primorial w : ℚ) ≠ 0 := by
      exact_mod_cast hW
    field_simp [hWq]

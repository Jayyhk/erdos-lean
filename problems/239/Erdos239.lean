    (Real.rpow_nonneg hNR.le e)
  have hpow : (N : ℝ) ^ d * (N : ℝ) ^ e =
      (N : ℝ) ^ (s : ℝ)⁻¹ := by
    rw [← Real.rpow_add hNR]
    congr 1
    dsimp only [d]
    ring
  have hmain :

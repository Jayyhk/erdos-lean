    (hp : IntegrableOn (fun x => ‖p x‖ ^ 2) J μ)
    (hΦ : IntegrableOn (fun x => Φ x ^ 2) J μ)
    (happrox : ∀ x ∈ J, ‖f x - p x‖ ≤ c * Φ x)

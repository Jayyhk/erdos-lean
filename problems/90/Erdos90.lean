        (rootsOfUnityEquivOfPrimitiveRoots
          (algebraMap K L.carrier).injective hroots).symm
            (radicalKummerExtension K Omega n L hn hroots sigma b) *
        (rootsOfUnityEquivOfPrimitiveRoots

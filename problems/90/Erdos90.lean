    coordinates_single_three
      w hwBasic hw
  unfold basicReductionScaled basicScaledTerm
  rw [hcoordinates]
  have hterm :
      ((Finset.univ.sort
          fun j k : BasicIndex (α := α) w.weight => j ≤ k).map
        fun j =>
          indexedTreeRep j ^
            (Finsupp.single i (1 : ℤ) j * z)).prod =
        indexedTreeRep i ^ z := by
    rw [show
        ((Finset.univ.sort
            fun j k : BasicIndex (α := α) w.weight => j ≤ k).map
          fun j =>
            indexedTreeRep j ^
              (Finsupp.single i (1 : ℤ) j * z)).prod =
          ((Finset.univ.sort
              fun j k : BasicIndex (α := α) w.weight => j ≤ k).map
            fun j =>
              if j = i then indexedTreeRep i ^ z
                else 1).prod by
          congr 1
          apply List.map_congr_left
          intro j _hj
          by_cases hji : j = i
          · subst j
            simp
          · simp [hji]]
    exact
      list_ite_nodup_v7
        (Finset.univ.sort
          fun j k : BasicIndex (α := α) w.weight => j ≤ k)

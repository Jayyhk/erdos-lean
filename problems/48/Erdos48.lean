    apply tendsto_finsetSum
    intro q hq
    have hrhoq : rho - q ≠ 0 :=
      sub_ne_zero.mpr (Finset.mem_erase.mp hq).1.symm
    exact ((continuousAt_const.div
      (continuousAt_id.sub continuousAt_const) hrhoq).tendsto).mono_left
        nhdsWithin_le_nhds

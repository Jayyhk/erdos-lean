    rw [hca] at hba
    rw [hcb] at hbb
    have hbin : (⌊|ca| / δ⌋₊ : ℝ) = (⌊|cb| / δ⌋₊ : ℝ) := by
      exact_mod_cast (show ⌊|ca| / δ⌋₊ = ⌊|cb| / δ⌋₊ by
        simpa [packingBin, ca, cb] using hn)
    rw [hca, hcb] at hbin
    rw [← hbin] at hbb

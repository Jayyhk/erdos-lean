    UniqueFactorizationMonoid.exists_mem_factors_of_dvd hI hirr hdiv
  let q' : UpperPrimeFactors (K := K) (L := L) P :=
    ⟨q, Multiset.mem_toFinset.mpr hqmem⟩
  refine ⟨q', ?_⟩
  apply Subtype.ext
  apply HeightOneSpectrum.ext
  exact associated_iff_eq.mp hQq.symm


                      dirichletExplicitFormulaIntegrand chi x
                        ((sigma : ℂ) - U * I)‖ ≤
                    640 * (A : ℝ) * C * x *
                      Real.log ((q : ℝ) * x) ^ 2 / T := by
  obtain ⟨A, hA, hpointwise⟩ :=
    exists_nat_norm_logDeriv_LFunction_primitive_horizontal_le

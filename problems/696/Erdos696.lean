      0 ≤ ((Nat.card {n : ℕ | n ≤ ⌊x⌋₊ ∧ ¬ GoodLowerDivisorChain ε n} : ℕ) : ℝ) / x := by
    positivity
  rw [Real.norm_of_nonneg hnonneg]
  linarith


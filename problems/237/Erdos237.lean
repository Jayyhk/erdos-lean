        ‖vaughanTwistedSumThreeSmall U V y q chi.1‖) +
        ‖vaughanTwistedSumThreeLarge U V y q chi.1‖) +
        ‖vaughanTwistedSumFour U V y q chi.1‖ := by
      gcongr
      exact norm_add_le _ _
    _ ≤ _ := by
      gcongr


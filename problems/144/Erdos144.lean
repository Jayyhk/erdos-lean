    filter_upwards [eventually_gt_atTop 0] with n hn
    simp only [partialDensity, Set.inter_univ, Set.univ_inter]
    have hIio : (Set.Iio n).ncard = n := by simp
    rw [hIio]
    field_simp
    ring)


  linarith

private theorem inv_sub_rpow_shift_le_log_div_reverse
    {Y p : ℕ} (hY : 2 ≤ Y) (hp : p.Prime) :
    (p : ℝ)⁻¹ - (p : ℝ) ^ (-(1 + (Real.log (Y : ℝ))⁻¹)) ≤
      Real.log (p : ℝ) / (p : ℝ) / Real.log (Y : ℝ) := by
  have hpPos : (0 : ℝ) < p := by exact_mod_cast hp.pos

                    mul_le_mul_of_nonneg_left
                      (div_le_div_of_nonneg_right (hFone p) (hpPos p).le) hw
          _ = (CF * w) *
              ((1 / (p.1 : ℝ)) * tPrime B.sampleData.n p.1) := by ring

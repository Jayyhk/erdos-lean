    ((resizedIdelesCofinal
        (K := K) (L := L) C qC).1,
      (⟦⟨C, (resizedIdelesCofinal
        (K := K) (L := L) C qC).2⟩⟧ :
        ResizedCofinalLimit K L)) = y

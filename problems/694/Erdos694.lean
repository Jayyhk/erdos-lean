lemma norm_cosecantBilinearForm_le_of_energy_bound
    (x : ι → ℝ) {δ : ℝ} (hδ : 0 < δ)
    (htrig : CosecantCotangentIdentity x)
    (henergy : ∀ (μ : ℝ) (v : ι → ℂ),

        (((Nat.totient W : ℝ) ^ K * (N : ℝ) * Lr ^ K) /
          (W : ℝ) ^ (K + 1)) = _
  have hSeq : S = (Nat.totient W : ℝ) / (W : ℝ) := by
    simpa [S, W, D, maynardModulus,
      BoundedGaps.Maynard.engelsmaMaynardModulus] using

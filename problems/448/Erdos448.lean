            (2 * (N : ℝ) ^ (1 / 2 : ℝ)) := by
        gcongr
        exact sum_Ioo_rpow_neg_half_le N (by omega)
      _ ≤ (2 * (N : ℝ) ^ (-(1 / 2 : ℝ))) *
            (2 * (N : ℝ) ^ (1 / 2 : ℝ)) := by
        gcongr
        exact half_rpow_neg_le_two_mul (N : ℝ) (1 / 2 : ℝ) hNR
          (by norm_num) (by norm_num)
      _ = 4 * ((N : ℝ) ^ (-(1 / 2 : ℝ)) *
            (N : ℝ) ^ (1 / 2 : ℝ)) := by ring
      _ = 4 := by
        rw [← Real.rpow_add hNR]
        norm_num
  rw [show (∑ j ∈ Finset.Ioo 0 N,
      (j : ℝ) ^ (-(1 / 2 : ℝ)) *
        ((N - j : ℕ) : ℝ) ^ (-(1 / 2 : ℝ))) =

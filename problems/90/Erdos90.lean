    apply Additive.toMul.injective
    apply Subtype.ext
    exact ha.symm
  apply sub_eq_zero.mp
  rw [← map_sub]
  change (Rep.Hom.hom (cokernel.π
    (restrictedPrincipalHom (K := K) (L := L) S))) (x - y) = 0
  rw [hsub]
  exact congrArg
    (fun f ↦ f (Additive.ofMul a'))
    (cokernel.condition
      (restrictedPrincipalHom (K := K) (L := L) S))


  have hswNontrivial : (sigma • w₁.1).IsNontrivial := by
    obtain ⟨x, hx0, hx1⟩ := hw₁
    refine ⟨sigma x, ?_, ?_⟩
    · simpa only [map_zero] using sigma.injective.ne hx0
    simpa using hx1

    calc
      2 ^ (Nat.log 2 X + 1) = 2 ^ Nat.log 2 X * 2 := by rw [pow_succ]
      _ ≤ X * 2 := Nat.mul_le_mul_right 2 (Nat.pow_log_le_self 2 hX.ne')

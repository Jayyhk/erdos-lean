      rw [Finset.mem_inter] at hmem₀
      have hq₀_in_block : selectedPrimeInBlock S y k₀ ∈ compositeBlock y k₀ := hmem₀.1
      have hq₀_gt_exp_y : Real.exp y < (selectedPrimeInBlock S y k₀ : ℝ) :=

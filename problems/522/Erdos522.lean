      ENNReal.ofReal (2 * A) := by
    rw [show (2 : ℝ≥0∞) = ENNReal.ofReal (2 : ℝ) by norm_num]
    exact (ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)).symm
  rw [htwo]
  rw [show 2 *
      (2 * ballUnitVolume (d - 2) *
        ∫ θ in (0 : ℝ)..Real.pi / 2,
          f (r * Real.sin θ) * Real.sin θ ^ (d - 1)) =
      4 * ballUnitVolume (d - 2) *
        ∫ θ in (0 : ℝ)..Real.pi / 2,

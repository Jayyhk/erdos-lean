        (DirichletCharacter.changeLevel hd ψ.1).primitiveCharacter = 1
    · rw [if_pos h, if_pos (hprincipal.mp h)]
    · rw [if_neg h, if_neg (fun hp ↦ h (hprincipal.mpr hp))]


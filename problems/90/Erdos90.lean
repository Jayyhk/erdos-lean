    piLocalizationTarget B E e₀
  letI : SMul C A :=
    (show Algebra C A from inferInstance).toSMul
  letI : SMul A (∀ Q, E Q) :=
    (show Algebra A (∀ Q, E Q) from inferInstance).toSMul
  letI : SMul C (∀ Q, E Q) :=
    (show Algebra C (∀ Q, E Q) from inferInstance).toSMul

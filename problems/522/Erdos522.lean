  have hB : 0 ≤ B := annularLocalMultiplicityBound_nonneg hN hK'
  let E₁ : Set (LogMoments.SignVector N) := {ω | ∃ c : ℂ,
    |‖c‖ - 1| ≤ 1 / (N : ℝ) ∧ B <
      (zeroCountIn (rademacherPolynomial N ω) (Metric.closedBall c (2 * K' / N)) : ℝ)}
  let E₂ : Set (LogMoments.SignVector N) := {ω | ∃ w : ℂ,

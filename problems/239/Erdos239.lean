        ∑ d ∈ Finset.range (j + 1), (1 / 2 : ℝ) ^ d := by
    calc
      (∑ k ∈ Finset.range (j + 1),
          (1 / 2 : ℝ) ^ Nat.dist j k) =
          ∑ k ∈ Finset.range (j + 1), (1 / 2 : ℝ) ^ (j - k) := by
        apply Finset.sum_congr rfl
        intro k hk

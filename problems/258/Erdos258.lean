      if q ∣ n + m.1 then
        (if p ∣ n + m.1 then sieveWeight K n else 0) else 0 by
    by_cases hpN : p ∣ n + m.1 <;> by_cases hqN : q ∣ n + m.1 <;>
      simp [hpN, hqN]]
  rw [sieveWeight_eq_fromYWeight]
  rw [hfirst]

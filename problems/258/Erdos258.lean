noncomputable def maynardS2MainFaceArithmeticFactor
    (H : Finset ℕ) (m : H) (r : H → ℕ) : ℝ :=
  ∏ h ∈ Finset.univ.erase m,
    (maynardS2G (r h) : ℝ) * (r h : ℝ) /
      (Nat.totient (r h) : ℝ) ^ 2


  { toFun := fun m ↦ ⟨transversalNorm A H S m, transversal_norm_invariants A H m m.2 S⟩
    map_add' := by
      intro x y
      ext
      simp [transversalNorm, Finset.sum_add_distrib]
    map_smul' := by
      intro r x
      ext
      simp [transversalNorm, Finset.smul_sum] }

end

end Submission.CField.COps


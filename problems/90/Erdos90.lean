  intro x
  let xQ : (A.ρ.quotientToInvariants H).invariants :=
    ⟨⟨x.1, fun h => x.2 h.1⟩,
      fun q => QuotientGroup.induction_on q fun g =>
        Subtype.ext (by simpa using x.2 g)⟩

    (hleftWeight : 0 < leftWeight)
    (hrightWeight : 0 < rightWeight) where
  batches :
    List (GPBatch
      n leftWeight rightWeight hleftWeight hrightWeight)
  shape_trace_perm :
    ∀ M N,
      List.Perm
        ((batches.map fun batch =>
          generatedParentsBatch
            batch M N).flatten)
        (selectedErasedShape layer M N)

namespace PGDecomp

/--

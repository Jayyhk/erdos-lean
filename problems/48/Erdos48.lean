      let A : ℕ → ι → ℝ := fun q i ↦
        ∑ psi : primitiveCharacters q,
          ‖∑ n ∈ s i, c n * psi.1 n‖ ^ 2
      have hpsi (q : ℕ) :
          (∑ psi : primitiveCharacters q,
              C * ∑ i : ι, ‖∑ n ∈ s i, c n * psi.1 n‖ ^ 2) =
            C * ∑ i : ι, A q i := by
        calc

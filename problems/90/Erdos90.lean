  change (∏ v : InfinitePlace K, v.1 (p : K) ^ v.mult) *
      (∏ᶠ P : HeightOneSpectrum (NumberField.RingOfIntegers K),
        (FinitePlace.equivHeightOneSpectrum.symm P) (p : K)) = 1

        ∑ k ∈ Finset.Ioc 0 (x / M),
          (vaughanFourthCoefficient V k) ^ 2 := by
    calc
      (∑ k ∈ (Finset.Ioc 0 (x / M)).filter
          (fun k : ℕ => V < (k : ℝ)),
          ‖(vaughanFourthCoefficient V k : ℂ)‖ ^ 2) =
          ∑ k ∈ (Finset.Ioc 0 (x / M)).filter
            (fun k : ℕ => V < (k : ℝ)),
            (vaughanFourthCoefficient V k) ^ 2 := by
        apply Finset.sum_congr rfl
        intro k hk
        rw [Complex.norm_real, Real.norm_eq_abs, sq_abs]

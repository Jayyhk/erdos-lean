  rw [← MeasureTheory.Measure.map_neg_eq_self
    (MeasureTheory.volume : MeasureTheory.Measure (ComplexSpace d))]
  rw [MeasureTheory.Measure.map_apply measurable_neg hΩ]
  congr 1
  ext z
  simp

/--

    (S : FSBound p d k Q) (r : S.fp.toPresentation.Relator) :
    r ∈ S.arithmeticRelators ↔ ∃ j, S.relatorCode r = Sum.inl j := by
  classical
  letI : Fintype S.fp.toPresentation.Relator := S.fintype_relator

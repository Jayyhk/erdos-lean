/-- Prefixing the sharp successor-skew schedule by a fixed schedule preserves
the exact carried-weight bound for every ordered-subsequence coordinate. -/
lemma multFixedCarried
    (cutoff : ℕ)
    (fixedPrefix : List SRTrans)
    (crossed outer selected right : CWord Atom)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (emittedPrefix : List (CWord Atom))
    (target : List SRTrans) :
    IVMost
      (fun steps : ℕ =>
        (orderedSubsequenceMultiplicity target
          (fixedPrefix ++
            middleSuccessorSkew cutoff
              crossed outer selected right emittedPrefix steps) : ℤ))
      (target.map secondRouteCarried).sum := by
  rw [show
    (fun steps : ℕ =>
      (orderedSubsequenceMultiplicity target
        (fixedPrefix ++
          middleSuccessorSkew cutoff
            crossed outer selected right emittedPrefix steps) : ℤ)) =
      fun steps : ℕ =>
        ∑ suffix ∈ target.tails.toFinset,
          (orderedSubsequenceMultiplicity
            (target.take (target.length - suffix.length))
            fixedPrefix : ℤ) *
          (orderedSubsequenceMultiplicity suffix
            (middleSuccessorSkew cutoff
              crossed outer selected right emittedPrefix steps) : ℤ) by
    funext steps
    exact_mod_cast
      subsequence_append_tails target fixedPrefix
        (middleSuccessorSkew cutoff
          crossed outer selected right emittedPrefix steps)]
  apply IVMost.finsetSum
  intro suffix hsuffix
  have hsuffixMem :
      suffix <:+ target :=
    (List.mem_tails suffix target).mp (List.mem_toFinset.mp hsuffix)
  rcases hsuffixMem with ⟨initial, rfl⟩
  simp only [List.length_append, Nat.add_sub_cancel_right,
    List.take_append_of_le_length (Nat.le_refl initial.length),
    List.take_length, List.map_append, List.sum_append]
  apply
    (TCTex.IVMost.mul
      (valued_most_constant 0
        (orderedSubsequenceMultiplicity initial fixedPrefix : ℤ))
      (multMiddleCarried
        cutoff crossed outer selected right houter hselected hright
          emittedPrefix suffix)).mono
  omega

/-- Prefixing by a fixed supported schedule preserves the sharp
strict-transition plus matching-producer bound for bounded terms. -/
lemma constantProducerCarried
    (cutoff : ℕ)
    (fixedPrefix : List SRTrans)
    (hfixedPrefix :
      ∀ transition ∈ fixedPrefix,
        transition ∈ secondRouteAlphabet cutoff)
    (crossed outer selected right : CWord Atom)
    (hcrossed : isFirstCurrent crossed = true)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (emittedPrefix : List (CWord Atom))
    (target : OCTerm) :
    IVMost
      (fun steps : ℕ =>
        ((boundedConstantTerms cutoff
          (fixedPrefix ++
            middleSuccessorSkew cutoff
              crossed outer selected right emittedPrefix steps)).count
                target : ℤ))
      ((target.strictTransitions.map
        secondRouteCarried).sum +
          matchingProducerCarried cutoff target) := by
  by_cases htarget : target.strictTransitions.length < cutoff
  · rw [show
      (fun steps : ℕ =>
        ((boundedConstantTerms cutoff
          (fixedPrefix ++
            middleSuccessorSkew cutoff
              crossed outer selected right emittedPrefix steps)).count
                target : ℤ)) =
        fun steps : ℕ =>
          ∑ producer ∈
              (secondRouteAlphabet cutoff).toFinset,
            if target.constant = (producer.affine cutoff).constant then
              (orderedSubsequenceMultiplicity
                (target.strictTransitions ++ [producer])
                (fixedPrefix ++
                  middleSuccessorSkew
                    cutoff crossed outer selected right emittedPrefix steps) :
                  ℤ)
            else
              0 by
      funext steps
      exact_mod_cast
        constant_ite_producers
          cutoff (secondRouteAlphabet cutoff)
            (fixedPrefix ++
              middleSuccessorSkew cutoff
                crossed outer selected right emittedPrefix steps)
            (fun transition htransition => by
              rcases List.mem_append.mp htransition with htransition | htransition
              · exact hfixedPrefix transition htransition
              · exact
                  middle_successor_skew
                    cutoff steps crossed outer selected right hcrossed
                      emittedPrefix transition htransition)
            target |>.trans (if_pos htarget)]
    apply IVMost.finsetSum
    intro producer hproducer
    by_cases hconstant :
        target.constant = (producer.affine cutoff).constant
    · simp only [hconstant, ↓reduceIte]
      have hsource :=
        multFixedCarried
          cutoff fixedPrefix crossed outer selected right houter hselected hright
            emittedPrefix (target.strictTransitions ++ [producer])
      apply hsource.mono
      rw [List.map_append, List.sum_append]
      simp only [List.map_singleton, List.sum_singleton]
      exact
        Nat.add_le_add_left
          (matching_producer_bound
            cutoff target producer (List.mem_toFinset.mp hproducer)
              hconstant)
          (target.strictTransitions.map
            secondRouteCarried).sum
    · simp only [hconstant, ↓reduceIte]
      exact
        valued_most_constant
          ((target.strictTransitions.map
              secondRouteCarried).sum +
            matchingProducerCarried cutoff target)
          0
  · rw [show
      (fun steps : ℕ =>
        ((boundedConstantTerms cutoff
          (fixedPrefix ++
            middleSuccessorSkew cutoff
              crossed outer selected right emittedPrefix steps)).count
                target : ℤ)) =
          fun _steps : ℕ => 0 by
      funext steps
      exact_mod_cast
        constant_ite_producers
          cutoff (secondRouteAlphabet cutoff)
            (fixedPrefix ++
              middleSuccessorSkew cutoff
                crossed outer selected right emittedPrefix steps)
            (fun transition htransition => by
              rcases List.mem_append.mp htransition with htransition | htransition
              · exact hfixedPrefix transition htransition
              · exact
                  middle_successor_skew
                    cutoff steps crossed outer selected right hcrossed
                      emittedPrefix transition htransition)
            target |>.trans (if_neg htarget)]
    exact
      valued_most_constant
        ((target.strictTransitions.map
            secondRouteCarried).sum +
          matchingProducerCarried cutoff target)
        0

/-- Every affine endpoint coordinate of a supported fixed prefix followed by
the variable successor-skew schedule has degree at most its emitted weight. -/
lemma countAffineAppend
    (cutoff : ℕ)
    (hcutoff : 0 < cutoff)
    (fixedPrefix : List SRTrans)
    (hfixedPrefix :
      ∀ transition ∈ fixedPrefix,
        transition ∈ secondRouteAlphabet cutoff)
    (crossed outer selected right : CWord Atom)
    (hcrossed : isFirstCurrent crossed = true)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)

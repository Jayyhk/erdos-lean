theorem sum_productRough_factorPairs_le_sum_conductorRough_multipliers
    (x Q : ℕ) (Q1 : ℝ) :
    (∑ p ∈ (positiveFactorPairs Q).filter (fun p ↦
        roughModulusAbove Q1 (p.1 * p.2) ∧ p.1 ≠ 1),
      ((p.1 * p.2).totient : ℝ)⁻¹ *
        ∑ ψ : primitiveCharacters p.1,

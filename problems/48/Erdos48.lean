    (n L Q : ℕ) :
    (∑ r ∈ powerSieveAuxPrimes n L Q, (r : ℝ)⁻¹) =
      Erdos822.reciprocalPrimeIntervalSum
        (powerSieveAuxLower n L Q + 1)
        (powerSieveAuxUpper n L Q) := by

    (fun _ _ h ↦ isCohomologous_restrict f hsmul h)
  map_one' := by
    change mk (NMCocycl₂.restrict f hsmul 1) = mk 1
    apply congrArg mk
    exact (NMCocycl₂.restrictionHom f hsmul).map_one
  map_mul' x y := by

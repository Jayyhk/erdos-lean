          logarithmicMomentCutoff A N * Real.sqrt
            (Real.exp (-2 * (Real.log N / 32)) + H / Real.sqrt N + (N : ℝ) ^ (-1 / 16 : ℝ)) +
          (3 / 2 : ℝ) * Real.exp (-2 * (Real.log N / 32)) <

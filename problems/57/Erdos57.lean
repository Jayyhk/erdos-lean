    (G : SimpleGraph V) (X : Set V) (A B : Finset V) (r s : ℕ)
    {z : V} (hzA : z ∈ ballAvoidingFrom G X A r)
    (hzB : z ∈ ballAvoidingFrom G X B s) :
    ∃ a ∈ A, ∃ b ∈ B, ∃ p : G.Walk a b,

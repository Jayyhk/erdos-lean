      -- ∏ T_actual ≥ q (Finset.single_le_prod') > d.
      have hT_actual_ne : T_actual.Nonempty := by rw [hT_actual]; exact hT_ne.image _
      obtain ⟨q₀, hq₀⟩ := hT_actual_ne
      rw [hT_actual, Finset.mem_image] at hq₀
      obtain ⟨i₀, _hi₀, rfl⟩ := hq₀

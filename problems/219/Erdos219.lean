nonnegative. -/
theorem HasLinearFormsCondition.error_nonneg {k N : ℕ} [NeZero N]
    {ν : ZMod N → ℝ} {η : ℝ}
    (h : HasLinearFormsCondition k N ν η) :
    0 ≤ η := by
  have he := h (emptyLinearFormsExponent k)
  have hproduct :
      linearFormsProduct k N ν (emptyLinearFormsExponent k) =

    O.weight leftWeight rightWeight =
      P.weight leftWeight rightWeight := by
  unfold BRPkt.RObstru.weight
  rw [
    RPEquiv.BRecipe.weighted_poly_equivalent
      h.1,
    RPEquiv.BRecipe.weighted_poly_equivalent
      h.2]


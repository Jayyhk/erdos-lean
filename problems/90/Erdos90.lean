    (hdim : Module.finrank k A = (Module.finrank k L) ^ 2)
    (sigma : Gal(L/k)) (u v : Aˣ)
    (hu : ∀ a : L, (u : A) * i a = i (sigma a) * (u : A))
    (hv : ∀ a : L, (v : A) * i a = i (sigma a) * (v : A)) :

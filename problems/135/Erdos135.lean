    exact hAB ⟨c, hc⟩
  · rw [ha₀, ha₁, hb₀, hb₁] at hc
    apply hAB
    refine ⟨-c, ?_⟩
    calc
      B₁ - B₀ = -(B₀ - B₁) := by module
      _ = -(c • (A₁ - A₀)) := congrArg Neg.neg hc
      _ = (-c) • (A₁ - A₀) := by module

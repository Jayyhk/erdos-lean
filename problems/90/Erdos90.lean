`ℝˣ` has index two. -/
theorem real_even_index
    {n : ℕ} (hn : Even n) (hn0 : n ≠ 0) :
    (powMonoidHom n : ℝˣ →* ℝˣ).range.index = 2 := by
  rw [real_even_pos hn hn0]
  exact Units.index_posSubgroup ℝ


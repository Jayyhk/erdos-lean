  (((2 * Real.pi : ℝ) : ℂ)⁻¹) *
    (I * (∫ sigma in (-1 / 2)..(1 + 1 / Real.log x),
          dirichletExplicitFormulaIntegrand chi x
            ((sigma : ℂ) - U * I)) -
      I * (∫ sigma in (-1 / 2)..(1 + 1 / Real.log x),
          dirichletExplicitFormulaIntegrand chi x
            ((sigma : ℂ) + U * I)) +

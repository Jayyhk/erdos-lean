/-- Complete crossed schedule for the successor-skew outer-middle trace. -/
def middleSuccessorSkew
    (cutoff : ℕ)
    (crossed outer selected right : CWord Atom)
    (emittedPrefix : List (CWord Atom))
    (steps : ℕ) :
    List SRTrans :=
  boundedCrossingSchedule cutoff crossed outer
      emittedPrefix steps ++
    repeatTransitionSchedule
      (successorSkewCrossing cutoff crossed
        outer selected right steps) (steps + 1)

/-- The positive crossed tail used by the final outer-packet recurrence is
the successor-skew complete schedule. -/
lemma crossed_iterate_prepend
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (steps : ℕ) :
    ((iteratePrepend cutoff isFirstCurrent
      WNTrace.trace steps
        (iteratePrepend cutoff isFirstCurrent [firstConventionalWord]
          (steps + 1)
          (iteratePrepend cutoff isFirstCurrent
            [secondConventionalInverse] (steps + 1) .empty))).trace
              cutoff).map
        (SRTrans.crossed firstConventionalInverse) =
      middleSuccessorSkew cutoff
        firstConventionalInverse firstConventionalInverse
          firstConventionalWord secondConventionalInverse
            (positiveFilteredPrefix cutoff) steps := by
  rw [
    prepend_move_append,
    middle_repeat_singleton
      cutoff hcutoff (steps + 1),
    iterated_cutoff_repeat,
    List.map_append]
  have hprefix :
      unitBelowTrace cutoff (positiveFilteredPrefix cutoff) =
        positiveFilteredPrefix cutoff := by
    unfold positiveFilteredPrefix filteredOuterPrefix
    exact unit_below_idem cutoff _
  rw [← hprefix,
    crossed_move_below
      cutoff steps firstConventionalInverse firstConventionalInverse
        (by simp) (positiveFilteredPrefix cutoff),
    crossed_repeat_moved
      cutoff (steps + 1) steps (steps + 1) firstConventionalInverse
        firstConventionalInverse firstConventionalWord
          secondConventionalInverse (by simp) (by simp)]
  rw [hprefix]
  rfl

/-- The negative crossed tail used by the final outer-packet recurrence is
the successor-skew complete schedule. -/
lemma crossed_prepend_middle
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (steps : ℕ) :
    ((iteratePrepend cutoff isFirstCurrent
      NNPower.inverseNormalizedTrace steps
        (iteratePrepend cutoff isFirstCurrent [firstConventionalInverse]
          (steps + 1)
          (iteratePrepend cutoff isFirstCurrent [secondConventionalWord]
            (steps + 1) .empty))).trace cutoff).map
        (SRTrans.crossed firstConventionalWord) =
      middleSuccessorSkew cutoff
        firstConventionalWord firstConventionalWord
          firstConventionalInverse secondConventionalWord
            (negativeFilteredPrefix cutoff) steps := by
  rw [
    iterate_prepend_append,
    middle_moved_singleton
      cutoff hcutoff (steps + 1),
    iterated_cutoff_repeat,
    List.map_append]
  have hprefix :
      unitBelowTrace cutoff (negativeFilteredPrefix cutoff) =
        negativeFilteredPrefix cutoff := by
    unfold negativeFilteredPrefix filteredOuterPrefix
    exact unit_below_idem cutoff _
  rw [← hprefix,
    crossed_move_below
      cutoff steps firstConventionalWord firstConventionalWord
        (by simp) (negativeFilteredPrefix cutoff),
    crossed_repeat_moved
      cutoff (steps + 1) steps (steps + 1) firstConventionalWord
        firstConventionalWord firstConventionalInverse
          secondConventionalWord (by simp) (by simp)]
  rw [hprefix]
  rfl

/-- Every transition in a successor-skew complete outer-middle schedule
belongs to the fixed second-route transition alphabet. -/
lemma middle_successor_skew
    (cutoff steps : ℕ)
    (crossed outer selected right : CWord Atom)
    (hcrossed : isFirstCurrent crossed = true)
    (emittedPrefix : List (CWord Atom))
    (transition : SRTrans)
    (htransition :
      transition ∈
        middleSuccessorSkew cutoff
          crossed outer selected right emittedPrefix steps) :
    transition ∈ secondRouteAlphabet cutoff := by
  rcases List.mem_append.mp htransition with htransition | htransition
  · exact
      route_crossing_schedule
        cutoff steps crossed outer hcrossed emittedPrefix transition
          htransition
  · exact
      successor_skew_crossing
        cutoff steps crossed outer selected right hcrossed transition
          htransition

/-- Ordered-subsequence coordinates of a successor-skew complete
outer-middle schedule are polynomial. -/
lemma subsequenceMultSkew
    (cutoff : ℕ)
    (crossed outer selected right : CWord Atom)
    (emittedPrefix : List (CWord Atom))
    (target : List SRTrans) :
    IVMost
      (fun steps : ℕ =>
        (orderedSubsequenceMultiplicity target
          (middleSuccessorSkew cutoff
            crossed outer selected right emittedPrefix steps) : ℤ))
      (target.length * (2 * cutoff + emittedPrefix.length + 4) + 1) := by
  rw [show
    (fun steps : ℕ =>
      (orderedSubsequenceMultiplicity target
        (middleSuccessorSkew cutoff
          crossed outer selected right emittedPrefix steps) : ℤ)) =
      fun steps : ℕ =>
        ∑ suffix ∈ target.tails.toFinset,
          (orderedSubsequenceMultiplicity
            (target.take (target.length - suffix.length))
            (boundedCrossingSchedule cutoff crossed outer
              emittedPrefix steps) : ℤ) *
          (orderedSubsequenceMultiplicity suffix
            (repeatTransitionSchedule
              (successorSkewCrossing cutoff
                crossed outer selected right steps) (steps + 1)) : ℤ) by
    funext steps
    exact_mod_cast
      subsequence_append_tails target
        (boundedCrossingSchedule cutoff crossed outer
          emittedPrefix steps)
        (repeatTransitionSchedule
          (successorSkewCrossing cutoff crossed
            outer selected right steps) (steps + 1))]
  apply IVMost.finsetSum
  intro suffix hsuffix
  have hsuffixMem :
      suffix <:+ target :=
    (List.mem_tails suffix target).mp (List.mem_toFinset.mp hsuffix)
  rcases hsuffixMem with ⟨initial, rfl⟩
  simp only [List.length_append, Nat.add_sub_cancel_right,
    List.take_append_of_le_length (Nat.le_refl initial.length),
    List.take_length]
  apply
    TCTex.IVMost.mono
  · let degree := 2 * cutoff + emittedPrefix.length + 4
    have hleft :
        cutoff + emittedPrefix.length + 1 ≤ degree := by
      dsimp [degree]
      omega
    have hright :
        2 * cutoff + 3 ≤ degree := by
      dsimp [degree]
      omega
    calc
      initial.length * (cutoff + emittedPrefix.length + 1) + 1 +
            suffix.length * (2 * cutoff + 3) ≤
          initial.length * degree + 1 + suffix.length * degree :=
        Nat.add_le_add
          (Nat.add_le_add_right
            (Nat.mul_le_mul_left initial.length hleft) 1)
          (Nat.mul_le_mul_left suffix.length hright)
      _ = (initial.length + suffix.length) * degree + 1 := by
        rw [Nat.add_mul]
        omega
  · exact
      TCTex.IVMost.mul
        (subsequenceMultPoly
          cutoff crossed outer emittedPrefix initial)
        (multSuccessorPoly
          cutoff crossed outer selected right suffix)


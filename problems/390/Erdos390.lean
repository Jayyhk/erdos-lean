      |(1 / H) * A - (1 / H) * R| ≤
        epsilonOff * L1 + 2 * epsilonDiag * alpha +
          Cdiag * B.bandDeviationReciprocalSquare i := by
    rw [← mul_sub, abs_mul, abs_of_pos (one_div_pos.mpr hH)]
    have hscaled0 :=

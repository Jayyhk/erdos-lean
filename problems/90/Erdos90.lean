    [Group G] [Group H] [Group K]
    {TG : pTopo G} {TH : pTopo H} {TK : pTopo K}
    (g : cHom H K TH TK)
    (f : cHom G H TG TH) (x : G) :
    (g.comp f).hom x = g.hom (f.hom x) := rfl


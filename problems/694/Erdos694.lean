    {q : ℕ} [NeZero q]
    (chi : DirichletCharacter ℂ q) {rho : ℂ} (t : ℝ)
    (hzero : inducingEulerProduct chi rho = 0)
    (hheight : |rho.im - t| ≤ 1) :
    rho ∈ closedBall ((2 : ℂ) + t * I) 3 := by

/-! ## Generic finite prime-support assignments -/

/-- A form-support chosen independently at every prime in `P`. -/
abbrev FixedFamilyPrimeSupportAssignment
    (κ : Type*) [Fintype κ] (P : Finset Nat.Primes) :=
  (p : {p // p ∈ P}) → Finset κ


      have hSQ0 : 0 ≤ ∑ s ∈ highExponents (valuationCutoff q M),
          ((s : ℝ) + 1) / (q : ℝ) ^ s := by positivity
      have hAP0 : 0 ≤ 8 / (p : ℝ) ^ 2 := by positivity

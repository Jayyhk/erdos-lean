    (le_iSup
      (fun L :
        {L : FiniteGaloisIntermediateField ℚ (AlgebraicClosure ℚ) //
          IsPGroup 3 Gal(L/ℚ) ∧ UnramifiedOutside L S} =>
        L.1.toIntermediateField)

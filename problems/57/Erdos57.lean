  classical
  letI : DecidableEq V := originalDecEq
  obtain ⟨left, hleft⟩ := A.leftEnd.proposition3_10 htarget hle
  obtain ⟨right, hright⟩ := A.rightEnd.proposition3_10 htarget hle

  · by_cases heven : chi.Even
    · have hq : 1 < q := by
        have hqpos : 0 < q := Nat.pos_of_ne_zero (NeZero.ne q)
        have hqne : q ≠ 1 := fun hq => hchiOne (chi.level_one' hq)

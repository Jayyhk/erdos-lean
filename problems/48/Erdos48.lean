namespace BoundedGaps.Maynard

/-- The synchronized near-one scale puts the real part strictly above one
half. -/
theorem half_lt_re_of_near_one_scale
    {M q : ℕ} [NeZero q] {rho : ℂ} (hM : 2 ≤ M)
    (hnear : 1 - 1 / ((M : ℝ) ^ 2 *

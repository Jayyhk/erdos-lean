    dsimp [alpha]
    linarith
  have hbetaAlpha : rho.re ≤ alpha := by
    simpa only [alpha, L] using hfar.le
  have hpow : x ^ rho.re ≤ x ^ alpha :=
    Real.rpow_le_rpow_of_exponent_le hxone hbetaAlpha
  have hpowOne : (1 : ℝ) ≤ x ^ rho.re := by
    calc

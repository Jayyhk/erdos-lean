    sum_divisorsAntidiagonal (fun x y =>
      maynardS2ReciprocalGSquarefreeAF W x * coprimeMobiusInvAF W y),
    Nat.sum_divisors_prime_pow hp]
  apply Finset.sum_eq_zero
  intro j hj

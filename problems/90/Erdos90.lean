          v.Completion w.1.Completion).trans
        ((h2Stabilizer
            (K := K) (L := L) v w
            (fun x y => (FinitePlace.mk P).add_le x y)).trans
          (uliftHasseNorm
            (K := K) (L := L) v w).symm)

        rfl
      · conv_lhs => rw [Finset.sum_comm]
        rfl
    _ ≤ (∑ r ∈ Finset.range s, lowContribution D r) +
        ∑ k ∈ Finset.range (R - s), highContribution D s k := by
      apply add_le_add
      · gcongr with r hr
        exact low_reconstructedProfileMass_le hI D r
      · gcongr with k hk
        exact high_reconstructedProfileMass_le hI


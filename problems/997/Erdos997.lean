      MeromorphicOn.AnalyticOnNhd.divisor_apply hA hsU]
    lift analyticOrderAt f s to ℕ using htop with n hn
    simp only [ENat.map_coe, WithTop.untop₀_coe]
    exact_mod_cast horder

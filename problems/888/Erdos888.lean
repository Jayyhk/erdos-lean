private theorem invSqrtDyadicTail_bridge_le (k m : ℕ) :
    (∑ j ∈ Finset.range m,
      1 / Real.sqrt ((2 : ℝ) ^ (k + j))) ≤
      4 / Real.sqrt ((2 : ℝ) ^ k) := by

  dsimp [cyclicExtendJ] at ha
  refine
    Submodule.iSup_induction
      (fun e : Fin p =>
        (W.J (r - (e : ℕ) * w)).map
          (rightMulLinear (Y ^ (e : ℕ))))
      (motive := fun a =>
        a * b ∈ cyclicExtendJ W.J x w (r + s))

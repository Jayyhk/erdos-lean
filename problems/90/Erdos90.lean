    {H : ∀ s : ℕ, BCWta.{u} d s}
    (earlier : SSAtom H inputWeight)
    (later : List (SSAtom H inputWeight)) :
    List (SPFactora H inputWeight) :=
  later.reverse.map fun atom => atom.pairCorrection earlier


/-- A successor-precomposed polynomial family has witnesses vanishing at the
formal predecessor input `-1`. -/
def SuccessorVanishNeg
    (f : ℕ → ℤ) :
    Prop :=
  ∀ P : Polynomial ℚ,
    (∀ steps : ℕ, P.eval (steps : ℚ) = (f (steps + 1) : ℚ)) →
      P.eval (-1) = 0

/-- At an actual zero origin, matching that origin is the same as vanishing
at the formal predecessor input `-1`. -/
lemma successor_origin_vanish
    {f : ℕ → ℤ}
    (hzero : f 0 = 0) :
    SuccessorPolynomialsOrigin f ↔
      SuccessorVanishNeg f := by
  simp [SuccessorPolynomialsOrigin, SuccessorVanishNeg,
    hzero]

/-- The positive natural-power strict trace is empty at multiplicity zero. -/
@[simp]
lemma natural_strict_zero :
    NPTail.strictTrace 0 = [] := by
  rfl

/-- The negative natural-power strict trace is empty at multiplicity zero. -/
@[simp]
lemma negative_strict_zero :
    NNPower.strictTrace 0 = [] := by
  rfl

/-- The positive strict-tail cutoff profile is zero at multiplicity zero. -/
@[simp]
lemma profile_natural_strict
    (cutoff : ℕ) :
    cutoffProfile cutoff
      (NPTail.strictTrace 0) = 0 := by
  simp [cutoffProfile,
    RMRecb.unitBelowTrace]

/-- The negative strict-tail cutoff profile is zero at multiplicity zero. -/
@[simp]
lemma profile_negative_strict
    (cutoff : ℕ) :
    cutoffProfile cutoff
      (NNPower.strictTrace 0) = 0 := by
  simp [cutoffProfile,
    RMRecb.unitBelowTrace]

/-- Every slot polynomial for the successor-precomposed profile family
vanishes at `-1`. -/
def SuccessorPolynomialsVanish
    (family : ℕ → Multiset (CWord Atom)) :
    Prop :=
  ∀ slot,
    SuccessorVanishNeg
      (fun steps : ℕ => (Multiset.count slot (family steps) : ℤ))

/-- For the positive Hall-Witt profile, origin matching is exactly
vanishing-at-`-1`. -/
lemma successor_match_origin
    (cutoff : ℕ) :
    StrictMatchOrigin cutoff ↔
      SuccessorPolynomialsVanish
        (fun multiplicity =>
          cutoffProfile cutoff
            (NPTail.strictTrace
              multiplicity)) := by
  apply forall_congr'
  intro slot
  apply successor_origin_vanish
  simp

/-- For the negative Hall-Witt profile, origin matching is exactly
vanishing-at-`-1`. -/
lemma match_origin_vanish
    (cutoff : ℕ) :
    NegativeMatchOrigin cutoff ↔
      SuccessorPolynomialsVanish
        (fun multiplicity =>
          cutoffProfile cutoff
            (NNPower.strictTrace
              multiplicity)) := by
  apply forall_congr'
  intro slot
  apply successor_origin_vanish
  simp


    apply LinearMap.ext
    intro x
    change Additive.ofMul (e sigma •
        (show Additive w.1.Completionˣ from x).toMul) =
      Additive.ofMul (sigma •
        (show Additive w.1.Completionˣ from x).toMul)
    exact congrArg Additive.ofMul
      (hsmul sigma (show Additive w.1.Completionˣ from x).toMul)

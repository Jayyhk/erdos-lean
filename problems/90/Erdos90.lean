theorem regular_int_action (g : G) (x : IntegralGroupRing G) :
    (Rep.leftRegular ℤ G).ρ g x = MonoidAlgebra.single g 1 * x := by
  induction x using MonoidAlgebra.induction_linear with
  | zero =>

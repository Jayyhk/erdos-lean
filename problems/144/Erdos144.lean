noncomputable def dirichletNontrivialLFunctionZeroWindowFinset
    {q : ℕ} [NeZero q] (chi : DirichletCharacter ℂ q)
    (t : ℝ) : Finset ℂ :=
  (dirichletNontrivialLFunctionZerosFinset chi (|t| + 1)).filter

    have hmul : a * (t + E) ≤ c * (t + E) :=
      mul_le_mul_of_nonneg_right hac (by linarith)
    have hstep : c * (t + E) ≤ 2 * c * (t + E + c) := by
      nlinarith [mul_nonneg hc (by linarith : 0 ≤ t + E)]
    linarith

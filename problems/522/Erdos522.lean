  let τ := ρ.map Z
  let γ := stdGaussian E
  let ν := μ.map (fun ω ↦ e (U ω))
  let θ := (Real.sqrt 2)⁻¹
  let p := Real.cos α
  let s := Real.sin α
  let q := θ * s
  let T := ((γ.map (fun y ↦ q • y)).prod ν).map
    (fun z : E × E ↦ p • z.2 + z.1)

theorem subsingleton_matrix_classification
    (h : ∀ A : CSA.{u, u} k, ∃ (n : ℕ), n ≠ 0 ∧
      Nonempty (A ≃ₐ[k] Matrix (Fin n) (Fin n) k)) :

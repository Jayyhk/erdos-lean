  let lifted : F ⊗[k] CProduc c →ₐ[F] B :=
    Algebra.TensorProduct.lift baseF transportK
      (fun a x => Algebra.commutes a (transportK x))
  exact lifted.comp
    (Algebra.TensorProduct.commRight k F (CProduc c)).symm.toAlgHom


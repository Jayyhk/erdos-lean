      Units.map (Algebra.norm A) z := by
  apply Units.ext
  change e (Algebra.norm A₀ (z : B)) = Algebra.norm A (z : B)
  rw [Algebra.norm_eq_of_equiv_equiv e (RingEquiv.refl B) he,
    RingEquiv.apply_symm_apply]
  rfl


  obtain ⟨n, hn⟩ :=
    exists_pow_lt_of_lt_one (div_pos hε hC1) hx1
  let N := max FP.maxRelatorDepth n
  refine ⟨{
    cutoff := N
    depth_le := ?_
    tail_abs_lt := ?_
  }⟩
  · dsimp [N]
    omega
  · have htail_le :
        |FP.gsRatBoundary b x N| ≤ C * x ^ (N + 1) := by
      rw [FP.rat_boundary_tail]

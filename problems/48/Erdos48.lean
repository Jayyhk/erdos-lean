/-- Away from the zeta pole, the modulus-one L-function and the entire
regularization `riemannZeta₁` have the same natural analytic order. -/
theorem analyticOrderNatAt_LFunction_modOne_eq_riemannZeta₁_of_ne_one
    {rho : ℂ} (hrho : rho ≠ 1) :

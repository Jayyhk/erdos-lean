    MHTwo Gal(E/K) Eˣ →* MHTwo Gal(E/L) Eˣ :=
  (CProduc.hRelativeBrauer L E).symm.toMonoidHom.comp
    ((relativeBrauerChange K L E).comp
      (CProduc.hRelativeBrauer K E).toMonoidHom)


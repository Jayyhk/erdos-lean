    { toFun := fun s => ⟨s.1, clockwiseNext s.1 s.2⟩
      invFun := fun s => ⟨s.1, (clockwiseNext s.1).symm s.2⟩
      left_inv := by
        intro s
        cases s with
        | mk v d =>
          dsimp
          rw [Equiv.symm_apply_apply]
      right_inv := by
        intro s
        cases s with
        | mk v d =>
          dsimp
          rw [Equiv.apply_symm_apply] }

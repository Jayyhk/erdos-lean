    (S : Finset (NumberFieldPlace K))
    (Q : primesAbovePlaces (K := K) (L := L) S) : ℝ :=
  Classical.choose (AbsoluteValue.isEquiv_iff_exists_rpow_eq.mp
    (upper_place_equiv (K := K) (L := L) S Q))


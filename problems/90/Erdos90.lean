  change ((y : dSubgro R G m) : G) * ((x : dSubgro R G m) : G) *
      ((y : dSubgro R G m) : G)⁻¹ ∈ dSubgro R G k
  exact (dimensionSubgroup_normal (R := R) (G := G) k).conj_mem
    ((x : dSubgro R G m) : G) hx ((y : dSubgro R G m) : G)


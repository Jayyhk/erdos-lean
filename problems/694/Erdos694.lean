    rw [Complex.normSq_mul, Complex.normSq_mul, Complex.normSq_I,
      Complex.normSq_ofReal]
    change 1 * (μ * μ) * Complex.normSq ((starRingEnd ℂ) (u r)) =
      μ ^ 2 * ‖u r‖ ^ 2

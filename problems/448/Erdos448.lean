theorem park_pham_threshold_not_small_lt_exists_of_antichain_multi_hard_core
    {CKK : ℝ} (hCKK_pos : 0 < CKK)
    (hCKK_large : (2 / Real.log 2 : ℝ) ≤ CKK)
    (hCore : ∀ {α : Type u} [DecidableEq α], StrictAntichainMultiHardCoreOn CKK α) :

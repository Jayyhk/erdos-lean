    ∀ e n (hn : n + 1 < (edgePieceOrder e).length),
      ∃ x : {p // p ∈ D.intersectionPoints},
        x.1 ∈ D.edgeRelativeInterior e ∧
          target ((edgePieceOrder e)[n]) ∈

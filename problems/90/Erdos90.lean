      nSKernel (Fintype.card G) A where
  toFun x := ⟨trivialCoinvariantsEquiv G A x.1, by
    change Fintype.card G • trivialCoinvariantsEquiv G A x.1 = 0
    rw [← trivialNorm_apply G A x.1]

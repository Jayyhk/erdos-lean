                ‖logDeriv (DirichletCharacter.LFunction
                    (1 : DirichletCharacter ℂ 1))
                    ((sigma : ℂ) - U * I)‖ ≤
                  10 * (A : ℝ) * C * Real.log (T + 2) ^ 2 := by
  obtain ⟨Af, hAf, hfixed⟩ :=
    exists_nat_norm_logDeriv_riemannZeta₁_sub_radiusSix_divisor_finsum_le

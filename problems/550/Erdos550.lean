  classical
  convert! Set.ext _;
  obtain ⟨ v, hv, hv' ⟩ := Finset.mem_image.mp c.2;
  intro x; specialize hv; simp_all +decide [ componentNonseedVertices, seedComponent ] ;
  intro hxc hxS
  have hx : x ∈ (seedComponent T S v).supp := by
    have hxv : (seedDeleted T S).connectedComponentMk x
        = (seedDeleted T S).connectedComponentMk v := by rw [hxc, hv']
    simpa [seedComponent, SimpleGraph.ConnectedComponent.mem_supp_iff] using hxv
  exact (Set.disjoint_left.mp (seedComponent_supp_avoids_seeds T S hv) hx) (by simpa using hxS)


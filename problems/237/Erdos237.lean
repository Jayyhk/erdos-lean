        intro h hh
        have hne := (Finset.mem_erase.mp hh).1
        simp [hne]
    _ = T * C ^ (s.erase j).card := by rw [Finset.prod_const]
    _ = T * C ^ (s.card - 1) := by rw [Finset.card_erase_of_mem hj]


  have hfirst : a * x ^ 2 ≤ 4 * x * a ^ 2 := by
    nlinarith [mul_nonneg (mul_nonneg ha.le hx.le) (sub_nonneg.mpr hxaFour)]
  have hsecond : 4 * a * t ^ 2 ≤ 16 * x * t ^ 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hax) (sq_nonneg t)]

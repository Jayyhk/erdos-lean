        ∑ d ∈ (primorial D).divisors,
          |(ArithmeticFunction.moebius d : ℝ) / d *
            (realHarmonic (Q / d) - Real.log ((Q : ℝ) / d))| :=
      Finset.abs_sum_le_sum_abs _ _

  filter_upwards
      [eventually_log_smallPowerBlockCutoff_div_log_le,
       eventually_inv_log_smallPowerBlockCutoff_le_realLog_one_thousandth,
       Erdos67.EulerSubpower.tendsto_log_nat_atTop.eventually
        (eventually_ge_atTop 1),

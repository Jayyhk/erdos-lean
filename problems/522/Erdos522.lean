noncomputable section
/-- The complex linear span of characters with frequencies in a prescribed set. -/
def exponentialSpan (S : Set ℝ) : Submodule ℂ (ℝ → ℂ) :=
  Submodule.span ℂ ((fun ξ x => angularCharacter (ξ * x)) '' S)


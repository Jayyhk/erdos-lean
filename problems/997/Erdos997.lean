  rw [BoundedGaps.isAdmissible_iff_avoids_residue]
  intro p hp
  by_cases hpq : p ∣ q
  · refine ⟨1, hp.one_lt, ?_⟩
    intro h hh
    have hph := hpq.trans (powerTuple_divisible hh)
    simp only [Nat.mod_eq_zero_of_dvd hph]

    {A₀ A B C : Type*} [CommRing A₀] [CommRing A] [CommRing B] [Ring C]
    [Algebra A₀ B] [Algebra A B] [Algebra B C] [Algebra A C]
    [IsScalarTower A B C]
    [Module.Free A₀ B] [Module.Free A B] [Module.Free B C] [Module.Free A C]
    (e : A₀ ≃+* A)

        else 0 := by
    calc
      (∑ d ∈ maynardDivisorTupleSupport H R W,
          if (∀ h : H, r h ∣ d h) ∧ d m = 1 then
            maynardCoefficientFromY H R W y d /
              divisorTupleTotientProduct H d
          else 0) =
          ∑ d ∈ maynardDivisorTupleSupport H R W,
            ∑ a ∈ maynardDivisorTupleSupport H R W,

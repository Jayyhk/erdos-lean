    (∫ t in (j.val : ℝ) / q..((j.val : ℝ) + 1) / q, ‖f t‖) =
      (1 / (q : ℝ)) * normCellAverage unitIntervalMeasure (unitIntervalCell j) f := by
  rw [normCellAverage_unitIntervalCell hq j]
  have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast hq.ne'

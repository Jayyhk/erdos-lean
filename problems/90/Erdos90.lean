    {α β : Type*}
    (packet : α → List β) :
    ∀ source : List α,
      packetSubsequenceExpansions packet source =
        (source.flatMap packet).sublists
  | [] => by
      rfl
  | item :: items => by
      rw [packetSubsequenceExpansions, List.flatMap_cons,
        List.sublists_append,
        ← expansions_sublists_flat packet items]
      rfl

/-- Number of ordered subsequence embeddings of `target` in `source`. -/
def orderedSubsequenceMultiplicity
    {α : Type*} [BEq α]
    (target source : List α) :
    ℕ :=
  source.sublists.count target

/-- Ordered subsequence multiplicities after a packet substitution are
counted by the exact packetwise expansion. -/
lemma subsequence_multiplicity_flat
    {α β : Type*} [BEq β]
    (packet : α → List β)
    (target : List β)
    (source : List α) :
    orderedSubsequenceMultiplicity target (source.flatMap packet) =
      (packetSubsequenceExpansions packet source).count target := by
  rw [orderedSubsequenceMultiplicity,
    expansions_sublists_flat]


  -bilinearProductCutoffSum y q chi
    (vaughanFourthDyadicMIndices U V x alpha)
    (vaughanFourthDyadicKIndices V x alpha)
    (fun m ↦ ((ArithmeticFunction.vonMangoldt m : ℝ) : ℂ))

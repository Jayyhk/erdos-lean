  factors := [B.bracket A]
  listEval_eq q := by
    simpa using heval q
  word_weight_left x hx := by
    rcases List.mem_singleton.mp hx with rfl
    exact B.word_bracket_left A
  word_weight_right x hx := by
    rcases List.mem_singleton.mp hx with rfl
    exact B.word_bracket_right A


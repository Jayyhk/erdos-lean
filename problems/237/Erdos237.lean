theorem norm_logDeriv_sub_divisor_finsum_le
    {f : ℂ → ℂ} {c s : ℂ} {R M : ℝ}
    (hR : 0 < R) (hM : 0 ≤ M)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R)))
    (hc : f c ≠ 0)
    (hbound : ∀ z ∈ sphere c (4 * R),
      ‖f z‖ ≤ Real.exp M * ‖f c‖)
    (hs : s ∈ closedBall c R) (hfs : f s ≠ 0) :
    ‖logDeriv f s - ∑ᶠ rho : ℂ,
      ((MeromorphicOn.divisor f (closedBall c (2 * R))) rho : ℂ) /

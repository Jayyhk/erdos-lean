private theorem infinite_place_embedding
    {q q' : InfinitePlace L} (h : q = q') (x : L) :
    RingEquiv.cast (R := fun z : InfinitePlace L => z.1.Completion) h
        (completionEmbedding q.1 x) = completionEmbedding q'.1 x := by
  subst q'
  rfl


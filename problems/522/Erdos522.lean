def unitCirclePoint (θ : ℝ) : ℂ := Complex.exp (Complex.I * θ)

@[simp] theorem norm_unitCirclePoint (θ : ℝ) : ‖unitCirclePoint θ‖ = 1 :=
  Complex.norm_exp_I_mul_ofReal θ


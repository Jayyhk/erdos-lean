              ⟨hleft.1.tail, hleft.2.tail⟩
              ⟨hright.1.tail, hright.2.tail⟩
              htailCode
          exact congrArg (List.cons leftHead) htail

/-- Head recovery makes the subtype foliage-code function injective. -/

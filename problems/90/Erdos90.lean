/-- The quotient equivalence induced by associating three product factors. -/
noncomputable def mFQuot.prodAssocEquiv
    (G H K : Type*) [Group G] [Group H] [Group K] :
    mFQuot p ((G × H) × K) ≃*
      mFQuot p (G × H × K) :=
{ toFun := mFQuot.map (p := p)
    (MulEquiv.prodAssoc (M := G) (N := H) (P := K)).toMonoidHom
  invFun := mFQuot.map (p := p)
    (MulEquiv.prodAssoc (M := G) (N := H) (P := K)).symm.toMonoidHom
  left_inv := by
    intro x
    exact mFQuot.mapprod_assocsymm_mapprodassoc (p := p) G H K x
  right_inv := by
    intro x
    exact mFQuot.mapprod_assocmap_prodassocsymm (p := p) G H K x
  map_mul' := by
    intro x y
    exact map_mul _ x y }

@[simp] theorem mFQuot.prod_assoc_equivapply
    (G H K : Type*) [Group G] [Group H] [Group K]
    (x : mFQuot p ((G × H) × K)) :
    mFQuot.prodAssocEquiv (p := p) G H K x =
      mFQuot.map (p := p)
        (MulEquiv.prodAssoc (M := G) (N := H) (P := K)).toMonoidHom x := rfl

@[simp] theorem mFQuot.prod_assocequiv_symmapply
    (G H K : Type*) [Group G] [Group H] [Group K]
    (x : mFQuot p (G × H × K)) :
    (mFQuot.prodAssocEquiv (p := p) G H K).symm x =
      mFQuot.map (p := p)
        (MulEquiv.prodAssoc (M := G) (N := H) (P := K)).symm.toMonoidHom x := rfl

@[simp] theorem mFQuot.prod_assoc_equivmk
    (G H K : Type*) [Group G] [Group H] [Group K]
    (a : G) (b : H) (c : K) :
    mFQuot.prodAssocEquiv (p := p) G H K
        (QuotientGroup.mk' (modPFrattini p ((G × H) × K)) ((a, b), c)) =
      QuotientGroup.mk' (modPFrattini p (G × H × K)) (a, (b, c)) := rfl

@[simp] theorem mFQuot.prod_assocequiv_symmmk
    (G H K : Type*) [Group G] [Group H] [Group K]
    (a : G) (b : H) (c : K) :
    (mFQuot.prodAssocEquiv (p := p) G H K).symm
        (QuotientGroup.mk' (modPFrattini p (G × H × K)) (a, (b, c))) =
      QuotientGroup.mk' (modPFrattini p ((G × H) × K)) ((a, b), c) := rfl

/-- Deleting a trivial middle factor gives a multiplicative equivalence on
Frattini quotients.  The inverse inserts the unique element of the middle factor. -/
noncomputable def mFQuot.prod_middle_trivialequiv
    (G E H : Type*) [Group G] [Group E] [Group H] [Subsingleton E] :
    mFQuot p ((G × E) × H) ≃*
      mFQuot p (G × H) :=
{ toFun := mFQuot.map (p := p)
    (MonoidHom.prodMap (MonoidHom.fst G E) (MonoidHom.id H))
  invFun := mFQuot.map (p := p)
    (MonoidHom.prodMap (MonoidHom.inl G E) (MonoidHom.id H))
  left_inv := by
    intro x
    refine QuotientGroup.induction_on x ?_
    intro a
    rcases a with ⟨ge, h⟩
    rcases ge with ⟨g, e⟩
    have he : e = 1 := Subsingleton.elim e 1
    subst e
    rfl
  right_inv := by
    intro x
    refine QuotientGroup.induction_on x ?_
    intro a
    rcases a with ⟨g, h⟩
    rfl
  map_mul' := by
    intro x y
    exact map_mul _ x y }

@[simp] theorem mFQuot.prod_middletrivial_equivapply
    (G E H : Type*) [Group G] [Group E] [Group H] [Subsingleton E]
    (x : mFQuot p ((G × E) × H)) :
    mFQuot.prod_middle_trivialequiv (p := p) G E H x =
      mFQuot.map (p := p)

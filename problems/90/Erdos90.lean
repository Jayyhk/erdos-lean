  apply Subtype.ext
  apply eM.injective
  change eM ((∏ g : G, g • eM.symm z)) = eM y.1
  rw [map_prod]
  simp_rw [heq, eM.apply_symm_apply]
  have hz' := congrArg Subtype.val hz

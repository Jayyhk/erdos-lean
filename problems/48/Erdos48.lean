theorem norm_variable_detector_prefix_le_majorant
    {q : ℕ} (chi : DirichletCharacter ℂ q)
    (eta : ℝ) (k M : ℕ) (t : ℝ) :
    ‖∑ n ∈ Finset.Icc 1 (2 ^ M),
        (weightedVonMangoldtMajorant eta k n : ℂ) * chi n *
          Complex.exp (I * (((-t * Real.log n) : ℝ) : ℂ))‖ ≤
      ∑ n ∈ Finset.Icc 1 (2 ^ M),

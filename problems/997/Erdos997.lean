    Set.indicator {n : ℕ | n.Prime ∧ n % q = a % q}
        (fun n ↦ Real.log (n : ℝ)) n
  let globalCoefficient : ℕ → ℝ := fun n ↦
    Set.indicator {n : ℕ | n.Prime} (fun n ↦ Real.log (n : ℝ)) n
  let c : ℕ → ℝ := fun n ↦
    progressionCoefficient n - (q.totient : ℝ)⁻¹ * globalCoefficient n

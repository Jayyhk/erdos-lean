    {H : Finset ℕ} {R W : ℕ} (m : H) {r : H → ℕ}
    (hr : BoundedGaps.Maynard.IsMaynardDivisorTuple H R W r)
    (hrm : r m = 1) (hR : 1 < R) {u : ℕ}
    (hu : u ∈ BoundedGaps.Maynard.maynardS2CoordinateFiberSupport
      H R W m r) :
    tupleLargeCandidate H

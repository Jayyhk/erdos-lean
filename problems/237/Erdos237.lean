    (one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hpow)

private lemma principalEulerFactor_ne_zero
    (p : ℕ) (hp : p.Prime) (s : ℂ) (hs : 1 ≤ s.re) :
    (1 : ℂ) - (p : ℂ) ^ (-s) ≠ 0 := by

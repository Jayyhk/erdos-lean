    {R S T : IRecipe}
    (hRS : PolynomialEquivalent R S)
    (hST : PolynomialEquivalent S T) :
    PolynomialEquivalent R T :=
  ⟨hRS.1.trans hST.1, hRS.2.1.trans hST.2.1,

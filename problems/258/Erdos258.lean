    have hphi : (Nat.totient (r h) : ℝ) ≠ 0 := by
      exact_mod_cast (Nat.ne_of_gt (Nat.totient_pos.mpr
        (Nat.pos_of_ne_zero (hr.coordinate_squarefree h).ne_zero)))

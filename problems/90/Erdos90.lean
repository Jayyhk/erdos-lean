    {A₀ A₁ A₂ B₀ B₁ B₂ : Type*}
    [AddGroup A₀] [AddGroup A₁] [AddGroup A₂]
    [AddGroup B₀] [AddGroup B₁] [AddGroup B₂]
    [Finite A₀] [Finite A₁] [Finite A₂]
    [Finite B₀] [Finite B₁] [Finite B₂]
    (f₀ : A₀ →+ A₁) (f₁ : A₁ →+ A₂) (f₂ : A₂ →+ B₀)
    (g₀ : B₀ →+ B₁) (g₁ : B₁ →+ B₂) (g₂ : B₂ →+ A₀)

    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (x : ι → ℝ) {δ : ℝ} (hδ : 0 < δ)
    (hsep : ∀ r s, r ≠ s →
      δ ≤ dist (x r : UnitAddCircle) (x s : UnitAddCircle))
    (u : ι → ℂ) :
    ‖cosecantBilinearForm x u‖ ≤ δ⁻¹ * ∑ r, ‖u r‖ ^ 2 :=
  CosecantHilbert.norm_cosecantBilinearForm_le_of_separated x hδ hsep u


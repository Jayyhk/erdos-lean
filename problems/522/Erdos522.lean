    nlinarith [mul_nonneg (sq_nonneg (N : ℝ)) (sub_nonneg.mpr hp)]
  have hexp : Real.exp (K + 1) ≤ Real.exp (K + 4) := Real.exp_le_exp.mpr (by linarith)
  have herror : (2 * Real.exp (K + 1) * (N : ℝ) ^ 4) *

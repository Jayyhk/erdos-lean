  rcases hpair with hpair | hpair | hpair
  · have hac : a = c := by
      apply le_antisymm (hab.trans hbc)
      by_contra hnot
      have haclt : a < c := Nat.lt_of_not_ge hnot
      have hlt : a * b < c * d :=

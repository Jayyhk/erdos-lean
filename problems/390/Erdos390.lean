theorem fourFivePhysicalProductReplacementError_le_movingFaceBudget
    {m y A B : Nat} {M : Real} (hm : m <= 3)
    (hy : 2 <= y) (hyA : y <= A) (hAB : A <= B)
    (hcut : fourFiveReciprocalBVSafeCutoff <= y)
    (hactualMass :

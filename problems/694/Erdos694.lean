        Real.rpow_nonneg (Nat.cast_nonneg psi.modulus) _
      have hscaled :=
        mul_le_mul_of_nonneg_right hcLe hweightNonneg
      linarith
  | some exception =>
      let gap : ℝ :=
        1 / ((2 ^ 22 : ℝ) * Real.sqrt (exception.modulus : ℝ) *
          (Real.log (exception.modulus : ℝ)) ^ 4)

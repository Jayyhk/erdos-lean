  ⟨x.1 * y.1, by
    change augmentation G (x.1 * y.1) = 0
    rw [augmentation_mul]
    rw [LinearMap.mem_ker.mp x.2, LinearMap.mem_ker.mp y.2, zero_mul]⟩

@[simp]
lemma augmentationProduct_coe (x y : augmentationIdeal G) :

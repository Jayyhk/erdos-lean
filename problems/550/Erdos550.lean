lemma card_biUnion_clusters
    {V ι : Type*} [DecidableEq V]
    (C : ι → Finset V)
    (hdisj : ∀ i j, i ≠ j → Disjoint (C i) (C j))
    (S : Finset ι) :
    (S.biUnion C).card = ∑ i ∈ S, (C i).card := by
  exact Finset.card_biUnion fun i hi j hj hij => hdisj i j hij

end


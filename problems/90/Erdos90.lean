theorem cast_embedding_tower
    {K : Type u} [Field K] [NumberField K]
    {P P' : HeightOneSpectrum (OK_v55 K)} (h : P = P') (x : K) :
    RingEquiv.cast
        (R := fun V : HeightOneSpectrum (OK_v55 K) ↦ V.adicCompletion K) h
        (FinitePlace.embedding P x) =

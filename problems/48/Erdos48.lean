                (96 * (A : ℝ) *
                  x ^ (1 - (((J + 1 : ℕ) : ℝ) * eta)) *
                    Real.log ((Q : ℝ) * (T + 2)) ^ 2) := by
  obtain ⟨A, hA, hreciprocal⟩ :=
    exists_nat_dirichletNontrivialZeroReciprocalMultiplicitySum_le

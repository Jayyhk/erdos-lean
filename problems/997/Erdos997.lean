  intro q1 q _ _ hq1 hq1q chi1 chi hchi1 hchi hcross
    beta x t hbeta0 hbeta1 hx
  have hxpos : 0 < x := zero_lt_one.trans_le hx
  have hq0 : (0 : ℝ) ≤ q := by positivity

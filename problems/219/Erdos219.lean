theorem summable_norm_error
    {C : ℝ} {localFactor : Nat.Primes → ℂ}
    (h : HasComplexPrimeSquareError C localFactor) :
    Summable
      (fun p : Nat.Primes =>
        ‖localFactor p - 1‖) := by
  exact Summable.of_nonneg_of_le
    (fun _ => norm_nonneg _)
    h.error_le
    h.summable_majorant


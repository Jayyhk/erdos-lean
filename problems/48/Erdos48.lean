      (a := (0 : ℝ)) (b := T)
    simp only [mul_zero, mul_comm] at hchange
    exact hchange
  rw [← hsub] at h
  simpa [hsign, abs_mul, abs_of_pos hT, mul_assoc,
    mul_comm, mul_left_comm] using h

end

end BoundedGaps.Maynard


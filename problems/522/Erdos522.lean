  have hsqrtpos : 0 < Real.sqrt C := Real.sqrt_pos.2 (lt_of_lt_of_le (by norm_num) hC)
  have hdq : 1 ≤ d ^ (1 / 4 : ℝ) := Real.one_le_rpow hd (by norm_num)

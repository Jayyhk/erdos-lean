    have HroughDepth :=
      eventually_mul_upperTailLength_le_self (K0 + 1) hcPos
    have Hpost :
        ∀ᶠ n : Nat in atTop,
          ∃ Bpost : BridgeData (PaperHeadSimplex.Tag P)

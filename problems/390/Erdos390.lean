/-- The literal two-prime-power modulus used in the four-mark chamber. -/
def pairPower (p q a b : ℕ) : ℕ := p ^ a * q ^ b

theorem pairPower_pos {p q a b : ℕ} (hp : p.Prime) (hq : q.Prime) :
    0 < pairPower p q a b := by

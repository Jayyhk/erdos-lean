    unfold vaughanPrimitiveMeanAlgebraicScale
    rw [hUqSq, hqSqSqrtU, hmixed, hsqrtTwoDiv, hplainDiv]
    ring
  have hc_le_sqrt :
      vaughanCubeRoot x ≤ Real.sqrt (x : ℝ) :=
    hq.trans hqsqrt

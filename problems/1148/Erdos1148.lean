  rw [heq]
  have ht : (1 / 2 : ℝ) * (k : ℝ) = (k : ℝ) / 2 := by ring
  have hc : μ.real Kᶜ / (1 / 2 : ℝ) = 2 * μ.real Kᶜ := by ring

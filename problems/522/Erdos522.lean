  rw [abs_of_nonneg hnonneg]
  calc
    ψ x ≤ ∫ _u, (1 : ℝ) ∂ν := by
      exact integral_mono hint (integrable_const 1) fun u ↦
        convexSetCutoff_le_one s ε _
    _ = 1 := by rw [integral_const, probReal_univ, one_smul]


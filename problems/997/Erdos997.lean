    simpa [M] using
      (squarefreeCoprimeInvTotientMean_mono_cutoff (W := W))
  have hMzero : M 0 = 0 := by
    simp [M, squarefreeCoprimeInvTotientMean]
  have hMnonneg : ∀ n, 0 ≤ M n := by
    intro n
    rw [← hMzero]
    exact hMmono (Nat.zero_le n)

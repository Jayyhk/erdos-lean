          have h_dist : ∃ p : SimpleGraph.Walk T a r, p.length ≤ q.length - 1 := by
            obtain ⟨ p, hp ⟩ := SimpleGraph.Walk.mem_support_iff_exists_append.mp hq_support;
            obtain ⟨ r, hr ⟩ := hp; use r; simp +decide only [hr, Walk.length_append] ;

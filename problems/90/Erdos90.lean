theorem natural_matrix_simple : IsSimpleModule (Matrix ι ι D) (ι -> D) := by
  rw [isSimpleModule_iff_toSpanSingleton_surjective]
  refine ⟨inferInstance, ?_⟩
  intro v hv w
  obtain ⟨A, hA⟩ := matrix_smul v hv w
  exact ⟨A, hA⟩

end Submission.CField.SAlgebr


    {A : Type u} [AddCommGroup A]
    (ord : A →+ ℤ) (hord : Function.Surjective ord)
    (I : AddSubgroup A) [I.FiniteIndex] (hker : ord.ker ≤ I) :
    ∃ n : ℕ, n ≠ 0 ∧ I = (AddSubgroup.zmultiples (n : ℤ)).comap ord := by

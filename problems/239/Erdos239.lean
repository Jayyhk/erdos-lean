    (∑ k ∈ Finset.range n, (((k + 1 : ℕ) : ℝ) / (2 : ℝ) ^ k)) ≤ 4 := by
  rw [dyadic_weight_sum_eq]
  exact sub_le_self _ (div_nonneg (by positivity) (by positivity))


          (powerSieveCofactorBound n L)).card : ℝ) ≤
          ∑ b ∈ Finset.Icc 1 (powerSieveCofactorBound n L),
            ((Cπ * ((((powerSieveX n L + 1) / (q * r * b) : ℕ) : ℝ)) /
                Real.log ((((powerSieveX n L + 1) / (q * r * b) : ℕ) : ℝ)) *
              ((1 + eta) *
                (CV * ((q * r * b : ℕ) : ℝ) /
                    (Nat.totient (q * r * b) : ℝ) /
                  Real.log (powerSieveSmallPrimeBound n L S : ℝ)))) +

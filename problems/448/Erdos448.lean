    CKK * Real.log ((max 2 (A.sup Finset.card) : ℕ) : ℝ) < (A.card : ℝ) →
    CKK * q * Real.log ((max 2 (A.sup Finset.card) : ℕ) : ℝ) < 1 →
    (∀ S ∈ A,

    calc
      ‖z‖ = ‖x + (z - x)‖ := by congr 1; abel
      _ ≤ ‖x‖ + ‖z - x‖ := norm_add_le _ _
      _ = ‖x‖ + dist z x := by rw [dist_eq_norm]
      _ ≤ ‖x‖ + R := by gcongr

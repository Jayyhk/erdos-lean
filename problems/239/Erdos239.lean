    (t : ℝ) {M : ℕ} (hM : 0 < M) (ht : t ≠ 0) (ht_small : |t| ≤ 1) :
    ‖(∑ m ∈ Finset.Ioc 0 M, LogPhaseSum.natLogTwist m t) -

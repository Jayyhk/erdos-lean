        ∑ d ∈ vaughanSecondTermIndices V y, ((d : ℝ))⁻¹ := by
      rw [← Finset.mul_sum]
      ring
    _ ≤ (y : ℝ) * Real.log (y : ℝ) * (1 + Real.log V) := by
      gcongr
      exact sum_inv_vaughanSecondTermIndices_le_one_add_log hV y


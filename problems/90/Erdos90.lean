theorem mem_boundarySubmodule
    {a : R} {m : ℕ} {f : NSeries R X} :
    f ∈ boundarySubmodule (R := R) (X := X) a m ↔
      (∀ w, w.length < m → f w = 0) ∧
        ∀ w, w.length = m → a ∣ f w :=
  Iff.rfl


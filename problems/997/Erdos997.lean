    intro a ha
    apply Fintype.mem_piFinset.mpr
    exact (mem_positiveProductTuples_iff.mp ha).1
  calc
    (∑ a ∈ positiveProductTuples ι Q, (∏ i, (a i : ℝ))⁻¹) ≤
        ∑ a ∈ box, (∏ i, (a i : ℝ))⁻¹ := by
      apply Finset.sum_le_sum_of_subset_of_nonneg hsubset
      intro a ha _
      positivity

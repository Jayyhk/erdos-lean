          0 < rho.re ∧ rho.re < 1 := by
  constructor
  · intro hrho
    exact ⟨hrho.1, hrho.2.1, hrho.LFunction_eq_zero,
      hrho.re_pos, hrho.re_lt_one⟩
  · rintro ⟨hq, hchi, hL, hre0, hre1⟩
    refine ⟨hq, hchi, ?_⟩

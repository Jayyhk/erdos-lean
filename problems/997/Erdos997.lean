    (chi : DirichletCharacter ℂ q) (rho : ℂ) : Prop :=
  DirichletCharacter.LFunction chi rho = 0 ∧
    0 < rho.re ∧ rho.re < 1

/-- An arbitrary character and its primitive inducer have exactly the same

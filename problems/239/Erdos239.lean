          (Nat.ne_zero_of_mem_divisorsAntidiagonal haq).2
        have hqlog : 0 < Real.log (aq.2 : ℝ) :=
          Real.log_pos (by exact_mod_cast (show 1 < aq.2 by omega))
        rw [Nat.sum_divisorsAntidiagonal
          (fun b _ ↦ ArithmeticFunction.vonMangoldt b *
            (2 * Real.log (aq.2 : ℝ))⁻¹)]

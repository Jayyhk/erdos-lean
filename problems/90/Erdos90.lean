  leftFamily := B
  rightFamily := A
  leftWords := decoratedFamilyList left
  rightWords := decoratedFamilyList right
  leftPacket := hleft.toCollapsedFor
  rightPacket := hright.toCollapsedFor
  ledger := ledger.toWordLedger


@[simp]
lemma list_raw_factors
    {M N : ℕ}
    {G : Type*} [Group G]
    (x y : G) :
    ∀ L : List (Factor M N),
      PPColl.listEval x y (rawFactors L) =
        listEval x y L
  | [] => by simp [rawFactors]
  | F :: L => by

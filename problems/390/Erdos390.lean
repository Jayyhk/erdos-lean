    yNat n *
        (bankPaperAnchorMarkerBudget n * Nat.log 2 (3 * n) +
          Nat.log2 (upperTailLength c n) + 1) =
        bankPaperPrechargeSmallPrimeCostMajorant n +
          yNat n * (Nat.log2 (upperTailLength c n) + 1) := by

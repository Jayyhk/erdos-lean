  letI : MulSemiringAction Gal(Efield/K) BE :=
    IsIntegralClosure.MulSemiringAction AK K Efield BE
  have htauE : tauE ∈ (IsLocalRing.maximalIdeal BE).inertia Gal(Efield/K) := by
    intro x

  change y.1 * x.1 = x.1 * y.1
  have hxq : x.1 ∈ q.ker := by
    change q x.1 = 1
    exact congrArg Subtype.val hx
  exact Subgroup.mem_center_iff.mp (hcentral hxq) y.1


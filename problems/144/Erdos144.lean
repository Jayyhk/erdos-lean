        lowReconstructionIndicator (Finset.Ioc (D / 8 ^ R) D) D r Q) +
      ∑ k ∈ Finset.range (R - s),
        highReconstructionIndicator (Finset.Ioc (D / 8 ^ R) D) D s k Q := by

    have hlogt0 : 0 ≤ Real.log (|t| + 2) :=
      Real.log_nonneg (by linarith [abs_nonneg t])
    have hsDisk : s ∈ closedBall ((2 : ℂ) + t * I) 3 := by
      rw [mem_closedBall, Complex.dist_eq]
      have hsSub : s - ((2 : ℂ) + t * I) = ((r - 2 : ℝ) : ℂ) := by

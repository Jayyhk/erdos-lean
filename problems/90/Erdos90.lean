          exact norm_le_pi_norm _ i
        _ ≤ ‖e‖ * ‖(x : D)‖ := e.le_opNorm _
        _ ≤ ‖e‖ := by
          exact mul_le_of_le_one_right (norm_nonneg e) x.property
        _ ≤ ‖c‖ := hc.le
    rw [inv_mul_eq_div]
    exact (div_le_one hcpos).mpr hcoord

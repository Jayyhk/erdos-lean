      rcases sq_eq_one_iff.mp hsq2 with h2 | h2 <;>
      rw [MulChar.one_apply hunit, MulChar.mul_apply, h1, h2] <;>
      norm_num
  · simp [MulChar.map_nonunit, hunit]


  rcases bc with ⟨b, c⟩
  rfl

/-- Associating product factors and then unassociating is identity on Frattini quotients. -/
@[simp] theorem mFQuot.mapprod_assocsymm_mapprodassoc
    (G H K : Type*) [Group G] [Group H] [Group K]
    (x : mFQuot p ((G × H) × K)) :
    mFQuot.map (p := p)
        (MulEquiv.prodAssoc (M := G) (N := H) (P := K)).symm.toMonoidHom

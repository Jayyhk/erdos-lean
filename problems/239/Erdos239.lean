        ((Q ^ 2 : ℕ) * eta) := by
    apply norm_sum_Ioc_le_log_mul_of_dyadic_bound_on f hMpos
      (mul_nonneg (Nat.cast_nonneg _) heta.le)
    intro X Y hMX hYK hX hXY hYtwo
    have hNS : N * S ≤ X + 1 := by
      have : N * S ≤ Q ^ 2 * S := Nat.mul_le_mul_right S hNQ

    rcases lt_or_gt_of_ne hY with hYneg | hYpos
    · rw [Real.sign_of_neg (mul_neg_of_pos_of_neg hT hYneg), Real.sign_of_neg hYneg]
    · rw [Real.sign_of_pos (mul_pos hT hYpos), Real.sign_of_pos hYpos]

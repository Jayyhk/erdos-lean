  mul_mem' := by
    intro x y hx hy R hR
    change x R * y R = 1
    rw [hx R hR, hy R hR, one_mul]
  inv_mem' := by
    intro x hx R hR
    change (x R)⁻¹ = 1
    rw [hx R hR, inv_one]


        (ZMod.equivPi (pairedDivisorLcm z)
          (NeZero.ne (pairedDivisorLcm z))).toRingHom)
  have hhom :
      componentHom =
        ZMod.castHom (Nat.dvd_of_mem_primeFactors p.2)

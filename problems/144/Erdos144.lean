  apply ContinuousOn.intervalIntegrable
  apply hF.comp
  · fun_prop
  · intro t ht
    simpa [Complex.Rectangle, Complex.mem_reProdIm] using And.intro hx ht

private lemma intervalIntegrable_horizontal_principalPartSum

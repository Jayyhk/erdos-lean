    simpa only [k] using Finset.card_pos.mpr hS_nonempty
  have hcard : S.card = k := rfl
  let e : Fin k ↪o ℕ := S.orderEmbOfFin hcard
  let g : ℕ → ℕ := fun i ↦
    if hi : i < k then e ⟨i, hi⟩ else M + i
  have hg : StrictMono g := by
    intro i j hij
    by_cases hi : i < k
    · by_cases hj : j < k
      · simp only [g, dif_pos hi, dif_pos hj]

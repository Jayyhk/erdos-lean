        ∀ i, B i ×ˢ B i ⊆ modularForwardBowenPairs (32 * η) ((n : ℝ) + 4 * Real.log H) := by
  obtain ⟨H₀, hH₀, hcover⟩ := exists_refined_moving_local_lift_cover hηpos hη hε

      rationalTameGalois S}
    {prime : Fin d → ℕ}
    {frobeniusLift : Fin d → free.Carrier}
    (hsetup :
      RationalKochSetup
        S
        free
        quotientMap
        prime
        frobeniusLift)
    {A E : Type v}
    [Group A]
    [TopologicalSpace A]
    [DiscreteTopology A]
    [Finite A]
    [Group E]
    [TopologicalSpace E]
    [DiscreteTopology E]
    [Finite E]

  have : ∀ i, Nonempty {w // w ∈ W i} :=
    fun i => ⟨⟨(hWne i).choose, (hWne i).choose_spec⟩⟩
  let μ (i : Fin q) : Measure (W i) := (PMF.uniformOfFintype (W i)).toMeasure

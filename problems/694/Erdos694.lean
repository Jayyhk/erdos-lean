open Asymptotics Complex Filter MeasureTheory Set
open scoped BigOperators Real Topology

namespace BoundedGaps.Maynard

private noncomputable def characterPrefixTail
    {q : ℕ} (chi : DirichletCharacter ℂ q) (y : ℝ) : ℂ :=

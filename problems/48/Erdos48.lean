        mul_le_mul_of_nonneg_left (sub_le_self _ hQnonneg) (by norm_num)
      calc
        2 * ((1 : ℝ) / D - 1 / Q) ≤ 2 * (1 / D) := hle
        _ = 2 / (D : ℝ) := by ring


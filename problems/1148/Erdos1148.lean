  let J := C * (Y * H + 1) ^ 3
  have hHpos : 0 < H := by linarith
  have hlog : 0 ≤ Real.log H := Real.log_nonneg hH
  have hT : 0 ≤ T := by dsimp only [T]; positivity
  have hbase : 1 ≤ Y * H + 1 := by nlinarith

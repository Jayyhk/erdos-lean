    _ = ∑ d ∈ Finset.Ioc 0 Q with roughModulusAbove Q1 d,
        ∑ k ∈ Finset.Ioc 0 (Q / d),
          ((d * k).totient : ℝ)⁻¹ *
            ∑ ψ : primitiveCharacters d,
              primitiveCenteredEndpointMaximum x d ψ := by
      simpa [S, T, F] using hbij.trans hsum.symm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro d hd
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      rw [mul_comm]


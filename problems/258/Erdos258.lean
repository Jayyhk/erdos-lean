    (H : Finset ℕ) (R W : ℕ) (y : (H → ℕ) → ℝ)
    (m : H) (r : H → ℕ) : ℝ :=
  ∑ a ∈ maynardDivisorTupleSupport H R W,
    if IsMaynardS2MainFace m r a then
      y a / Nat.totient (a m)

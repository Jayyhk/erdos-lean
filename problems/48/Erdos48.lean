theorem
    norm_dirichletNontrivialZeroKernelSum_sub_le_zeroShellMultiplicity
    {q : ℕ} [NeZero q] (chi : DirichletCharacter ℂ q)
    {x T U : ℝ} (hx : 2 ≤ x) (hT : 2 ≤ T)
    (hU : U ∈ Set.Icc T (T + 1)) :

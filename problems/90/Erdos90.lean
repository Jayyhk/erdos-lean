theorem completion_ring_one
    {F : Type*} [Field F] {v u : AbsoluteValue F ℝ}
    [IsUltrametricDist v.Completion] [IsUltrametricDist u.Completion]
    (h : v.IsEquiv u) (x : v.Completion) :

    rwa [prime_action_ideal] at hval
  · intro hsigma
    apply Subtype.ext
    apply HeightOneSpectrum.ext
    change (sigma • Q.1).asIdeal = Q.1.asIdeal
    rw [prime_action_ideal]
    exact hsigma


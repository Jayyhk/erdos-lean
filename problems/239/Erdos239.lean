      ∑ j ∈ Finset.range L, f (j + 1) := by
  have hIcc : Finset.Icc 1 L = Finset.Ico 1 (L + 1) := by
    ext n
    simp only [Finset.mem_Icc, Finset.mem_Ico]
    omega
  rw [hIcc, Finset.sum_Ico_eq_sum_range]
  have hlen : L + 1 - 1 = L := by omega
  rw [hlen]
  apply Finset.sum_congr rfl
  intro j hj
  rw [Nat.add_comm]


      Q.under R = p ∧ Ideal.ramificationIdx p Q ≠ 1}
  have hramifiedIdeals : ramifiedIdeals.Finite := by
    exact ramified_base_primes R T
  let ramifiedPrimes : Set (HeightOneSpectrum R) :=
    {P | P.asIdeal ∈ ramifiedIdeals}

          (principalIdeles (NumberField.RingOfIntegers L) L) (p * y) :=
      (map_mul _ _ _).symm
    _ = QuotientGroup.mk'
          (principalIdeles (NumberField.RingOfIntegers L) L) x := by
      rw [hpy]


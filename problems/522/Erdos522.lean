theorem _root_.ProbabilityTheory.lipschitzOnWith_orthogonalProjectionPatchInverse_of_subset_positivePatch {d : ℕ}
    {C : Set (EuclideanSpace ℝ (Fin d))} (hclosed : IsClosed C)
    {θ : EuclideanSpace ℝ (Fin d)} (hθ : ‖θ‖ = 1)

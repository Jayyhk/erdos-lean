      (fun s : ℂ => (s - rho) * (c rho / (s - rho)))
      (𝓝[≠] rho) (𝓝 (c rho)) := by
    apply tendsto_const_nhds.congr'
    filter_upwards [self_mem_nhdsWithin] with s hs
    have hsrho : s - rho ≠ 0 := sub_ne_zero.mpr (by simpa using hs)
    rw [← mul_div_assoc, mul_div_cancel_left₀ _ hsrho]

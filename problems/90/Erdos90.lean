      v x ^ c = w₁ (algebraMap K L x) ^ c := by
        exact congrArg (fun r : ℝ => r ^ c) hw₁x.symm
      _ = w₂ (algebraMap K L x) := congrFun hpow _
      _ = v x := hw₂x

    IntervalIntegrable
        (fun sigma : ℝ =>
          dirichletExplicitFormulaIntegrand chi x
            ((sigma : ℂ) + U * I))
        volume (-1 / 2) (1 + 1 / Real.log x) ∧
      IntervalIntegrable
        (fun sigma : ℝ =>
          dirichletExplicitFormulaIntegrand chi x
            ((sigma : ℂ) - U * I))

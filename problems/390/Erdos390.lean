    dsimp only [H, bandReciprocalSum]
    positivity
  have hS0 : 0 ≤ S := by
    dsimp only [S, bandReciprocalSquareSum]
    positivity
  have hW0 : 0 < (W : ℝ) := by exact_mod_cast (Nat.zero_lt_of_lt hW)
  have hw0 : 0 ≤ w := by dsimp only [w]; positivity
  have hw1 : w ≤ 1 := by

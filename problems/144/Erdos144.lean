      HarmonicDecomposition.lowContribution D r := by
  calc
    (∑ M ∈ P, predecessorFibreMass M) ≤
        (2 / 3 : ℝ) * ∑ M ∈ P, 1 / (M.1 : ℝ) ^ 2 :=
      sum_predecessorFibreMass_le hI P

  let Qabove : PrimesAboveBase (K := K) (L := L) P := ⟨Q.1, rfl⟩
  let qFactor : UpperPrimeFactors (K := K) (L := L) P :=
    (upperAboveBase
      (K := K) (L := L) P).symm Qabove

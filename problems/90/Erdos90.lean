open PMExp
open TGExp

/-- Positive and negative Newton expansions for one retained strict-tail
cutoff-profile slot.  The degree bounds remain explicit on the two branches. -/
structure ISExp
    (cutoff : ℕ) where
  natural :
    BCExp 1
      (naturalStrictBound cutoff)
  negative :
    BCExp 1
      (negativeStrictBound cutoff)

namespace ISExp

/-- Evaluate a paired strict-tail recipe with the same signed dispatch as the
literal integral strict trace. -/
noncomputable def eval
    {cutoff : ℕ}
    (expansion : ISExp cutoff) :
    ℤ → ℤ
  | .ofNat multiplicity =>
      expansion.natural.eval multiplicity
  | .negSucc multiplicity =>
      expansion.negative.eval (multiplicity + 1)

end ISExp

/-- Paired global Newton expansion for one retained strict-tail slot. -/
noncomputable def strictSlotExpansion
    (cutoff : ℕ)
    (slot : CWord Atom) :
    ISExp cutoff where
  natural := naturalStrictExpansion cutoff slot
  negative := negativeStrictExpansion cutoff slot

/-- A paired slot recipe evaluates to the literal retained coordinate for
every integral strict-tail coefficient. -/
lemma eval_slot_expansion
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (slot : CWord Atom)
    (coefficient : ℤ) :
    (strictSlotExpansion cutoff slot).eval coefficient =
      (Multiset.count slot
        (cutoffProfile cutoff
          (PSTail.strictTrace
            coefficient)) : ℤ) := by
  cases coefficient with
  | ofNat multiplicity =>
      simp only [ISExp.eval,
        strictSlotExpansion,
        PSTail.strictTrace]
      rw [natural_strict_slot cutoff hcutoff slot]
  | negSucc multiplicity =>
      simp only [ISExp.eval,
        strictSlotExpansion,
        PSTail.strictTrace]
      rw [negative_strict_slot cutoff hcutoff slot]

end GRExp

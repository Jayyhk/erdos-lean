    (gsA10LambdaWindow (gsA9HighGeneralizedMangoldt hmul y) y X)
  let W₂ := gsRealShift (alpha + 2 * beta)
    (gsA10LambdaWindow (gsA9HighGeneralizedMangoldt hmul y) y X)

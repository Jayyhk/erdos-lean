    0 ≤ (bufferedRunInterval H p).1 ∧
      (bufferedRunInterval H p).1 ≤ (bufferedRunInterval H p).2 ∧
      (bufferedRunInterval H p).2 ≤ (n : ℝ) + 4 * Real.log H := by

        push_cast
        rfl
  have hsubsetBound :
      (∑ m ∈ S.image (fun n : ℕ => n / p),
          (1 : ℝ) / ((Nat.totient p : ℝ) * Nat.totient m)) ≤
        ∑ m ∈ T,
          (1 : ℝ) / ((Nat.totient p : ℝ) * Nat.totient m) := by
    apply Finset.sum_le_sum_of_subset_of_nonneg himage

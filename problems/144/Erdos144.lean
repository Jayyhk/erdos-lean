    Real.rpow_le_one_of_one_le_of_nonpos hxone (by norm_num)
  have hnum : ‖(x : ℂ) ^ s - 1‖ ≤ 2 := by
    calc
      ‖(x : ℂ) ^ s - 1‖ ≤ ‖(x : ℂ) ^ s‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
      _ = x ^ (-1 / 2 : ℝ) + 1 := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hxpos]
        simp [s]

    {G : Type u} [Group G]
    {M N : Rep.{v, 0, u} ℤ G} (f : M ⟶ N) :
    ShortComplex (Rep.{v, 0, u} ℤ G) :=
  ShortComplex.mk (Abelian.image.ι f) (cokernel.π f)

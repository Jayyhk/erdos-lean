      (∑ x ∈ s, ‖c x‖) ≤
        (∑ m ∈ sm, ‖a m‖) * (∑ n ∈ sn, ‖b n‖) := by
    rw [Finset.sum_product, Finset.sum_mul_sum]
    apply Finset.sum_le_sum
    intro m _hmm
    apply Finset.sum_le_sum
    intro n _hnn
    simp only [c, norm_mul]
    calc
      ‖a m‖ * ‖b n‖ * ‖χ (m * n)‖ ≤ ‖a m‖ * ‖b n‖ * 1 :=
        mul_le_mul_of_nonneg_left (χ.norm_le_one _)

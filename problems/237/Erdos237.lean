      |(Real.sin (Real.pi * x))⁻¹| * |(Real.sin (Real.pi * x))⁻¹| =
        (Real.sin (Real.pi * x))⁻¹ ^ 2 := by
    rw [← sq, sq_abs]
  rw [mul_assoc, habs]
  ring

end BoundedGaps.Maynard


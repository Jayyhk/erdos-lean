      ∑ᶠ rho : ℂ, (D rho : ℂ) / (s - rho) := by
  have hmul : (fun rho : ℂ => (fun z : ℂ => z - rho) ^ D rho).mulSupport ⊆
      hD.toFinset := by
    rw [Function.FactorizedRational.mulSupport]

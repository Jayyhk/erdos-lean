  BRExp

/-- The finite concrete Hall index type in the strict-tail parent layer. -/
abbrev AddressParentIndex
    (d : ℕ)
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))) :
    Type u :=
  (concreteCommutatorsWeight.{u} d
    (exponentAddressParent x y z + 1)).index

/--
The canonical Hall-family theorem supplies a basis in every strict-tail
parent layer lying below the truncation class.  Choose that basis.
-/
noncomputable def concreteParentBasis
    (d n : ℕ)
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (hparent :
      exponentAddressParent x y z + 1 < n) :
    Module.Basis
      (AddressParentIndex d x y z)
      ℤ
      (AddressParentLayer (n := n) x y z) :=
  Classical.choose
    (concrete_forms_associated
      d n (exponentAddressParent x y z + 1)
        (by omega) hparent)

/-- The selected concrete basis consists of the canonical Hall classes. -/
@[simp]
lemma concrete_parent_basis
    (d n : ℕ)
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (hparent :
      exponentAddressParent x y z + 1 < n)
    (i : AddressParentIndex d x y z) :
    concreteParentBasis
        d n x y z hparent i =
      BCWt.associatedGradedClass (n := n)
        ((concreteCommutatorsWeight.{u} d
          (exponentAddressParent x y z + 1)).commutator i) := by
  exact
    (Classical.choose_spec
      (concrete_forms_associated
        d n (exponentAddressParent x y z + 1)
          (by omega) hparent)) i

/-- Positive Newton recipe for one selected concrete Hall coordinate. -/
noncomputable def addressNaturalParent
    (d n : ℕ)
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (cutoff : ℕ)
    (hparent :
      exponentAddressParent x y z + 1 < n)
    (i : AddressParentIndex d x y z) :
    BCExp 1
      (naturalStrictBound cutoff) :=
  addressParentBasis
    x y z cutoff
      (concreteParentBasis d n x y z hparent) i

/-- Shifted-negative Newton recipe for one selected concrete Hall coordinate. -/
noncomputable def addressParentExpansion
    (d n : ℕ)
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (cutoff : ℕ)
    (hparent :
      exponentAddressParent x y z + 1 < n)
    (i : AddressParentIndex d x y z) :
    BCExp 1
      (negativeStrictBound cutoff) :=
  addressNegativeParent
    x y z cutoff
      (concreteParentBasis d n x y z hparent) i

lemma address_parent_basis
    (d n : ℕ)
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (hparent :
      exponentAddressParent x y z + 1 < n)
    (i : AddressParentIndex d x y z) :
    (addressNaturalParent
      d n x y z cutoff hparent i).eval =
      fun multiplicity : ℕ =>
        addressParentCoordinate x y z

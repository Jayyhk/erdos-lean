        ‖∑ᶠ rho : ℂ, (D rho : ℂ) / (s - rho)‖ ≤
          4 * (A : ℝ) * C * L ^ 2 := by
      calc
        ‖∑ᶠ rho : ℂ, (D rho : ℂ) / (s - rho)‖ ≤

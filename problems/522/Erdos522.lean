    (stdGaussian E0).real (Metric.cthickening ε (closure s) \ s) ≤
      ballGaussianPerimeterConstant 0 * ε := by
  rw [stdGaussian_outer_shell_finZero_eq_zero]
  simp [ballGaussianPerimeterConstant]

open _root_.ProbabilityTheory in

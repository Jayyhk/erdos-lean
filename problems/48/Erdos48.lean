/-!
# High derivatives of a zero-regularized logarithmic derivative

This file makes the fixed-disk regular factor available to the Erdos 48
zero detector and applies Cauchy's estimate to its logarithmic derivative.
The factorization argument is the proved one used by the pinned
BoundedGaps development; it is reproduced task-locally because its regular
factor is deliberately private there.
-/

open Filter Function Metric Set
open scoped Topology

namespace BoundedGaps.Maynard

noncomputable section

private noncomputable def selectedDivisor_v1
    (f : ℂ -> ℂ) (c : ℂ) (R : ℝ) : Function.locallyFinsuppWithin
      (closedBall c (2 * R)) ℤ :=
  MeromorphicOn.divisor f (closedBall c (2 * R))

private noncomputable def selectedZeroProduct_v1
    (f : ℂ -> ℂ) (c : ℂ) (R : ℝ) : ℂ -> ℂ :=
  ∏ᶠ rho : ℂ, (fun z => z - rho) ^ selectedDivisor_v1 f c R rho

private noncomputable def selectedRawFactor_v1
    (f : ℂ -> ℂ) (c : ℂ) (R : ℝ) : ℂ -> ℂ :=
  (selectedZeroProduct_v1 f c R)⁻¹ * f

private noncomputable def selectedRegularFactor_v1
    (f : ℂ -> ℂ) (c : ℂ) (R : ℝ) : ℂ -> ℂ :=
  toMeromorphicNFOn (selectedRawFactor_v1 f c R)
    (closedBall c (4 * R))

private theorem selectedDivisor_support_finite_v1
    (f : ℂ -> ℂ) (c : ℂ) (R : ℝ) :
    (selectedDivisor_v1 f c R).support.Finite :=
  (selectedDivisor_v1 f c R).finiteSupport (isCompact_closedBall c (2 * R))

private theorem analyticOrderAt_ne_top_on_closedBall_v1
    {f : ℂ -> ℂ} {c : ℂ} {R : ℝ} (hR : 0 ≤ R)
    (hf : AnalyticOnNhd ℂ f (closedBall c R)) (hc : f c ≠ 0)
    {z : ℂ} (hz : z ∈ closedBall c R) :
    analyticOrderAt f z ≠ ⊤ := by
  have hc_mem : c ∈ closedBall c R := mem_closedBall_self hR
  apply hf.analyticOrderAt_ne_top_of_isPreconnected
    (convex_closedBall c R).isPreconnected hc_mem hz
  rw [(hf c hc_mem).analyticOrderAt_eq_zero.mpr hc]
  exact WithTop.zero_ne_top

private theorem selectedDivisor_apply_eq_order_v1
    {f : ℂ -> ℂ} {c : ℂ} {R : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) (hc : f c ≠ 0)
    {z : ℂ} (hz : z ∈ closedBall c (2 * R)) :
    selectedDivisor_v1 f c R z = (analyticOrderNatAt f z : ℤ) := by
  have hf_inner : AnalyticOnNhd ℂ f (closedBall c (2 * R)) :=
    hf.mono (closedBall_subset_closedBall (by linarith))
  have hfinite := analyticOrderAt_ne_top_on_closedBall_v1 (by positivity)
    hf_inner hc hz
  rw [selectedDivisor_v1, MeromorphicOn.AnalyticOnNhd.divisor_apply hf_inner hz,
    ← Nat.cast_analyticOrderNatAt hfinite, ENat.map_coe, WithTop.untop₀_coe]

private theorem selectedDivisor_nonneg_v1
    {f : ℂ -> ℂ} {c : ℂ} {R : ℝ}
    (hR : 0 < R) (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) :
    0 ≤ selectedDivisor_v1 f c R := by
  exact MeromorphicOn.AnalyticOnNhd.divisor_nonneg
    (hf.mono (closedBall_subset_closedBall (by linarith)))

private theorem meromorphic_selectedZeroProduct_v1
    (f : ℂ -> ℂ) (c : ℂ) (R : ℝ) :
    Meromorphic (selectedZeroProduct_v1 f c R) := by
  simpa [selectedZeroProduct_v1] using
    (Function.FactorizedRational.meromorphicNFOn_univ
      (selectedDivisor_v1 f c R)).meromorphicOn

private theorem meromorphicOn_selectedRawFactor_v1
    {f : ℂ -> ℂ} {c : ℂ} {R : ℝ}
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) :
    MeromorphicOn (selectedRawFactor_v1 f c R) (closedBall c (4 * R)) := by
  exact (meromorphic_selectedZeroProduct_v1 f c R).meromorphicOn.inv.mul
    hf.meromorphicOn

private theorem meromorphicOrderAt_selectedRawFactor_v1
    {f : ℂ -> ℂ} {c z : ℂ} {R : ℝ}
    (hfz : AnalyticAt ℂ f z) :
    meromorphicOrderAt (selectedRawFactor_v1 f c R) z =
      -(selectedDivisor_v1 f c R z : WithTop ℤ) +
        (analyticOrderAt f z).map (↑) := by
  rw [selectedRawFactor_v1,
    meromorphicOrderAt_mul
      ((meromorphic_selectedZeroProduct_v1 f c R z).inv) hfz.meromorphicAt,
    meromorphicOrderAt_inv,
    selectedZeroProduct_v1,
    Function.FactorizedRational.meromorphicOrderAt_eq
      (selectedDivisor_v1 f c R) (selectedDivisor_support_finite_v1 f c R),
    hfz.meromorphicOrderAt_eq]

private theorem meromorphicOrderAt_selectedRawFactor_eq_zero_v1
    {f : ℂ -> ℂ} {c z : ℂ} {R : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) (hc : f c ≠ 0)
    (hz : z ∈ closedBall c (2 * R)) :
    meromorphicOrderAt (selectedRawFactor_v1 f c R) z = 0 := by
  have hz_outer : z ∈ closedBall c (4 * R) :=
    closedBall_subset_closedBall (by linarith) hz
  have hfinite := analyticOrderAt_ne_top_on_closedBall_v1 (by positivity) hf hc hz_outer
  rw [meromorphicOrderAt_selectedRawFactor_v1 (hf z hz_outer),
    selectedDivisor_apply_eq_order_v1 hR hf hc hz,
    ← Nat.cast_analyticOrderNatAt hfinite, ENat.map_coe]
  simp

private theorem meromorphicOrderAt_selectedRawFactor_nonneg_v1
    {f : ℂ -> ℂ} {c z : ℂ} {R : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) (hc : f c ≠ 0)
    (hz : z ∈ closedBall c (4 * R)) :
    0 ≤ meromorphicOrderAt (selectedRawFactor_v1 f c R) z := by
  by_cases hz_inner : z ∈ closedBall c (2 * R)
  · rw [meromorphicOrderAt_selectedRawFactor_eq_zero_v1 hR hf hc hz_inner]
  · have hfinite := analyticOrderAt_ne_top_on_closedBall_v1 (by positivity) hf hc hz
    rw [meromorphicOrderAt_selectedRawFactor_v1 (hf z hz),
      selectedDivisor_v1, Function.locallyFinsuppWithin.apply_eq_zero_of_notMem _ hz_inner,
      ← Nat.cast_analyticOrderNatAt hfinite, ENat.map_coe]
    simp only [WithTop.coe_zero, neg_zero, zero_add]
    exact_mod_cast Nat.zero_le (analyticOrderNatAt f z)

private theorem analyticOnNhd_selectedRegularFactor_v1
    {f : ℂ -> ℂ} {c : ℂ} {R : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) (hc : f c ≠ 0) :
    AnalyticOnNhd ℂ (selectedRegularFactor_v1 f c R) (closedBall c (4 * R)) := by
  intro z hz
  have hraw := meromorphicOn_selectedRawFactor_v1 hf
  have hnf := meromorphicNFOn_toMeromorphicNFOn
    (selectedRawFactor_v1 f c R) (closedBall c (4 * R)) hz
  unfold selectedRegularFactor_v1
  rw [← hnf.meromorphicOrderAt_nonneg_iff_analyticAt,
    meromorphicOrderAt_toMeromorphicNFOn hraw hz]
  exact meromorphicOrderAt_selectedRawFactor_nonneg_v1 hR hf hc hz

private theorem selectedRegularFactor_ne_zero_v1
    {f : ℂ -> ℂ} {c z : ℂ} {R : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) (hc : f c ≠ 0)
    (hz : z ∈ closedBall c (2 * R)) :
    selectedRegularFactor_v1 f c R z ≠ 0 := by
  have hz_outer : z ∈ closedBall c (4 * R) :=
    closedBall_subset_closedBall (by linarith) hz
  have hraw := meromorphicOn_selectedRawFactor_v1 hf
  have hnf := meromorphicNFOn_toMeromorphicNFOn
    (selectedRawFactor_v1 f c R) (closedBall c (4 * R)) hz_outer
  unfold selectedRegularFactor_v1
  rw [← hnf.meromorphicOrderAt_eq_zero_iff,
    meromorphicOrderAt_toMeromorphicNFOn hraw hz_outer]
  exact meromorphicOrderAt_selectedRawFactor_eq_zero_v1 hR hf hc hz

private theorem selectedZeroProduct_ne_zero_of_divisor_eq_zero_v1
    {f : ℂ -> ℂ} {c z : ℂ} {R : ℝ}
    (hz : selectedDivisor_v1 f c R z = 0) :
    selectedZeroProduct_v1 f c R z ≠ 0 := by
  simpa [selectedZeroProduct_v1] using
    (Function.FactorizedRational.ne_zero (d := selectedDivisor_v1 f c R) hz)

private theorem selectedRegularFactor_eq_raw_v1
    {f : ℂ -> ℂ} {c z : ℂ} {R : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R)))
    (hz : z ∈ closedBall c (4 * R))
    (hPz : selectedZeroProduct_v1 f c R z ≠ 0) :
    selectedRegularFactor_v1 f c R z = selectedRawFactor_v1 f c R z := by
  have hraw := meromorphicOn_selectedRawFactor_v1 hf
  have hP_analytic : AnalyticAt ℂ (selectedZeroProduct_v1 f c R) z := by
    unfold selectedZeroProduct_v1
    exact Function.FactorizedRational.analyticAt
      (selectedDivisor_nonneg_v1 hR hf z)
  have hraw_nf : MeromorphicNFAt (selectedRawFactor_v1 f c R) z := by
    apply AnalyticAt.meromorphicNFAt
    unfold selectedRawFactor_v1
    exact (hP_analytic.inv hPz).mul (hf z hz)
  rw [selectedRegularFactor_v1,
    toMeromorphicNFOn_eq_toMeromorphicNFAt hraw hz,
    toMeromorphicNFAt_eq_self.2 hraw_nf]

private theorem selectedDivisor_apply_center_eq_zero_v1
    {f : ℂ -> ℂ} {c : ℂ} {R : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) (hc : f c ≠ 0) :
    selectedDivisor_v1 f c R c = 0 := by
  rw [selectedDivisor_apply_eq_order_v1 hR hf hc (by simp [hR.le])]
  have horder := (hf c (by simp [hR.le])).analyticOrderAt_eq_zero.mpr hc
  simp [analyticOrderNatAt, horder]

private theorem selectedDivisor_apply_eq_zero_of_ne_zero_v1
    {f : ℂ -> ℂ} {c z : ℂ} {R : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) (hc : f c ≠ 0)

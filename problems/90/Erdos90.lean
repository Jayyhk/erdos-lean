    dsimp only [N]
    simp only [Representation.norm, LinearMap.sum_apply]
    let sndHom : (C × augmentationIdeal G) →+ augmentationIdeal G :=
      { toFun := Prod.snd, map_zero' := rfl, map_add' := fun _ _ ↦ rfl }

    (x Q : ℕ) (Q1 : ℝ) (hx : 4 ≤ x)
    (hQsqrt : (Q : ℝ) ≤ Real.sqrt (x : ℝ)) :
    (∑ d ∈ Finset.Ioc 0 Q with roughModulusAbove Q1 d,
      (∑ ψ : primitiveCharacters d,
        primitiveCenteredEndpointMaximum x d ψ) *
        ((d.totient : ℝ)⁻¹ *
          (4 * (1 + Real.log ((Q / d : ℕ) : ℝ))))) ≤
      (5 * Real.log (x : ℝ)) *
        ∑ d ∈ Finset.Ioc 0 Q with roughModulusAbove Q1 d,

    {z w : ℂ} (hz : ‖z‖ ≤ 1) (hw : ‖w‖ ≤ 1) :
    ‖z + w - z * w‖ ≤ 3 := by
  calc
    ‖z + w - z * w‖ ≤
        ‖z + w‖ + ‖z * w‖ :=
      norm_sub_le _ _
    _ ≤ (‖z‖ + ‖w‖) + ‖z‖ * ‖w‖ := by
      rw [norm_mul]
      exact add_le_add (norm_add_le z w) le_rfl
    _ ≤ 3 := by
      nlinarith [norm_nonneg z, norm_nonneg w]


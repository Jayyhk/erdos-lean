    · apply IsClosed.union
      · exact isClosed_iUnion_of_finite fun e => by
          split_ifs
          · exact isClosed_empty
          · exact isClosed_iUnion_of_finite fun j => by
              rw [← convexHull_pair]
              exact (by simp : ({(D.edgeArc e).vertices[j.1],

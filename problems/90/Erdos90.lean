    1 - (d : ℚ) * c.t0 + ∑ r : S.RelatorIndex, c.t0 ^ S.depth r < 0 := by
  have hsum := S.relator_weightsum_letail c
  have hneg := quadratic_tail_neg c hk
  dsimp [quadraticGSValue] at hneg
  linarith


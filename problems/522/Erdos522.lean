    intro t
    simp only [Multiset.countP_eq_card_filter, closedZeroCount, zeroCountIn,
      Set.mem_ofPred_eq]
  rw [hcount] at hlow hupp
  constructor
  · apply (le_div_iff₀ hlog).mpr
    linarith
  · apply (div_le_iff₀ hlog).mpr
    linarith


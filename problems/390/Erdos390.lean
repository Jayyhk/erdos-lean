    linarith
  have hMassLower : (1 : ℝ) / 8 ≤
      anchorMass (primeWeight n) anchor := by
    rw [anchorMass_canonicalPrimeAnchorSet_eq M]
    exact le_trans (by linarith : (1 : ℝ) / 8 ≤
      (∑ k ∈ anchors, M.width k) - (1 : ℝ) / 16) hSumLower

              XAexact = XAcopy ∧ XBremoved ⊆ XBexact ∧
              (∀ p, p ∈ XAexact ↔
                p ∈ A \ ({D.vertexPlacement u, x} : Set _) ∧ p ∈ H) ∧
              (∀ p, p ∈ XBexact ↔
                p ∈ B \ ({D.vertexPlacement u, x} : Set _) ∧ p ∈ H) ∧

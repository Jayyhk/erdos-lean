        (CProduc.single (concreteInflationCocycle K hFEFact.out c) sigma l) =
      concreteInflationSingle (E := E) K c sigma l := by
  rw [concreteInflationAction, CProduc.sum_single_index]
  exact inflation_single_zero (E := E) K c sigma


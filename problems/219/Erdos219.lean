    (∀ x, f x ≤ ν x) →
    IsUnitBounded g →
    CutDiscrepancyLe (r + 1) f g cutError →
    |cyclicAPCount (r + 2) N f -
        cyclicAPCount (r + 2) N g| ≤ countError


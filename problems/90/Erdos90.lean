    (hk : 0 < k) :
    (select inputWeight k hk).eval q = Nat.choose q k := by
  simp [select, eval]

lemma eval_append
    {inputWeight : ℕ}
    (left right : PBRecipe inputWeight)
    (q : ℕ) :

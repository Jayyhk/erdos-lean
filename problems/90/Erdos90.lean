    (cutoff : ℕ)
    (hcutoff : 3 < cutoff) :
    CPDataa cutoff
      (negativeStrictBound cutoff)
      (fun multiplicity =>
        cutoffProfile cutoff
          (NNPower.strictTrace
            multiplicity)) := by
  apply
    poly_compiler_endpoint
      cutoff hcutoff
  exact
    empty_compiler_bound

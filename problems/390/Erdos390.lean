  simp only [Complex.conj_conj, smul_eq_mul, Function.comp_apply]
  congr 1
  · congr 1
    rw [← Complex.norm_conj]
    simp
  · rw [← Complex.norm_conj]
    simp

theorem deriv_conj_conj (f : ℂ → ℂ) (p : ℂ) :
    deriv (fun z ↦ conj (f (conj z))) (conj p) = conj (deriv f p) := by

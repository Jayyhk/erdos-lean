theorem exists_inducingPrimitive_bound (A : ℝ) (hA : 0 < A) :
    ∃ C c : ℝ, 0 < C ∧ 0 < c ∧
      ∃ X₀ : ℕ, 4 ≤ X₀ ∧ ∀ x : ℕ, X₀ ≤ x →

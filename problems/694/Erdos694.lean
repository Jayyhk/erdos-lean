  apply differentiableOn_fillFiniteRemovable_of_tendsto_mul P
      (fun s => f s - principalPartSum P c s) U hP
  · intro s hsU hsP
    apply (hd s hsU hsP).sub
    apply DifferentiableAt.fun_sum
    intro rho hrho

  let G : ℝ := ∏ h : H, (maynardS2G (r h) : ℝ)
  let M : ℝ := preSievedCoordinateInvTotientMass (primorial D) R
  let A : ℝ := maynardS2MainFaceArithmeticFactor H m r
  let T : ℝ := 8 * Real.exp 8 / (D : ℝ)

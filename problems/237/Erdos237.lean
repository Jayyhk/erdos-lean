    · rintro ⟨ht, hblock⟩
      exact ⟨ht, (mem_dyadicBlock_iff_log_pred_eq (hs t ht).1).mp hblock⟩
    · rintro ⟨ht, hlog⟩
      exact ⟨ht, (mem_dyadicBlock_iff_log_pred_eq (hs t ht).1).mpr hlog⟩

          (Real.log (n : ℝ) - Real.log (p : ℝ)) := by
    apply Finset.sum_congr rfl
    intro p hp
    rw [Real.log_div]
    · exact_mod_cast hn
    · exact_mod_cast (Finset.mem_filter.mp hp).2.ne_zero

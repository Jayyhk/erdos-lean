      (A : Real) / ((∏ i, q i : Nat) : Real)
  · have hrightNat : y <= A / ∏ i, q i := by
      rw [← Nat.floor_div_eq_div (K := Real)]
      exact Nat.le_floor hright
    rw [max_eq_right hright, Nat.floor_div_eq_div,
      max_eq_right hrightNat]

    exists_liu_montgomery_expander H hk hHpos
  have hSaverage : (2 * d : ℝ) ≤ ksInducedAverageDegree H S := by
    push_cast at hHreal ⊢
    nlinarith
  refine ⟨H, S, hHG, hbip, hS, hexp, hSaverage, ?_⟩
  · intro v

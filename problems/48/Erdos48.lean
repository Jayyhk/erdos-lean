theorem vaughanTwistedSumTwo_eq_divisorLogSums
    (V : ℝ) (y q : ℕ) (χ : DirichletCharacter ℂ q) :
    vaughanTwistedSumTwo V y q χ =
      ∑ d ∈ vaughanSecondTermIndices V y,

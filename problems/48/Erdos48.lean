      (∑ b ∈ Finset.Icc 1 (X / a), weight (a * b)) =
          (((∑ b ∈ Finset.Icc 1 (X / a),
            (1 - (a : ℝ) * (b : ℝ) / (X : ℝ))) : ℝ) : ℂ) := by
        rw [Complex.ofReal_sum]

    (zTSubgro.inclusion (p := p) (G := G) hmn hnk).comp
        (zTSubgro.inclusion (p := p) (G := G)
          (Nat.le_trans hmn hnk) hkl) =
      zTSubgro.inclusion (p := p) (G := G) hmn
        (Nat.le_trans hnk hkl) := by

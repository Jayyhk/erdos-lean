        q ≤ powerSieveSmoothBound n L →
        r ∈ powerSieveAuxPrimes n L Q →
        Real.log Aβ ≤ 2 * (S - 100 : ℕ) / 99 →
        PrimeLevelWitness (1 / 4 : ℝ) Bexp CBV X₀ →
        X₀ ≤ n ^ L →
        let eta := (4 * Aβ / 3) * (1 / 4 : ℝ) ^ (S - 100)

  rw [card_range_mul f₀ f₁ hA₁,
    card_range_mul f₁ f₂ hA₂,
    card_range_mul f₂ g₀ hB₀,
    card_range_mul g₀ g₁ hB₁,
    card_range_mul g₁ g₂ hB₂,
    card_range_mul g₂ f₀ hA₀]
  ac_rfl


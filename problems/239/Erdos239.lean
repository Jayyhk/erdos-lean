    rw [zeta_eq_tsum_one_div_nat_cpow (by simpa using hu)]
    rw [Complex.ofReal_tsum]
    apply tsum_congr
    intro n
    simp only [one_div, Complex.ofReal_inv, Complex.ofReal_cpow
      (Nat.cast_nonneg n), Complex.ofReal_natCast]

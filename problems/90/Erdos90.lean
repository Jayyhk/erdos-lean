  letI : Algebra v.Completion (sigma⁻¹ • w).1.Completion :=
    (completionLies v (sigma⁻¹ • w).1 (sigma⁻¹ • w).2).toAlgebra
  letI : Algebra v.Completion w.1.Completion :=
    (completionLies v w.1 w.2).toAlgebra

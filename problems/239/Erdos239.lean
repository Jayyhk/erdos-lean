      primeExtension z n * primeExtension w n := by
  classical
  simp only [primeExtension, assignmentMul, primeValue]
  rw [← Finsupp.prod_mul]
  apply Finsupp.prod_congr
  intro p e
  split_ifs with hprime
  · rw [mul_pow]
  · simp


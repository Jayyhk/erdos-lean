    (powMonoidHom n : ℝˣ →* ℝˣ).range = Units.posSubgroup ℝ := by
  apply le_antisymm
  · rintro y ⟨x, rfl⟩
    exact hn.pow_pos x.ne_zero
  · intro y hy
    obtain ⟨z, hz⟩ := real_unit_pos y hy hn0
    exact ⟨z, hz⟩


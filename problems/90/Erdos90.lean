    UPNorm.{v} kernel packet.packets where
  packet_prod_expansion := by
    intro M N G _inst left right
    exact
      (packet.listEval_eq left right (M : ℤ) (N : ℤ)).trans
        (by
          simpa only [zpow_natCast] using
            (kernel.recipe_cast_pow
              M N left right).symm)


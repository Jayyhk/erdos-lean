theorem tendsto_finiteSimplexInnerGridWeightedSum
    {H : Finset ℕ} (h0 : H) {f : (H → ℝ) → ℝ}
    (hf : Continuous f) (hbound : ∀ x ∈ finiteSimplexOf H, |f x| ≤ 1) :

          (t * Real.log t ^ 2)⁻¹ := by
    calc
      |∫ t in (2 : ℝ)..(x : ℝ),
          centeredThetaProgressionError ⌊t⌋₊ q a /
            (t * Real.log t ^ 2)| =
          ‖∫ t in (2 : ℝ)..(x : ℝ),

        (continuousAt_const : ContinuousAt (fun _ : ℂ => rho) rho)).tendsto
    simpa using hfull.mono_left nhdsWithin_le_nhds
  have hother : Tendsto
      (fun s => ∑ q ∈ P.erase rho, c q / (s - q)) (𝓝[≠] rho)

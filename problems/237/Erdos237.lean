    {alpha U : ℝ} (halphaUpper : alpha ≤ 2) (hU : 0 < U) :
    alpha / (Real.pi * U) ≤ 32 / U := by
  have hpi : alpha / Real.pi ≤ (32 : ℝ) := by
    rw [div_le_iff₀ Real.pi_pos]
    nlinarith [Real.pi_gt_three]

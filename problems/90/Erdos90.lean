theorem h_brauer_restriction
    (x : MHTwo Gal(E/K) Eˣ) :
    CProduc.hRelativeBrauer L E
        (brauerHRestriction K L E x) =
      relativeBrauerChange K L E
        (CProduc.hRelativeBrauer K E x) := by
  simp [brauerHRestriction]


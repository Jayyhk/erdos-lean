    exact hcancel sigma
  · intro q hq hq3 P hP hPover sigma
    letI : P.IsPrime := hP
    letI : P.LiesOver (Ideal.rationalPrimeIdeal q) := hPover
    have hunramified : RationalPrimeUnramified

    truncate n leftWeight rightWeight packet.packets =
      packet.packets := by
  apply List.filter_eq_self.2
  intro nextPacket hnextPacket
  simpa only [decide_eq_true_eq] using
    packet.packet_weight_cutoff hnextPacket


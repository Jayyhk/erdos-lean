    exact Real.log_nonneg (by linarith)
  have hbaseArgPos : 0 < (q : ℝ) * (T + 2) := by positivity
  have hargFirst : (q : ℝ) * (T + 2) ≤ 2 * ((q : ℝ) * x) := by
    have hheight : T + 2 ≤ 2 * x := by linarith
    nlinarith [mul_le_mul_of_nonneg_left hheight hq0]

    (hD d hd_mem) (hD e he_memD)
  push_cast at hprod
  rw [div_eq_mul_inv, hprod]
  ring

def commonDivisorTupleSupport
    (H : Finset ℕ) (d e : H → ℕ) : Finset (H → ℕ) :=
  Fintype.piFinset (fun h => (Nat.gcd (d h) (e h)).divisors)

def commonDivisorTupleTerm

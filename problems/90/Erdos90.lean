/-- Pointwise form of swap-naturality for dimension layer-kernel product equivalences. -/
@[simp] theorem dLKern.prod_equiv_swapapply
    (G H : Type*) [Group G] [Group H] (n : ℕ)
    (x : dLKern R (G × H) n) :
    dLKern.prodEquiv (R := R) H G n
        (dLKern.map (R := R)

/-- Prime-band restriction depends only on the pointwise predicate. -/
theorem primeBandCoefficient_congr_pred
    (f : ℕ → ℂ) (P Q : ℕ → Prop)
    [DecidablePred P] [DecidablePred Q]
    (hPQ : ∀ p, P p ↔ Q p) :
    primeBandCoefficient f P = primeBandCoefficient f Q := by

theorem dirichletExplicitFormulaCandidateSingularities_finite
    {N : ℕ} [NeZero N] (chi : DirichletCharacter ℂ N)
    (z w : ℂ) :
    (dirichletExplicitFormulaCandidateSingularities chi z w).Finite := by

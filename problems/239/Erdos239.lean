          calc
            ‖(∑ n ∈ Finset.Ioc M (2 * M), f n) +
                ∑ n ∈ Finset.Ioc (2 * M) H, f n‖ ≤
                ‖∑ n ∈ Finset.Ioc M (2 * M), f n‖ +
                  ‖∑ n ∈ Finset.Ioc (2 * M) H, f n‖ := norm_add_le _ _

      · apply mul_le_mul_of_nonneg_left hlog.le
        positivity
      · exact sum_primitiveCenteredEndpointMaximum_nonneg x d
    _ = _ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro d hd
      ring


      0 ≤ 2 * Real.sqrt (x : ℝ) * Q1 := by positivity
  have hlowerCube :
      0 ≤ 12 * vaughanCubeRoot x ^ 2 * Real.sqrt Q1 := by positivity
  unfold vaughanPrimitiveMeanAbelSharpPolynomial
    vaughanPrimitiveMeanAbelEnvelope
  rw [abelEnvelope_log_eq hQ1 hQ]
  linarith


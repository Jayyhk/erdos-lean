    · exact hVfirst
    · exact hV0
  have hfirst :
      |fourFiveReciprocalPrimeBVDefect
        (fun i => ∑ j ∈ S,
          fourFiveAnchoredReciprocalPrimeAtom A j * K i j) A Y| <=

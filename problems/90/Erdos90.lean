    List (SPFactora H inputWeight)
  higher_least_succ :
    SPFactora.WordWeightLeast (lowerWeight + 1) higherSource
  rewrites :
    SCRw
      (n := n) (lowerWeight := lowerWeight)
      (coordinates.weightFactors lowerWeight ++
        (factor.normalCoordinateExpansions hn H hH).weightFactors
          lowerWeight)

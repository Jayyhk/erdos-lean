private theorem weightedWindow_target_implies_centeredWindow
    {A : ℝ} {B : ℕ} {x Q : ℕ}
    (hx : 4 ≤ x) (hB : A + 5 < (B : ℝ))
    (hQ : (Q : ℝ) ≤ Real.sqrt (x : ℝ) /
      (Real.log (x : ℝ)) ^ B) :

      -((denseGeneratorsElement p Λ x⁻¹) *
        (denseGeneratorsElement p Λ x - 1)) := by
  have hleft_inverse :
      denseGeneratorsElement p Λ x⁻¹ *
          denseGeneratorsElement p Λ x =
        (1 : denseGroupAlgebra p Λ) := by
    rw [← dense_element_mul]
    simp
  noncomm_ring [hleft_inverse]


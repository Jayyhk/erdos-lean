      3 + (1 / 3 : ℝ) * Real.log (x : ℝ) := by
  have hxpos : 0 < (x : ℝ) := by exact_mod_cast (Nat.zero_lt_of_lt hx)
  have hcpos := vaughanCubeRoot_pos hx
  have hlogCube : Real.log (vaughanCubeRoot x) =
      (1 / 3 : ℝ) * Real.log (x : ℝ) := by
    unfold vaughanCubeRoot

      exact_mod_cast Nat.totient_pos.mpr (hprime hp).pos
    have hphiOne : (1 : ℝ) ≤ Nat.totient p := by
      exact_mod_cast (Nat.one_le_iff_ne_zero.mpr
        (Nat.ne_of_gt (Nat.totient_pos.mpr (hprime hp).pos)))

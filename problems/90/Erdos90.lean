    { toFun := fun x i ↦ ⟨coord x i, hcoord_mem x i⟩
      map_add' := by
        intro x y
        ext i
        simp [coord, mul_add]
      map_smul' := by
        intro r x
        funext i
        apply Subtype.ext
        change coord (r • x) i = (r : K) * coord x i
        simp only [coord, Submodule.coe_smul, Algebra.smul_def]
        rw [show algebraMap 𝒪[K] D r = algebraMap K D (r : K) by rfl]

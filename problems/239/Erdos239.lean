  have hweight : badWeight bad x = eventWeight (bad x) := by
    funext p
    by_cases hp : bad x p <;> simp [badWeight, eventWeight, hp]
  rw [hweight]
  exact lowerSieve_pointwise A (bad x) P

/-- Summing the pointwise upper combinatorial-sieve inequality. -/

    ‖riemannZeta (u : ℂ)‖ =
      ∑' n : ℕ, 1 / (n : ℝ) ^ u := by
  have hsum : Summable (fun n : ℕ ↦ 1 / (n : ℝ) ^ u) :=
    by simpa only [one_div] using Real.summable_nat_rpow_inv.mpr hu
  have hzeta : riemannZeta (u : ℂ) =

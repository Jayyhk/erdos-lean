theorem tendsto_normalized_of_sparse_blocks {N : ℕ → ℕ} {X ε : ℕ → ℝ} {c : ℝ}
    (hN : StrictMono N)
    (hratio : Tendsto (fun j ↦ (N (j + 1) : ℝ) / N j) atTop (𝓝 1))

private theorem mul_prime_pow_nonneg_of_local_eq
    (f g : ArithmeticFunction ℂ) {p k : ℕ} (hp : p.Prime)
    (hf : ∀ n, 0 ≤ f n) (hlocal : ∀ j, g (p ^ j) = f (p ^ j)) :
    0 ≤ (f * g) (p ^ k) := by
  rw [mul_apply_prime_pow f g hp]

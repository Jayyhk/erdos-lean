    intro hrho
    have hre := congrArg Complex.re hrho
    norm_num at hre
    linarith
  exact hzeta rho
    ((principal_LFunction_eq_zero_iff_riemannZeta_eq_zero_of_re_pos_of_ne_one
      hrho0 hrho_one).mp hzero)


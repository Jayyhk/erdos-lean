          (∑ t ∈ P.powerset,
              (∏ p ∈ insert x t, a p) * ∑ p ∈ insert x t, b p) =
            a x * b x * (∏ q ∈ P, (1 + a q)) +
              a x * (∑ t ∈ P.powerset,
                (∏ p ∈ t, a p) * ∑ p ∈ t, b p) := by

            v r * star (v s) *
              ∑ n ∈ S, phase ((n : ℝ) * (y r - y s)) := by
      congr 1
      push_cast
      rw [Finset.mul_sum]

private lemma sum_phase_Ioc_eq_cosecant
    (t : ℝ) (ht : (t : UnitAddCircle) ≠ 0) (m0 N : ℕ) :
    (∑ n ∈ Finset.Ioc m0 (m0 + N), phase ((n : ℝ) * t)) =
      Complex.I / 2 *
        (phase (((m0 : ℝ) + 1 / 2) * t) -
          phase ((((m0 + N : ℕ) : ℝ) + 1 / 2) * t)) *

    zmodMulEquivOfGenerator (g := q yH) (by
      intro z
      rw [tame_frobenius_zpowers
        x y (localResidueCard K) hcoprime hconj]
      exact Subgroup.mem_top z) rfl
  exact (levelZMod K f).toMonoidHom.comp
    (eQ.symm.toMonoidHom.comp q)


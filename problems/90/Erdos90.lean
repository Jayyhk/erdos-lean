  ∀ (Q : Type u) [Group Q] [Finite Q],
    IsPGroup p Q →
      ∀ t : Fin d → Q,
        GeneratedBy t →
          ∀ x : Q,
            x ∈ zassenhausFiltration p Q n →
              ∃ L : List (BSValue p d n Q),
                L.length ≤ k ∧
                  x * (L.map BSValue.eval).prod⁻¹ ∈
                    Subgroup.lowerCentralSeries Q (n - 1)

/--

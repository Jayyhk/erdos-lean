  (Real.log (radialSigma N (1 + (x + 2 * h) / N)) -
      Real.log (radialSigma N (1 + (x + h) / N)) + 2 * logarithmicTolerance N) /
    ((N : ℝ) * Real.log ((1 + (x + 2 * h) / N) / (1 + (x + h) / N)))


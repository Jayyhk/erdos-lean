  have hsigmaTwo : sigma < 2 := by dsimp [sigma]; linarith
  obtain ⟨hchi, hzero, hrhoPos, hrhoOne⟩ :=
    (isNonprincipalNontrivialLFunctionZero_iff chi rho).1 hrho

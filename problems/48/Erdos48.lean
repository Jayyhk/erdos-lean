  let C : ℝ := 96 * (A : ℝ) *
    x ^ (1 - (((J + 1 : ℕ) : ℝ) * eta)) *
      Real.log ((Q : ℝ) * (T + 2)) ^ 2
  have hC : 0 ≤ C := by dsimp [C]; positivity

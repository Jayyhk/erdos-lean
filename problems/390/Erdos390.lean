      tPrime B.sampleData.n p.1 ∈
        Set.Icc (1 / 8 : ℝ) (1 - 1 / 8) := by
    simpa only [anchor, Pcanonical,
      Subsingleton.elim hnAnchor B.n_gt_one,
      Subsingleton.elim hWanchor hWuser] using hInteriorRaw

          ∑ r ∈ highExponents (valuationCutoff p M),
            ∑ s ∈ highExponents (valuationCutoff q M), e r s := by
      simp_rw [Finset.sum_add_distrib]
      congr 1
      calc
        (∑ r ∈ highExponents (valuationCutoff p M),

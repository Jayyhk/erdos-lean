        (Fintype.card (OrderedPositiveSubface r) : ℝ) *
          ((coarseBound : ℝ) * α +
            (fineBound : ℝ) * P.totalAtomEnergyGap / β) := by
      simp only [Finset.sum_const, Finset.card_univ,

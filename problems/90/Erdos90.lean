  unfold gsEvalInt
  rw [Finset.sum_eq_single 0]
  · simp
  · intro q hq hq0
    have hpos : 0 < q := Nat.pos_of_ne_zero hq0
    have hp : (0 : ℤ) ^ q = 0 := by simp [Nat.ne_of_gt hpos]
    simp [hp]
  · intro h0
    exfalso
    apply h0
    simp


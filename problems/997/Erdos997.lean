      _ ≤ 2 * (2 : ℝ) ^ (522 * s) := mul_le_mul_of_nonneg_left hpow (by norm_num)
      _ = (2 : ℝ) ^ (522 * s + 1) := by rw [pow_succ, mul_comm]
      _ ≤ (2 : ℝ) ^ (523 * s) := pow_le_pow_right₀ (by norm_num) (by omega)

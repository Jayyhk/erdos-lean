      (goldfeldTruncatedLowerIntegral chi1 chi beta x)
      atTop (𝓝 0) := by
    have h := hedges.2.const_mul
      ((((2 * Real.pi : ℝ) : ℂ) * I)⁻¹)
    change Tendsto (fun T : ℝ =>
      ((((2 * Real.pi : ℝ) : ℂ) * I)⁻¹) *

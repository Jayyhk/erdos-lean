    linarith [ show ( n : ℝ ) ≥ 1 by exact Nat.one_le_cast.mpr ( Nat.pos_of_ne_zero hn ) ];
  have hpair :
      (∑ j ∈ Finset.filter (fun j => I' j = i0) Finset.univ, (s j : ℝ)) ^ 2 +
          (∑ j ∈ Finset.filter (fun j => I' j = h) Finset.univ, (s j : ℝ)) ^ 2 <
        (∑ j ∈ Finset.filter (fun j => I j = i0) Finset.univ, (s j : ℝ)) ^ 2 +

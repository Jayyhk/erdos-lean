    |(B.cellMediumLaw xi c).covariance
        (fun m ↦ valuation p.1 (m : ℕ))
        (fun m ↦ B.physicalScore ⟨c, m⟩)| ≤
      (Kspan * epsilonPrefix B.sampleData.n) *
        (1 / (p.1 : ℝ)) := by simpa only [div_one, mul_assoc] using hraw
    _ = epsilon B.sampleData.n / (p.1 : ℝ) := by
      dsimp only [epsilon]
      ring


  rw [← Finset.sum_subtype q.divisors (fun _ ↦ Iff.rfl) G]
  rw [Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro d hd
  by_cases h : d ≠ 1
  · simp [h]
  · have h1 : d = 1 := by
      exact Classical.byContradiction (fun hn ↦ h hn)
    simp [h, hzero d hd h1]


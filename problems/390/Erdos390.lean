    calc
      |∑ l : Low, omega (.inl l) * q (.inl l)| ≤
          ∑ l : Low, (H (e (.inl l)) * alphaA (e (.inl l))) *
            (Clow * Ggraph + epsLow * B) := by
        calc
          |∑ l : Low, omega (.inl l) * q (.inl l)| ≤
              ∑ l : Low, |omega (.inl l) * q (.inl l)| :=
            Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ l : Low,

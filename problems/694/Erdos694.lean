  -- Use A Y * U = ℓ - 1 in ℝ: cast.
  have hAU_R : (A Y : ℝ) * (U : ℝ) = (ℓ : ℝ) - 1 := by
    rw [← hℓm1_cast, ← Nat.cast_mul]
    exact_mod_cast hAU
  -- So U = (ℓ - 1) / A Y in ℝ.
  have hU_R : (U : ℝ) = ((ℓ : ℝ) - 1) / (A Y : ℝ) := by
    field_simp
    linarith [hAU_R]
  rw [hU_R]

    apply AdicCompletion.ext
    intro n
    change AdicCompletion.transitionMap I R _
      (powerQuotientEquiv I e n 1) = 1
    rw [map_one, transitionMap_one]
  map_mul' x y := by
    apply AdicCompletion.ext
    intro n
    change AdicCompletion.transitionMap I R _
        (powerQuotientEquiv I e n (x.val n * y.val n)) =
      AdicCompletion.transitionMap I R _

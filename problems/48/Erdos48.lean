    rw [← Complex.ofReal_sum]
    exact_mod_cast
      three_eighths_mul_real_sqrt_le_sum_square_linearCutoff hX
  exact hscalar.trans
    (sum_square_linearCutoff_le_quadraticZetaLinearSmoothedSum
      hsquare (by omega))

end BoundedGaps.Maynard


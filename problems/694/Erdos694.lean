  unfold natLogTwist
  rw [Nat.cast_mul, Real.log_mul (by positivity) (by positivity), mul_add]
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- Every explicit logarithmic phase has norm one. -/

    { support := I.image (shiftedProduct shifts)
      prodPrimes := Erdos387.sievePrimeProduct z Y
      prodPrimes_squarefree := Erdos387.sievePrimeProduct_squarefree z Y
      weights := fun q ↦
        ((I.filter fun a ↦ shiftedProduct shifts a = q).card : ℝ)

  have hsum : (∑ γ : Γ, edgeCount (G γ)) ≤
      T * D + C * ∑ γ : Γ, Real.sqrt (Real.sqrt (Q γ)) := by
    calc
      (∑ γ : Γ, edgeCount (G γ)) ≤

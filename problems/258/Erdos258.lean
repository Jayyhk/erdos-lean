          (preSieveModulus K * 4 * 16 ^ K) < intervalStart K := by
    have h := hscaledNat
    ring_nf at h ⊢
    exact h
  have hscaled :
      (16 * (J : ℝ) ^ 4 * ((radiusProduct K : ℝ) ^ 6 * 257)) * F <

    ext t
    simp only [Set.mem_ofPred, Set.mem_iUnion]
    aesop
  rw [heq]
  apply (measureReal_biUnion_finset_le s _).trans
  apply Finset.sum_le_sum
  intro p hp
  exact volume_angular_pair_collision_le (hab p hp) hτ hδ


theorem pGroup_reduction
    (hprime : PrimeCyclicCases.{u})
    (hnormal : NormalSubgroupBridge.{u})
    (htrivial : TrivialExtensionBridge.{u})
    (hfixed : FixedFieldBridge.{u})

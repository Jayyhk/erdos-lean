    apply near_one_of_le_v3 (one_le_two.trans hMreal) (le_max_left _ _) hL1pos
    simpa only [M, L1] using hnear1
  have hnearReal2 : 1 - 1 / ((Mreal : ℝ) ^ 2 * L2) ≤ rho2.re := by
    apply near_one_of_le_v3 (one_le_two.trans hMreal) (le_max_left _ _) hL2pos

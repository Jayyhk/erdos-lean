    {D Q : ℕ} (hDQ : primorial D ≤ Q) :
    |coprimeHarmonicSum (primorial D) Q -
      primorialCoprimeHarmonicMainTerm D Q| ≤ primorial D := by
  have hW : 0 < primorial D := primorial_pos D

      2 * Real.log x ≤ 4 * Real.log (x * (q : ℝ)) ^ 2 := by
    have hlinear : 2 * Real.log x ≤
        2 * Real.log (x * (q : ℝ)) := by linarith
    have hsquare : 2 * Real.log (x * (q : ℝ)) ≤
        4 * Real.log (x * (q : ℝ)) ^ 2 := by
      nlinarith [sq_nonneg (Real.log (x * (q : ℝ)) - 1 / 2)]

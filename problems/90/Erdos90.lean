theorem dTSubgro.inclusion_injective {G : Type*} [Group G]
    {m n k : ℕ} (hmn : m ≤ n) (hnk : n ≤ k) :
    Function.Injective (dTSubgro.inclusion (R := R) (G := G) hmn hnk) := by
  intro x y hxy
  apply Subtype.ext
  exact congrArg (fun z : dTSubgro (R := R) (G := G) hmn =>
      (z : dSubgro R G m)) hxy


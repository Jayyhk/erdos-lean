    exact_mod_cast hmu2
  have hmu2AF :
      (ArithmeticFunction.moebius : ArithmeticFunction ℝ) (p ^ 2) = 0 := by
    change (ArithmeticFunction.moebius (p ^ 2) : ℝ) = 0
    exact_mod_cast hmu2

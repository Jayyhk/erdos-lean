    (hmomentI : Integrable (fun ω => ∫ θ, |Real.log (X (θ, ω))| ^ (2 * q) ∂ν) μ)
    (M : ℝ) (hM0 : 0 ≤ M)
    (hM : (∫ ω, ∫ θ, |Real.log (X (θ, ω))| ^ (2 * q) ∂ν ∂μ) ≤ M)

  if h : c < 11 then
    (![1, 208, 45344, 10358400, 2479436544, 621913344000,
      163502746767360, 45074911052021760, 13040192296300216320,
      3963497946537236889600, 1267924969103825829888000] : Fin 11 → ℚ)

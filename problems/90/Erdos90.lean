def basisHighSpan
    {κ : Type v}
    {p : ℕ} [Fact p.Prime]
    {Q : Type u} [Group Q]
    (B : Module.Basis κ (ZMod p) (denseGroupAlgebra p Q))
    (wt : κ → ℕ)
    (s : ℕ) :

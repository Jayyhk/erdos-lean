          v.1.Completion w.1.1.Completion).trans
        ((infiniteHStabilizer
            (K := K) (L := L) v w).trans
          (uliftHasseNorm
            (K := K) (L := L) v.1 w0).symm)

set_option synthInstance.maxHeartbeats 300000 in

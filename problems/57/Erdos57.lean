      _ ≤ 18 * (917504 * (j + 3) ^ 3) + 127 := by
        exact Nat.add_le_add_right (by simpa [mul_assoc] using hscaled) 127
      _ ≤ 18 * (917504 * (j + 3) ^ 3) +

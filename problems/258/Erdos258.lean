    EulerProduct.summable_and_hasSum_smoothNumbers_prod_primesBelow_tsum
      hf1 hmul hlocal N
  have hIndicator : Summable (N.smoothNumbers.indicator f) :=
    summable_subtype_iff_indicator.mp hEuler.2.summable

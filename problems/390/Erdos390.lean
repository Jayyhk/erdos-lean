          ¬t ≤ (X : ℝ) / (((m + 1 : ℕ) : ℝ) ^ (2 : ℕ)) := by
        intro hright
        exact hmNot (hright.trans (hsupportAntitone hmData.1 (Nat.le_succ m)))
      rw [roughSaiasFullyRealHyperbolaCellKernelOscillation,
        if_neg hrightNot, if_neg hmNot]

      (K := K) (K' := K') (M := M) E) := by
  intro σ τ hστ
  apply AlgEquiv.ext
  intro x
  let equalizer : IntermediateField K M :=
    { carrier := {x | σ x = τ x}
      zero_mem' := by simp
      one_mem' := by simp
      add_mem' := by
        intro x y hx hy

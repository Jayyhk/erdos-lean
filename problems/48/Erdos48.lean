        (Q : ℝ) *
          (Chebyshev.psi (x : ℝ) - Chebyshev.theta (x : ℝ)) := by
  calc
    (∑ q ∈ Finset.Icc 1 Q,
        maxCenteredThetaProgressionDiscrepancyUpTo x q) ≤
        ∑ q ∈ Finset.Icc 1 Q,

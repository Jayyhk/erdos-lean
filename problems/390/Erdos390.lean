  rw [fourFiveMovingSimplexTwoIntegratedHybridThree_eq_explicit]
  unfold fourFiveMovingSimplexIteratedRealCellProductThree
  calc
    (∑ r ∈ Finset.Ioc A Y,
          fourFiveLogLogLebesgueCellAtom r *

    calc
      (u : A) = ((u : A) * (v⁻¹ : Aˣ)) * (v : A) := by simp
      _ = i c * (v : A) := by rw [hw]
  refine ⟨cu, hcu, ?_⟩
  intro d hd
  apply scalarUnits_injective k L A i
  apply mul_right_cancel (b := v)
  rw [← hcu, ← hd]


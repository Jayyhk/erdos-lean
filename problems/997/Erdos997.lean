    simp [z, p, goldfeldShiftedZetaPole]
    linarith
  have hpRe : p.re < w.re := by
    simp [w, p, goldfeldShiftedZetaPole]
    linarith
  have hzIm : z.im < p.im := by
    simp [z, p, goldfeldShiftedZetaPole]
    linarith
  have hpIm : p.im < w.im := by
    simp [w, p, goldfeldShiftedZetaPole]
    linarith

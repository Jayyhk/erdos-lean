      ‖dirichletExplicitFormulaKernel x rho‖ ≤
        (x ^ rho.re + 1) / T := by
    simpa only [Complex.re_add_im] using
      (norm_dirichletExplicitFormulaKernel_horizontal_le
        (x := x) (sigma := rho.re) (t := rho.im) (T := T)
        (by linarith) (by linarith) hheight)

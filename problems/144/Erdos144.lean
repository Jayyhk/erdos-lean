        _ ≤ 2 * ((A : ℝ) * (2 * L)) := by nlinarith
        _ = 4 * (A : ℝ) * L := by ring
    have hsum : ‖∑ᶠ rho : ℂ, (D rho : ℂ) / (s - rho)‖ ≤

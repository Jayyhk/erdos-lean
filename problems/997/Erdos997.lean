    {H : Finset ℕ} {R D : ℕ} {y : (H → ℕ) → ℝ}
    (m : H) {r : H → ℕ}
    (hD : 0 < D) (hr : IsMaynardDivisorTuple H R (primorial D) r)
    (hrm : r m = 1) {B : ℝ} (hB : 0 ≤ B)

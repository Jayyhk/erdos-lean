  rw [dNQuot.prod_assocequiv_symmeq]
  change (dNQuot.congr (R := R)
      (MulEquiv.prodAssoc : (G × H) × K ≃* G × H × K).symm n).toMonoidHom x = _
  rw [dNQuot.congr_monoid_hom]


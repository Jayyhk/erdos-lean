      (x : w.1.Completionˣ) : e sigma • x = sigma • x := by
    apply Units.ext
    change (e sigma : w.1.Completion ≃ₐ[v.Completion] w.1.Completion)
        (x : w.1.Completion) =
      stabilizerRingHom v w sigma (x : w.1.Completion)

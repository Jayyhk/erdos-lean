    AdicCompletion I R ⊗[R] S ≃ₗ[R]
      AdicCompletion (I.map (algebraMap R S)) S :=
  ((AdicCompletion.ofTensorProductEquivOfFiniteNoetherian I S).restrictScalars R).trans

theorem exists_nat_selected_radiusSix_subdivisor_sum_sub_le_re_logDeriv_LFunction :
    ∃ A : ℕ, 37 ≤ A ∧
      ∀ (q : ℕ) [NeZero q], 1 < q →
        ∀ (chi : DirichletCharacter ℂ q), chi.IsPrimitive →
          ∀ (t sigma : ℝ) (Z : ℂ →₀ ℕ),

  have hepsilon0 : ∀ n, 0 ≤ epsilon n := by
    intro n
    cases n with
    | zero => simp [epsilon, tailCoefficient, L, hsigned0]
    | succ n =>
      dsimp only [epsilon, tailCoefficient]
      have hL0 : 0 ≤ L (n + 1) := by
        exact Real.log_nonneg (by exact_mod_cast Nat.succ_le_succ (Nat.zero_le n))

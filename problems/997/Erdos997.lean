/-- The removable scalar kernel in the Dirichlet-L explicit formula. -/
noncomputable def dirichletExplicitFormulaKernel (x : ℝ) (rho : ℂ) : ℂ :=
  dslope (fun s : ℂ => Complex.exp (s * (Real.log x : ℂ))) 0 rho


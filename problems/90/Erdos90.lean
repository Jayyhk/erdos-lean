  rw [hzcomp] at htransport
  have hcastx :
      RingEquiv.cast
          (R := fun R : HeightOneSpectrum
            (NumberField.RingOfIntegers L) => R.adicCompletion L)
          hQ (xInt : Q.1.adicCompletion L) =

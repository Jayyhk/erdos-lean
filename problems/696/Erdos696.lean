private lemma hasSum_perron_kernel_integrals
    {a : ℕ → ℂ} {x : ℕ} {alpha U : ℝ}
    (hsum : LSeriesSummable a (alpha : ℂ))
    (hx : 0 < x) (halpha : 0 < alpha) :
    HasSum (fun n : ℕ => if n = 0 then 0 else
      a n * dirichletPerronKernel ((x : ℝ) / n) alpha U)

omit [FiniteDimensional K E] [IsGalois K E] [FiniteDimensional L E] [IsGalois L E] in
private theorem crossed_embedding_fn
    (c : NMCocycl₂ (G := Gal(E/K)) (M := Eˣ))
    (x y : CProduc (restrictedCocycle K L E c)) :

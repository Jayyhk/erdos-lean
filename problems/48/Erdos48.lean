      Z.sum (fun rho m =>
        (m : ℝ) * (((s - rho)⁻¹).re)) ≤ S.re := by
    simpa [S] using
      selected_radiusSix_subdivisor_sum_le_re_analyticOrder_finsum
        hq chi hchi t s hsre Z hZ

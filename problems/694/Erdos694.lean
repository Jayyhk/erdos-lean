      (le_max_left _ _) hL0Pos hL0Lq
    simpa only [M, Lq] using hnear
  have hprincipalNe :
      DirichletCharacter.LFunction
          (1 : DirichletCharacter ℂ q) rho ≠ 0 := by
    intro hzero

        exact hFQ.symm.trans hF'Q'
      · exact False.elim
          ((Set.disjoint_left.mp (hRelDisjointFace F)) hpRel' hpF)
    · rcases (hfaceSetDel Q' p).1 hpQ' with
        ⟨F', hF'Q', hpF'⟩ | ⟨hnoneQ', _hpRel'⟩
      · exact False.elim
          ((Set.disjoint_left.mp (hRelDisjointFace F')) hpRel hpF')
      · exact hnoneQ.symm.trans hnoneQ'

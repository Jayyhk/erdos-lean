        alpha ∈ dyadicExponentRange ⌊(x : ℝ) / V⌋₊ := by
      rw [dyadicExponentRange, Finset.mem_range]
      rw [hlog] at hlogLe
      exact Nat.lt_succ_of_le hlogLe

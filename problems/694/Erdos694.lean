      (if r ≤ k then (Real.pi : ℂ) else 0)‖ ≤
      2 / (T * |Real.log ((r : ℝ) / ((k : ℝ) + 1 / 2))|) := by
  let y : ℝ := (k : ℝ) + 1 / 2
  have hrR : 0 < (r : ℝ) := by positivity
  have hy : 0 < y := by
    dsimp [y]

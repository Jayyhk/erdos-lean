    (tripleLogCutoff N : ℝ) ≤ Real.log (Real.log (N : ℝ)) := by
  unfold tripleLogCutoff
  have hlogll : 0 ≤ Real.log (Real.log (Real.log (N : ℝ))) :=
    Real.log_nonneg hll

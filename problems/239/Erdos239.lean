          simpa only [y, K, L] using hlogy
        _ ≤ Real.log 2 * (2 * R ^ (1 / 500 : ℝ)) :=
          mul_le_mul_of_nonneg_left hpow (Real.log_pos (by norm_num)).le
        _ = (2 * Real.log 2) * R ^ (1 / 500 : ℝ) := by ring
    calc

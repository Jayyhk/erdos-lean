        _ ≤ 512 * (c * Q ^ (-epsilon)) * Q ^ (epsilon / 4) *
              L ^ 5 := by gcongr
        _ = 512 * c * Q ^ (-3 * epsilon / 4) * L ^ 5 := by
          rw [show 512 * (c * Q ^ (-epsilon)) * Q ^ (epsilon / 4) *

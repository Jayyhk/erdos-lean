    rw [show s + (t - s) = t by ring] at h
    exact h.mono_bound (mul_le_mul_of_nonneg_right hKoK (Real.exp_pos _).le)
  have hr : ∀ p ∈ intervals, p.1 ≠ 0 → ∀ F ⊆ E, LiftForwardClose η p.1 F →

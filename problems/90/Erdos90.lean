theorem augmentation_ideal_algebra :
    Submission.GShafar.augmentationIdeal R (FreeGroup X) =
      Submission.GroupAlgebra.augmentationIdeal R (FreeGroup X) := by
  unfold Submission.GShafar.augmentationIdeal
    Submission.GroupAlgebra.augmentationIdeal
  congr 1


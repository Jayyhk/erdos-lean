            ({slot} : Multiset (CWord Atom)) := by
      apply Finset.sum_subset
      · intro slot hslot
        exact
          List.mem_toFinset.mpr
            (hsource slot (Multiset.mem_toFinset.mp hslot))
      · intro slot _hslotVocabulary hslotSource
        have hslotNot : slot ∉ source := by
          simpa only [Multiset.mem_toFinset] using hslotSource
        rw [Multiset.count_eq_zero_of_notMem hslotNot, zero_nsmul]


      simpa [X, P] using hP.1
    letI : Finite (tateNegOne X.X₂) := by
      simpa [X, P] using hP.2.1
    letI : Finite (tateZero X.X₃) := by
      simpa [X, Z] using hZ.1
    letI : Finite (tateNegOne X.X₃) := by
      simpa [X, Z] using hZ.2.1

                  A.eval q * B.eval q) *
              SPFactora.listEval q S := by
            simp [mul_assoc]
        _ =
            SPFactora.listEval q P *
                (B.eval q * A.eval q) *
              SPFactora.listEval q S := by
            rw [C.list_mul_swap]
        _ =
            SPFactora.listEval (n := n) q
              (P ++ [B, A] ++ S) := by
            simp [mul_assoc]


/-- The Euclidean plane used in the public statement. -/
abbrev Plane := EuclideanSpace ℝ (Fin 2)

/-- The nonzero distances determined by a finite point set. -/
noncomputable def distinctDistances (S : Finset Plane) : Finset ℝ :=

  let := Fintype.ofFinite V
  let := Fintype.ofFinite κ
  classical
  let a : ℝ :=
    (componentSideCount T Sseed col c (D.root c) false : ℕ)
  let b : ℝ :=
    (componentSideCount T Sseed col c (D.root c) true : ℕ)

theorem lt_dyadicCeil (n : ℕ) : n < dyadicCeil n := by
  simpa [dyadicCeil, dyadicCeilExponent, Nat.succ_eq_add_one] using
    (Nat.lt_pow_succ_log_self (by norm_num : 1 < (2 : ℕ)) n)


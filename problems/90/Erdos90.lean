    {x y : G}
    (hcomm : Commute y ⁅x, y⁆) :
    ∀ n : ℕ, ⁅x, y ^ n⁆ = ⁅x, y⁆ ^ n := by
  intro n
  induction n with
  | zero =>
      simp
  | succ n ih =>
      rw [commutator_element_succ, ih]
      have hconj :
          y ^ n * ⁅x, y⁆ * (y ^ n)⁻¹ = ⁅x, y⁆ := by
        rw [(hcomm.pow_left n).eq, mul_inv_cancel_right]

        2 * (Real.sqrt (q : ℝ) * Real.log (q : ℝ)) := by
    calc
      (Real.sqrt (q : ℝ) * Real.log (q : ℝ)) / sigma =
          (1 / sigma) *
            (Real.sqrt (q : ℝ) * Real.log (q : ℝ)) := by ring
      _ ≤ 2 * (Real.sqrt (q : ℝ) * Real.log (q : ℝ)) :=
        mul_le_mul_of_nonneg_right hinv hscale

theorem PSRel.existsaug_layerprefix_rankdatafin
    {p d k : ℕ} {Q : Type u} [Group Q]
    (S : PSRel p d k Q)
    [Finite S.target] :
    ∃ (B : ℕ) (a : ℕ → ℕ),

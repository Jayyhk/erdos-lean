              ∑ ψ : primitiveCharacters d,
                primitiveCenteredEndpointMaximum x d ψ := by
      simpa [T, F] using hbij.trans hsum.symm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro d _hd
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k _hk
      rw [mul_comm]

/-- The large-conductor mass is bounded by the normalized raw primitive mean

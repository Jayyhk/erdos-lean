  -- inner function is the eta-contracted `centeredProgressionDiscrepancy y q`,
  -- which the three-argument equation lemma cannot match, so it is closed by
  -- definitional unfolding instead.
  simp_rw [maxCenteredProgressionDiscrepancy, dif_pos hq]
  rfl


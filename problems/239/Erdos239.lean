    {f : ℕ → ℂ} (hmul : IsMultiplicativeOnPositiveNat f)
    (Q : ℕ → Prop) [DecidablePred Q] :
    IsMultiplicativeOnPositiveNat (gsDeletePrimeBand f Q) := by
  exact primeBandCoefficient_isMultiplicativeOnPositiveNat hmul _


  let r := completionPlaceReturn v w0 w
  have hr : r • w = w0 := place_return_smul v w0 w
  have hr_inv : r⁻¹ • w0 = w := by
    rw [← hr]
    simp
  let theta : CompletionPlaceStabilizer v w0 :=
    ⟨sigma * r⁻¹, by
      change (sigma * r⁻¹) • w0 = w0
      rw [mul_smul, hr_inv]

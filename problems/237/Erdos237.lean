              (v r * (starRingEnd ℂ) (v s)) := by ring
        _ = phase ((n : ℝ) * (y r - y s)) *
              (v r * (starRingEnd ℂ) (v s)) := by rw [← hphase]
        _ = v r * (starRingEnd ℂ) (v s) *
              phase ((n : ℝ) * (y r - y s)) := by ring


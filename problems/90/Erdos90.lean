      let parentRoute :=
        factory.semantic_sharp_normalizer
          sharp prefixRoute.higherSource
            prefixRoute.higher_least_succ [B] (by
              intro x hx
              rcases List.mem_singleton.mp hx with rfl
              exact hB)

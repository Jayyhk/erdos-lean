    dsimp only [E, ρ, S, hS, e, P, B, UO, VG, U, O, G, Z, τ, γ, ν,
      θ, p, s, q, T, L, vO, wO, full, base] at htranslated ⊢
    exact htranslated
  change
    (∫ ω, (fderiv ℝ (convexSetCutoff A ε)
        ((p • UO ω + s • VG ω) + (p • O ω + s • G ω)))
        ((-s) • O ω + p • G ω) ∂ρ) =
      ∫ t in (0 : ℝ)..1, ∫ r in (0 : ℝ)..1, ∫ z,

open ArithmeticFunction Complex

private lemma four_factor_character_phase_nonneg
    {N n : ℕ} (chi1 chi2 : DirichletCharacter ℂ N)
    (hsquare1 : chi1 ^ 2 = 1) (hsquare2 : chi2 ^ 2 = 1) :

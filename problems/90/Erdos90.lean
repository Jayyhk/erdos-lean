-- Merged from JacobiIntegralPowerStrictTailCutoffAffineRouteProfile.lean

/-!
# Affine cutoff profiles for stable Hall-Witt routing

Stable routing is naturally stateful: process a source prefix against an
already-routed higher suffix.  Below cutoff, each selected word applies the
linear move operator `1 + C`, while each unselected word adds one retained
singleton profile.  Therefore every fixed source packet compiles to one affine
transformation of cutoff profiles.

This file keeps the literal ordered trace and its multiplicity shadow linked.
In particular, routing a repeated fixed packet is iteration of one fixed
affine profile transformation.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace ARProfa

open CWTrace
open WSTrace
open NPTail
open TBProf

/--
Route one source prefix onto an already-routed higher suffix.  Unlike
`stableRoute`, the selected suffix is deliberately omitted: this is exactly
the state transformer underlying the first component of stable routing.
-/
def routeOnto
    (isCurrent : CWord Atom → Bool) :
    List (CWord Atom) →
      List (CWord Atom) →
        List (CWord Atom)
  | [], rights =>
      rights
  | word :: words, rights =>
      let routed := routeOnto isCurrent words rights
      if isCurrent word = true then
        moveHigherTrace word routed
      else
        word :: routed

/-- Routing onto a suffix composes across source concatenation. -/
lemma routeOnto_append
    (isCurrent : CWord Atom → Bool)
    (left right rights : List (CWord Atom)) :
    routeOnto isCurrent (left ++ right) rights =
      routeOnto isCurrent left (routeOnto isCurrent right rights) := by
  induction left with
  | nil =>
      rfl
  | cons word left ih =>
      simp only [List.cons_append, routeOnto]
      rw [ih]

/-- The first component of stable routing is routing onto the empty higher
suffix. -/
lemma stable_fst_nil
    (isCurrent : CWord Atom → Bool)
    (source : List (CWord Atom)) :
    (stableRoute isCurrent source).1 =
      routeOnto isCurrent source [] := by
  induction source with
  | nil =>
      rfl
  | cons word source ih =>
      simp only [stableRoute, routeOnto]
      rw [ih]
      split <;> rfl

/-- Cutoff profiles turn concatenation into addition. -/
lemma cutoffProfile_append
    (cutoff : ℕ)
    (left right : List (CWord Atom)) :
    cutoffProfile cutoff (left ++ right) =
      cutoffProfile cutoff left + cutoffProfile cutoff right := by
  unfold cutoffProfile
  simp [
    RMRecb.unitBelowTrace]

/-- One affine transformation of cutoff multiplicity profiles. -/
structure CPAffine where
  linear :
    AddMonoid.End (Multiset (CWord Atom))
  constant :
    Multiset (CWord Atom)

namespace CPAffine

/-- Evaluate one affine cutoff-profile transformation. -/
def apply
    (transform : CPAffine)
    (source : Multiset (CWord Atom)) :
    Multiset (CWord Atom) :=
  transform.linear source + transform.constant

/-- Identity affine transformation. -/
def one :
    CPAffine where
  linear := 1
  constant := 0

/-- Composition of affine transformations, with `outer` applied last. -/
def comp
    (outer inner : CPAffine) :
    CPAffine where
  linear := outer.linear * inner.linear
  constant := outer.linear inner.constant + outer.constant

@[simp]
lemma apply_one
    (source : Multiset (CWord Atom)) :
    one.apply source = source := by
  simp [apply, one]

@[simp]
lemma apply_comp
    (outer inner : CPAffine)
    (source : Multiset (CWord Atom)) :
    (outer.comp inner).apply source =
      outer.apply (inner.apply source) := by
  simp [apply, comp, add_assoc]

@[simp]
lemma one_comp
    (transform : CPAffine) :
    one.comp transform = transform := by
  cases transform
  simp [one, comp]

@[simp]
lemma comp_one
    (transform : CPAffine) :
    transform.comp one = transform := by
  cases transform
  simp [one, comp]

lemma comp_assoc
    (outer middle inner : CPAffine) :
    (outer.comp middle).comp inner =
      outer.comp (middle.comp inner) := by
  cases outer
  cases middle
  cases inner
  simp [comp, mul_assoc, add_assoc]

/-- Affine action of one selected current word. -/
def selected
    (cutoff : ℕ)
    (word : CWord Atom) :
    CPAffine where
  linear := moveEnd cutoff word
  constant := 0

/-- Affine action of one retained unselected word. -/
def retained
    (cutoff : ℕ)
    (word : CWord Atom) :
    CPAffine where
  linear := 1
  constant := cutoffProfile cutoff [word]

@[simp]
lemma apply_selected
    (cutoff : ℕ)
    (word : CWord Atom)
    (source : Multiset (CWord Atom)) :
    (selected cutoff word).apply source =
      moveEnd cutoff word source := by
  simp [apply, selected]

@[simp]
lemma apply_retained
    (cutoff : ℕ)
    (word : CWord Atom)
    (source : Multiset (CWord Atom)) :
    (retained cutoff word).apply source =
      cutoffProfile cutoff [word] + source := by
  simp [apply, retained, add_comm]

/-- Compile one literal source trace to its affine cutoff-profile
transformation. -/
def ofTrace
    (cutoff : ℕ)
    (isCurrent : CWord Atom → Bool) :
    List (CWord Atom) →
      CPAffine
  | [] =>
      one
  | word :: words =>
      (if isCurrent word = true then
          selected cutoff word
        else
          retained cutoff word).comp
        (ofTrace cutoff isCurrent words)

/-- Compiling a concatenated trace composes the compiled affine actions. -/
lemma ofTrace_append
    (cutoff : ℕ)
    (isCurrent : CWord Atom → Bool)
    (left right : List (CWord Atom)) :
    ofTrace cutoff isCurrent (left ++ right) =
      (ofTrace cutoff isCurrent left).comp
        (ofTrace cutoff isCurrent right) := by
  induction left with
  | nil =>
      exact (one_comp (ofTrace cutoff isCurrent right)).symm
  | cons word left ih =>
      simp only [List.cons_append, ofTrace]
      rw [ih, comp_assoc]

/-- The affine compiler exactly computes the cutoff profile of literal
stateful routing. -/
lemma trace_cutoff_profile
    (cutoff : ℕ)
    (isCurrent : CWord Atom → Bool)
    (rights : List (CWord Atom)) :
    ∀ source : List (CWord Atom),
      (ofTrace cutoff isCurrent source).apply (cutoffProfile cutoff rights) =
        cutoffProfile cutoff (routeOnto isCurrent source rights)
  | [] => by
      exact apply_one (cutoffProfile cutoff rights)
  | word :: words => by
      by_cases hcurrent : isCurrent word = true
      · simp only [ofTrace, if_pos hcurrent, routeOnto, apply_comp,
          apply_selected]
        rw [trace_cutoff_profile cutoff isCurrent rights words,
          move_end_cutoff]
      · simp only [ofTrace, if_neg hcurrent, routeOnto, apply_comp,
          apply_retained]
        rw [trace_cutoff_profile cutoff isCurrent rights words]
        exact (cutoffProfile_append cutoff [word]
          (routeOnto isCurrent words rights)).symm

/-- Iteration of one fixed affine cutoff-profile transformation. -/
def iterate
    (transform : CPAffine) :
    ℕ → CPAffine
  | 0 =>
      one
  | steps + 1 =>
      transform.comp (iterate transform steps)

@[simp]
lemma apply_iterate_zero
    (transform : CPAffine)
    (source : Multiset (CWord Atom)) :
    (iterate transform 0).apply source = source := by
  exact apply_one source

/-- The compiled affine action computes the cutoff profile of the first
stable-routing component for every literal source trace. -/
lemma profile_stable_fst
    (cutoff : ℕ)
    (isCurrent : CWord Atom → Bool)
    (source : List (CWord Atom)) :
    cutoffProfile cutoff (stableRoute isCurrent source).1 =
      (ofTrace cutoff isCurrent source).apply 0 := by
  rw [stable_fst_nil,
    ← trace_cutoff_profile cutoff isCurrent [] source]
  rfl

end CPAffine

end ARProfa
end TCTex
end Submission

-- Merged from JacobiIntegralPowerStrictTailCutoffAffineRouteUnipotence.lean

/-!
# Unipotence of fixed-packet Hall-Witt cutoff routing

The linear part of a compiled stable-routing packet is unipotent modulo every
positive cutoff.  Recursively isolate its strict correction endomorphism `N`.
Every emitted term of `N` gains at least one unit of formal weight, and every
emitted term remains strictly below cutoff.  Consequently `N ^ cutoff = 0`.

This is the nilpotent engine behind polynomial iteration of fixed affine
Hall-Witt routing packets.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace ARUnipot

open CWTrace
open WSTrace
open RMRecb
open TBProf
open ARProfa
open ARProfa.CPAffine

/-- Additive endomorphisms of formal cutoff profiles. -/
abbrev ProfileEnd :=
  AddMonoid.End (Multiset (CWord Atom))

/-- Strict bracket-correction endomorphism from the cutoff binomial profile
layer. -/
abbrev strictCorrectionEnd :=
  TBProf.correctionEnd

/-- Every emitted term originates in an input term whose unit weight rises by
at least `increment`. -/
def RUWt
    (increment : ℕ)
    (transform : ProfileEnd) :
    Prop :=
  ∀ source emitted,
    emitted ∈ transform source →
      ∃ original ∈ source,
        original.weight (fun _ => 1) + increment ≤
          emitted.weight (fun _ => 1)

/-- Every emitted term lies strictly below one unit-weight cutoff. -/
def OBCutoff
    (cutoff : ℕ)
    (transform : ProfileEnd) :
    Prop :=
  ∀ source emitted,
    emitted ∈ transform source →
      emitted.weight (fun _ => 1) < cutoff

namespace RUWt

/-- The zero endomorphism vacuously raises weight by every amount. -/
lemma zero
    (increment : ℕ) :
    RUWt increment (0 : ProfileEnd) := by
  intro source emitted hemitted
  simp at hemitted

/-- The identity endomorphism preserves unit weight. -/
lemma one :
    RUWt 0 (1 : ProfileEnd) := by
  intro source emitted hemitted
  exact ⟨emitted, hemitted, by simp⟩

/-- A proven weight rise may be weakened. -/
lemma mono
    {smaller larger : ℕ}
    {transform : ProfileEnd}
    (hbound : smaller ≤ larger)
    (htransform : RUWt larger transform) :
    RUWt smaller transform := by
  intro source emitted hemitted
  rcases htransform source emitted hemitted with
    ⟨original, horiginal, hweight⟩
  exact ⟨original, horiginal, (Nat.add_le_add_left hbound _).trans hweight⟩

/-- Sums preserve a common lower weight rise. -/
lemma add
    {increment : ℕ}
    {left right : ProfileEnd}
    (hleft : RUWt increment left)
    (hright : RUWt increment right) :
    RUWt increment (left + right) := by
  intro source emitted hemitted
  change emitted ∈ left source + right source at hemitted
  rw [Multiset.mem_add] at hemitted
  rcases hemitted with hemitted | hemitted
  · exact hleft source emitted hemitted
  · exact hright source emitted hemitted

/-- Composition adds guaranteed weight rises. -/
lemma mul
    {leftIncrement rightIncrement : ℕ}
    {left right : ProfileEnd}
    (hleft : RUWt leftIncrement left)
    (hright : RUWt rightIncrement right) :
    RUWt (leftIncrement + rightIncrement) (left * right) := by
  intro source emitted hemitted
  change emitted ∈ left (right source) at hemitted
  rcases hleft (right source) emitted hemitted with
    ⟨middle, hmiddle, hmiddleWeight⟩
  rcases hright source middle hmiddle with
    ⟨original, horiginal, horiginalWeight⟩
  refine ⟨original, horiginal, ?_⟩
  omega

/-- One strict bracket-correction endomorphism raises weight by the full
weight of its left input. -/
lemma correctionEnd
    (cutoff : ℕ)
    (left : CWord Atom) :
    RUWt (left.weight (fun _ => 1))
      (strictCorrectionEnd cutoff left) := by
  intro source emitted hemitted
  change emitted ∈
    (source.map (CWord.commutator left)).filter
      (fun word => word.weight (fun _ => 1) < cutoff) at hemitted
  rcases Multiset.mem_map.mp (Multiset.mem_filter.mp hemitted).1 with
    ⟨right, hright, rfl⟩
  exact
    ⟨right, hright, by
      simp [CWord.weight_commutator, Nat.add_comm]⟩

/-- Every strict bracket-correction endomorphism raises unit weight by at
least one. -/
lemma correctionEnd_one
    (cutoff : ℕ)
    (left : CWord Atom) :
    RUWt 1 (strictCorrectionEnd cutoff left) := by
  apply mono
  · exact
      CWord.weight_pos (fun _ => 1) (fun _ => by simp) left
  · exact RUWt.correctionEnd cutoff left

end RUWt

namespace OBCutoff

/-- The zero endomorphism vacuously has below-cutoff output. -/
lemma zero
    (cutoff : ℕ) :
    OBCutoff cutoff (0 : ProfileEnd) := by
  intro source emitted hemitted
  simp at hemitted

/-- Sums preserve below-cutoff output. -/
lemma add
    {cutoff : ℕ}
    {left right : ProfileEnd}
    (hleft : OBCutoff cutoff left)
    (hright : OBCutoff cutoff right) :
    OBCutoff cutoff (left + right) := by
  intro source emitted hemitted
  change emitted ∈ left source + right source at hemitted
  rw [Multiset.mem_add] at hemitted
  rcases hemitted with hemitted | hemitted
  · exact hleft source emitted hemitted
  · exact hright source emitted hemitted

/-- If the outer transform has below-cutoff output, so does a composition. -/
lemma mul_left
    {cutoff : ℕ}
    {left right : ProfileEnd}
    (hleft : OBCutoff cutoff left) :
    OBCutoff cutoff (left * right) := by
  intro source emitted hemitted
  exact hleft (right source) emitted hemitted

/-- Strict bracket-correction endomorphisms filter their output below cutoff. -/
lemma correctionEnd
    (cutoff : ℕ)
    (left : CWord Atom) :
    OBCutoff cutoff (strictCorrectionEnd cutoff left) := by
  intro source emitted hemitted
  change emitted ∈
    (source.map (CWord.commutator left)).filter
      (fun word => word.weight (fun _ => 1) < cutoff) at hemitted
  exact (Multiset.mem_filter.mp hemitted).2

end OBCutoff

/--
Strict correction part of the linear profile action compiled from one fixed
packet.  Selected words contribute one new outer bracket correction, while
retained words leave the linear correction part unchanged.
-/
def packetCorrectionEnd
    (cutoff : ℕ)
    (isCurrent : CWord Atom → Bool) :
    List (CWord Atom) →
      ProfileEnd
  | [] =>
      0
  | word :: words =>
      let tail := packetCorrectionEnd cutoff isCurrent words
      if isCurrent word = true then
        strictCorrectionEnd cutoff word * (tail + 1) + tail
      else
        tail

/-- The compiled linear action is identity plus its strict packet correction
endomorphism. -/
lemma trace_linear_end
    (cutoff : ℕ)
    (isCurrent : CWord Atom → Bool) :
    ∀ packet : List (CWord Atom),
      (ofTrace cutoff isCurrent packet).linear =
        packetCorrectionEnd cutoff isCurrent packet + 1
  | [] => by
      simp [ofTrace, packetCorrectionEnd, CPAffine.one]
  | word :: words => by
      by_cases hcurrent : isCurrent word = true
      · simp only [ofTrace, packetCorrectionEnd, hcurrent, if_pos, comp,
          selected]
        rw [trace_linear_end cutoff isCurrent
          words]
        simp only [moveEnd, add_mul, mul_add, one_mul]
        unfold strictCorrectionEnd
        simp only [add_assoc, add_comm, add_left_comm]
      · simp only [ofTrace, packetCorrectionEnd, hcurrent, comp,
          retained]
        rw [trace_linear_end cutoff isCurrent
          words]
        simp

/-- Every strict packet correction raises unit weight by at least one. -/
lemma packet_end_raises
    (cutoff : ℕ)
    (isCurrent : CWord Atom → Bool) :
    ∀ packet : List (CWord Atom),
      RUWt 1 (packetCorrectionEnd cutoff isCurrent packet)
  | [] => by
      exact RUWt.zero 1
  | word :: words => by
      by_cases hcurrent : isCurrent word = true
      · simp only [packetCorrectionEnd, hcurrent, if_pos]
        apply RUWt.add
        · apply RUWt.mono (show 1 ≤ 1 + 0 by omega)
          apply RUWt.mul
          · exact RUWt.correctionEnd_one cutoff word
          · apply RUWt.add
            · exact
                (packet_end_raises cutoff isCurrent
                  words).mono (show 0 ≤ 1 by omega)
            · exact RUWt.one
        · exact
            packet_end_raises cutoff isCurrent words
      · simpa [packetCorrectionEnd, hcurrent] using
          packet_end_raises cutoff isCurrent words

/-- Every strict packet correction emits only terms surviving the cutoff
filter. -/
lemma end_outputs_below
    (cutoff : ℕ)
    (isCurrent : CWord Atom → Bool) :
    ∀ packet : List (CWord Atom),
      OBCutoff cutoff (packetCorrectionEnd cutoff isCurrent packet)
  | [] => by
      exact OBCutoff.zero cutoff
  | word :: words => by
      by_cases hcurrent : isCurrent word = true
      · simp only [packetCorrectionEnd, hcurrent, if_pos]
        apply OBCutoff.add
        · exact
            OBCutoff.mul_left
              (OBCutoff.correctionEnd cutoff word)
        · exact end_outputs_below cutoff isCurrent words
      · simpa [packetCorrectionEnd, hcurrent] using
          end_outputs_below cutoff isCurrent words

end ARUnipot
end TCTex

      (δ := (1 : ℝ) / (Q : ℝ) ^ 2) hdelta
      (fun r s hrs => one_div_sq_le_dist_reducedFractionPoint hrs)
      m0 N c
    simp_rw [unitAddCircleAddChar_nsmul_reducedFractionPoint] at hlarge
    simpa only [inv_div, div_one] using hlarge


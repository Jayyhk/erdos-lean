              r * (placeLogScale (K := K) (L := L) S Q *
                f (upperPlacePrime (K := K) (L := L) S Q))) +
              ∑ w : InfinitePlace L, r * ((w.mult : ℝ) *
                f (infiniteUpperPlace
                  (K := K) (L := L) S hSinf w)) := by

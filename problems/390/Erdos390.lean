      intro r hr
      exact mul_le_mul_of_nonneg_left (hentry r hr) (abs_nonneg _)
    _ = CKernel * (1 / (p : ℝ)) *
          (∑ r ∈ primeBand B.sampleData.n B.sampleData.W,

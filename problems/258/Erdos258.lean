      rw [Finset.mul_sum]
    _ ≤ C * ∏ h : nearShifts K, varyingCoordinateMajorant K h :=
      mul_le_mul_of_nonneg_left (varyingTupleReciprocalWeightSum_le K) hC
    _ = _ := rfl





lemma address_strict_parent
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (hparent :
      exponentAddressParent x y z + 1 < n) :
    3 < n := by
  have hx :
      0 < x.weight PEAddres.weight :=
    CWord.weight_pos
      PEAddres.weight PEAddres.weight_pos x
  have hy :
      0 < y.weight PEAddres.weight :=
    CWord.weight_pos
      PEAddres.weight PEAddres.weight_pos y
  have hz :
      0 < z.weight PEAddres.weight :=
    CWord.weight_pos
      PEAddres.weight PEAddres.weight_pos z
  simp only [exponentAddressParent] at hparent
  omega

/-- Positive concrete Hall-coordinate recipes satisfy the sharp physical
repeated-block degree bound. -/
lemma parent_coordinates_physical
    (d n : ℕ)
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (inputWeight : ℕ)
    (hinputWeight : 0 < inputWeight)
    (hx : inputWeight ≤ x.weight PEAddres.weight)
    (hy : inputWeight ≤ y.weight PEAddres.weight)
    (hz : inputWeight ≤ z.weight PEAddres.weight)
    (hparent :
      exponentAddressParent x y z + 1 < n)
    (i : AddressParentIndex d x y z) :
    IVMost
      (fun multiplicity : ℕ =>
        concreteParentCoordinates
          d n x y z n multiplicity hparent i)
      ((exponentAddressParent x y z + 1) /
        inputWeight) := by
  have hcutoff :
      3 < n :=
    address_strict_parent
      x y z hparent
  rw [show
    (fun multiplicity : ℕ =>
      concreteParentCoordinates
        d n x y z n multiplicity hparent i) =
      fun multiplicity : ℕ =>
        addressParentCoordinate x y z
          (concreteParentBasis
            d n x y z hparent) i
          (TBluepr.lowerCentralClass
            (exponentAddressParent x y z)
            (addressBelowTerms
              (n := n) x y z n (Int.ofNat multiplicity)).prod) by
    funext multiplicity
    unfold concreteParentCoordinates
    exact congrFun
      (address_parent_basis
        d n x y z n hcutoff hparent i) multiplicity]
  exact
    lowerPolyPhysical
      x y z n inputWeight hcutoff hinputWeight hx hy hz
        (addressParentCoordinate x y z

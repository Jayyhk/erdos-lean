      IntervalIntegrable (fun t : ℝ => G ((t : ℂ) + z.im * I))
        volume z.re w.re := by
    apply intervalIntegrable_horizontal_principalPartSum P c
    intro rho hrho
    exact ne_of_lt (hP rho hrho).2.2.1

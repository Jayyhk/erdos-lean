    Group (CExt f) :=
  Group.ofLeftAxioms
    (fun x y z ↦ by
      apply Prod.ext
      · change
          (x.1 * (x.2 • y.1) * f (x.2, y.2)) *
                ((x.2 * y.2) • z.1) * f (x.2 * y.2, z.2) =
            x.1 * (x.2 • (y.1 * (y.2 • z.1) * f (y.2, z.2))) *
              f (x.2, y.2 * z.2)
        rw [mul_smul]
        simp only [smul_mul']
        have hcocycle := hf x.2 y.2 z.2
        calc
          x.1 * (x.2 • y.1) * f (x.2, y.2) * (x.2 • y.2 • z.1) *
                f (x.2 * y.2, z.2) =

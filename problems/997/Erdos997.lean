        (fun n : ℕ =>
          abstractVolterraIncrement M n / (Real.log n - F)^2) := by
      filter_upwards [hlog.eventually (eventually_gt_atTop F)] with n hn
      have hn0 : Real.log n ≠ 0 := ne_of_gt (hF.trans hn)
      have hnF : Real.log n - F ≠ 0 := ne_of_gt (sub_pos.mpr hn)

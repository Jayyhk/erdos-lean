namespace Submission.CField.LBrauer

noncomputable section

open ValuativeRel IsLocalRing

variable (K : Type u)
  [NontriviallyNormedField K] [IsUltrametricDist K] [ValuativeRel K]
  [IsNonarchimedeanLocalField K]

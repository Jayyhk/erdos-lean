noncomputable def brauerDataSupport
    (K : Type u) [Field K] [NumberField K]
    (hfinite : GlobalChangeSupport K) :
    BData K where
  localization := globalBrauerLocalization K hfinite
  localizeAt_eq _ _ := rfl
  placeInvariant := placeInvariantData K


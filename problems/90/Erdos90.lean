/-- Ordered-subsequence multiplicity across the flattened crossing schedules of
a fixed carried trace has degree controlled by the requested transition
carried weights and the fixed trace length. -/
lemma multFlatCarried
    (cutoff : ℕ)
    (outer selected : CWord Atom)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true) :
    ∀ (trace : List (CWord Atom))
      (target : List SRTrans),
      IVMost
        (fun steps : ℕ =>
          (orderedSubsequenceMultiplicity target
            (trace.flatMap fun right =>
              depthCrossingSchedule cutoff outer selected right
                steps) : ℤ))
        ((target.map secondRouteCarried).sum + trace.length)
  | [], target => by
      simpa using
        valued_most_constant
          ((target.map secondRouteCarried).sum)
          (orderedSubsequenceMultiplicity target [] : ℤ)
  | right :: trace, target => by
      rw [show
        (fun steps : ℕ =>
          (orderedSubsequenceMultiplicity target
            ((right :: trace).flatMap fun next =>
              depthCrossingSchedule cutoff outer selected next
                steps) : ℤ)) =
          fun steps : ℕ =>
            ∑ suffix ∈ target.tails.toFinset,
              (orderedSubsequenceMultiplicity
                (target.take (target.length - suffix.length))
                (depthCrossingSchedule cutoff outer selected
                  right steps) : ℤ) *
              (orderedSubsequenceMultiplicity suffix
                (trace.flatMap fun next =>
                  depthCrossingSchedule cutoff outer selected
                    next steps) : ℤ) by
        funext steps
        exact_mod_cast
          subsequence_append_tails
            target
              (depthCrossingSchedule cutoff outer selected right
                steps)
              (trace.flatMap fun next =>
                depthCrossingSchedule cutoff outer selected next
                  steps)]
      apply IVMost.finsetSum
      intro suffix hsuffix
      have hdegree :
          ((target.take (target.length - suffix.length)).map
              secondRouteCarried).sum + 1 +
              ((suffix.map secondRouteCarried).sum +
                trace.length) ≤
            (target.map secondRouteCarried).sum +
              (right :: trace).length := by
        have hsuffixMem :
            suffix <:+ target :=
          (List.mem_tails suffix target).mp
            (List.mem_toFinset.mp hsuffix)
        rcases hsuffixMem with ⟨initial, htarget⟩
        subst target
        simp only [List.length_append, Nat.add_sub_cancel_right,
          List.take_append_of_le_length (Nat.le_refl initial.length),
          List.take_length, List.map_append, List.sum_append, List.length_cons]
        omega
      apply
        TCTex.IVMost.mono
      · exact hdegree
      · exact
          TCTex.IVMost.mul
            (multCrossingCarried
              cutoff outer selected right hselected
                (target.take (target.length - suffix.length)))
            (multFlatCarried
              cutoff outer selected hselected trace suffix)


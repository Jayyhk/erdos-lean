    calc
      (2 : ℝ) ≤ p := hp2
      _ = (p : ℝ) ^ (1 : ℝ) := by rw [Real.rpow_one]
      _ ≤ (p : ℝ) ^ s.re :=
        Real.rpow_le_rpow_of_exponent_le hp1 hs
  rw [Complex.norm_natCast_cpow_of_pos hp.pos, neg_re,
    Real.rpow_neg (Nat.cast_nonneg p)]

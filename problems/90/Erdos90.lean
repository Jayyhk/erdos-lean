    adicCompletionAlgebra (K := K) (L := L) P hP Q
  letI : q.asIdeal.LiesOver P.asIdeal := by
    constructor
    exact (congrArg HeightOneSpectrum.asIdeal
      (upperPrime_under (K := K) (L := L) P Q)).symm

    (hinitialGapMeetsLocalCarrierOnly :
      ∀ i (t : {t : ℝ // t ∈ centerParams i})
        ⦃p : EuclideanSpace ℝ (Fin 2)⦄,
        p ∈ segment ℝ (a i) (entryPoint i t) →
          p ∈ (localArcAtParam i t).carrier → p = entryPoint i t)
    (hterminalGapMeetsLocalCarrierOnly :
      ∀ i (t : {t : ℝ // t ∈ centerParams i})

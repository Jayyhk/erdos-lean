      _ ≤ (120 * (A : ℝ)) * (6 * Q ^ 2) :=
        mul_le_mul_of_nonneg_left hLR (by positivity)
      _ = 720 * (A : ℝ) * Q ^ 2 := by ring
  have hTpos : 0 < T := by linarith
  have hratio : (1 : ℝ) ≤ x / T :=
    (le_div_iff₀ hTpos).2 (by simpa using hTx)
  calc
    _ ≤ 720 * (A : ℝ) * Q ^ 2 := hsource
    _ ≤ (720 * (A : ℝ) * Q ^ 2) * (x / T) :=
      le_mul_of_one_le_right (by positivity) hratio

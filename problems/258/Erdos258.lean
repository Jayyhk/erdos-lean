theorem incompatibleSum_eq_neg_nontrivialAuxiliaryMobiusSum
    {H : Finset ℕ} {R W : ℕ} {D : Finset (H → ℕ)}
    {lambda : (H → ℕ) → ℝ}
    (hD : ∀ d ∈ D, IsMaynardDivisorTuple H R W d) :
    incompatibleDivisorPairCommonDivisorTupleSum H D lambda =

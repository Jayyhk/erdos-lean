      ∀ {r : ℕ} {a : denseGroupAlgebra p G},
        a ∈ W.J r →
          conjGA p G x a - a ∈ W.J (r + w))
    {a b : denseGroupAlgebra p G}
    (ha : a ∈ cyclicExtendJ W.J x w r)
    (hb : b ∈ cyclicExtendJ W.J x w s) :
    a * b ∈ cyclicExtendJ W.J x w (r + s) := by

        exact congrArg (fun r : ℝ => r ^ c) hzBase.symm
      _ = w.1 (algebraMap K L x) := congrFun hpow _
      _ = v.1 x := hwBase
  have hc1 : c = 1 :=
    (Real.rpow_right_inj hvx hx1).mp hbase
  apply AbsoluteValue.ext
  intro y
  have hy := congrFun hpow y
  simpa [hc1] using hy


  rw [coordinates.factors_higher_tail higher hcoordinates hhigher
      hlowerWeightPos hlowerWeightCutoff,
    coordinates.append_no_below
      hcoordinates hlowerWeightPos hlowerWeightCutoff,
    SPFactora.listEval_append,
    SPFactora.listEval_append,
    hhigherEval q,
    SPFactora.listEval_append,
    SPFactora.listEval_append]
  simp [mul_assoc]


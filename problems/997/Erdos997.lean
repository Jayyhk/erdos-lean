        h2 (Nat.Coprime.of_dvd_right (Nat.dvd_lcm_right q1 q) h)
      have hpzero : DirichletCharacter.mul chi1 chi n = 0 :=
        MulChar.map_nonunit _ (by
          simpa [ZMod.isUnit_iff_coprime] using hlcm)
      have hzero : chi n = 0 :=

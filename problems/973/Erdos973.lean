import Mathlib

namespace Erdos973

/-
# Erdős Problem 973

Does there exist a constant $C>1$ such that, for every $n\geq 2$, there exists a sequence
$z_i\in \mathbb{C}$ with $z_1=1$ and $\lvert z_i\rvert \geq 1$ for all $1\leq i\leq n$ with
$$\max_{2\leq k\leq n+1}\left\lvert \sum_{1\leq i\leq n}z_i^k\right\rvert < C^{-n}?$$

The answer is **no**, shown by Luo, Yang and Zhu (arXiv:2607.22017). `erdos_973` negates
`OriginalStatement`, a copy of the statement in `formal-conjectures`. The development also
proves a stronger uniform bound (`eventually_exterior_power_sum_lower_bound`): for each fixed
$C > 1$ and all large $n$, every choice of $n$ points with $\lvert z_i\rvert \geq 1$ has some
power sum of order $2 \leq k \leq n+1$ of size greater than $C^{-n}$. The proof follows the
residual-polynomial method of Tan, Wang, Huang and Chen (arXiv:2608.02043).

Formalised by Linmiao Xu in `linrock/math-proofs` (`erdos-973`); the eleven modules forming the
closure of `erdos_973` are flattened here in dependency order. The final theorem is renamed from
upstream `not_erdos_973`, and the restatement `erdos_973_false` after it is omitted so that
`erdos_973` is the last declaration.

Note that erdosproblems.com still lists this problem as open, pending human review of the
argument; what is recorded here is the machine-checked Lean development.

Declarations that `erdos_973` does not depend on have been removed.
-/

/-! ### Upstream module `NewtonBridge973.lean` -/

/-!
# The algebraic projected-Newton bridge for Erdős problem 973

All point configurations in this file are finite; points need not be distinct,
nonzero, or exterior.  No analytic lower bound is assumed or proved here.
-/

noncomputable section

open _root_.Polynomial

variable {ι : Type*}

/-- The reciprocal-root polynomial generated by a finite point configuration. -/
def rootPolynomial (s : Finset ι) (z : ι → ℂ) : ℂ[X] :=
  ∏ i ∈ s, (1 - C (z i) * X)

/-- A power sum with the same multiplicities and index set as `rootPolynomial`. -/
def powerSum (s : Finset ι) (z : ι → ℂ) (k : ℕ) : ℂ :=
  ∑ i ∈ s, z i ^ k

/-- The differential residual with its constant coefficient removed. -/
def residual (P : ℂ[X]) : ℂ[X] :=
  P.derivative - C (P.derivative.eval 0) * P

private def geometricSeries (z : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun k => z ^ k

private theorem factor_mul_geometricSeries (z : ℂ) :
    (1 - PowerSeries.C z * PowerSeries.X) * geometricSeries z = 1 := by
  ext k
  cases k with
  | zero => simp [geometricSeries, sub_mul, mul_assoc]
  | succ k => simp [geometricSeries, sub_mul, mul_assoc, pow_succ']

@[simp] theorem rootPolynomial_eval_zero (s : Finset ι) (z : ι → ℂ) :
    (rootPolynomial s z).eval 0 = 1 := by
  simp [rootPolynomial, Polynomial.eval_prod]

@[simp] theorem rootPolynomial_coeff_zero (s : Finset ι) (z : ι → ℂ) :
    (rootPolynomial s z).coeff 0 = 1 := by
  simpa only [Polynomial.coeff_zero_eq_eval_zero] using rootPolynomial_eval_zero s z

theorem rootPolynomial_natDegree_le (s : Finset ι) (z : ι → ℂ) :
    (rootPolynomial s z).natDegree ≤ s.card := by
  calc
    (rootPolynomial s z).natDegree ≤
        ∑ i ∈ s, (1 - C (z i) * X : ℂ[X]).natDegree :=
      Polynomial.natDegree_prod_le _ _
    _ ≤ ∑ _i ∈ s, 1 := by
      apply Finset.sum_le_sum
      intro i hi
      exact (Polynomial.natDegree_sub_le _ _).trans (max_le (by simp)
        ((Polynomial.natDegree_C_mul_le _ _).trans (by simp)))
    _ = s.card := by simp

theorem differential_residual_natDegree_le (G : ℂ[X]) (mu : ℂ) :
    (G.derivative - C mu * G).natDegree ≤ G.natDegree := by
  exact (Polynomial.natDegree_sub_le _ _).trans (max_le
    ((Polynomial.natDegree_derivative_le _).trans (Nat.sub_le _ _))
    (Polynomial.natDegree_C_mul_le _ _))

theorem residual_natDegree_le (P : ℂ[X]) :
    (residual P).natDegree ≤ P.natDegree := by
  exact differential_residual_natDegree_le P (P.derivative.eval 0)

private theorem rootPolynomial_derivative_series (s : Finset ι) (z : ι → ℂ) :
    ((rootPolynomial s z).derivative : PowerSeries ℂ) =
      -(rootPolynomial s z : PowerSeries ℂ) *
        ∑ i ∈ s, PowerSeries.C (z i) * geometricSeries (z i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [rootPolynomial]
  | @insert a s ha ih =>
    have hP : rootPolynomial (insert a s) z =
        (1 - C (z a) * X) * rootPolynomial s z := by
      simp [rootPolynomial, ha]
    rw [hP, Polynomial.derivative_mul]
    simp only [Polynomial.derivative_sub, Polynomial.derivative_one,
      Polynomial.derivative_C_mul, Polynomial.derivative_X, mul_one, zero_sub,
      Polynomial.coe_add, Polynomial.coe_mul, Polynomial.coe_neg,
      Polynomial.coe_C, Polynomial.coe_sub, Polynomial.coe_one,
      Polynomial.coe_X, ih, Finset.sum_insert ha]
    have hg := factor_mul_geometricSeries (z a)
    linear_combination (rootPolynomial s z : PowerSeries ℂ) * PowerSeries.C (z a) * hg

/-- Newton's coefficient identity, including all degrees above the polynomial degree. -/
theorem rootPolynomial_derivative_coeff (s : Finset ι) (z : ι → ℂ) (m : ℕ) :
    (rootPolynomial s z).derivative.coeff m =
      -∑ j ∈ Finset.range (m + 1),
        (rootPolynomial s z).coeff j * powerSum s z (m + 1 - j) := by
  have h := congrArg (PowerSeries.coeff m) (rootPolynomial_derivative_series s z)
  simp only [Polynomial.coeff_coe] at h
  rw [PowerSeries.coeff_mul] at h
  simp only [map_neg, Polynomial.coeff_coe, map_sum,
    PowerSeries.coeff_C_mul, geometricSeries, PowerSeries.coeff_mk, neg_mul] at h
  rw [Finset.sum_neg_distrib] at h
  rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk] at h
  convert h using 1
  congr 1
  apply Finset.sum_congr rfl
  intro j hj
  have hjm : j ≤ m := Nat.le_of_lt_succ (Finset.mem_range.mp hj)
  simp only [powerSum]
  rw [show m + 1 - j = (m - j) + 1 by omega]
  simp only [pow_succ']

@[simp] theorem rootPolynomial_derivative_eval_zero (s : Finset ι) (z : ι → ℂ) :
    (rootPolynomial s z).derivative.eval 0 = -powerSum s z 1 := by
  rw [← Polynomial.coeff_zero_eq_eval_zero, rootPolynomial_derivative_coeff]
  simp

/-- The projected identity excludes exactly the first power sum. -/
theorem residual_rootPolynomial_coeff (s : Finset ι) (z : ι → ℂ) (m : ℕ) :
    (residual (rootPolynomial s z)).coeff m =
      -∑ j ∈ Finset.range m,
        (rootPolynomial s z).coeff j * powerSum s z (m + 1 - j) := by
  rw [residual, Polynomial.coeff_sub, Polynomial.coeff_C_mul,
    rootPolynomial_derivative_eval_zero, rootPolynomial_derivative_coeff,
    Finset.sum_range_succ]
  rw [show m + 1 - m = 1 by omega]
  ring

/-- Solving the projected identity for its highest power sum. -/
theorem powerSum_eq_residual_recurrence (s : Finset ι) (z : ι → ℂ) (m : ℕ) :
    powerSum s z (m + 2) =
      -(residual (rootPolynomial s z)).coeff (m + 1) -
        ∑ j ∈ Finset.range m,
          (rootPolynomial s z).coeff (j + 1) * powerSum s z (m + 1 - j) := by
  have h := residual_rootPolynomial_coeff s z (m + 1)
  rw [Finset.sum_range_succ'] at h
  simp only [rootPolynomial_coeff_zero, Nat.sub_zero, one_mul] at h
  have hs : (∑ j ∈ Finset.range m,
      (rootPolynomial s z).coeff (j + 1) * powerSum s z (m + 1 + 1 - (j + 1))) =
      ∑ j ∈ Finset.range m,
        (rootPolynomial s z).coeff (j + 1) * powerSum s z (m + 1 - j) := by
    apply Finset.sum_congr rfl
    intro j hj
    rw [show m + 1 + 1 - (j + 1) = m + 1 - j by omega]
  rw [hs] at h
  linear_combination h

/-- A coefficientwise bound using only the requested powers `2,...,n+1`. -/
theorem residual_rootPolynomial_coeff_norm_le (s : Finset ι) (z : ι → ℂ)
    (n m : ℕ) (M : ℝ)
    (hM : ∀ k ∈ Finset.Icc 2 (n + 1), ‖powerSum s z k‖ ≤ M)
    (hm : m ≤ n) :
    ‖(residual (rootPolynomial s z)).coeff m‖ ≤
      M * ∑ j ∈ Finset.range m, ‖(rootPolynomial s z).coeff j‖ := by
  rw [residual_rootPolynomial_coeff, norm_neg]
  calc
    ‖∑ j ∈ Finset.range m,
        (rootPolynomial s z).coeff j * powerSum s z (m + 1 - j)‖ ≤
        ∑ j ∈ Finset.range m,
          ‖(rootPolynomial s z).coeff j * powerSum s z (m + 1 - j)‖ :=
      norm_sum_le _ _
    _ ≤ ∑ j ∈ Finset.range m, M * ‖(rootPolynomial s z).coeff j‖ := by
      apply Finset.sum_le_sum
      intro j hj
      have hjm := Finset.mem_range.mp hj
      rw [norm_mul, mul_comm M]
      exact mul_le_mul_of_nonneg_left (hM _ (Finset.mem_Icc.mpr (by omega)))
        (norm_nonneg _)
    _ = _ := by rw [Finset.mul_sum]

/-- A common coefficient bound controls every residual coefficient. -/
theorem residual_rootPolynomial_coeff_norm_le_of_bound
    (s : Finset ι) (z : ι → ℂ) (n m : ℕ) (M A : ℝ)
    (hM0 : 0 ≤ M)
    (hM : ∀ k ∈ Finset.Icc 2 (n + 1), ‖powerSum s z k‖ ≤ M)
    (hA : ∀ j ≤ n, ‖(rootPolynomial s z).coeff j‖ ≤ A)
    (hm : m ≤ n) :
    ‖(residual (rootPolynomial s z)).coeff m‖ ≤ (n : ℝ) * M * A := by
  have hA0 : 0 ≤ A := (norm_nonneg _).trans (hA 0 (Nat.zero_le _))
  calc
    ‖(residual (rootPolynomial s z)).coeff m‖ ≤
        M * ∑ j ∈ Finset.range m, ‖(rootPolynomial s z).coeff j‖ :=
      residual_rootPolynomial_coeff_norm_le s z n m M hM hm
    _ ≤ M * ∑ _j ∈ Finset.range m, A := by
      apply mul_le_mul_of_nonneg_left _ hM0
      exact Finset.sum_le_sum fun j hj => hA j (by have := Finset.mem_range.mp hj; omega)
    _ = M * ((m : ℝ) * A) := by simp
    _ ≤ M * ((n : ℝ) * A) := by
      gcongr
    _ = _ := by ring

/-- A maximal-coefficient argument bounds the omitted first power sum.
No Bernstein inequality, exterior condition, or analytic theorem is used. -/
theorem powerSum_one_norm_le
    (s : Finset ι) (z : ι → ℂ) (n : ℕ) (M : ℝ)
    (hs : s.card ≤ n) (hM0 : 0 ≤ M)
    (hM : ∀ k ∈ Finset.Icc 2 (n + 1), ‖powerSum s z k‖ ≤ M) :
    ‖powerSum s z 1‖ ≤ (n : ℝ) + n * M := by
  obtain ⟨k, hk, hmax⟩ :=
    (Finset.range (n + 1)).exists_max_image
      (fun j => ‖(rootPolynomial s z).coeff j‖) (by simp)
  have hkn : k ≤ n := by have := Finset.mem_range.mp hk; omega
  let A : ℝ := ‖(rootPolynomial s z).coeff k‖
  have hA : ∀ j ≤ n, ‖(rootPolynomial s z).coeff j‖ ≤ A := by
    intro j hj
    exact hmax j (Finset.mem_range.mpr (by omega))
  have hA1 : 1 ≤ A := by simpa using hA 0 (Nat.zero_le n)
  have hA0 : 0 < A := lt_of_lt_of_le zero_lt_one hA1
  have hd : ‖(rootPolynomial s z).derivative.coeff k‖ ≤ (n : ℝ) * A := by
    by_cases hkn' : k < n
    · rw [Polynomial.coeff_derivative, norm_mul, ← Nat.cast_add_one,
        Complex.norm_natCast, mul_comm (n : ℝ)]
      exact mul_le_mul (hA _ (by omega)) (by exact_mod_cast (show k + 1 ≤ n by omega))
        (by positivity) (by positivity)
    · have hzero : (rootPolynomial s z).coeff (k + 1) = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt
          (lt_of_le_of_lt ((rootPolynomial_natDegree_le s z).trans hs) (by omega))
      simp only [Polynomial.coeff_derivative, hzero, zero_mul, norm_zero]
      positivity
  have he := residual_rootPolynomial_coeff_norm_le_of_bound s z n k M A hM0 hM hA hkn
  have hmu :
      (rootPolynomial s z).derivative.eval 0 * (rootPolynomial s z).coeff k =
        (rootPolynomial s z).derivative.coeff k -
          (residual (rootPolynomial s z)).coeff k := by
    simp [residual]
  have hbound : ‖powerSum s z 1‖ * A ≤ ((n : ℝ) + n * M) * A := by
    calc
      ‖powerSum s z 1‖ * A =
          ‖(rootPolynomial s z).derivative.eval 0 * (rootPolynomial s z).coeff k‖ := by
        simp [A]
      _ ≤ ‖(rootPolynomial s z).derivative.coeff k‖ +
            ‖(residual (rootPolynomial s z)).coeff k‖ := by rw [hmu]; exact norm_sub_le _ _
      _ ≤ (n : ℝ) * A + n * M * A := add_le_add hd he
      _ = _ := by ring
  nlinarith

end
/-! ### Upstream module `PolynomialBounds973.lean` -/

section
/-!
# Polynomial estimates for the exterior power-sum problem

These estimates use the coefficient and boundary norms explicitly.  In particular,
no residual lower bound or unproved analytic input is assumed.
-/

open _root_.Polynomial _root_.Complex _root_.Set _root_.MeasureTheory

theorem norm_coeff_le_of_circle_bound (p : ℂ[X]) {S : ℝ}
    (hS : ∀ w : ℂ, ‖w‖ = 1 → ‖p.eval w‖ ≤ S) (k : ℕ) :
    ‖p.coeff k‖ ≤ S := by
  let : Fact (0 < 2 * Real.pi) := ⟨Real.two_pi_pos⟩
  rw [← p.fourierCoeff_toAddCircle_natCast k, fourierCoeff]
  have h : ∀ a : AddCircle (2 * Real.pi),
      ‖fourier (-(k : ℤ)) a • p.toAddCircle a‖ ≤ S := by
    intro a
    simp only [norm_smul, fourier_apply, Circle.norm_coe, one_mul]
    simpa [Polynomial.toAddCircle, Polynomial.aeval_continuousMap_apply] using
      hS (a.toCircle : ℂ) (Circle.norm_coe _)
  simpa using norm_integral_le_of_norm_le_const
    (μ := AddCircle.haarAddCircle) (Filter.Eventually.of_forall h)

theorem exists_circle_max (p : ℂ[X]) :
    ∃ τ : ℂ, ‖τ‖ = 1 ∧ ∀ w : ℂ, ‖w‖ = 1 → ‖p.eval w‖ ≤ ‖p.eval τ‖ := by
  obtain ⟨τ, hτ, hmax⟩ := (isCompact_sphere (0 : ℂ) 1).exists_isMaxOn
    (show (Metric.sphere (0 : ℂ) 1).Nonempty from ⟨1, by simp⟩)
    p.continuous.norm.continuousOn
  refine ⟨τ, by simpa using hτ, ?_⟩
  intro w hw
  exact hmax (by simpa using hw)

theorem exists_circle_max_ne_zero (p : ℂ[X]) (hp : p.coeff 0 = 1) :
    ∃ τ : ℂ, ‖τ‖ = 1 ∧ p.eval τ ≠ 0 ∧
      (∀ w : ℂ, ‖w‖ = 1 → ‖p.eval w‖ ≤ ‖p.eval τ‖) ∧
      (∀ k : ℕ, ‖p.coeff k‖ ≤ ‖p.eval τ‖) := by
  obtain ⟨τ, hτ, hmax⟩ := exists_circle_max p
  have hcoeff := norm_coeff_le_of_circle_bound p hmax
  refine ⟨τ, hτ, ?_, hmax, hcoeff⟩
  intro hz
  have := hcoeff 0
  norm_num [hp, hz] at this

theorem norm_eval_le_of_coeff_bound (p : ℂ[X]) {n : ℕ} {B : ℝ}
    (hn : p.natDegree ≤ n) (hB : ∀ k : ℕ, ‖p.coeff k‖ ≤ B)
    {w : ℂ} (hw : ‖w‖ ≤ 1) : ‖p.eval w‖ ≤ (n + 1 : ℝ) * B := by
  rw [p.eval_eq_sum_range' (show p.natDegree < n + 1 by omega) w]
  calc
    ‖∑ i ∈ Finset.range (n + 1), p.coeff i * w ^ i‖ ≤
        ∑ i ∈ Finset.range (n + 1), ‖p.coeff i * w ^ i‖ := norm_sum_le _ _
    _ ≤ ∑ _i ∈ Finset.range (n + 1), B := by
      apply Finset.sum_le_sum
      intro i hi
      rw [norm_mul, norm_pow]
      exact (mul_le_mul_of_nonneg_left (pow_le_one₀ (norm_nonneg _) hw) (norm_nonneg _)).trans
        (by simpa using hB i)
    _ = (n + 1 : ℝ) * B := by simp

theorem norm_taylor_one_coeff_le (p : ℂ[X]) {n : ℕ} {B : ℝ}
    (hn : p.natDegree ≤ n) (hB : ∀ k : ℕ, ‖p.coeff k‖ ≤ B) (k : ℕ) :
    ‖(Polynomial.taylor 1 p).coeff k‖ ≤ B * (n + 1 : ℝ) ^ (k + 1) := by
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  rw [Polynomial.taylor_coeff, Polynomial.hasseDeriv_apply, Polynomial.sum_def,
    Polynomial.eval_finsetSum]
  simp only [Polynomial.eval_monomial, one_pow, mul_one]
  calc
    ‖∑ i ∈ p.support, (i.choose k : ℂ) * p.coeff i‖ ≤
        ∑ i ∈ p.support, ‖(i.choose k : ℂ) * p.coeff i‖ := norm_sum_le _ _
    _ ≤ ∑ _i ∈ p.support, (n + 1 : ℝ) ^ k * B := by
      apply Finset.sum_le_sum
      intro i hi
      have hin : i ≤ n := (Polynomial.le_natDegree_of_mem_supp i hi).trans hn
      have hc : (i.choose k : ℝ) ≤ (n + 1 : ℝ) ^ k := by
        exact_mod_cast (Nat.choose_le_pow i k).trans
          (Nat.pow_le_pow_left (by omega : i ≤ n + 1) k)
      simpa only [norm_mul, Complex.norm_natCast] using
        mul_le_mul hc (hB i) (norm_nonneg _) (by positivity : 0 ≤ (n + 1 : ℝ) ^ k)
    _ ≤ (n + 1 : ℝ) * ((n + 1 : ℝ) ^ k * B) := by
      rw [Finset.sum_const, nsmul_eq_mul]
      apply mul_le_mul_of_nonneg_right ?_ (by positivity)
      have hc : p.support.card ≤ n + 1 := by
        simpa using Finset.card_le_card
          (show p.support ⊆ Finset.range (n + 1) from fun i hi =>
            Finset.mem_range.mpr (lt_of_le_of_lt
              ((Polynomial.le_natDegree_of_mem_supp i hi).trans hn) (Nat.lt_succ_self n)))
      exact_mod_cast hc
    _ = B * (n + 1 : ℝ) ^ (k + 1) := by ring

end

/-! ### Upstream module `Normalization973.lean` -/

/-!
# Boundary normalization for Erdős problem 973

Rotation to a maximum-modulus point and division by its nonzero value preserve
the root domain while controlling every coefficient of the polynomial and its
differential residual.  The estimates here are finite and algebraic once the
maximum point has been supplied.
-/

noncomputable section

open _root_.Polynomial

/-- Rotate and divide by the value at the chosen boundary point. -/
def boundaryNormalization (P : ℂ[X]) (tau : ℂ) : ℂ[X] :=
  C (P.eval tau)⁻¹ * P.comp (C tau * X)

/-- The constant coefficient in the rotated differential equation. -/
def normalizedMu (P : ℂ[X]) (tau : ℂ) : ℂ :=
  tau * P.derivative.eval 0

@[simp] theorem boundaryNormalization_eval (P : ℂ[X]) (tau w : ℂ) :
    (boundaryNormalization P tau).eval w = (P.eval tau)⁻¹ * P.eval (tau * w) := by
  simp [boundaryNormalization]

@[simp] theorem boundaryNormalization_eval_one (P : ℂ[X]) (tau : ℂ)
    (hval : P.eval tau ≠ 0) : (boundaryNormalization P tau).eval 1 = 1 := by
  simp [hval]

@[simp] theorem boundaryNormalization_coeff (P : ℂ[X]) (tau : ℂ) (k : ℕ) :
    (boundaryNormalization P tau).coeff k = (P.eval tau)⁻¹ * (P.coeff k * tau ^ k) := by
  simp [boundaryNormalization]

theorem boundaryNormalization_natDegree_le (P : ℂ[X]) (tau : ℂ) :
    (boundaryNormalization P tau).natDegree ≤ P.natDegree := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  simp [Polynomial.coeff_eq_zero_of_natDegree_lt hk]

theorem boundaryNormalization_coeff_norm_le_one (P : ℂ[X]) (tau : ℂ)
    (htau : ‖tau‖ = 1) (hval : P.eval tau ≠ 0)
    (hcoeff : ∀ k : ℕ, ‖P.coeff k‖ ≤ ‖P.eval tau‖) (k : ℕ) :
    ‖(boundaryNormalization P tau).coeff k‖ ≤ 1 := by
  have hnorm : 0 < ‖P.eval tau‖ := norm_pos_iff.mpr hval
  have h := (div_le_one₀ hnorm).mpr (hcoeff k)
  simpa [norm_mul, norm_inv, norm_pow, htau, div_eq_mul_inv, mul_comm] using h

theorem boundaryNormalization_residual (P : ℂ[X]) (tau : ℂ) :
    (boundaryNormalization P tau).derivative -
        C (normalizedMu P tau) * boundaryNormalization P tau =
      C (tau * (P.eval tau)⁻¹) * (residual P).comp (C tau * X) := by
  simp only [boundaryNormalization, normalizedMu, residual, Polynomial.derivative_C_mul,
    Polynomial.derivative_comp, Polynomial.derivative_X, mul_one,
    Polynomial.sub_comp, Polynomial.C_mul_comp, map_mul]
  ring

theorem boundaryNormalization_residual_coeff (P : ℂ[X]) (tau : ℂ) (k : ℕ) :
    ((boundaryNormalization P tau).derivative -
        C (normalizedMu P tau) * boundaryNormalization P tau).coeff k =
      (tau * (P.eval tau)⁻¹) * ((residual P).coeff k * tau ^ k) := by
  rw [boundaryNormalization_residual, Polynomial.coeff_C_mul,
    Polynomial.comp_C_mul_X_coeff]

theorem boundaryNormalization_residual_coeff_norm_le
    {ι : Type*} (s : Finset ι) (z : ι → ℂ) (n : ℕ) (M : ℝ) (tau : ℂ)
    (hs : s.card ≤ n) (hM0 : 0 ≤ M)
    (hM : ∀ k ∈ Finset.Icc 2 (n + 1), ‖powerSum s z k‖ ≤ M)
    (htau : ‖tau‖ = 1) (hval : (rootPolynomial s z).eval tau ≠ 0)
    (hcoeff : ∀ k : ℕ, ‖(rootPolynomial s z).coeff k‖ ≤
      ‖(rootPolynomial s z).eval tau‖) (k : ℕ) :
    ‖((boundaryNormalization (rootPolynomial s z) tau).derivative -
      C (normalizedMu (rootPolynomial s z) tau) *

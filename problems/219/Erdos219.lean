          f x ^ 2 + ((-2 : ℝ) * f x + 1)) := by
      apply congrArg mean
      funext x
      ring
    _ = mean (fun x => f x ^ 2) +
        mean (fun x => (-2 : ℝ) * f x + 1) :=
      mean_add _ _
    _ = mean (fun x => f x ^ 2) +
        (mean (fun x => (-2 : ℝ) * f x) +
          mean (fun _ : Ω => (1 : ℝ))) := by
      rw [mean_add]
    _ = mean (fun x => f x ^ 2) - 2 * mean f + 1 := by
      rw [mean_smul, mean_const]

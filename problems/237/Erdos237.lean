    {H : Finset ℕ} {d r : H → ℕ}
    (hdpos : ∀ h : H, 0 < d h)
    (hrpos : ∀ h : H, 0 < r h)
    (hdr : ∀ h : H, d h ∣ r h) (h : H) :
    0 < divisorTupleQuotient d r h := by
  apply Nat.div_pos
  · exact Nat.le_of_dvd (hrpos h) (hdr h)
  · exact hdpos h


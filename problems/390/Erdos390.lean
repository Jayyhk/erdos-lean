    {m : Nat} {T : Real} (hT : T ∈ Set.Ioo (0 : Real) 3) :
    HasDerivAt (fourFiveFixedSimplexKernel m)
      (fourFiveFixedSimplexKernelDerivative m T) T := by
  let P : Set (Real × (Fin m -> Real)) :=
    Set.Icc (0 : Real) 3 ×ˢ fourFiveClosedSimplex m

          edgeParam e ⟨1, by simp⟩ = D.edgeTarget e ∧
            D.edgeCarrier e = Set.range (edgeParam e) ∧
              D.edgeRelativeInterior e =
                Set.range (fun t : {t : ℝ // 0 < t ∧ t < 1} =>
                  edgeParam e
                    ⟨t.1, ⟨le_of_lt t.2.1, le_of_lt t.2.2⟩⟩)

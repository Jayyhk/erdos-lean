    apply Finset.prod_eq_zero hpMem
    simp [hpW]
  rw [show (∏ x ∈ n.primeFactors,
      (if x ∣ W then 0 else (1 : ℝ) / ((x - 2 : ℕ) : ℝ))) = 0 from hprod]
  simp

theorem maynardS2ReciprocalGSquarefreeAF_nonneg (W n : ℕ) :

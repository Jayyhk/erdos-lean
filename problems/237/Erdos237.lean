    rw [Finset.sum_product, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro m _hmm
    rw [Finset.mul_sum, Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro n _hnn
    by_cases hmn : m * n ≤ k <;> simp [r, c, hmn]
    ring

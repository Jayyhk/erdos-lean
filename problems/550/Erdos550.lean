    T ⊑ Gb := by
  obtain ⟨f, hf⟩ :
      ∃ f : VT → V, Function.Injective f ∧ (∀ a b, T.Adj a b → Gb.Adj (f a) (f b)) := by
    -- By `bin_embed`, for each `i`, there exists a function `f_i` that embeds the forest

    exact (Int.natAbs_ne_zero.mpr hdZ) (Nat.gcd_eq_zero_iff.mp hG).1
  have hf0 : pairSquareContent d ℓ ≠ 0 := squareContentRoot_ne_zero _ hG
  apply (mem_squareDivisors hd.ne').mpr
  refine ⟨Nat.pos_of_ne_zero hf0, ?_⟩

    unfold BoundedGaps.Maynard.vaughanPrimitiveMeanEquationOneTwoConstant
    have h := BoundedGaps.Maynard.vaughanPrimitiveMeanEquationOneOneConstant_nonneg
      (Real.log 4 + 4)

    ‖S - M‖ = ‖(S - I) + (I - M)‖ := by ring_nf
    _ ≤ ‖S - I‖ + ‖I - M‖ := norm_add_le _ _
    _ ≤ (|t| * Real.sqrt (t ^ 2 + 1) / 3 + 1) + 1 :=
      add_le_add hSI hIM

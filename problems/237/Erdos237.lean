    change (∑ i, ‖(b.repr u).ofLp i‖ ^ 2) = ‖u‖ ^ 2
    rw [← PiLp.norm_sq_eq_of_L2 (fun _ : ι => ℂ) (b.repr u)]
    rw [b.repr.norm_map]

    {x : ℕ} {q : ℝ} (hx : 4 ≤ x)
    (hq0 : 0 ≤ q) (hq : q ≤ vaughanCubeRoot x) :
    vaughanPrimitiveMeanAlgebraicScale
        (vaughanCubeRoot x) (vaughanCubeRoot x) x q ≤

    {n L Q : ℕ} (hn : 1 ≤ n) :
    0 < powerSieveAuxCore n L Q := by
  rw [powerSieveAuxCore]
  exact lt_of_lt_of_le
    (Nat.zero_lt_one.trans_le hn)
    (le_max_right _ _)


    {Γ : Type u} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]
    [CompactSpace Γ] [TotallyDisconnectedSpace Γ]
    {d : ℕ} (s : Fin d → Γ) :
    Type u where
  open_finite_index :
    ∀ N : Subgroup Γ,
      N.Normal →
      N.FiniteIndex →
      IsOpen ((N : Subgroup Γ) : Set Γ)


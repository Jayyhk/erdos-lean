noncomputable def dirichletPerronIntegral
    (a : ℕ → ℂ) (y alpha U : ℝ) : ℂ :=
  (((2 * Real.pi : ℝ) : ℂ)⁻¹) *
    ∫ t in -U..U,
      LSeries a ((alpha : ℂ) + t * I) *
        (y : ℂ) ^ ((alpha : ℂ) + t * I) /
          ((alpha : ℂ) + t * I)

private lemma cpow_div_of_pos

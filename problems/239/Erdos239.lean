      ((modularPreimage X g A).card : ℝ) -
          (A.card : ℝ) * (X : ℝ) / g =
        (r : ℝ) - (A.card : ℝ) * (X % g : ℕ) / g := by
    rw [card_modularPreimage hg A hA]
    push_cast
    rw [hxReal]
    field_simp

                  (Real.log (powerSieveResidualCutoff n L : ℝ)) Bexp) := by
  obtain ⟨Aβ, Cπ, CV, hAβ, hCπ, hCV, hbound⟩ :=
    exists_powerSieve_representedLargeFactorPrimes_pointwise_upper_bound_of_root_le

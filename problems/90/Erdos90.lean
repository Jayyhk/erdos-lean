      (kernel f) g hg
    have hC := tate_ratio_module
      (cokernel f) g hg
    refine ⟨inferInstance, inferInstance, ?_⟩
    calc
      (Nat.card (tateZero M) : ℚ) /
          Nat.card (tateNegOne M) =

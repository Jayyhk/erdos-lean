      by_cases hlarge : Y₀ ≤ Y
      · have h := exp_reciprocalPrimeSum_le_log_rpow hY
          (hthreshold Y hlarge)
        calc
          Real.exp ((1 / 10 : ℝ) * reciprocalPrimeSum Y + 18 / 5) ≤

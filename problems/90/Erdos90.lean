commutator. This is the class-two Hall collection identity. -/
lemma element_left_commute
    {G : Type*} [Group G]
    {x y : G}
    (hcomm : Commute x ⁅x, y⁆) :
    ∀ n : ℕ, ⁅x ^ n, y⁆ = ⁅x, y⁆ ^ n := by
  intro n
  induction n with
  | zero =>
      simp
  | succ n ih =>
      rw [element_left_succ, ih]
      have hconj :
          x ^ n * ⁅x, y⁆ * (x ^ n)⁻¹ = ⁅x, y⁆ := by
        rw [(hcomm.pow_left n).eq, mul_inv_cancel_right]
      rw [hconj, ← pow_succ']


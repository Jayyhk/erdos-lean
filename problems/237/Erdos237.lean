      rw [if_neg hue, if_neg hboth]
      simp
  · by_cases hue : ∀ h : H, u h ∣ e h
    · have hboth : ¬(∀ h : H, u h ∣ d h ∧ u h ∣ e h) :=
        fun h => hud (fun i => (h i).1)
      rw [if_pos hue, if_neg hud, if_neg hboth]
      simp
    · have hboth : ¬(∀ h : H, u h ∣ d h ∧ u h ∣ e h) :=
        fun h => hue (fun i => (h i).2)
      rw [if_neg hue, if_neg hboth]
      simp


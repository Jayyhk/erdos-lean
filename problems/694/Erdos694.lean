def vaughanFourthDyadicExponents
    (U V : ℝ) (x : ℕ) : Finset ℕ :=
  (dyadicExponentRange ⌊(x : ℝ) / V⌋₊).filter (fun alpha ↦
    let M : ℕ := 2 ^ alpha

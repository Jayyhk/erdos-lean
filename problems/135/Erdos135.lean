      · exact Or.inr hforward
      · exact Or.inl hback
  let dartArc : G.Dart → PolygonalArc := fun d =>
    if (D.edgeArc (edgeOfDart d)).source = D.vertexPlacement d.toProd.1 then
      D.edgeArc (edgeOfDart d)

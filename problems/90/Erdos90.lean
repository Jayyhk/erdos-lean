    adicFactorAlgebra (K := K) (L := L) P hP Q
  letI (Q : ι) : IsScalarTower C F (E Q) :=
    adic_scalar_tower
      (K := K) (L := L) P hP Q
  letI (Q : ι) : IsLocalization
      (Algebra.algebraMapSubmonoid (B Q) C⁰) (E Q) :=
    adic_localization_coordinate
      (K := K) (L := L) P hP Q

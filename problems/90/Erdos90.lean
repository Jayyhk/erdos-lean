                (K := K) (L := L) v) z) = 0 := by
        rw [← H2π_comp_map_apply]
        exact congrFun hr v
      have hwitness (v : InfinitePlace K) :
          ∃ aV : Gal(L/K) →
              uliftUnitsRepresentation
                (K := K) (L := L) v.1,
            d₁₂ _ aV = mapCocycles₂ (MonoidHom.id Gal(L/K))
              (resizedProductsEvaluation
                (K := K) (L := L) v) z :=

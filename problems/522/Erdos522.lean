    (a : Fin (N + 1) → ℂ) (ω : SignVector N) (Ξ : List ℝ) (x : ℝ) :
    finiteExponentialSum Finset.univ
      (fun k => (sign (ω k) * a k) * (Ξ.map fun ξ => frequencyMultiplier ((k.val : ℝ) - ξ)).prod)

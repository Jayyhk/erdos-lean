  rw [range_centralizer_eq k L A i hdim] at hwcentral
  obtain ⟨c, hc⟩ := hwcentral
  have hc0 : c ≠ 0 := by
    intro hc0
    have hw0 : (w : A) = 0 := by simpa [hc0] using hc.symm

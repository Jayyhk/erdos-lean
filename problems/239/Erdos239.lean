  let y : ℕ := 2 ^ ((Erdos67.gsA10SmallPowerBlockExponent Z) ^ 2)
  let R : ℝ := Real.log (Z : ℝ)
  let d : ℝ := (Real.log (y : ℝ)) / R
  let e : ℝ := R ^ (-(1 / 1000 : ℝ))
  have hRpos : 0 < R := zero_lt_one.trans_le (by simpa only [R] using hRone)

    Isometry φ := by
  apply AddMonoidHomClass.isometry_of_norm
  intro x
  rcases w.isReal_or_isComplex with hw | hw
  · let ew := InfinitePlace.Completion.ringEquivRealOfIsReal hw
    let Ew := InfinitePlace.Completion.isometryEquivRealOfIsReal hw

  · by_cases hodd : Odd s.length
    · have hnotEven : ¬ Even s.length := Nat.not_even_iff_odd.mpr hodd
      simp [upperTerm, upperBoundaryTerm, hadm, hodd, hnotEven,
        hodd.neg_one_pow, chainWeight_cons]

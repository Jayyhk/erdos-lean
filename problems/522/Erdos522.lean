  have hL : (x ^ (1 / 64 : ℝ)) ^ 2 = x ^ (1 / 32 : ℝ) := by
    rw [← Real.rpow_mul_natCast hx.le]
    congr 1
    norm_num
  have hp₁ : x * x ^ (1 / 32 : ℝ) * x ^ (-3 / 32 : ℝ) / x ^ (31 / 32 : ℝ) =
      1 / x ^ (1 / 32 : ℝ) := by

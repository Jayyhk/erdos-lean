                                      (E.prefixPiece i).vertices[m] ∧
                                    Bprefix.vertices[j + 1] =
                                      (E.prefixPiece i).vertices[m + 1]) ∨
                                   (Bprefix.vertices[j] =
                                      (E.prefixPiece i).vertices[m + 1] ∧
                                    Bprefix.vertices[j + 1] =
                                      (E.prefixPiece i).vertices[m]))) ∧

      F.eval x y := by
  have hatoms :
      (fun a =>
        specialize x y (HPAtom.eval universalLeft universalRight a)) =
        HPAtom.eval x y := by
    funext a
    cases a <;> simp [HPAtom.eval]
  rw [Factor.eval, Factor.eval, map_zpow, CWord.map_eval]
  rw [hatoms]


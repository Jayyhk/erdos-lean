  have hpA : ∀ x ∈ Set.uIoc (((p - 1 : Nat) : Real)) (p : Real),
      (A : Real) < x := by
    intro x hx
    have hporder : (((p - 1 : Nat) : Real)) <= (p : Real) := by
      exact_mod_cast Nat.sub_le p 1
    have hxIoc :
        x ∈ Set.Ioc (((p - 1 : Nat) : Real)) (p : Real) := by

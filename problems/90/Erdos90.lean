lemma ramification_idx_residue
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    {r : ℕ} (hr : Nat.Prime r)
    {P : Ideal (NumberField.RingOfIntegers L)}
    (hP0 : P ≠ ⊥)
    [P.IsPrime]
    [P.LiesOver (Ideal.rationalPrimeIdeal r)]

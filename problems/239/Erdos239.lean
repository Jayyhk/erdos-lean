theorem primeLogDiv_le_four_mul_log_four_mul_div
    {n p : ℕ} (hn : 0 < n) (hp : 0 < p)
    (hnp : n / 4 < p) (hpn : p ≤ 4 * n) :
    Real.log (p : ℝ) / p ≤ 4 * Real.log ((4 * n : ℕ) : ℝ) / n := by

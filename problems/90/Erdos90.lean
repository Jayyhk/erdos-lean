/-!
# Recollecting concrete Hall-Witt strict-trace sources

The complete Hall-Witt strict trace has the same evaluation as a fixed
three-head Jacobi packet.  The heads lie in the parent Hall layer, while
their product starts one lower-central layer higher.  A semantic normalizer
at the parent layer can therefore discard the vanishing active block and
emit an exact strict-trace source supported in the next layer.

This file packages that compiler.  Combined with the physical-coordinate
constructor, it reduces operational Hall-Witt recollection to explicit
polynomial degree estimates at the physical weights where recipes are
attached.

The file is intentionally not imported by the existing collection proof.
-/

noncomputable section

namespace Submission
namespace TCTex
namespace TSRecoll

open CWTrace
open STSubsti
open TEAddres
open
  GPBasis
open
  PRVector
open
  PRResid
open
  RSRecol
open
  PCSrc

/-- The original left-normed Jacobi head over Hall addresses. -/
def addressJacobiOriginal
    {d : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H)) :
    CWord (HEAddres H) :=
  .commutator (.commutator x y) z

/-- The first conventional Jacobi descendant over Hall addresses. -/
def exponentAddressJacobi
    {d : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H)) :
    CWord (HEAddres H) :=
  .commutator (.commutator x z) y

/-- The second conventional Jacobi descendant over Hall addresses. -/
def addressJacobiSecond
    {d : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H)) :
    CWord (HEAddres H) :=
  .commutator (.commutator y z) x

@[simp]
lemma address_jacobi_original
    {d : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H)) :
    (addressJacobiOriginal x y z).weight
        PEAddres.weight =
      exponentAddressParent x y z :=
  rfl

@[simp]
lemma exponent_address_jacobi
    {d : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H)) :
    (exponentAddressJacobi x y z).weight
        PEAddres.weight =
      exponentAddressParent x y z := by
  simp [exponentAddressJacobi,
    exponentAddressParent, Nat.add_assoc, Nat.add_comm,
    Nat.add_left_comm]

@[simp]
lemma address_jacobi_second
    {d : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H)) :
    (addressJacobiSecond x y z).weight
        PEAddres.weight =
      exponentAddressParent x y z := by
  simp [addressJacobiSecond,
    exponentAddressParent, Nat.add_assoc, Nat.add_comm,
    ]

/--
A physical parent-layer coefficient expansion for the fixed Hall-Witt head
packet.
-/
structure CHExp
    {d inputWeight : ℕ}
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (coefficient : ℕ → ℤ) where
  expansion :
    BCExp inputWeight
      (exponentAddressParent x y z)
  eval_expansion :
    expansion.eval = coefficient

namespace CHExp

/-- Reindex the shared coefficient expansion at the original Jacobi head. -/
def originalExpansion
    {d inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {coefficient : ℕ → ℤ}
    (head :
      CHExp
        (inputWeight := inputWeight) x y z coefficient) :
    BCExp inputWeight
      ((addressJacobiOriginal x y z).weight
        PEAddres.weight) :=
  BCExp.reweight (by simp) head.expansion

/-- Reindex the shared coefficient expansion at the first Jacobi descendant. -/
def firstExpansion
    {d inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {coefficient : ℕ → ℤ}
    (head :
      CHExp
        (inputWeight := inputWeight) x y z coefficient) :
    BCExp inputWeight
      ((exponentAddressJacobi x y z).weight
        PEAddres.weight) :=
  BCExp.reweight (by simp) head.expansion

/-- Reindex the shared coefficient expansion at the second Jacobi descendant. -/
def secondExpansion
    {d inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {coefficient : ℕ → ℤ}
    (head :
      CHExp
        (inputWeight := inputWeight) x y z coefficient) :
    BCExp inputWeight
      ((addressJacobiSecond x y z).weight
        PEAddres.weight) :=
  BCExp.reweight (by simp) head.expansion

@[simp]
lemma eval_originalExpansion
    {d inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {coefficient : ℕ → ℤ}
    (head :
      CHExp
        (inputWeight := inputWeight) x y z coefficient) :
    head.originalExpansion.eval = coefficient := by
  rw [originalExpansion, BCExp.eval_reweight,
    head.eval_expansion]

@[simp]
lemma eval_firstExpansion
    {d inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {coefficient : ℕ → ℤ}
    (head :
      CHExp
        (inputWeight := inputWeight) x y z coefficient) :
    head.firstExpansion.eval = coefficient := by
  rw [firstExpansion, BCExp.eval_reweight,
    head.eval_expansion]

@[simp]
lemma eval_secondExpansion
    {d inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {coefficient : ℕ → ℤ}
    (head :
      CHExp
        (inputWeight := inputWeight) x y z coefficient) :
    head.secondExpansion.eval = coefficient := by
  rw [secondExpansion, BCExp.eval_reweight,
    head.eval_expansion]

/-- The fixed symbolic three-head Jacobi packet. -/
def headSource
    {d inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {coefficient : ℕ → ℤ}
    (head :
      CHExp
        (inputWeight := inputWeight) x y z coefficient) :
    List
      (SPFactora
        (concreteBasicCommutators.{u} d) inputWeight) :=
  SPFactora.inverseList
      (head.originalExpansion.symbolicPowerFactors
        (addressJacobiOriginal x y z)) ++
    head.firstExpansion.symbolicPowerFactors
        (exponentAddressJacobi x y z) ++
      SPFactora.inverseList
        (head.secondExpansion.symbolicPowerFactors
          (addressJacobiSecond x y z))

/-- The fixed three-head packet evaluates exactly to the complete strict trace. -/
lemma head_full_trace
    {d n inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {coefficient : ℕ → ℤ}
    (head :
      CHExp
        (inputWeight := inputWeight) x y z coefficient)

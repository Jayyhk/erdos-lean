        primorialMobiusLogMoment D := by
      unfold primorialMobiusDensity primorialMobiusLogMoment
      rw [Finset.mul_sum]
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib]
      congr 1
      apply Finset.sum_congr rfl

theorem sum_tauPow_mul_progressionDiscrepancy
    {theta A C : ℝ} {X₀ x d Q q : ℕ}
    (hw : PrimeLevelWitness theta A C X₀) (hx : X₀ ≤ x) (hq : 0 < q)
    (S : Finset ℕ) (hSQ : S ⊆ Finset.Icc 1 Q)
    (hsq : ∀ n ∈ S, Squarefree n)
    (hqx : ∀ n ∈ S, q * n ≤ x + 1)

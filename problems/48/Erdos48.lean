          (2 * |gallagherWeight eta (j - 1) N| ^ 2)) *
            gallagherAmplifiedCutoffBandBound L A N +
        (2 * eta ^ 3 *
          normalizedGallagherDerivativeGammaCoefficient eta J (j - 1)) *
            gallagherAmplifiedCutoffEnergyBound L A N := by

@[simp] theorem shifted_coefficient_zero (b : ℕ → ℕ) (N : ℕ) :
    shiftedCoefficientPrefix b N 0 = ∑ n ∈ Finset.range (N + 1), b n := by
  classical
  unfold shiftedCoefficientPrefix
  simp

end

      gaussParameterFrame g '' R ⊆ ⋃ i, B i ∧ ∀ i, LiftForwardClose (8 * δ) T (B i) := by
  let ι := Fin Nr × Fin Nx × Fin Nh
  let B : ι → Set SL(2, ℝ) := fun i =>
    gaussLiftBox g (a i.1) (b i.2.1) (c i.2.2) (δ * Real.exp (-T)) δ δ

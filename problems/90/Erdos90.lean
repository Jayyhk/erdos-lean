    {M N K : ℕ}
    {B A : BFam M N}
    {left right : List (DFTerm M N K)}
    (ledger : PTLedger B A left right)
    (before : List (DFTerm M N K))
    (term : DFTerm M N K)
    (after : List (DFTerm M N K))

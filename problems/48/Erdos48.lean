open scoped BigOperators

def squarefreeCoprimeInvTotientMean (W Q : ℕ) : ℝ := by
  classical
  exact ∑ n ∈ Finset.Icc 1 Q,
    if Squarefree n ∧ Nat.Coprime n W then
      (1 : ℝ) / Nat.totient n

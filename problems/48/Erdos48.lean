theorem one_div_nat_sq_le_two_mul_telescoping
    {m : ℕ} (hm : 0 < m) :
    (1 : ℝ) / (m : ℝ) ^ 2 ≤
      2 * ((1 : ℝ) / m - 1 / (m + 1)) := by

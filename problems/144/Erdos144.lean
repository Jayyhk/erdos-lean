    ext r
    simp only [Finset.mem_Ioc, Finset.mem_Ico]
    omega
  rw [hset, Finset.sum_Ico_eq_sum_range]
  simp_rw [hterm]
  calc
    (∑ k ∈ Finset.range (R + 1 - (s + 1)), q ^ (s + 1 + k)) =

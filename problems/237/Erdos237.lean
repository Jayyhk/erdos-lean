    {n : ℕ} (hn : Squarefree n) :
    |(ArithmeticFunction.moebius n : ℝ)| = 1 := by
  have hsq : (ArithmeticFunction.moebius n : ℝ) ^ 2 = 1 := by
    exact_mod_cast (squarefree_iff_moebius_sq_eq_one n).mp hn
  rcases (sq_eq_one_iff.mp hsq) with h | h
  · rw [h]
    norm_num
  · rw [h]
    norm_num


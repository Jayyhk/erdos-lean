        (sigma.1 (E0.val y) - E0.val y) < 1 := by
      exact_mod_cast hamb'
    have hreal : spectralNorm K Efield (tauE (x : Efield) - x) < 1 := by
      calc
        spectralNorm K Efield (tauE (x : Efield) - x) =
            spectralNorm K E0 (tau0 y - y) := by
          rw [spectral_alg_equiv K E0 Efield e]

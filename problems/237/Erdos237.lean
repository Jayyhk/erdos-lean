    (∑ᶠ rho : ℂ, (m rho : ℂ) / (s - rho)).re
  rw [hfullSum, Complex.re_sum]
  apply Finset.sum_le_sum
  intro rho _
  by_cases hmrho : m rho = 0
  · have hZrho : Z rho = 0 :=
      Nat.eq_zero_of_le_zero ((hZ rho).trans_eq hmrho)
    simp [hZrho, hmrho]

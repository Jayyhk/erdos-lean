        rw [← Real.rpow_add hNR]
        norm_num
  have hhigh :
      (∑ j ∈ high,
          (j : ℝ) ^ (-(1 / 2 : ℝ)) *
            ((N - j : ℕ) : ℝ) ^ (-(1 / 2 : ℝ))) ≤ 4 := by
    calc
      _ ≤ ∑ j ∈ high, ((N : ℝ) / 2) ^ (-(1 / 2 : ℝ)) *

theorem sum_dvd_indicator_eq_div (d : ℕ) (n : ℕ) :
    (∑ i ∈ Finset.range n, if d ∣ i + 1 then (1 : ℝ) else 0) = (n / d : ℕ) := by
  induction n with
  | zero => simp

          if d ∣ n then (ArithmeticFunction.moebius d : ℝ) / n else 0 := by
      rw [Finset.sum_comm]
    _ = ∑ d ∈ W.divisors,
        (ArithmeticFunction.moebius d : ℝ) / d * realHarmonic (Q / d) := by
      apply Finset.sum_congr rfl
      intro d hdW
      have hdPos := Nat.pos_of_mem_divisors hdW

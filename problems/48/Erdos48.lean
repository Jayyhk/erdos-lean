    (hd : ∀ s ∈ U, s ∉ P → DifferentiableAt ℂ g s)
    (hrem : ∀ rho ∈ P,
      Tendsto (fun s => (s - rho) * g s) (𝓝[≠] rho) (𝓝 0)) :
    DifferentiableOn ℂ (fillFiniteRemovable P g) U := by

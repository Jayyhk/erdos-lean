def gsA10BetaSourceDepth (Cβ : ℝ) : ℕ :=
  101 + Nat.ceil (50 * max 0 (Real.log Cβ))

/-- The logarithmic exponent used by the source cutoff. -/
def gsA10BetaSourceExponent (Cβ : ℝ) (y : ℕ) : ℝ :=
  Real.log (y : ℝ) / (16 * gsA10BetaSourceDepth Cβ : ℕ)


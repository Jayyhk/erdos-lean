    (hQ : ∀ q ∈ Q, q.Prime) (hR : ∀ r ∈ R, r.Prime)
    (hRupper : ∀ r ∈ R, r ≤ Maux)
    (hprodUpper : ∀ q ∈ Q, ∀ r ∈ R, q * r ≤ Mprod)
    (hpartners : ∀ q ∈ E,

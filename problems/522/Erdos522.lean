  · have hz : ‖z‖ ≤ r := by linarith
    have hv : ‖v‖ ≤ r' := by linarith
    exact iff_of_true hz hv
  · have hhi : r + w < ‖z‖ := lt_of_not_ge (fun hz => hband ⟨lt_of_not_ge hlo, hz⟩)
    have hz : ¬ ‖z‖ ≤ r := by linarith
    have hv : ¬ ‖v‖ ≤ r' := by linarith

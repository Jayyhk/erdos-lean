  let u := completionDecompositionPlace v hvna w
  let huv := completion_decomposition_lies v hvna w
  letI : NumberField D := NumberField.of_module_finite K D
  letI : Fact u.IsNontrivial :=
    ⟨absolute_extension_nontrivial v

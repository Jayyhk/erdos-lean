      { toFun := fun x ↦ e2 (e1.hom x)
        invFun := fun x ↦ e1.inv (e2.symm x)
        left_inv := fun x ↦ by simp
        right_inv := fun x ↦ by simp
        map_add' := fun x y ↦ by
          rw [map_add]
          exact e2.map_add (e1.hom x) (e1.hom y) }

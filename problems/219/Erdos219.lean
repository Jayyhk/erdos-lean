            δ * ‖baseline tu‖ :=
      ae_restrict_of_forall_mem
        (SmoothSieveCutoff.measurableSet_selectedCFZPairedFourierBox e T)
        (fun tu htu => hinterior tu htu)
    have hboundIntegrable :
        Integrable
          (fun tu :
              (SelectedCFZFormIndex e → ℝ) ×
                (SelectedCFZFormIndex e → ℝ) =>
            δ * ‖baseline tu‖)
          (volume.prod volume) :=
      hbaseline.norm.const_mul δ

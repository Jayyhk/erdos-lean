    {d inputWeight : ℕ}
    {H : ∀ s : ℕ, BCWta.{u} d s}
    (lowerWeight : ℕ)
    (L : List (SPFactora H inputWeight)) :
    Prop :=
  ∀ x ∈ L,
    lowerWeight ≤ x.word.weight PEAddres.weight


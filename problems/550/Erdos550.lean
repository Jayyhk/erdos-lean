    let I' := Function.update I j0 i0
    (∑ i, (∑ j ∈ {j | I' j = i}, (s j : ℝ)) ^ 2) <
      ∑ i, (∑ j ∈ {j | I j = i}, (s j : ℝ)) ^ 2 := by
  dsimp only
  set I' : Fin d → Fin q := Function.update I j0 i0
  have hI'_potential :
      (∑ j ∈ Finset.filter (fun j => I' j = i0) Finset.univ, (s j : ℝ)) =
          (∑ j ∈ Finset.filter (fun j => I j = i0) Finset.univ, (s j : ℝ)) + (s j0 : ℝ) ∧
        (∑ j ∈ Finset.filter (fun j => I' j = h) Finset.univ, (s j : ℝ)) =
          (∑ j ∈ Finset.filter (fun j => I j = h) Finset.univ, (s j : ℝ)) - (s j0 : ℝ) := by
    constructor;
    · rw [show
          (Finset.filter (fun j => I' j = i0) Finset.univ) =

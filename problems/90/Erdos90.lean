  rcases Submodule.mem_span_singleton.mp hb with ⟨cb, hcb⟩
  refine Submodule.mem_span_singleton.mpr ⟨ca * cb, ?_⟩
  rw [← hca, ← hcb]
  simp [smul_smul, mul_comm]


        (realSign (ω k) * realSign (ω l)) ∂signMeasure N) *
      (if (i : ℤ) - (j : ℤ) = (k : ℤ) - (l : ℤ) then 1 else 0) := by
  have heq (q : SignVector N × AddCircle (1 : ℝ)) :
      inner ℂ (pairMode i j q) (pairMode k l q) =

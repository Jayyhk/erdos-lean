        Real.sqrt
          (C * (x : ℝ) / Real.rpow (Real.log (x : ℝ)) A) := by
  apply hw.sum_tauPow_mul_maxProgressionDiscrepancy hx
    (X := (3 : ℝ) * ((x + 1 : ℕ) : ℝ)) (S := S)
  · positivity
  · exact hSQ
  · exact hsq
  · exact hcut
  · intro q hq
    have hqData := Finset.mem_Icc.mp (hSQ hq)
    have hqpos : 0 < q := zero_lt_one.trans_le hqData.1
    have hqx : q ≤ x + 1 := hqData.2.trans hQx

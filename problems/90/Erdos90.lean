    {d : ℕ}
    {ι : Type}
    (factor :
      SPFactor
        (concreteBasicCommutators.{u} d) ι)
    {x :
      SPFactor
        (concreteBasicCommutators.{u} d) ι}
    (hx : x ∈ basicReductionFactors factor) :
    (tree x.word).IsBasic := by
  rcases indexed_tree_factors factor hx with
    ⟨i, _hx, htree⟩
  rw [htree]

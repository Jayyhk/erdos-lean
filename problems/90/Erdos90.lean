@[simp]
theorem upper_primes_above
    (P : HeightOneSpectrum (NumberField.RingOfIntegers K))
    (Q : UpperPrimeFactors (K := K) (L := L) P) :
    (upperPrimesAbove (K := K) (L := L) P Q).1 =
      upperPrime (K := K) (L := L) P Q :=

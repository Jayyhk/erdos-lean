successor slot witness vanishes at the formal predecessor input. -/
lemma natural_vanish_neg
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (hvanish :
      SuccessorPolynomialsVanish
        (fun multiplicity =>
          cutoffProfile cutoff
            (NPTail.strictTrace

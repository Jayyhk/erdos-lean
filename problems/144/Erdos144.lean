theorem lower_tail_chernoff {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (p : ι → ℝ)
    (hp0 : ∀ i ∈ s, 0 ≤ p i) (hp1 : ∀ i ∈ s, p i ≤ 1)
    {K : ℕ} {EW r : ℝ} (hEW : EW = ∑ i ∈ s, p i)
    (hr0 : 0 < r) (hr1 : r < 1)
    (hK : (K : ℝ) ≤ r * EW) :
    (∑ T ∈ s.powerset.filter (fun T => T.card < K), weight s p T) ≤

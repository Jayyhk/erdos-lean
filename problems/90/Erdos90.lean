    (v : NumberFieldPlace K) :
    IdeleGroup (OK_v88 K) K →* placeUnits K v := by
  cases v with
  | inl P =>
      exact
        { toFun := fun a => a.2.1 P
          map_one' := rfl
          map_mul' := fun _ _ => rfl }
  | inr v =>

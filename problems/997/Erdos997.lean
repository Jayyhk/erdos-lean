  rw [hSeq]
  dsimp [Ln, Lr, K]
  simp only [div_pow]
  ring_nf
  field_simp [hW.ne', hphi.ne', (Nat.cast_pos.mpr hN).ne',
    hRnat.ne', hRreal.ne', inv_inv]
  let T := tupleShiftedPrimeIntervalCount N m *
    tupleRestrictedGKernel H alpha (tupleLargeCandidate H) N m

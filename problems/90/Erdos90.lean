      σ y = ((AlgEquiv.restrictNormalHom E (σ.restrictScalars K)
          ⟨y, hy⟩ : E) : M) :=
        (AlgEquiv.restrictNormalHom_apply E (σ.restrictScalars K)
          ⟨y, hy⟩).symm

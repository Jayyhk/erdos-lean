  have hJpos : 0 < J := by dsimp [J]; positivity
  have hlogTwo : 0 < Real.log 2 := Real.log_pos one_lt_two
  let R : ℝ := 2 * (4 + 4 * K + 2 * J + 3 * C / Real.log 2)
  let D : ℝ := max 2 (max (1 / Real.log 2) R)
  obtain ⟨M, hM⟩ := exists_nat_gt D

    nlinarith only [hreciprocal, hraw']
  have hchi1Lower :=
    hcharLower chi1 rho1 hchi1 hrho1 him1 hreciprocal1
  have hchi2Lower :=
    hcharLower chi2 rho2 hchi2 hrho2 him2 hreciprocal2
  let Zempty : ℂ →₀ ℕ := 0

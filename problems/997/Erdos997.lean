namespace BoundedGaps.Maynard

open Finset Nat Filter
open scoped BigOperators

private noncomputable def maynardS2ReciprocalGSingularCorrection (p : ℕ) : ℝ :=
  (1 : ℝ) / ((p : ℝ) * ((p : ℝ) - 2))


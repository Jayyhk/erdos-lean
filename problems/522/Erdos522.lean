private lemma _root_.ProbabilityTheory.mem_positiveSupportingNormalPoints_closedBall_iff {d : ℕ}
    {v x : EuclideanSpace ℝ (Fin d)} :
    x ∈ positiveSupportingNormalPoints
        (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) 1) v ↔

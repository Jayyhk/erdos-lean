    {ι : Type}
    (factor : SPFactor H ι) :
    factor.neg.neg = factor := by
  cases factor with
  | mk word coefficient =>
      cases coefficient with
      | mk terms =>
          simp [neg, WBForm.scale,
            WBTerm.scale, Function.comp_def]


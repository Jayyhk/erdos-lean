def ShapiroInjPrimary
    (A : Rep k G) (p : ℕ) [Fact p.Prime] (P : Sylow p G) (r : ℕ) :
    Prop :=
    Set.InjOn (restriction A P.1 r)
      (AddCommGroup.primaryComponent (groupCohomology A r) p)


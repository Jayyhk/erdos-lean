                ∫ tu in boxᶜ, baseline tu
                  ∂(volume.prod volume)‖ :=
          norm_add_le _ _
        _ ≤
            ‖(∫ tu in box, scaled tu ∂(volume.prod volume)) -
                ∫ tu in box, baseline tu ∂(volume.prod volume)‖ +

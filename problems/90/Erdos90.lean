      change ‖algebraMap ℚ K qfac‖ ≤ ‖algebraMap ℚ K qp‖ at hnorm
      simpa [v, qfac, qp, pK, map_inv₀, map_pow] using hnorm
    rw [NormedSpace.expSeries_eq_ofScalars,
      FormalMultilinearSeries.ofScalars_norm]

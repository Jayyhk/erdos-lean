    ‖riemannZeta₁ z‖ ≤ T ^ E := habs
    _ = T ^ E * 1 := by ring
    _ ≤ T ^ E * (T ^ 2 * ‖riemannZeta₁ c‖) :=
      mul_le_mul_of_nonneg_left hTcenter (pow_nonneg hTpos.le E)
    _ = T ^ (E + 2) * ‖riemannZeta₁ c‖ := by rw [pow_add]; ring
    _ ≤ T ^ A * ‖riemannZeta₁ c‖ :=

theorem adic_complete_free
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Module.Free R M]
    (I : Ideal R) [IsAdicComplete I R] :
    IsAdicComplete I M := by

theorem ISBound.gsCoeffInt
    [Fintype FP.toPresentation.Relator] :
    ISBound (FP.gsCoeffInt) (FP.maxRelatorDepth + 1) := by
  intro q hq
  exact FP.gs_coeff_bound hq


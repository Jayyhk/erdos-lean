          Nat.add_le_add_right
            (Nat.mul_le_mul_right (2 * cutoff + emittedPrefix.length + 4)
              hwordLength)
            1
      have hfull :
          IVMost
            (fun steps : ℕ =>
              (orderedSubsequenceMultiplicity word
                (middleSuccessorSkew
                  cutoff crossed outer selected right emittedPrefix steps) :
                    ℤ))
            wordDegree := by
        dsimp [wordDegree]
        exact
          subsequenceMultSkew
            cutoff crossed outer selected right emittedPrefix word
      have horbit :
          IVMost
            (fun steps : ℕ =>
              (orderedSubsequenceMultiplicity word
                (boundedCrossingSchedule cutoff crossed
                  outer emittedPrefix steps) : ℤ))
            wordDegree := by
        apply
          TCTex.IVMost.mono
            (degreeBound :=
              word.length * (cutoff + emittedPrefix.length + 1) + 1)
            (largerBound := wordDegree)
        · dsimp [wordDegree]
          exact
            Nat.add_le_add_right
              (Nat.mul_le_mul_left word.length (by omega))
              1
        · exact
            subsequenceMultPoly
              cutoff crossed outer emittedPrefix word
      change
        newtonSignedEvaluation stateDegree
            (fun steps : ℕ =>
              (orderedSubsequenceMultiplicity word
                (middleSuccessorSkew
                  cutoff crossed outer selected right emittedPrefix steps) :
                    ℤ)) =
          newtonSignedEvaluation stateDegree
            (fun steps : ℕ =>
              (orderedSubsequenceMultiplicity word
                (boundedCrossingSchedule cutoff crossed
                  outer emittedPrefix steps) : ℤ))
      rw [newton_signed_evaluation wordDegree stateDegree
        hwordDegree _ hfull]
      rw [newton_signed_evaluation wordDegree stateDegree
        hwordDegree _ horbit]
      exact
        newton_orbit_prefix
          cutoff crossed outer selected right emittedPrefix word
    · simp only [hconstant, ↓reduceIte]
  · rw [show
      (fun steps : ℕ =>
        ((boundedConstantTerms cutoff
          (middleSuccessorSkew cutoff
            crossed outer selected right emittedPrefix steps)).count
              target : ℤ)) =
          fun _steps : ℕ => 0 by
      funext steps
      exact_mod_cast
        constant_ite_producers
          cutoff (secondRouteAlphabet cutoff)
            (middleSuccessorSkew cutoff
              crossed outer selected right emittedPrefix steps)
            (fun transition htransition =>
              middle_successor_skew
                cutoff steps crossed outer selected right hcrossed emittedPrefix
                  transition htransition)
            target |>.trans (if_neg htarget)]
    rw [show
      (fun steps : ℕ =>
        ((boundedConstantTerms cutoff
          (boundedCrossingSchedule cutoff crossed outer
            emittedPrefix steps)).count target : ℤ)) =
          fun _steps : ℕ => 0 by
      funext steps
      exact_mod_cast
        constant_ite_producers
          cutoff (secondRouteAlphabet cutoff)
            (boundedCrossingSchedule cutoff crossed outer
              emittedPrefix steps)
            (fun transition htransition =>
              route_crossing_schedule
                cutoff steps crossed outer hcrossed emittedPrefix transition
                  htransition)
            target |>.trans (if_neg htarget)]


    (hratio : Tendsto (fun j ↦ (N (j + 1) : ℝ) / N j) atTop (𝓝 1))
    (hsparse : Tendsto (fun j ↦ X (N j) / N j) atTop (𝓝 c))
    (ha : Tendsto a atTop (𝓝 0)) (hb : ∀ h, Tendsto (b h) atTop (𝓝 0))

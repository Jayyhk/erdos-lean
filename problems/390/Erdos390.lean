BV argument. -/
def fourFiveRealMovingFaceKernel
    (A y : Nat) (u c x : Real) : Real :=
  if (A : Real) < x ∧
      fourFiveRealLogCoordinate y x < u - c - 1 then
    fourFiveRealMovingFaceReciprocal y u c x

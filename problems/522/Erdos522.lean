    (show 0 ≤ 4 * C / c by positivity)
  have hfactor : (4 * C / c) * (5120 * Real.exp 1 * Real.log (2 / mass x₀) ^ 6) =
      (20480 * Real.exp 1 * C / c) * Real.log (2 / mass x₀) ^ 6 := by ring
  rw [hfactor] at hcost
  nlinarith

end

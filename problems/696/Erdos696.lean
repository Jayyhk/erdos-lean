  have hx1 : (1 : ℝ) ≤ x := (le_max_left _ _).trans hx
  have hxpos : 0 < x := lt_of_lt_of_le (by norm_num) hx1
  let E : Set ℕ :=
    {n : ℕ | n ≤ ⌊x⌋₊ ∧

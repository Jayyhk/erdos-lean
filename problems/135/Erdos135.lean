      · exact hw_ne_l (hinj hw_left)
      · exact hw_ne_r (hinj hw_right)
  have centers_ordered_disjoint :
      ∀ {x y : {p // p ∈ D.intersectionPoints}} {e : G.edgeFinset}
        (hx : x.1 ∈ D.edgeRelativeInterior e)
        (hy : y.1 ∈ D.edgeRelativeInterior e),

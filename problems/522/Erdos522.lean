    (∫ ω in s, ‖f ω‖ ∂ν) ≤ Real.sqrt (ν.real s * ∫ ω, ‖f ω‖ ^ 2 ∂ν) := by
  have h := sq_integral_norm_le_mass_mul_integral_sq (hf.restrict s)

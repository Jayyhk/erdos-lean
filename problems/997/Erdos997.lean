  rcases exists_pos_vonMangoldt_tsum_lt_inv_sub_one_add with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro sigma hsigma hsigma_two
  rw [← ofReal_vonMangoldt_tsum_eq_neg_logDeriv_riemannZeta hsigma]

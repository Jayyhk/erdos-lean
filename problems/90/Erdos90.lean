def complexPlaceInvariant
    (K : Type u) [Field K] [NumberField K]
    (v : InfinitePlace K) :
    Additive (BrauerGroup (Submission.CField.RExist.placeCompletion K (.inr v))) →+
      LocalInvariant := 0

/-- The zero invariant has the required canonical properties at a complex

    {m y B : Nat} {q : Fin m -> Nat}
    (hq : q ∈ fourFiveOrderedPrimePrefixSet m y B) :
    0 < ∏ i, q i := by
  apply Finset.prod_pos
  intro i _hi
  exact (mem_fourFiveOrderedPrimePrefixSet.mp hq i).2.2.pos


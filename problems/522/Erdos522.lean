    rw [min_eq_left h1d, max_eq_right he, Real.log_one]
    have hlog : 0 ≤ Real.log d := Real.log_nonneg h1d
    rw [max_eq_right (neg_nonpos.mpr hlog), min_eq_right hT, neg_zero]


theorem orderedPatternEdgeFactor_self
    {G : Type*} {k r : ℕ}
    (H K : WeightedOrderedPattern G k r)
    (e : OrderedFace k r) (x : Fin k → G) :
    orderedPatternEdgeFactor H K e e x = 1 := by
  simp [orderedPatternEdgeFactor]


  rw [← hcoord]
  field_simp [hlogy]

private theorem fourFivePrimePrefixMovingTerm_eq_scaledCutoff
    {m y B : Nat} {q : Fin m -> Nat}
    (hy : 2 <= y) (hq : q ∈ fourFiveOrderedPrimePrefixSet m y B)

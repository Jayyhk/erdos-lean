    exact natAbs_cfzAffineForm_eval_finiteBox_le q x
  have ha : a.val ≤ N := (ZMod.val_lt a).le
  have hdiffBound :
      Int.natAbs (A - (a.val : ℤ)) ≤
        N * (Fintype.card (CFZVariable k) * k + 1) := by
    calc
      Int.natAbs (A - (a.val : ℤ)) ≤

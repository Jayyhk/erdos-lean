def congruenceLSeries {m : Modulus K}
    {H : Subgroup (IdealsPrimeTo (NumberField.RingOfIntegers K) K m.finiteSupport)}
    (chi : CongruenceClassQuotient K m H →* ℂˣ) (s : ℂ) : ℂ :=
  limUnder atTop (fun N ↦ congruenceLPartial K chi s N)


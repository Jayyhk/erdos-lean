  rcases hdvd with ⟨c, hc⟩
  rw [hc]
  rw [Nat.mul_div_cancel_left _ hsc_pos]
  rcases Nat.eq_zero_or_pos c with hc0 | hc0
  · subst hc0
    rw [Nat.mul_zero] at hc
    omega
  · exact hc0

theorem exponent_pos_when_mod_a_eq (k : ℕ) (cov_a : ℕ → ℕ) (j : ℕ) (p : ℕ)

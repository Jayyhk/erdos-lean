      intro s hs
      apply (hd s (interior_subset hs.1.1) ?_).differentiableWithinAt
      intro hsP
      have hsrho : s ≠ rho := by simpa using hs.2
      exact hs.1.2 (by simpa [Finset.mem_erase, hsrho] using hsP)

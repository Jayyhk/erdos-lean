/-- The coefficientwise divisibility condition defining the weighted Magnus
ideal through degree `n`. -/
def SatisfiesWeightedCondition
    (e : MDescen) (n : ℕ)
    (f : MSeries R X) : Prop :=
  f 1 = 0 ∧
    ∀ w, 1 ≤ w.length → w.length ≤ n →
      ((e n w.length : ℕ) : R) ∣ f w


    have hx_j : c * (-ε) + d * 0 = p 0 := by
      have hx' := congrArg (fun q : EuclideanSpace ℝ (Fin 2) => q 0) hcomb_j
      simpa [hLx j, hMx j] using hx'
    have hac : a = c := by nlinarith [hε, hx_i, hx_j]
    have hbd : b = d := by nlinarith [hab, hcd, hac]

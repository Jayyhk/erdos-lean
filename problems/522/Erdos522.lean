  have href := (hasDerivAt_id (0 : ℝ)).add hn
  change HasDerivAt (fun x : ℝ => x + kacLogVarianceProfile (-x))
    (1 + -deriv kacLogVarianceProfile 0) 0 at href
  rw [heq] at href
  have hv : deriv kacLogVarianceProfile 0 = (1 / 2 : ℝ) := by linarith [hd.unique href]
  exact hv ▸ hd


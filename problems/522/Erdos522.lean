    exact (levelOccupation_mem_Icc ν X (-T, ω)).2
  have hALp : MemLp (fun ω => levelOccupation ν X (-T, ω)) 2 μ :=
    MemLp.of_bound ((measurable_levelOccupation ν X hX).comp

  have hqv := nearestPoint_variational hconv hq.1 hq.2 p hp.1
  have hpv' : 0 ≤ inner ℝ (x - p) (p - q) := by
    rw [show q - p = -(p - q) by abel, inner_neg_right] at hpv
    linarith
  have hrel :

      (nonarchimedeanHeightSpectrum (sigma • w₁.1)
          hswNontrivial hswNonarch).asIdeal = P₂.asIdeal := by
    rw [centered_smul_ideal w₁.1 hw₁ hna₁ sigma]
    exact hsigma

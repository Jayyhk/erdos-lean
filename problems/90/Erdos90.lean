          (positiveFilteredPrefix cutoff) steps := by
  rw [
    prepend_move_append,
    FRProgra.trace_empty, iterated_trace_nil,
    List.append_nil]

/-- The negative empty-tail outer-packet trace is its emitted orbit prefix. -/
lemma iterate_prepend_empty
    (cutoff steps : ℕ) :
    (iteratePrepend cutoff isFirstCurrent
      NNPower.inverseNormalizedTrace
        steps .empty).trace cutoff =
      cutoffMovePrefix cutoff firstConventionalWord
        (negativeFilteredPrefix cutoff) steps := by
  rw [
    iterate_prepend_append,
    FRProgra.trace_empty, iterated_trace_nil,
    List.append_nil]


    gauss_frame_decomposition g ha0.ne'⟩
  · rw [abs_div, abs_of_pos ha0]
    apply (div_le_iff₀ ha0).mpr
    nlinarith [hg.2.2.1]
  · rw [abs_mul, abs_of_pos ha0]
    have hb : |g 0 1| ≤ η := hg.2.1
    calc
      _ ≤ (3 / 2) * η := mul_le_mul (by linarith [ha.2]) hb (abs_nonneg _) (by norm_num)
      _ ≤ 2 * η := by linarith


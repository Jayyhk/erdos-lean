        hhistory)
      (RHRecipe.RHistor.inverse_raw_histories
        hhistory)
  mem_trace :=
    LRecipe.labellinword_meminvleft_rigtralabato
      history.word
      (RHRecipe.RHistor.positive_raw_histories
        hhistory)
      (RHRecipe.RHistor.inverse_raw_histories

lemma eval_zpow_series
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (innerWord rightWord : CWord (HEAddres H))
    (exponent : ℤ) :
    ⁅innerWord.eval
          (PEAddres.freeLowerTruncation
            (n := n)) ^ exponent,

            (trimToMultiple D N : ℝ) ^ t) ≤
      4 * (D : ℝ) * (t : ℝ) *
          (N : ℝ) ^ (t - 1) / (N : ℝ) ^ t +
        2 * (C : ℝ) * (D : ℝ) *
          (N : ℝ) ^ (t - 1) *
          (2 : ℝ) ^ t / (N : ℝ) ^ t
  apply add_le_add
  · exact
      div_le_div_of_nonneg_right
        (by
          calc
            4 * (((N ^ t -
                (trimToMultiple D N) ^ t : ℕ) : ℝ)) ≤
                4 * ((D : ℝ) * (t : ℝ) *
                  (N : ℝ) ^ (t - 1)) :=

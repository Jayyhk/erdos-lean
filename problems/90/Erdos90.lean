        (n := n) (lowerWeight := lowerWeight) H leftSource)
    (right :
      TSRecol
        (n := n) (lowerWeight := lowerWeight) H rightSource) :
    TSRecol
      (n := n) (lowerWeight := lowerWeight) H (leftSource ++ rightSource) where
  higherSource := left.higherSource ++ right.higherSource

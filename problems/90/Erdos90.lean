def ideleCoordinate
    (x : IdeleGroup (RingOfIntegers L) L) (w : NumberFieldPlace L) :
    PlaceUnits L w := by
  cases w with
  | inl w =>
      exact (show Πʳ v : HeightOneSpectrum (RingOfIntegers L),

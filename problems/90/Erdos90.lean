    0 < -(FP.gsEvalRat x * (b 0 : ℚ)) := by
  have hb0q : (0 : ℚ) < b 0 := by exact_mod_cast hb0
  have hmul : FP.gsEvalRat x * (b 0 : ℚ) < 0 :=
    mul_neg_of_neg_of_pos hneg hb0q
  linarith


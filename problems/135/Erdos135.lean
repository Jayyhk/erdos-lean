    intro x e hx
    rcases edgeParam_spec e with ⟨_hcont, hinj, _hsource, _htarget, _hcarrier, _hrel⟩
    have hpoint_ne :
        edgeParam e (leftRawParam hx) ≠ edgeParam e (rightRawParam hx) := by
      intro h

private lemma pole_re_le_of_im_ge
    {a gamma delta : ℝ} (ha : 0 ≤ a) (ha_one : a ≤ 1) (hdelta : 0 < delta)
    (hgamma : delta / 2 ≤ |gamma|) :
    (((a : ℂ) + gamma * I)⁻¹).re ≤ 4 / delta ^ 2 := by
  rw [Complex.inv_re]

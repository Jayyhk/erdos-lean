    (orbitFunctionRepresentation G W).ρ.invariants →+
      ZMod (Fintype.card (MulAction.stabilizer G w0)) where
  toFun x := orbitInvariantsEquiv G W w0 x
  map_zero' := by simp
  map_add' x y := by simp


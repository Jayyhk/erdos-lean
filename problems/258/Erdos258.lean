    (∑ n ∈ Finset.range N, |reciprocalTotientCorrectionAF W n|) =
        ∑ n ∈ Finset.range N, f n := by rfl
    _ ≤ ∑ n ∈ Finset.range N, N.smoothNumbers.indicator f n := by
      apply Finset.sum_le_sum
      intro n hn

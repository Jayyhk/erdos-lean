              omega) -
          (commutator (commutator v w) u).freeLowerWeight
            (by
              simp only [weight_commutator]
              omega) := by
      rw [hjacobi, zero_add]

/-- Transported form of the Jacobi rewrite in an explicitly chosen total weight. -/

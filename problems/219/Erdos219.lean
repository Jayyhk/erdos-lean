  letI :
      Countable
        (SelectedCFZCanonicalCarryEulerCompletionTailIndex e R) := by
    unfold SelectedCFZCanonicalCarryEulerCompletionTailIndex
    infer_instance
  have hterm :
      ∀ idx :
          SelectedCFZCanonicalCarryEulerCompletionTailIndex e R,

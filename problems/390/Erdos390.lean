    (fun t _ht => abs_fourFivePhysicalMovingProductOne_sub_cell_le
      hy hcut (hyA.trans hAB))

theorem fourFivePhysicalProductReplacementError_two_le_outer
    {y A B : Nat} {M : Real}
    (hy : 2 <= y) (hyA : y <= A) (hAB : A <= B)

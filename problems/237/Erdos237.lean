    {x n : ℕ} {alpha U : ℝ}
    (hx : 0 < x) (hn : 0 < n)
    (hUpper : (n : ℝ) < 2 * x)
    (halpha : 0 < alpha) (halphaUpper : alpha ≤ 2)
    (hU : 0 < U) :

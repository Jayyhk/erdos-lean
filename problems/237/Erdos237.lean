          (B / (commonS2GProduct H u * crossS2GProduct H s)) := by
      gcongr
    _ = B ^ 2 / (commonS2GProduct H u * crossS2GProduct H s ^ 2) := by
      field_simp [ne_of_gt hU, ne_of_gt hS]
    _ = B ^ 2 * (1 / crossS2GProduct H s ^ 2) *

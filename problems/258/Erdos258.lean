      (Nat.totient (a m) : ℝ) * ∏ h ∈ off, phi h := by
    unfold divisorTupleTotientProduct
    calc
      (∏ h : H, (Nat.totient (a h) : ℝ)) =
          (Nat.totient (a m) : ℝ) *
            ∏ h ∈ Finset.univ.erase m, (Nat.totient (a h) : ℝ) := by

theorem hasComplexPrimeSquareError_boundedMasked
    {C : ℝ} {localFactor : Nat.Primes → ℂ}
    (B : ℕ) (hC : 0 ≤ C)
    (herror :
      ∀ p : Nat.Primes, B < (p : ℕ) →
        ‖localFactor p - 1‖ ≤ C / (p : ℝ) ^ 2) :

          ∃ hnTail : N ≤ Bsource.sampleData.n,
            let R := F.realization Bsource.sampleData.n hnTail
            let certificate := F.certificate Bsource.sampleData.n hnTail
            ∃ J : BankPaperCanonicalSectionNinePostHeightBridgeInputsAt

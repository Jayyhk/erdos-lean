      Finite.of_equiv (tateZero B) f₀.toEquiv
    letI : Finite (tateNegOne A) :=
      Finite.of_equiv (tateNegOne B) f₁.toEquiv
    refine ⟨inferInstance, inferInstance, ?_⟩
    rw [Nat.card_congr f₀.symm.toEquiv, Nat.card_congr f₁.symm.toEquiv]

noncomputable def scaledCharacterPrefix {q N : ℕ} [NeZero q] [NeZero N]
    (χ : DirichletCharacter ℂ q) (d L : ℕ) (a : ZMod N) : ℂ :=
  ∑ m ∈ Finset.range L, scaledShiftedCharacter χ d m a


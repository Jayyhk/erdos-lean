        (he.squarefree_of_dvd (divisorTupleCoordinate_dvd_product e h))
        (hr h) (hre h)
    _ = if r = e then ∏ h : H, ArithmeticFunction.moebius (r h) else 0 := by
      by_cases hdiag : r = e
      · subst e
        simp
      · rw [if_neg hdiag]

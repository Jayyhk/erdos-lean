    (f g : PowerSeries R) (a : σ → R)
    (phi : MvPowerSeries σ R) : Prop :=
  constantCoeff phi = 0 ∧
    homogeneousComponent 1 phi = mvLinearForm a ∧
    lubinIntertwiningError f g phi = 0


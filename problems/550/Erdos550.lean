    (G : SimpleGraph V) [DecidableRel G.Adj]
    (ε d : ℝ) (endpoint headCore : Finset V) : Finset V :=
  open scoped Classical in
  endpoint.filter fun v =>
    (d - ε) * (headCore.card : ℝ) ≤
      ((headCore.filter fun x => G.Adj v x).card : ℝ)


        Real.log_le_log (by linarith) hrightArg
      _ = 2 * Q := by rw [Real.log_pow]; simp [Q]
  have hLR : L * R ≤ 6 * Q ^ 2 := by
    calc
      L * R ≤ (3 * Q) * (2 * Q) :=

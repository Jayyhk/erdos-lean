  let rightWeight := rightWord.weight PEAddres.weight
  have hinnerWeight : 0 < innerWeight := by
    exact CWord.weight_pos
      PEAddres.weight PEAddres.weight_pos
        innerWord
  have hrightWeight : 0 < rightWeight := by
    exact CWord.weight_pos
      PEAddres.weight PEAddres.weight_pos
        rightWord

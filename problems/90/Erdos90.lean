      (∏ w : InfinitePlacesAbove (K := K) (L := L) v,
        infiniteCompletionNorm (K := K) (L := L) v w
          (Units.map (algebraMap L w.1.1.Completion) x)) =
    (Units.coeHom v.1.Completion)

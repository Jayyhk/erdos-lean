          (List.map (fun term => term.eval e)
              ((right.terms.map fun rightTerm =>
                  leftTerm.mul rightTerm hweight) ++
                (leftTerms.flatMap fun nextLeftTerm =>
                  right.terms.map fun rightTerm =>
                    nextLeftTerm.mul rightTerm hweight))).sum =

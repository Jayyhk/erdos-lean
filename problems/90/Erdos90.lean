            (@AlgEquiv.restrictNormalHom_apply ℚ inferInstance D
              inferInstance inferInstance E hEgal.to_normal sigma.1 x).symm
          _ = (x : D) :=
            congrArg Subtype.val (DFunLike.congr_fun hEone x)
    | some j =>
        let Cj := cyclotomicCubicCompositum
          D0 hD0three S j

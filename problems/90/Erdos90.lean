            (childrenSwapFactor factor left right hleftBasic hrightBasic
              htree)
            ranked
            (by
              simpa only [basic_children_swap] using
                hfactorTruncated)
            (valueResidual
              (childrenSwapFactor factor left right hleftBasic
                hrightBasic htree)
              ranked
              (by
                simpa only [basic_children_swap] using
                  hfactorTruncated)))

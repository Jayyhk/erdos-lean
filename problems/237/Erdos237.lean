/-- An ordinary zero of a primitive Dirichlet L-function of modulus greater
than one lies strictly to the left of the line `Re(s)=1`. -/
theorem LFunction_zero_re_lt_one_of_isPrimitive
    {q : ℕ} [NeZero q] (hq : 1 < q)

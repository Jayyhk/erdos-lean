      principalIdeles (OK_v58 K) K ⊔ idelesAtPlaces K S :=
    (le_sup_left : principalIdeles (OK_v58 K) K ≤
      principalIdeles (OK_v58 K) K ⊔ idelesAtPlaces K S) hp

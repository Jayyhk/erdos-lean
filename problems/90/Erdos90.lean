    {K : Type u} [Field K] [NumberField K]
    {P P' : HeightOneSpectrum (OK_v55 K)} (h : P = P') :
    Continuous (RingEquiv.cast
      (R := fun V : HeightOneSpectrum (OK_v55 K) ↦ V.adicCompletion K) h) := by
  subst P'
  exact continuous_id


    Type (u + 1) where
  open_ker_discrete :
    ∀ {Λ : Type u} [Group Λ] [TopologicalSpace Λ] [DiscreteTopology Λ] [Finite Λ],
      (φ : Γ →* Λ) →
        IsOpen ((φ.ker : Subgroup Γ) : Set Γ)


      B ^ E * B ^ L * B ^ L * B ^ (2 * L) := by gcongr
    _ = B ^ (E + 4 * L) := by ring

private lemma goldfeld_leftLine_decay_product_le
    {q u x C : ℝ} {A : ℕ}

    rcases hFiber_nonempty with ⟨q, hq⟩
    have hOmegaQ : 1 ≤ omega q :=
      hOmegaPos q (hFiber_modLower q hq)
    rw [hFiber_omega q hq] at hOmegaQ
    exact hOmegaQ

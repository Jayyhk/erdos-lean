theorem doubleIntervalIntegral_gsA10JointHighMajorant_le_half
    {H : ℕ} (hH : 0 < H) {eta : ℝ} (heta : 0 ≤ eta) :
    (∫ alpha : ℝ in 0..eta,
      ∫ beta : ℝ in 0..eta,
        gsA10JointHighMajorant H alpha beta) ≤ 1 / 2 := by

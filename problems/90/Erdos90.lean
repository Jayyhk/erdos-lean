      CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity
        B.carrier K
    _ = B.card := by
      rw [Nat.card_eq_fintype_card]
      exact (B.finite_carrier.card_toFinset).symm

end

end Submission.CField.KTheory


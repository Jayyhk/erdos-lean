/-- Part (d): the norm group of an intersection is generated by the two
norm groups. -/
theorem normGroup_inf
    (phi : Kˣ →* AbsoluteAbelianGalois K)
    (hphi : ∀ L : FASubext K,
      InducesLocalReciprocity K phi L)
    (L L' : FASubext K) :
    (L.inf L').normGroup = L.normGroup ⊔ L'.normGroup := by
  let M := L.inf L'

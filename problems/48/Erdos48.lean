        mem_dirichletExplicitFormulaCandidateSingularitiesFinset_iff.mp hrho
    · intro s hsRect hsP
      apply
        differentiableAt_dirichletExplicitFormulaIntegrand_of_mem_rectangle_of_not_candidate

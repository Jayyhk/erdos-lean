theorem prod_primesLEAsPrimes
    (R : ℕ) (f : ℕ → ℝ) :
    (∏ p ∈ primesLEAsPrimes R, f p) =
      ∏ p ∈ Nat.primesLE R, f p := by
  classical
  unfold primesLEAsPrimes

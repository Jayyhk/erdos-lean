    simp_rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
    push_cast
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  have hreal := congrArg Complex.re hcomplex
  simpa only [Complex.ofReal_re, Complex.add_re] using hreal


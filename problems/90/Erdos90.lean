@[simp]
private theorem power_quotient_mk (I : Ideal R) (e n : ℕ) (x : R) :
    powerQuotientEquiv I e n
        (Submodule.mkQ ((I ^ e) ^ n • (⊤ : Submodule R R)) x) =
      Submodule.mkQ (I ^ (e * n) • (⊤ : Submodule R R)) x :=
  rfl

@[simp]
private theorem power_symm_mk (I : Ideal R) (e n : ℕ) (x : R) :
    (powerQuotientEquiv I e n).symm

theorem mean_sub_one_sq_eq
    {Ω : Type*} [Fintype Ω] [Nonempty Ω]
    (f : Ω → ℝ) :
    mean (fun x => (f x - 1) ^ 2) =
      mean (fun x => f x ^ 2) - 2 * mean f + 1 := by
  calc
    mean (fun x => (f x - 1) ^ 2) =

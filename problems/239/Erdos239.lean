    {I : ℕ × ℕ} {y X n : ℕ} {T density remainder : ℝ}
    (hT : 0 < T) (hnWindow : n ∈ gsA10PrimeWindow y X)
    (hIz : ∀ q ∈ Erdos67.primesInBlock I,

  rw [map_sub]
  by_cases hd0 : d.degree = 0
  · have hdzero : d = 0 := (Finsupp.degree_eq_zero_iff d).mp hd0
    subst d
    simp [coeff_zero_eq_constantCoeff_apply, hzero]
  · have hd1 : d.degree = 1 := by omega
    rw [sub_eq_zero]
    have h := congrArg (coeff d) hone

  [IsGalois F E] [Algebra k E] [IsScalarTower k F E] in
@[simp]
theorem crossed_change_tmul
    (i : L →+* E) (g : Gal(L/k) ≃* Gal(E/F))
    (hi : ∀ sigma : Gal(L/k), ∀ a : L,

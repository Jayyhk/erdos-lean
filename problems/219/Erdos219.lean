          fixedUpperLayerComplexityFactor
              j B (R.index + 1) *
            initialBound :=
        Nat.mul_le_mul_left _ (hinitial e)
      _ =
          growthRegularityComplexity
            k j initialBound F (R.index + 1) := by
        rw [growthRegularityComplexity_eq_factor_mul]


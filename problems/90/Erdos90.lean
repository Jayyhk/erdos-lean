  letI : Algebra C B :=
    adicCompletionAlgebra (K := K) (L := L) P hP Q
  letI : Algebra B E := B.subtype.toAlgebra
  letI : Algebra C E :=
    adicIntegerAlgebra (K := K) (L := L) P hP Q
  letI : Algebra F E :=
    adicFactorAlgebra (K := K) (L := L) P hP Q

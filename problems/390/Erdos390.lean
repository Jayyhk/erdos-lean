    have hpR : (0 : ℝ) < p := by exact_mod_cast hpPos
    have hpredPosNat : 0 < p - 1 := Nat.sub_pos_of_lt hpPrime.one_lt
    have hpredPos : (0 : ℝ) < ((p - 1 : ℕ) : ℝ) := by

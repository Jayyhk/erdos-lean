abbrev finiteCoordinate
    (K : Type u) [Field K] [NumberField K]
    (a : IdeleGroup (OK_v86 K) K) (P : HeightOneSpectrum (OK_v86 K)) :
    (P.adicCompletion K)ˣ :=
  a.2.1 P


    (χ ψ : CharacterModule (Additive G)) (g : G) :
    ∃ z : ℤ, (z : ℚ) =
      rationalCharacterLift (χ + ψ) g -
        rationalCharacterLift χ g - rationalCharacterLift ψ g := by
  let q := rationalCharacterLift (χ + ψ) g -
    rationalCharacterLift χ g - rationalCharacterLift ψ g

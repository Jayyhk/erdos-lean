    _ = Real.exp M *
          (‖selectedZeroProduct_v1 f c R c‖⁻¹ * ‖f c‖) := by ring

private theorem norm_selectedRegularFactor_le_on_outer_closedBall_v1
    {f : ℂ -> ℂ} {c z : ℂ} {R M : ℝ} (hR : 0 < R)
    (hf : AnalyticOnNhd ℂ f (closedBall c (4 * R))) (hc : f c ≠ 0)
    (hbound : ∀ w ∈ sphere c (4 * R),
      ‖f w‖ ≤ Real.exp M * ‖f c‖)
    (hz : z ∈ closedBall c (4 * R)) :

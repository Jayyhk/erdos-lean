            simpa [localInterval] using hdLocal m
          rw [hdm]
          apply Finset.mem_filter.mpr
          exact ⟨Nat.mem_divisors.mpr
            ⟨one_dvd _, (ha.coordinate_squarefree m).ne_zero⟩, by
              rw [hrm]⟩
        · simpa [localInterval, hh] using hdLocal h
      · simpa [localInterval] using hdLocal m

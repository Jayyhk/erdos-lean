      IsOpen (IdeleUnitSubgroups (NumberField.RingOfIntegers K) K v :
        Set (v.adicCompletion K)ˣ)) :=
    ⟨fun v ↦ ideleUnitSubgroups_open K v⟩
  have hHdense : Dense (H : Set (IK_v46 K)) :=
    hdense.mono hsmall_le_H

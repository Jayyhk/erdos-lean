def StrictAntichainReducedHardCoreOn (CKK : ℝ) (α : Type*) [DecidableEq α] : Prop :=
  ∀ (X : Finset α) (A : Finset (Finset α)) (q : ℝ),
    0 < q → q < 1 →
    (∀ S ∈ A, S ⊆ X) →
    InclusionAntichain A →

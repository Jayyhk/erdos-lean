    rw [div_le_iff₀ Real.pi_pos]
    nlinarith [Real.pi_gt_three]
  have hpow :
      20 / Real.pi ≤ 32 * (((x : ℝ) / n) ^ alpha) := by
    nlinarith
  calc
    20 / (Real.pi * U) = (20 / Real.pi) / U := by ring
    _ ≤ (32 * (((x : ℝ) / n) ^ alpha)) / U :=
      div_le_div_of_nonneg_right hpow hU.le


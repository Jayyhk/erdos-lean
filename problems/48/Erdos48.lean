structure CoverData (m k : ℕ) where
  a : ℕ → ℕ
  q : ℕ
  q_prime : q.Prime
  m_le_q : m ≤ q
  q_le_2m : q ≤ 2 * m - 2
  k_ge_4m : 4 * m + 4 ≤ k
  q_dvd_k : q ∣ k

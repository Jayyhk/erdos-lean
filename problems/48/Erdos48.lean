          (1000000 * (L : ℝ) ^ 2)) * (r : ℝ) := by ring
  unfold powerSieveGoodRootWeight
  have hrewrite :
      (powerSieveX n L : ℝ) /
          ((q : ℝ) * Real.log (powerSieveX n L : ℝ) *
            (1000000 * (L : ℝ) ^ 2)) * (r : ℝ)⁻¹ =

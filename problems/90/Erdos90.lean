    [Fact v.IsNontrivial]
    (α : L) (hα : Algebra.adjoin K {α} = ⊤) (g : v.Completion[X])
    (hmonic : g.Monic) (hirr : Irreducible g)
    (hg : g ∣ (minpoly K α).map (completionEmbedding v)) :
    AbsoluteValue.LiesOver
      (absoluteExtensionFactor v α hα g hmonic hirr hg) v := by
  constructor
  ext x

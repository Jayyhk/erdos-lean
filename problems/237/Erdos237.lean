        _ = C * (x : ℝ)⁻¹ := mul_comm _ _
    rw [hrepresentation]
    calc
      ‖((y : ℂ)⁻¹ * characterCumulative chi (y : ℝ) -
          (x : ℂ)⁻¹ * characterCumulative chi (x : ℝ)) -

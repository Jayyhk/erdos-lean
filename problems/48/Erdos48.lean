  calc
    (1 : ℝ) ≤ 2 * 1 * 1 * 1 := by norm_num
    _ ≤ 2 * (4 / 3 : ℝ) * Real.sqrt (4 / 3 : ℝ) *
        (1 / 3 + 3 / (2 * Real.log 2)) := by
      gcongr
      norm_num


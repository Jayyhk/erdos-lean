      exact restrictionCochainsShort A H 2 (by omega) hvanish
  letI : Finite X.X₁ := by
    dsimp only [X, restrictionCochainsComplex]
    infer_instance
  letI : Finite X.X₃ := by
    dsimp only [X, restrictionCochainsComplex]
    infer_instance

    have hsP := (sP h).property
    have hfirst := normalized_surj_maps p hp h
    change (sP h).1.1 = h at hfirst
    change f (sP h).1.1 = q (sP h).1.2 at hsP
    rw [hfirst] at hsP
    exact hsP.symm

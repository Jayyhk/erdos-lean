      hasseGlobalRepresentation K L := by
  apply Rep.mkIso
  refine
    { toLinearEquiv := LinearEquiv.refl (ULift.{u} ℤ) (Additive Lˣ)
      isIntertwining' := ?_ }
  intro sigma
  rfl


private theorem primes_above_image
    (P : HeightOneSpectrum (NumberField.RingOfIntegers K))
    (sigma : Gal(L/K))
    (alpha : ∀ w : CompletionPlacesAbove
      (L := L) (FinitePlace.mk P).val, w.1.Completion)

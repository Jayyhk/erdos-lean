  constructor
  · filter_upwards with z
    have hdensity : Integrable (fun u : E ↦
        standardGaussianDensity E (u + b z)) volume := by
      have hbase :=
        (integrable_standardGaussianDensity_volume (d := d)).comp_sub_right (-b z)

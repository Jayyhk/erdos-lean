lemma augmentationClass_coe (g : G) :
    (augmentationClass G g : IntegralGroupRing G) = single g 1 - single 1 1 :=
  rfl

@[simp]
lemma augmentationClass_one : augmentationClass G 1 = 0 := by
  apply Subtype.ext
  change single 1 (1 : ℤ) - single 1 1 = 0

        rw [(D.edgeArc e).carrier_eq]
        exact ⟨j.1, by omega, hxj⟩
    · rcases Set.mem_iUnion.mp hx_vertices with ⟨v, hxv⟩
      exact hcenter_not_vertex v (by simpa using hxv)
    · rcases Set.mem_iUnion.mp hx_centers with ⟨y, hxy⟩

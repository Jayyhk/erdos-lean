          (gsA10LambdaWindow (gsA9HighGeneralizedMangoldt hmul y) y X)
          ((sigma₁ : ℂ) + Complex.I * (t : ℂ)) *
        LSeries
          (gsA10LambdaWindow (gsA9HighGeneralizedMangoldt hmul y) y X)
          ((sigma₂ : ℂ) + Complex.I * (t : ℂ)) -
        gsA10PrimeLambdaPolynomial hmul y X sigma₁ (-t) *
          gsA10PrimeLambdaPolynomial hmul y X sigma₂ (-t)‖ ≤
      gsA10LambdaVerticalSplitError y X sigma₁ sigma₂ := by

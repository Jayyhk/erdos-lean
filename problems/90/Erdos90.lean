theorem unramifiedUnitBridge :
    UnramifiedUnitBridge.{u} := by
  intro K L _ _ _ _ _ _ P hUpper x hx
  let Q := chosenPrimeFactor (K := K) (L := L) P
  exact norm_lift_unramified
    (K := K) (L := L) P Q (hUpper Q) x hx


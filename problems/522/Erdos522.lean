    _ = (∫ ω : SignVector N, Complex.ofReal ((realSign (ω i) * realSign (ω j)) *
        (realSign (ω k) * realSign (ω l))) ∂signMeasure N) *
        (∫ θ : AddCircle (1 : ℝ), inner ℂ (fourier ((i : ℤ) - (j : ℤ)) θ)

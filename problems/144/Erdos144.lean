harmonic stage. -/
theorem stage_normalizedOffDiagonalExpectation_le_1200 (s j : ℕ) :
    normalizedOffDiagonalExpectation
        (Finset.Ioc (Harmonic.lowerScale s) (Harmonic.stageTop s j))

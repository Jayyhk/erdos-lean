    mul_pos hdensity B.L_pos
  have hfactor : 0 ≤ Cmass / (density * B.L) :=
    div_nonneg hCmass hden.le
  have hscaled :
      (Cmass / (density * B.L)) *
          (density * (B.sampleData.n : Real)) ≤

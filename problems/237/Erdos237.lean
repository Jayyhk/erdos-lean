            ∑ h ∈ Finset.Icc 1 (y / d),
              χ h * (Real.log h : ℂ)‖ =
            ‖((ArithmeticFunction.moebius d : ℝ) : ℂ)‖ * ‖χ d‖ *
              ‖∑ h ∈ Finset.Icc 1 (y / d),
                χ h * (Real.log h : ℂ)‖ := by rw [norm_mul, norm_mul]
        _ ≤ 1 * 1 *
              ‖∑ h ∈ Finset.Icc 1 (y / d),
                χ h * (Real.log h : ℂ)‖ := by
            gcongr
            exact χ.norm_le_one d

      (Monoid.exponent Gal(L.carrier/K)) :=
    HasEnoughRootsOfUnity.of_dvd K hexp
  letI : CommGroup Gal(L.carrier/K) :=
    { (inferInstance : Group Gal(L.carrier/K)) with mul_comm := mul_comm' }

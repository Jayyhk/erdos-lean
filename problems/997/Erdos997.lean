        maynardS2G (r h)) *
          maynardS2WeightedOffFaceSum H R W y m r := by
  rw [maynardS2RestrictedYFromCoefficientFromY_eq_weightedFaceSum
    hy m hr hrm]
  rw [maynardS2WeightedFaceSum_eq_main_add_off m hrm, mul_add]


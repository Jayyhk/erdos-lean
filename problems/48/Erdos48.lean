              realFrequencyPolynomial x (u k) t‖ ^ 2 /
            ((k.factorial : ℝ))⁻¹ := by
  unfold blockTaylorPolynomial
  apply norm_finset_sum_sq_le_sum_mul_sum_sq_div
  intro k hk
  positivity

/-- Hybrid large-sieve estimate after a Dirichlet polynomial has been split

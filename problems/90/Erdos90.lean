    GAWt.groupAlgebraMagnus
        (R := ℤ) (X := X)
        (freeAssociativeRealization ℤ X p.1 -
          (a : MonoidAlgebra ℤ (FreeGroup X))) w.1 =
      0 at hzero
  rw [map_sub,
    magnus_associative_realization] at hzero

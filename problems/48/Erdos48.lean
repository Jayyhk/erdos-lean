        analyticOrderNatAt (DirichletCharacter.LFunction chi) rho
      else 0 := by
  apply (divisor_LFunction_closedBall_support_finite
    (character_ne_one_of_isPrimitive hq chi hchi)
    ((2 : ℂ) + t * I) 6).subset

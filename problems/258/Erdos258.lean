theorem coprime_divisorTupleProduct_quotient
    {H : Finset ℕ} {d r : H → ℕ}
    (hdr : ∀ h : H, d h ∣ r h)
    (hr : Squarefree (divisorTupleProduct H r)) :
    Nat.Coprime (divisorTupleProduct H d)

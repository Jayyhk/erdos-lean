theorem half_pretentiousDistSq_le_deletePrimeBand
    {f g : ℕ → ℂ}
    (hf : ∀ p, p.Prime → ‖f p‖ ≤ 1)
    (hg : ∀ p, p.Prime → ‖g p‖ ≤ 1)
    (Q : ℕ → Prop) [DecidablePred Q] (X : ℕ) :

namespace BoundedGaps.Maynard

open scoped BigOperators

def divisorTupleQuotient {H : Finset ℕ} (d r : H → ℕ) : H → ℕ :=
  fun h => r h / d h

theorem divisorTuple_mul_quotient_coordinate
    {H : Finset ℕ} {d r : H → ℕ}
    (hdr : ∀ h : H, d h ∣ r h) (h : H) :

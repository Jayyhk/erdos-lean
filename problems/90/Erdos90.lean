theorem subsingleton_cohomology_normal
    [Fintype G] (A : Rep.{u} k G) (H : Subgroup G) [H.Normal]
    [Fintype H] [Fintype (G ⧸ H)]
    (hH : Subsingleton
      (tateCohomologyZero (Rep.res H.subtype A)))

/-!
# Alternating-sum form of the Hall-Witt strict-tail origin boundary

The remaining origin compatibility condition for a successor-precomposed
collection polynomial is finite: in the Newton basis, evaluation at `-1` is
the alternating sum of the Newton coefficients.  Package that reduction for
individual coordinate families and then for every cutoff-profile slot.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace ASAdapt

open WSTrace
open TBProf
open TACompos
open OTSubsti
open OCAdapt
open OVAdapt
open FPMultip
open PMExp

/-- The finite Newton-coefficient condition asserting that the polynomial
selected by the positive-input values of `f` vanishes at formal predecessor
input `-1`. -/
def SuccessorAlternatingVanishes
    (degreeBound : ℕ)
    (f : ℕ → ℤ) :
    Prop :=
  ∑ k ∈ Finset.range (degreeBound + 1),
      natBinomialCoefficient (fun steps : ℕ => f (steps + 1)) k *
        (-1 : ℤ) ^ k = 0

/-- For a polynomial successor-precomposition, vanishing at `-1` is exactly
the finite alternating Newton-coefficient identity. -/
lemma vanish_alternating_vanishes
    {degreeBound : ℕ}
    {f : ℕ → ℤ}
    (hsucc :
      IVMost
        (fun steps : ℕ => f (steps + 1)) degreeBound) :
    SuccessorVanishNeg f ↔
      SuccessorAlternatingVanishes degreeBound f := by
  let g : ℕ → ℤ := fun steps => f (steps + 1)
  let Q : Polynomial ℚ := natBinomialExpansion g degreeBound
  have hQeval :
      ∀ steps : ℕ, Q.eval (steps : ℚ) = (f (steps + 1) : ℚ) := by
    intro steps
    dsimp only [Q]
    rw [binomial_expansion_polynomial]
    norm_cast
    exact (hsucc.nat_binomial_basisexpansion steps).symm
  constructor
  · intro hvanish
    have hQnegOne := hvanish Q hQeval
    dsimp only [Q] at hQnegOne
    rw [binomial_expansion_neg] at hQnegOne
    exact_mod_cast hQnegOne
  · intro hsum P hPeval
    have hPQ : P = Q := by
      apply Polynomial.eq_of_infinite_eval_eq
      apply Set.infinite_of_injective_forall_mem
        (Nat.cast_injective :
          Function.Injective (fun steps : ℕ => (steps : ℚ)))
      intro steps
      change P.eval (steps : ℚ) = Q.eval (steps : ℚ)
      rw [hPeval steps, hQeval steps]
    rw [hPQ]
    dsimp only [Q]
    rw [binomial_expansion_neg]
    exact_mod_cast hsum

/-- Every slot in a cutoff profile satisfies the finite alternating
Newton-coefficient origin identity. -/
def NewtonAlternatingVanish
    (degreeBound : ℕ)
    (family : ℕ → Multiset (CWord Atom)) :
    Prop :=
  ∀ slot,
    SuccessorAlternatingVanishes degreeBound
      (fun multiplicity : ℕ => (Multiset.count slot (family multiplicity) : ℤ))

/-- Slotwise positive-input polynomiality turns the vanishing-at-`-1`
condition into a finite alternating Newton-coefficient identity in every
cutoff-profile slot. -/
lemma vanish_alternating_sums
    {cutoff degreeBound : ℕ}
    {family : ℕ → Multiset (CWord Atom)}
    (hsucc :
      CPDataa cutoff degreeBound
        (fun steps : ℕ => family (steps + 1))) :
    SuccessorPolynomialsVanish family ↔
      NewtonAlternatingVanish degreeBound family := by
  apply forall_congr'
  intro slot
  apply vanish_alternating_vanishes
  exact hsucc.2 slot

/-- Positive strict-tail profiles are globally polynomial once the explicit
finite alternating Newton-coefficient identities hold. -/
lemma newton_sums_vanish
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (halternating :
      NewtonAlternatingVanish
        (naturalStrictBound cutoff)
        (fun multiplicity =>
          cutoffProfile cutoff
            (NPTail.strictTrace multiplicity))) :
    CPDataa cutoff
      (naturalStrictBound cutoff)
      (fun multiplicity =>
        cutoffProfile cutoff
          (NPTail.strictTrace multiplicity)) := by
  apply natural_vanish_neg
    cutoff hcutoff
  rw [
    vanish_alternating_sums
      (by
        simpa [naturalStrictBound] using
          cutoff_natural_succ cutoff hcutoff)]
  exact halternating

/-- Negative strict-tail profiles are globally polynomial once the explicit
finite alternating Newton-coefficient identities hold. -/
lemma alternating_sums_vanish
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (halternating :
      NewtonAlternatingVanish
        (negativeStrictBound cutoff)
        (fun multiplicity =>
          cutoffProfile cutoff
            (NNPower.strictTrace
              multiplicity))) :
    CPDataa cutoff
      (negativeStrictBound cutoff)
      (fun multiplicity =>
        cutoffProfile cutoff
          (NNPower.strictTrace
            multiplicity)) := by
  apply negative_vanish_neg
    cutoff hcutoff
  rw [
    vanish_alternating_sums
      (by
        simpa [negativeStrictBound] using
          cutoff_negative_succ cutoff hcutoff)]
  exact halternating

end ASAdapt

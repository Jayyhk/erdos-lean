    f ∈ weightedIdeal (R := R) (X := X) e n := by
  classical
  let quotientAtDegree (i : ℕ) : MSeries R X :=
    ⟨fun w =>
      if hi : 1 ≤ i ∧ i < n then
        if hw : w.length = i then
          Classical.choose
            (hf.2 w (by omega) (by omega))

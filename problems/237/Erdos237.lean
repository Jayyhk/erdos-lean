            ∑ n ∈ S, phase ((n : ℝ) * (y r - y s)) := by
      simp only [Complex.star_def]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro r _
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro s _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n _
      simp only [map_mul]

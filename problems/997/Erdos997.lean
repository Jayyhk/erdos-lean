/-- The centered theta floor-step integrand is genuinely interval-integrable
on every natural source interval. -/
theorem intervalIntegrable_centeredThetaProgressionError_div_id_mul_log_sq
    {x q a : ℕ} (hx : 2 ≤ x) :

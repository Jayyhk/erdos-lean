        (Chebyshev.psi (x : ℝ) - Chebyshev.theta (x : ℝ))) := by
      apply mul_le_mul_of_nonneg_left (maxCenteredThetaProgressionDiscrepancyUpTo_le hq)
      positivity
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)

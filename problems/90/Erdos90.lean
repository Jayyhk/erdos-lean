variable {p : ℕ} (FP : FPres p)

/-- Prefix of a coefficient sequence shifted by a depth `q`, with out-of-range
terms omitted. -/
noncomputable def shiftedCoefficientPrefix (b : ℕ → ℕ) (N q : ℕ) : ℕ :=
  ∑ n ∈ Finset.range (N + 1), if _h : q ≤ n then b (n - q) else 0

end

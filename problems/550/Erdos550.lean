    simpa [f, Clean, clusterNormalizedDegree] using! h
  have htoWeight :=
    cleaned_endpoint_union_le_matchingWeight
      G D.P ε d D.scale D.scale_pos D.part_size_upper X cL cR hinj
  linarith


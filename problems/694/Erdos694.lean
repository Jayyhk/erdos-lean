      (differentiableAt_id.sub_const rho)
      (sub_ne_zero.mpr fun h => hsP (h ▸ hrho))
  · intro rho hrho
    have hf := hres rho hrho
    have hs := tendsto_mul_principalPartSum P c hrho
    simpa only [mul_sub, sub_self] using hf.sub hs


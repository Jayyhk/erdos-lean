      (negativeStrictBound cutoff) :=
  BCExp.binomialBasis 1
    (negativeStrictBound cutoff) (by omega)
      (fun multiplicity : ℕ =>
        (Multiset.count slot
          (cutoffProfile cutoff
            (NNPower.strictTrace
              multiplicity)) : ℤ))


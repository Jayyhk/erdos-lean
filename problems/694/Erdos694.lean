/-- The constructed totient value is bounded: `φ(ℓ · Q) ≤ A_Y · U²`. -/
lemma collision_n_le_A_mul_U_sq (Y U ℓ : ℕ) (hℓ : Nat.Prime ℓ) (hU_pos : 0 < U)
    (hU_lt : U < ℓ) (hAU : A Y * U = ℓ - 1) :

    invariantsMulEquiv e (pulledNorm (M := M) e x) =
      FMAct.norm G M x := by
  apply Subtype.ext
  change (∏ c : C (n := n), e c • x) = ∏ g : G, g • x
  exact Fintype.prod_equiv e.toEquiv _ _ (fun _ ↦ rfl)


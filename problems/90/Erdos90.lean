    have h := brauer_tensor_compatibility
      k L hcompat (1 : MHTwo (Gal(L/k)) Lˣ) 1
    simp only [one_mul] at h
    apply mul_left_cancel (a := h2Relative k L 1)
    simpa using h.symm
  map_mul' := brauer_tensor_compatibility k L hcompat


    {G H : Type*} [Group G] [Group H] (φ : G →* H)
    (honto : MapsOnto (zassenhausFiltration p G) (zassenhausFiltration p H) φ)
    (hinj : Function.Injective φ) (n : ℕ) (y : zLKern p H n) :

        ((uniformOnFinset (rawCell P I B.sampleData.n c)
            ((hremaining c).mono Finset.sdiff_subset)).exponentialTilt
          (fun m ↦ valuationScore
            (primeBand B.sampleData.n B.sampleData.W)
            (B.effectiveNatCoefficient xi) B.L (m : ℕ))).expect

theorem erdos_237 (A : Set ℕ) (hA : A.Infinite) :
    ∀ C : ℕ, ∃ n : ℕ, C < repCount A n := by
  intro C
  obtain ⟨ℓ₀, hℓ₀⟩ := chen_ding_theorem (C + 1)

theorem zero_cohomology_injective
    (I : Rep k G) [Injective I] (n : ℕ) (hn : 0 < n) :
    Limits.IsZero (groupCohomology I n) := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  exact cohomology_succ_injective I m


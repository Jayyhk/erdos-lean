theorem sum_weighted_norm_bilinear_natLogTwists_subset_Ioc_le
    (Q m0 M n0 N : ℕ) (sm sn : Finset ℕ)
    (hsm : sm ⊆ Finset.Ioc m0 (m0 + M))
    (hsn : sn ⊆ Finset.Ioc n0 (n0 + N))

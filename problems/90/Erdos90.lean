      let v : InfinitePlace K := w.comap (algebraMap K L)
      let vS : S := ⟨Sum.inr v, hSinf v⟩
      let z : CompletionPlacesAbove (L := L) v.1 :=
        ⟨w.1, infinite_lies_comap v w rfl⟩

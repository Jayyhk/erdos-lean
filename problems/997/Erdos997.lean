        (largeA * (largeK : ℝ)) :=
      div_lt_div_of_pos_right log_large_face_cutoff_gt hden

/-! ## Positivity of the denominator -/

def largeBoxWidth : ℝ := (2 * (largeK : ℝ))⁻¹

def largePositiveBox : Set (Fin largeK → ℝ) :=

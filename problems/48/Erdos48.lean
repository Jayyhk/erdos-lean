  have hAdA : Ad ≤ A := Nat.le_max_right Af Ad
  have hAfAReal : (Af : ℝ) ≤ A := by exact_mod_cast hAfA
  have hAdAReal : (Ad : ℝ) ≤ A := by exact_mod_cast hAdA
  have hA37 : 37 ≤ A := hAf.trans hAfA
  have hA0 : (0 : ℝ) ≤ A := by positivity

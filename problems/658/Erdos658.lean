    orderedRemovalFinePartitionComplexityBound
      (n + 1) 2 S.budget S.length
  let c : ℝ :=
    orderedRemovalConfigurationLowerBound k (n + 1)
      (orderedRemovalDensityFloor (n + 1) M ξ)
      (orderedRemovalCountingError k (n + 1) M ξ)
      (orderedRemovalCountingError k (n + 1) M ξ)

  apply Nat.eq_of_factorization_eq (primeBandPart_ne_zero P p) (by
    split <;> simp [hp.ne_zero])
  intro q
  rw [primeBandPart_factorization, hp.factorization]
  by_cases hP : P p
  · simp [hP, hp.factorization]
  · simp [hP]


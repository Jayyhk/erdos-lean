/-- Reciprocal Euler totients are submultiplicative on positive natural numbers. -/
theorem inv_totient_mul_le_mul_inv_totient
    {d k : ℕ} (hd : 0 < d) (hk : 0 < k) :
    ((d * k).totient : ℝ)⁻¹ ≤

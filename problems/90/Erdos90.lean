  (towerTensorCongr L M (A ⊗[k] L) (L ⊗[k] A)
      (Algebra.TensorProduct.commRight k L A).symm).trans
    (Algebra.TensorProduct.commRight L M (L ⊗[k] A)).symm |>.trans

          (denseGeneratorsElement p Λ y - 1) +
        (denseGeneratorsElement p Λ x - 1) := by
  rw [dense_element_mul]
  noncomm_ring

lemma dense_element_inv
    {p : ℕ} [Fact p.Prime]
    {Λ : Type u} [Group Λ]

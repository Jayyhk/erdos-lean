theorem modularBowenPairs_subset_flow_grid {η δ : ℝ} (hη0 : 0 ≤ η) (hη : η ≤ 1 / 2)
    (hδ : 0 < δ) (hδ1 : δ ≤ 1) :
    ∃ (N : ℕ) (s : Fin N → ℝ), (N : ℝ) ≤ 2 / δ ∧

          entryPoint i t = AffineMap.lineMap (a i) (b i) s) ∧
          (∃ s : ℝ, t.1 < s ∧ s < 1 ∧
            exitPoint i t = AffineMap.lineMap (a i) (b i) s))
    (horderedCutSeparation :
      ∀ i (t1 t2 : {t : ℝ // t ∈ centerParams i}),
        t1.1 < t2.1 →
          ∃ sExit sEntry : ℝ,
            t1.1 < sExit ∧

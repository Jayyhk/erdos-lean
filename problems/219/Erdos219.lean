open MeasureTheory
open scoped BigOperators

namespace SmoothSieveCutoff

/-- The two differentiated frequency weights add to the denominator of
the cutoff-normalizer kernel. -/
theorem cutoffDerivativeFrequencyWeight_add
    (t u : ℝ) :

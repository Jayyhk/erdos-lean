/-- Exact pointwise realization of one medium-prime event. -/
theorem exists_mediumSinglePrimePointwiseTransform
    {K p : ℕ} (hp : p.Prime) (hpCut : tinyCutoff K < p)
    (m : nearShifts K) :
    ∃ v : ℕ, ∀ n,

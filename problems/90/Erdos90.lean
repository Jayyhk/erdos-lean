    A.ρ g (transversalNorm A H S m) =
        ∑ q : G ⧸ H, A.ρ g (A.ρ (S.2.leftQuotientEquiv q : G) m) := by
          simp [transversalNorm]
    _ = ∑ q : G ⧸ H, A.ρ (g * (S.2.leftQuotientEquiv q : G)) m := by
          apply Fintype.sum_congr
          intro q
          simp [map_mul]

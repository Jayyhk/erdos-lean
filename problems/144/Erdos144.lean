/-- The sum of squared occupancies of the fibres of `block` on `D`. -/
def occupiedBinEnergy
    {α β : Type*} [DecidableEq α] [DecidableEq β]
    (D : Finset α) (block : α → β) : ℕ :=
  ∑ b ∈ D.image block, (D.filter fun a => block a = b).card ^ 2


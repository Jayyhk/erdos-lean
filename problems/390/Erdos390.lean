    eventually_abs_roughCanonicalAggregateGuardedPostchargeRowCorrection_le_strictScale
      W K0 (beta := beta) hc hdelta
  have hraw :=
    eventually_roughCanonicalAggregateRawRowCorrectionBound_strictScale
      W K0 (beta := beta) hc hdelta

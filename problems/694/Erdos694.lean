    calc
      |alpha - beta| ≤ |alpha| + |beta| := abs_sub alpha beta
      _ = alpha + beta := by
        rw [abs_of_nonneg halpha, abs_of_pos hbeta]
      _ = |beta + alpha| := by
        rw [abs_of_pos (add_pos_of_pos_of_nonneg hbeta halpha)]
        ring_nf
  rw [zpow_neg_one, zpow_neg_one]

    {d : ℕ} :
    CWord (HEAddres (concreteBasicCommutators.{u} d)) →
      HallTree (FreeGenerator.{u} d)
  | .atom address => concreteBasicTree address.2
  | .commutator left right => .commutator (tree left) (tree right)


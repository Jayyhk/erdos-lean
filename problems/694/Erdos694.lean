  have hγ : Real.exp Real.eulerMascheroniConstant ≠ 0 := (Real.exp_pos _).ne'
  have hDR : (D : ℝ) ≠ 0 := by exact_mod_cast hD.ne'
  simp only [dyadicRatio, Nat.cast_pow, Real.log_pow]
  field_simp


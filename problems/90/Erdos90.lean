private noncomputable abbrev oddEvenBoundary
    {G : Type u} [CommGroup G] [Fintype G]
    {X : ShortComplex (Rep.{v, 0, u} ℤ G)}
    (hX : X.ShortExact) (g : G) :
    cyclicTateOdd X.X₃ g ⟶

    nsmul_eq_mul, mul_comm] using h

private theorem sum_norm_le_sqrt_span_mul_sqrt_sum_sq
    {m0 M : ℕ} (s : Finset ℕ)
    (hs : s ⊆ Finset.Ioc m0 (m0 + M)) (a : ℕ → ℂ) :
    (∑ x ∈ s, ‖a x‖) ≤

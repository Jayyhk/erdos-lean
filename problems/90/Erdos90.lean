theorem exponent_coefficientScale
    {d inputWeight : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (factor : SPFactora H inputWeight)
    (coefficient : ℤ)
    (q : ℕ) :
    (factor.coefficientScale coefficient).exponent q =
      coefficient * factor.exponent q := by
  simp [coefficientScale, exponent, mul_assoc]


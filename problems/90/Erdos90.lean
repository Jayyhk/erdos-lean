      is_henselian := by
        intro p hp a ha hpa
        exact @HenselianRing.is_henselian U _ (maximalIdeal U)
          (IsAdicComplete.henselianRing U (maximalIdeal U))
          p hp a ha
          (hpa.map (Ideal.Quotient.mk (maximalIdeal U))) }

end


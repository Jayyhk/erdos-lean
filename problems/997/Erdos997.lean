          (maynardS2OuterScalarWeight_prime_nonneg hp)
          (by
            unfold maynardS2OuterSquarefreeMean
            apply Finset.sum_nonneg
            intro n hn
            exact maynardS2OuterSquarefreeAF_nonneg (primorial D) n)

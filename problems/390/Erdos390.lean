      b ∈ Finset.Icc 1
        (tangentPaperExceptionalCutoff deltaStar n / 2)) :
    roughCanonicalFourFiveFrozenCoordinate n b ∈
      Set.Icc ((41 : Real) / 10) ((47 : Real) / 10) := by

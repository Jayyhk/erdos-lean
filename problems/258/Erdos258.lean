/-- Exact pointwise realization of two distinct medium-prime events. -/
theorem exists_mediumPairPrimePointwiseTransform
    {K p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (hpCut : tinyCutoff K < p) (hqCut : tinyCutoff K < q)
    (m : nearShifts K) :

  · have hnot : ¬Nat.Coprime p W := by
      exact fun h => (hp.coprime_iff_not_dvd.mp h) hpW
    have hnot2 : ¬Nat.Coprime (p ^ 2) W := by
      exact fun h => hnot ((Nat.coprime_pow_left_iff (by norm_num : 0 < 2)

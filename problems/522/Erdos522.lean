theorem integral_sum_sq_le_card_mul_sum_integral_sq {Ω ι : Type*}
    [MeasurableSpace Ω] (μ : Measure Ω) (s : Finset ι) (f : ι → Ω → ℝ)
    (hf : ∀ i ∈ s, MemLp (f i) 2 μ) :
    (∫ x, (∑ i ∈ s, f i x) ^ 2 ∂μ) ≤

the corresponding natural-number budget. -/
theorem sum_scaledFloorCount_le
    {ι : Type*} [DecidableEq ι]
    (indices : Finset ι) (scale : ℝ) (weight : ι → ℝ) (total : ℕ)
    (hscale : 0 ≤ scale)
    (hweight : ∀ i ∈ indices, 0 ≤ weight i)
    (hbudget :

    intro p hp
    have hpm := mem_primesInInterval.mp hp
    exact mem_primesInInterval.mpr ⟨hpm.1, hpm.2.1.trans hKU, hpm.2.2⟩
  calc
    expWeightedPrimeTail y U ≤ expWeightedPrimeTail y (y ^ (K + 1)) := by

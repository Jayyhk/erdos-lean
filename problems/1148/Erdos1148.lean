    ENNReal.ofReal ((a * c) * Real.exp (-S)) =
        (modularHaarMeasure Set.univ)⁻¹ * ENNReal.ofReal (c * Real.exp (-S)) := by
      rw [mul_assoc, ENNReal.ofReal_mul ha.le, hae]

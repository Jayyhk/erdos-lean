    adicCompletionAlgebra (K := K) (L := L) P hP Q
  letI (Q : ι) : Algebra (B Q) (E Q) :=
    ((factorHeightSpectrum
      (P.asIdeal.map (algebraMap R S)) Q).adicCompletionIntegers L).subtype.toAlgebra

        _ ≤ 24 * (A : ℝ) * L := by
          have hlogNonneg :
              0 ≤ Real.log ((d : ℝ) * (|t| + 2)) := by
            apply Real.log_nonneg
            have hdOne : (1 : ℝ) ≤ d := by exact_mod_cast hd.le
            nlinarith [mul_le_mul_of_nonneg_left
              (show (1 : ℝ) ≤ |t| + 2 by linarith [abs_nonneg t])

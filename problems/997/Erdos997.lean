  · by_cases hpP : p ∣ P
    · have hpWP : p ∣ primorial D * P := dvd_mul_of_dvd_right hpP _
      simp [hpW, hpP, hpWP]
    · have hpWP : ¬p ∣ primorial D * P := by
        simpa [hpPrime.dvd_mul] using not_or_intro hpW hpP
      simp [hpW, hpP, hpWP]


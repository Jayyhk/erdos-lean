      Summable (N.smoothNumbers.indicator (correctionQuarterTerm W)) :=
    summable_subtype_iff_indicator.mp hEuler.2.summable
  calc
    (∑ n ∈ Finset.range N, correctionQuarterTerm W n) ≤

    (ha0 : 0 < a) (hb0 : 0 < b) (hc0 : 0 < c) (hd0 : 0 < d)
    (hab : a ≤ b) (hbc : b ≤ c) (hcd : c ≤ d)
    (hpair : a * b = c * d ∨ a * c = b * d ∨ a * d = b * c) :

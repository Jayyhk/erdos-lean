          dirichletCharacterSuffixMaximum x H q χ := by
      apply Finset.sum_le_sum
      intro a ha
      have haBounds := Finset.mem_Icc.mp ha
      have hpredPos : 0 < ((a - 1 : ℕ) : ℝ) := by
        exact_mod_cast (show 0 < a - 1 by omega)

open scoped TensorProduct

variable (k A B : Type u) [Field k]
  [Ring A] [Algebra k A] [IsSimpleRing A] [Algebra.IsCentral k A]
  [Module.Finite k A]
  [Ring B] [Algebra k B] [IsSimpleRing B] [Algebra.IsCentral k B]
  [Module.Finite k B]


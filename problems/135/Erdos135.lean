        (∅ : Set (EuclideanSpace ℝ (Fin 2))))
    (i : ι) {m n : ℕ}
    (hm : m + 1 < (assembledVertices i).length)
    (hn : n + 1 < (assembledVertices i).length)
    (hmn : m < n)

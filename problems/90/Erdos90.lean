    A.hV2.smul a (A.hV2.smul b x) = a • (b • x) := by
      rw [int_smul_eq_zsmul A.hV2 a (A.hV2.smul b x),
        int_smul_eq_zsmul A.hV2 b x]
    _ = (a * b) • x := smul_smul a b x
    _ = A.hV2.smul (a * b) x :=

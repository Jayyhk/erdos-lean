          _ = C * Sp := by dsimp [C]
    · -- High range empty.
      have hQlt : Q < (((2 * p : ℕ) : ℝ)) := lt_of_not_ge h2pQ
      have hQ_pos : 0 < Q := by dsimp [Q]; positivity
      have hhigh_zero :
          (∑ q ∈ Finset.filter
            (fun q => q.Prime ∧ q % p = 1 ∧ (((2 * p : ℕ) : ℝ)) < (q : ℝ) ∧ (q : ℝ) ≤ Q)
            (Finset.Iic ⌊Q⌋₊), (1 : ℝ) / (q : ℝ)) = 0 := by
        apply Finset.sum_eq_zero

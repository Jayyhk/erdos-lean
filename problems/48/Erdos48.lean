theorem three_eighths_mul_real_sqrt_le_sum_square_linearCutoff
    {X : ℕ} (hX : 4 ≤ X) :
    (3 / 8 : ℝ) * Real.sqrt (X : ℝ) ≤
      ∑ m ∈ Finset.Icc 1 X.sqrt,
        (1 - (m : ℝ) ^ 2 / (X : ℝ) : ℝ) := by

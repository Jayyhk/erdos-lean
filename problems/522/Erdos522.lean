  have hclipBad : μ E₃ ≤ ENNReal.ofReal (4 * T ^ 2 * v / u ^ 2) := by
    refine (measure_mono ?_).trans (measure_clippedLogarithmicIntegral_deviation_le μ ν X hX hX0 T hT v hvar u hu)

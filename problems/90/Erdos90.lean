    rintro a b ⟨haU, haN⟩ ⟨hbU, hbN⟩
    exact ⟨fun P ↦ (IdeleUnitSubgroup (OK_v128 K) K P).mul_mem
        (haU P) (hbU P),
      fun P hP ↦ (finiteCompletionNorm (K := K) (L := L) P (Q P)).range.mul_mem
        (haN P hP) (hbN P hP)⟩
  inv_mem' := by
    rintro a ⟨haU, haN⟩
    exact ⟨fun P ↦ (IdeleUnitSubgroup (OK_v128 K) K P).inv_mem (haU P),
      fun P hP ↦ (finiteCompletionNorm (K := K) (L := L) P (Q P)).range.inv_mem

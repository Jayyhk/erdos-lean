    · have heq : positivePartSq =ᶠ[𝓝 t] fun _ : ℝ ↦ 0 := by
        filter_upwards [Iio_mem_nhds htneg] with u hu
        change u < 0 at hu
        simp [positivePartSq, max_eq_right hu.le]
      rw [heq.hasDerivAt_iff]

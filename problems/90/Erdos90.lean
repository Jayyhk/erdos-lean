    apply Subtype.ext
    apply RestrictedProduct.ext
    intro Q
    rfl
  right_inv y := by
    funext P
    apply Subtype.ext
    funext Q
    rcases Q with ⟨Q, hQ⟩
    cases hQ
    rfl
  map_mul' x y := by
    funext P
    apply Subtype.ext
    funext Q
    rfl


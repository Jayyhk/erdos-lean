    by_cases hrk : r ≤ k
    · exact ne_of_lt (hcutoff.mpr hrk)
    · have hk1r : k + 1 ≤ r := Nat.succ_le_iff.mpr (lt_of_not_ge hrk)
      have hk1rR : ((k + 1 : ℕ) : ℝ) ≤ (r : ℝ) := by exact_mod_cast hk1r

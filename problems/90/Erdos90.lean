private theorem idele_transport_val
    (P : HeightOneSpectrum (NumberField.RingOfIntegers K))
    {Q Q' : FinitePrimesAbove (K := K) (L := L) P}
    (h : Q = Q')
    (x : IdeleUnitSubgroup

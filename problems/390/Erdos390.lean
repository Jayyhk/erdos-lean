            (fun m ↦ valuation p.1 (m : ℕ)) k| ≤
        (epsilonPrefix B.sampleData.n / (1 : ℝ)) *
          (1 / (p.1 : ℝ)) := by
    intro t ht
    rw [FiniteLogStieltjes.sum_centeredFiberMass_Icc_eq_covariance_prefixIndicator]
    calc
      _ ≤ epsilonPrefix B.sampleData.n / (p.1 : ℝ) :=
        hprefixN p c ⌊t⌋₊

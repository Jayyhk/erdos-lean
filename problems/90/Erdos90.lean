      (norm_completionEmbedding w.1 _).symm
    _ = ‖φ (completionEmbedding w.1 x)‖ := by
      rw [embedding_restrict_alg v.1 w.1]
    _ = ‖completionEmbedding w.1 x‖ := hnorm
    _ = w.1 x := norm_completionEmbedding w.1 x


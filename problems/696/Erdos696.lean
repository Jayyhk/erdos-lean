private lemma mem_quadraticEulerCutoff_iff
    {X : ℕ} {t : ℝ} (ht : 0 < t) (a : ℕ) :
    a ∈ Finset.Icc 1 (quadraticEulerCutoff X t) ↔
      a ∈ Finset.Icc 1 X ∧ (a : ℝ) ≤ (X : ℝ) / t := by
  rw [quadraticEulerCutoff, if_neg ht.ne']
  rw [Finset.mem_Icc, Finset.mem_Icc, Nat.le_min]

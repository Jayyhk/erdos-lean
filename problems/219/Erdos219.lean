    {κ : Type*} [Fintype κ] [DecidableEq κ]
    (P : Finset Nat.Primes) (z : κ → ℕ × ℕ) :
    FixedFamilyPrimeSupportAssignment κ P :=
  fun p => pairedPrimeSupport z (p : ℕ)


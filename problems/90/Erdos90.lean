  basicRawSource
      (jacobiSecondFactor factor left middle right hword) ++
    [(jacobiSecondFactor factor left middle right hword).neg] ++
      basicRawSource
          (jacobiFirstFactor factor left middle right hword) ++
        [jacobiSecondFactor factor left middle right hword] ++
          jacobiRawSource factor left middle right hword


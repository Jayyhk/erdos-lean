  obtain ⟨N, s, hN, hcover⟩ := exists_bowenTube_flow_grid hη0 hη hδ hδ1
  refine ⟨N, s, hN, ?_⟩
  rintro z ⟨g, h, rfl, hgh⟩
  obtain ⟨i, hi⟩ := hcover (g⁻¹ * h) hgh
  refine Set.mem_iUnion.mpr ⟨i, ?_⟩
  refine ⟨g, h * diagonalFlow (s i), rfl, ?_⟩
  simpa only [mul_assoc] using hi


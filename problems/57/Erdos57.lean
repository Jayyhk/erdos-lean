                have htwice : 2 * current.card ≤ Fintype.card V := by omega
                have htwiceReal : ((2 * current.card : ℕ) : ℝ) ≤
                    (Fintype.card V : ℝ) := by exact_mod_cast htwice
                norm_num at htwiceReal ⊢
                linarith))

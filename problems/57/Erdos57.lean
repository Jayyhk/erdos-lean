private def _root_.SimpleGraph.Walk.IsAvoidingPath (p : G.Walk x y) (X P : Set V) : Prop :=
  p.IsPath ∧ p.Avoids X P

private theorem _root_.SimpleGraph.Walk.IsAvoidingPath.mono_forbidden {p : G.Walk x y} {X X' P : Set V}
    (h : p.IsAvoidingPath X P) (hX : X' ⊆ X) : p.IsAvoidingPath X' P :=
  ⟨h.1, h.2.mono_forbidden hX⟩

private theorem _root_.SimpleGraph.Walk.IsAvoidingPath.mono_permitted {p : G.Walk x y} {X P P' : Set V}
    (h : p.IsAvoidingPath X P) (hP : P ⊆ P') : p.IsAvoidingPath X P' :=
  ⟨h.1, h.2.mono_permitted hP⟩

private theorem _root_.SimpleGraph.Walk.IsAvoidingPath.mapLe {G G' : SimpleGraph V} (hGG' : G ≤ G')
    {x y : V} {p : G.Walk x y} {X P : Set V} (h : p.IsAvoidingPath X P) :
    (p.mapLe hGG').IsAvoidingPath X P :=
  ⟨h.1.mapLe hGG', h.2.mapLe hGG'⟩

private theorem _root_.SimpleGraph.Walk.IsAvoidingPath.reverse {x y : V} {p : G.Walk x y} {X P : Set V}
    (h : p.IsAvoidingPath X P) : p.reverse.IsAvoidingPath X P :=

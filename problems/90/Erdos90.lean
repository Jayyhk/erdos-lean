    calc
      Nat.card I = P.ramificationIdxIn
          (NumberField.RingOfIntegers L) :=
        Ideal.card_inertia_eq_ramificationIdxIn P hP0 Q
      _ = P.ramificationIdx Q :=
        Ideal.ramificationIdxIn_eq_ramificationIdx P Q Gal(L/K)

        maynardS2WeightedFaceFactor H m r a
    else 0

noncomputable def maynardS2WeightedOffFaceSum
    (H : Finset ℕ) (R W : ℕ) (y : (H → ℕ) → ℝ)
    (m : H) (r : H → ℕ) : ℝ :=
  ∑ a ∈ maynardDivisorTupleSupport H R W,
    if (∀ h : H, r h ∣ a h) ∧ ¬IsMaynardS2MainFace m r a then

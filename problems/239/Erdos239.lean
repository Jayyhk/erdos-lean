    have hnOne : (1 : ℝ) ≤ n := by exact_mod_cast hnData.2.2.one_le
    have hnU : (n : ℝ) ≤ U := by
      dsimp only [U]
      exact_mod_cast hnData.2.1.le
    have hexp : 1 - sigma ≤ rho := by
      dsimp only [rho]
      exact le_max_left _ _
    have hpow :

    (x y : G)
    (r s : ℕ) :
    (iteratePairwiseError r s).eval (HPAtom.eval x y) =
      ⁅leftIteratedElement x ⁅x, y⁆ r,
        leftIteratedElement x ⁅x, y⁆ s⁆ := by
  simp [iteratePairwiseError]

@[simp]
lemma weight_pairwise_error

    (S : Finset (NumberFieldPlace K))
    (Q : primesAbovePlaces (K := K) (L := L) S)
    (x : L) :
    (upperPlacePrime (K := K) (L := L) S Q).2.1 x ^
        placeLogScale (K := K) (L := L) S Q =
      (FinitePlace.mk Q.1).1 x := by

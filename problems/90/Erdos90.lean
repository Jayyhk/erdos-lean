    ⁅innerWord.eval
          (PEAddres.freeLowerTruncation
            (n := n)) ^
        factor.exponent q,
      rightWord.eval
        (PEAddres.freeLowerTruncation
          (n := n))⁆
  let parent := factor.eval (n := n) q
  have hforward : temporary * parent⁻¹ ∈ K := by
    simpa [K, temporary, parent, SPFactora.eval,
      SPFactora.wordValue, hword] using
      (IPBridge.eval_zpow_series

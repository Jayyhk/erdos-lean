  obtain ⟨hodd, heven⟩ := cyclic_tate_left hX g
  letI : Finite (cyclicTateEven X.X₁ g) := heven
  letI : Finite (cyclicTateOdd X.X₁ g) := hodd
  exact ⟨Finite.of_equiv _ e₁₀.symm.toEquiv,

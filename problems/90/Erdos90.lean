/-- Cohomologous cocycles remain cohomologous after restriction. -/
theorem isCohomologous_restrict (f : H →* G)
    (hsmul : ∀ h : H, ∀ m : M, h • m = f h • m)
    {c d : NMCocycl₂ (G := G) (M := M)}

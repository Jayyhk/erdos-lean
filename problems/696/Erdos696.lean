def goldfeldPrimitiveNearOneZero
    (epsilon c : ℝ) (psi : GoldfeldPrimitiveRealCharacter) : Prop :=
  ∃ beta : ℝ,
    1 - c * (psi.modulus : ℝ) ^ (-epsilon) < beta ∧
      beta < 1 ∧

        (n : ℝ) * ((n : ℝ) + 1) / 2 := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
        rw [Finset.sum_Icc_succ_top (by omega), ih]
        push_cast
        ring
  simp_rw [div_eq_mul_inv]
  rw [← Finset.sum_mul, hsum_id]
  simp only [Nat.card_Icc]
  push_cast
  field_simp [hu.ne']
  ring

end BoundedGaps.Maynard


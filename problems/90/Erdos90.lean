/-- Representative formula for a left-union descent equivalence. -/
@[simp] theorem Hom.descrelators_unionleft_equivquotmap
    {P Q : Presentation.{u}} {S T : Set P.Free}
    (f : Hom (P.withRelators S) Q)
    (hT : ∀ ⦃t : P.Free⦄, t ∈ T → f.freeMap t ∈ Q.rNClos)

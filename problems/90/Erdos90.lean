`[[x, z], y]⁻¹`. -/
def firstConventionalInverse :
    CWord Atom :=
  rootSwapWord firstConventionalWord

/-- The first weight-three intermediate `[[z, x], y]`. -/
def firstIntermediateWord :
    CWord Atom :=
  .commutator (rootSwapWord xzWord) (.atom yAtom)


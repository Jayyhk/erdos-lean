          (fun _ => α) (fun _ => β)) e ≤
      (Fintype.card (OrderedPositiveSubface r) : ℝ) *
        ((coarseBound : ℝ) * α +
          (fineBound : ℝ) * P.totalAtomEnergyGap / β) := by
  calc
    OrderedPattern.faceDeletionDensity
        (P.orderedCoarseBadBaseDeletionFamily
          (fun _ => α) (fun _ => β)) e ≤
        ∑ q : OrderedPositiveSubface r,

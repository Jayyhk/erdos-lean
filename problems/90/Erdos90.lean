              rw [c.isMulCocycle₂, d.isMulCocycle₂]
      _ = g • (c (h, j) * d (h, j)) *
            (c (g, h * j) * d (g, h * j)) := by
              rw [smul_mul']
              ac_rfl
  map_one_fst g := by simp
  map_one_snd g := by simp


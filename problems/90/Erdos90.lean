      Units.map (Algebra.norm A) z := by
  calc
    _ = Units.map (Algebra.norm A) (Units.map (Algebra.norm B) z) :=
      units_norm_base e he _
    _ = Units.map (Algebra.norm A) z := (units_norm_trans z).symm


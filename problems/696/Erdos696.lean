        unfold firstKGoodBlockIndices
        rw [dif_pos hKle]
        exact Finset.orderEmbOfFin_mem _ _ ⟨i₀.val, lt_of_lt_of_le i₀.isLt hKle⟩
      rw [goodBlockIndices, Finset.mem_filter] at hk₀_mem
      obtain ⟨_, hk₀_good⟩ := hk₀_mem

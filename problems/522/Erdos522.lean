    (p := (3 : ℝ) / 2) (q := (3 : ℝ))
    (by exact ⟨by norm_num, by norm_num, by norm_num⟩)
    (fun i _ ↦ sq_nonneg (a i)) (fun _ _ ↦ by norm_num)

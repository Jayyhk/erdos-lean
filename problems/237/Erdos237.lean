    {H : Finset ℕ} (D : Finset (H → ℕ))
    (lambda : (H → ℕ) → ℝ) (u : H → ℕ) :
    (∑ d ∈ D,
        if ∀ h : H, u h ∣ d h then
          lambda d / (divisorTupleProduct H d : ℝ)
        else 0) ^ 2 =

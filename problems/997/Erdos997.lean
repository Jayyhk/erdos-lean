    apply Finset.sum_congr rfl
    intro d hd
    by_cases hrd : ∀ h : H, r h ∣ d h
    · rw [if_pos hrd]
      apply Finset.sum_congr rfl
      intro e he
      rw [if_pos hrd]
    · rw [if_neg hrd]

          ≤ (1 / Real.log 2) * (Real.log p / (p : ℝ)) := h_logpp_ge_invp
        _ ≤ (1 / Real.log 2) * Sp := mul_le_mul_of_nonneg_left hSp_ge_logpp h1log2_nonneg

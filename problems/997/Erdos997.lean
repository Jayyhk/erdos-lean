  apply mul_le_mul_of_nonneg_left
  · calc
      ‖∑ χ : DirichletCharacter ℂ q,
          χ (a : ZMod q)⁻¹ * centeredTwistedChebyshevSum x q χ‖ ≤
          ∑ χ : DirichletCharacter ℂ q,
            ‖χ (a : ZMod q)⁻¹ * centeredTwistedChebyshevSum x q χ‖ := by

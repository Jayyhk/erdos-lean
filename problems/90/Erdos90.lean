  change localUnitOrder F (Additive.ofMul aF) = 0
  apply le_antisymm
  · have h := (local_order_valuation F aF 1).2
        (by simp [haFVal])
    simpa using h
  · have h := (local_order_valuation F 1 aF).2
        (by simp [haFVal])

      2 * Real.sin (Real.pi * (a.val : ℝ) / (q : ℝ)) := by
    rw [show (1 : ℂ) - ZMod.stdAddChar a =
      -(ZMod.stdAddChar a - 1) by ring, norm_neg,
      norm_stdAddChar_sub_one_eq_two_mul_abs_sin,
      abs_of_pos hsin]

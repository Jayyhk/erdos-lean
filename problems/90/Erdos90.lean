/-- Commutators add Magnus vanishing orders. -/
theorem magnus_difference_vanishes
    {g h : FreeGroup X} {m n : ℕ}
    (hg : VanishesBelow (magnusDifference (R := R) g) m)
    (hh : VanishesBelow (magnusDifference (R := R) h) n) :
    VanishesBelow

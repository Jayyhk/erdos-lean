        f z := by
    calc
      Finsupp.linearCombination R (fun i => f (b i)) (b.repr z) =
          f (Finsupp.linearCombination R b (b.repr z)) := by
            simp [Finsupp.linearCombination_apply, map_finsuppSum]
      _ = f z := by rw [b.linearCombination_repr]

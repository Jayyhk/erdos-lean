    apply Finset.sum_eq_zero
    intro e heBox
    by_cases hcond : divisorTupleProduct H e < R ∧
        (∀ h : H, d h ∣ e h)
    · rw [if_pos hcond]
      by_cases hye : y e = 0
      · simp [hye]
      · exact False.elim (hdNot
          (isMaynardDivisorTuple_of_mem_box_of_dvd hdBox (hy e hye) hcond.2))
    · rw [if_neg hcond]

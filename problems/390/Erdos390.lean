      qn * Tpost.baseline.cellMass cell ≤
        Cmass * (B.sampleData.n : Real) / B.L := by
    calc
      qn * Tpost.baseline.cellMass cell ≤ qn * 1 :=
        mul_le_mul_of_nonneg_left hcellLeOne H.activeMass_pos.le

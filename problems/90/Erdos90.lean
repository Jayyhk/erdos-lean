/-- Alternate orientation of the left-union inverse characterization. -/
@[simp] theorem Hom.eqdesc_relaunioleft_equivsymmapply
    {P Q : Presentation.{u}} {S T : Set P.Free}
    (f : Hom (P.withRelators S) Q)
    (hT : ∀ ⦃t : P.Free⦄, t ∈ T → f.freeMap t ∈ Q.rNClos)

          x⁻¹ := by
    calc
      _ = ((1 : ℕ) : ℝ) *
          (((((sigma : ℂ) + rho.im * I) - rho)⁻¹).re) := by
        dsimp [Zone]
        exact Finsupp.sum_single_index (a := rho) (b := 1)

def correctionPacketFactory
    {d n lowerWeight : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (factory :
      SSFtrya
        (n := n) H lowerWeight) :
    TSFtry
      (n := n) H lowerWeight where
  packet B A hB hA :=
    (factory.expansion B A hB hA).truncate

end SSFtrya

end TCTex

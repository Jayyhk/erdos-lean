theorem coinvariants_invariants_normal
    [Fintype G] (A : Rep.{u} k G) (H : Subgroup G) [H.Normal]
    [Fintype H] [Fintype (G ⧸ H)]
    (hH : Function.Surjective
      (normCoinvariantsInvariants (Rep.res H.subtype A)))

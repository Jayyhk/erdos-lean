  Phi : ℂ → ℂ
  agrees_on_right : ∀ {s : ℂ}, 0 < s.re → Phi s = goldfeldRawMellin s
  equals_candidate : ∀ s, Phi s = goldfeldMellinCandidate s
  meromorphic : MeromorphicOn Phi Set.univ

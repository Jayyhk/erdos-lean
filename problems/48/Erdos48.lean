      4 * (A : ℝ) * L := by
    calc
      _ ≤ ((∑ᶠ rho : ℂ, D rho : ℤ) : ℝ) / (1 / 2) := hsum0
      _ ≤ (2 * (A : ℝ) * L) / (1 / 2) := by gcongr
      _ = 4 * (A : ℝ) * L := by ring
  calc
    ‖logDeriv (DirichletCharacter.LFunction chi) s‖ =
        ‖(logDeriv (DirichletCharacter.LFunction chi) s -
            ∑ᶠ rho : ℂ, (D rho : ℂ) / (s - rho)) +
          ∑ᶠ rho : ℂ, (D rho : ℂ) / (s - rho)‖ := by ring_nf

  · intro hM
    letI : Finite (tateZero M) := hM.1
    letI : Finite (tateNegOne M) := hM.2.1
    letI : Finite (tateZero (kernel f)) :=
      (tate_finite_module (kernel f)).1
    letI : Finite (tateNegOne (kernel f)) :=
      (tate_finite_module (kernel f)).2

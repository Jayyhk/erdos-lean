private lemma endpointUnitDiskAssembly_segments_terminal
    {ι : Type*} [Fintype ι]
    (a b : ι → EuclideanSpace ℝ (Fin 2))
    (T : Finset (EuclideanSpace ℝ (Fin 2)))
    (r : EuclideanSpace ℝ (Fin 2) → ℝ)
    (centerParams : ι → List ℝ)
    (centerOfParam :

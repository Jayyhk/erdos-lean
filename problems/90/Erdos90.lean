  letI : IsAlgClosed Omega := IsAlgClosure.isAlgClosed K
  letI : IsAlgClosed Omega' := IsAlgClosure.isAlgClosed K
  exact Classical.choose
    (IsAlgClosed.surjective_restrictDomain_of_isAlgebraic
      (E := Omega) (M := Omega') i)


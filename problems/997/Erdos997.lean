    · rintro ⟨hnQ, hnPrime, hDn⟩
      exact ⟨⟨by omega, hnQ⟩, hnPrime⟩
    · rintro ⟨⟨hDn, hnQ⟩, hnPrime⟩
      exact ⟨hnQ, hnPrime, by omega⟩

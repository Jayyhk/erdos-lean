    {V : ℝ} (hV : 1 ≤ V) (X : ℕ) :
    (∑ n ∈ Finset.Ioc 0 X,
      (vaughanFourthCoefficient V n) ^ 2) ≤
      (4 / 3 : ℝ) * (X : ℝ) * (Real.log V + 3) ^ 2 := by

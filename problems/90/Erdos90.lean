    Module.finrank K (kummerField K Ω n hn B) =
        Nat.card Gal(kummerField K Ω n hn B/K) :=
      (IsGalois.card_aut_eq_finrank K (kummerField K Ω n hn B)).symm
    _ ≤ Nat.card (B.carrier →* Kˣ) :=
      Nat.card_le_card_of_injective

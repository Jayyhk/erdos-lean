/-- The averaged complex local factor of a carry-adjusted CFZ family is one
at a prime dividing `W`. -/
theorem complexWeightedLocalFactor_cfzCarryAdjusted_eq_one_of_dvd
    {κ : Type*} [Fintype κ] [DecidableEq κ]
    {k p : ℕ} [NeZero p]
    (N W b : ℕ)

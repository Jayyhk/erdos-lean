    · let ev := InfinitePlace.Completion.ringEquivRealOfIsReal hv
      let ew := InfinitePlace.Completion.ringEquivComplexOfIsComplex hw
      let Ew := InfinitePlace.Completion.isometryEquivComplexOfIsComplex hw

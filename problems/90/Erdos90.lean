    UnitNormLift K L P x := by
  classical
  obtain ⟨y, hy⟩ :=
    units_surjective_unramified
      (K := K) (L := L) P Q hQ ⟨x, hx⟩
  let q := upperPrime (K := K) (L := L) P Q

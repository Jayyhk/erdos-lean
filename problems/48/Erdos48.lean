      c * I * (Real.arctan (b / y) - Real.arctan (a / y)) := by
  have hpoint (x : ℝ) :
      c / (x + y * I) =
        c * (x / (x ^ 2 + y ^ 2) : ℝ) -
          c * I * (y / (x ^ 2 + y ^ 2) : ℝ) := by
    rw [div_eq_mul_inv, inv_add_mul_I]
    push_cast
    ring

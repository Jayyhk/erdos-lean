    {d n inputWeight : ℕ}
    (H : ∀ s : ℕ, BCWta.{u} d s) :
    Prop where
  insert :
    ∀ lowerWeight : ℕ,
      ¬n ≤ 2 * lowerWeight →
        TSNormalb
            (n := n) (inputWeight := inputWeight)
              (lowerWeight := lowerWeight + 1) H →
          TSInserta
            (n := n) (inputWeight := inputWeight)
              (lowerWeight := lowerWeight) H


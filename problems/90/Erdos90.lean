    {d : ℕ}
    (H : ∀ s : ℕ, BCWta.{u} d s)
    (inputWeight : ℕ) where
  address :
    HEAddres H
  coefficient :
    ℤ
  inputWeight_le :
    inputWeight ≤ PEAddres.weight address

namespace SSAtom

/-- The raw `choose q 1` symbolic factor attached to one source atom. -/
def factor
    {d inputWeight : ℕ}
    {H : ∀ s : ℕ, BCWta.{u} d s}

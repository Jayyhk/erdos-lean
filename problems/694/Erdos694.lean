    (s t : Finset ℕ) (hst : s ⊆ t) (c : ℕ → ℂ) :
    (∑ n ∈ t, ‖if n ∈ s then c n else 0‖ ^ 2) =
      ∑ n ∈ s, ‖c n‖ ^ 2 := by
  calc
    (∑ n ∈ t, ‖if n ∈ s then c n else 0‖ ^ 2) =

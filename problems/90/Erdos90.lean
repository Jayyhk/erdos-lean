  intro w₁ w₂
  have hw₁ : w₁.1.IsNontrivial := absolute_extension_nontrivial v w₁
  have hw₂ : w₂.1.IsNontrivial := absolute_extension_nontrivial v w₂
  have hna₁ : IsNonarchimedean w₁.1 :=
    absolute_extension_nonarchimedean v w₁
  have hna₂ : IsNonarchimedean w₂.1 :=
    absolute_extension_nonarchimedean v w₂

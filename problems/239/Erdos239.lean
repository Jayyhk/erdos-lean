  let uNat : Finset ℕ := u.image (fun p ↦ p.1.1)
  have hinj : Set.InjOn (fun p : {p : Nat.Primes // p ∉ primeSubtypeUpTo Y} ↦
      p.1.1) u := by
    intro p hp q hq hpq
    exact Subtype.ext (Subtype.ext hpq)
  have hsum :
      (∑ p ∈ u,
        (p.1.1 : ℝ) ^ (-(1 + (Real.log (Y : ℝ))⁻¹))) =
        ∑ p ∈ uNat,
          (p : ℝ) ^ (-(1 + (Real.log (Y : ℝ))⁻¹)) := by
    dsimp only [uNat]

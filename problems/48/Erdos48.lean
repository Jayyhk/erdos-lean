      apply Finset.sum_congr rfl
      intro n _hn
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro p hp
      rw [← (Nat.mem_divisorsAntidiagonal.mp hp).1]
      simp only [Nat.cast_mul]

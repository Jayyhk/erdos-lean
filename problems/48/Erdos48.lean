    have hzero :=
      (mem_dirichletNontrivialLFunctionZerosFinset_iff.mp hrhoData.1).1
    have hkernel := norm_dirichletExplicitFormulaKernel_le_of_re_le
      hx halpha hzero.2.1 hrhoData.2.le

def mul
    {d leftWeight rightWeight targetWeight : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    {ι : Type}
    (left : WBTerm H ι leftWeight)
    (right : WBTerm H ι rightWeight)

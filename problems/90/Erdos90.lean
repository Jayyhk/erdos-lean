  intro a
  rfl

/-- Inverse quotient associator sends middle-factor insertion to nested left-right insertion. -/
@[simp] theorem mFQuot.mapprod_assocsymm_inrinl
    (G H K : Type*) [Group G] [Group H] [Group K]

      apply Prod.ext
      · change
          ((f (1, 1))⁻¹ * (x.2⁻¹ • x.1⁻¹) *
                (f (x.2⁻¹, x.2))⁻¹) *
                (x.2⁻¹ • x.1) * f (x.2⁻¹, x.2) = (f (1, 1))⁻¹
        simp only [smul_inv']
        simp [mul_assoc]
      · exact inv_mul_cancel x.2)


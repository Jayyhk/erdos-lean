    (factorHeightSpectrum
      (P.asIdeal.map (algebraMap R S)) Q).adicCompletion L
  let A := C ⊗[R] S
  letI : Algebra C A := Algebra.TensorProduct.leftAlgebra
  letI : Algebra C F := C.subtype.toAlgebra

    have hregularTotal : ‖logDeriv riemannZeta₁ s‖ ≤
        ‖logDeriv riemannZeta₁ s -
          ∑ᶠ rho : ℂ, (D rho : ℂ) / (s - rho)‖ +
        ‖∑ᶠ rho : ℂ, (D rho : ℂ) / (s - rho)‖ := by
      calc
        ‖logDeriv riemannZeta₁ s‖ =

    dirichletPerronIntegral, dirichletPerronIntegral]
  change (((2 * Real.pi : ℝ) : ℂ)⁻¹) *
        (∫ t in -U..U,
          dirichletExplicitFormulaIntegrand chi x
            ((alpha : ℂ) + t * I)) =

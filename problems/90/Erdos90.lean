def PSRel.cutIndex
    {p d k : ℕ} {Q : Type u} [Group Q]
    (S : PSRel p d k Q)
    (r : S.RelatorIndex) : ℕ :=
  match S.relatorCode r with
  | Sum.inl _ => 0
  | Sum.inr i => i


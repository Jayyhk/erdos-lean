      riemannZeta (s t + (beta : ℂ))) := by
    rw [continuous_iff_continuousAt]
    intro t
    have hcomp :=
      (differentiableAt_riemannZeta (hshiftOne t)).continuousAt.comp
        (f := fun u : ℝ => s u + (beta : ℂ)) hshift.continuousAt
    simpa [Function.comp_def] using hcomp

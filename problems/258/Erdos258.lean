              a x * (∑ t ∈ P.powerset,
                (∏ p ∈ t, a p) * ∑ p ∈ t, b p) := by
            simp_rw [mul_add]
            rw [Finset.sum_add_distrib]
            congr 1
            · calc
                (∑ t ∈ P.powerset, (a x * ∏ p ∈ t, a p) * b x) =
                    ∑ t ∈ P.powerset, (a x * b x) * ∏ p ∈ t, a p := by
                  apply Finset.sum_congr rfl
                  intro t ht
                  ring

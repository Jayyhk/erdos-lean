      QuotientGroup.mk'
        (pthPowerSubgroup p (placeUnits K v.1))
          (coordinateHom K v.1 a.1) *
      QuotientGroup.mk'
        (pthPowerSubgroup p (placeUnits K v.1))
          (coordinateHom K v.1 b.1)
    rw [map_mul, map_mul]


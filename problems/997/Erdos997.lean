      analyticOrderAt riemannZeta₁ rho =
        analyticOrderAt riemannZeta rho := by
    calc
      analyticOrderAt riemannZeta₁ rho =
          analyticOrderAt (fun s => (s - 1) * riemannZeta s) rho :=
        analyticOrderAt_congr heq

  ∑ p ∈ (Q + 1).primesBelow,
    ∑ nu ∈ Finset.Icc 1 (Nat.log p Q),
      h (p ^ nu) * Real.log ((p ^ nu : ℕ) : ℝ)

/-- Explicit constant for the linear prime-power mass bound. -/

    (hdim : Module.finrank k A = (Module.finrank k L) ^ 2) :
    Subalgebra.centralizer k (i.range : Set A) = i.range := by
  let e := rangeEquiv k L A i
  letI : IsSimpleRing i.range :=
    IsSimpleRing.of_ringEquiv e.toRingEquiv inferInstance

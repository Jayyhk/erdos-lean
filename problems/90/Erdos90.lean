    [MulAction.IsPretransitive Gal(L/K) (CompletionPlacesAbove (L := L) v)] :
    Function.Surjective (completionUnitsCoinduced v w0) := by
  intro f
  exact ⟨coinducedCompletionUnits v w0 f,
    completion_units_coinduced v w0 f⟩


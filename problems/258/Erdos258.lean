    {H : Finset ℕ} {R W t : ℕ} {d : H → ℕ}
    (hd : IsMaynardDivisorTuple H R W d)
    (ht : t ∈ (lambdaQuotientTupleSupport H R d).image
      (divisorTupleProduct H)) :

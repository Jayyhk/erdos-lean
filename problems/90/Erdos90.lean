    {A B : ℤ}
    {g h : UniversalGroup}
    (hg : g ∈ subgroup A B)
    (hh : h ∈ subgroup A B) :
    g * h ∈ subgroup A B :=
  (subgroup A B).mul_mem hg hh

lemma inv_mem
    {A B : ℤ}
    {g : UniversalGroup}
    (hg : g ∈ subgroup A B) :

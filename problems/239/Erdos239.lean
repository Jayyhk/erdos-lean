  let primes := ascendingSievePrimes (P - 1) Q
  let D := Q ^ S
  let stop := rosserStoppingPredicate 100 D
  have hm := hmain (P - 1) Q S (by omega) (by omega) (by omega)
    hS hlog
  dsimp only at hm

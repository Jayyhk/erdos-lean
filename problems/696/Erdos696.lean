  · rintro ⟨ha1, haX, haf⟩
    refine ⟨⟨ha1, haX⟩, ?_⟩
    rw [Nat.le_floor_iff (div_nonneg (by positivity) ht.le)] at haf
    exact haf
  · rintro ⟨⟨ha1, haX⟩, har⟩
    refine ⟨ha1, haX, ?_⟩
    exact (Nat.le_floor_iff (div_nonneg (by positivity) ht.le)).mpr har


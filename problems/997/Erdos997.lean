noncomputable def dirichletExplicitFormulaCandidateSingularities
    {N : ℕ} [NeZero N] (chi : DirichletCharacter ℂ N)
    (z w : ℂ) : Set ℂ :=
  {rho | rho ∈ Complex.Rectangle z w ∧
    ((chi = 1 ∧ rho = 1) ∨
      ((rho ≠ 1 ∨ chi ≠ 1) ∧

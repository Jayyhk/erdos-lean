          (steps + 1) .empty))).apply 0 =
      (positiveSecondAffine cutoff).apply
        (positiveEmptyEndpoint cutoff steps) := by
  rw [
    schedule_affine_second,
    affine_iterate_prepend cutoff hcutoff,
    CPAffine.apply_comp,
    prepend_empty_prefix]
  rfl


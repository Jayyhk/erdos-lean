    (B : ℝ) ≤ Real.log (n : ℝ) := hB
    _ ≤ (Real.log (n : ℝ)) ^ 2 := by
      nlinarith [mul_nonneg (show 0 ≤ Real.log (n : ℝ) by linarith)

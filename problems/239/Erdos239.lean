theorem gsA9HighGeneralizedMangoldt_mul_high
    {f : ℕ → ℂ} (hmul : IsMultiplicativeOnPositiveNat f) (y : ℕ) :
    gsA9HighGeneralizedMangoldt hmul y * gsA9HighArithmetic f y =

      change ((subsetProd T (firstKResidueVector S y d K) : (ZMod d)ˣ) : ZMod d) = 1
      rw [hsubsetprod_one]
      rfl
    · -- (4) d < ∏ T_actual (paper line 1811: each prime > exp y > d).
      -- Pick any q in T_actual.  Since T_actual is the image of T (nonempty), T_actual nonempty.

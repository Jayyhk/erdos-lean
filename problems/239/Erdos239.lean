private theorem finite_primeSubtype_rpow_tail_le
    {Y : ℕ} (hY : 4 ≤ Y)
    (u : Finset {p : Nat.Primes // p ∉ primeSubtypeUpTo Y}) :
    (∑ p ∈ u,
      (p.1.1 : ℝ) ^ (-(1 + (Real.log (Y : ℝ))⁻¹))) ≤
      4 * (Real.log 2 + primeLogIntervalMertensConstant) / Real.log 2 := by

      Nf ≤ (qQ.comp φ).ker := by
    intro y hy
    change qQ (φ y) = 1
    apply (QuotientGroup.eq_one_iff (N := Nq) (φ y)).mpr
    exact Subgroup.lowerCentralSeries.map φ (n - 1) (Subgroup.mem_map_of_mem φ hy)

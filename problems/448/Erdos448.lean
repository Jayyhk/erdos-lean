noncomputable def tauInv (n : ℕ) : ℝ :=
  if n = 0 then 0 else 1 / (n.divisors.card : ℝ)

@[simp] lemma tauInv_zero : tauInv 0 = 0 := by
  simp [tauInv]

@[simp] lemma tauInv_one : tauInv 1 = 1 := by
  simp [tauInv]


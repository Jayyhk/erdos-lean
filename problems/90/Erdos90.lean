    funext P
    split <;> rfl
  map_add' x y := by
    funext P
    by_cases hP : (Sum.inl P.1 : NumberFieldPlace K) ∈ S
    · simp only [hP, ↓reduceDIte, Pi.add_apply]
    · simp only [hP, ↓reduceDIte, Pi.add_apply, add_zero]


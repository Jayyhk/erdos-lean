open CategoryTheory

/-- Every additive homomorphism from a finite group to `ℤ` is zero. -/
theorem additive_int_zero (G : Type) [AddGroup G] [Finite G]
    (f : G →+ ℤ) : f = 0 := by
  ext x
  obtain ⟨n, hn, hnx⟩ := (isOfFinAddOrder_of_finite x).exists_nsmul_eq_zero

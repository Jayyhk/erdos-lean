    ArithmeticFunction.IsMultiplicative.prodPrimeFactors_add_of_squarefree
      (ArithmeticFunction.IsMultiplicative.prodPrimeFactors
        (fun p : ℕ => p - 2))
      (ArithmeticFunction.isMultiplicative_zeta :

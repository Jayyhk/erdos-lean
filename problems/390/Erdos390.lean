        |B.actualCompensatedNatCoefficient q p| *
          (epsilonDiag * (1 / (p : ℝ)) +
            epsilonSecond * (1 / (p : ℝ)) ^ 2) := by ring

/-- The Poisson--Dickman reference marked row is controlled by the same

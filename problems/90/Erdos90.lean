  simp only [unop_comp] at hu
  dsimp only [F] at hu
  rw [ProjectiveResolution.isoExt, ProjectiveResolution.isoExt]
  dsimp [Ext]
  simp only [Category.assoc]
  slice_lhs 2 3 => rw [hu]

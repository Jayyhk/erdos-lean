  have hc0 : 0 ≤ vaughanCubeRoot x := vaughanCubeRoot_nonneg x
  have hc1 : 1 ≤ vaughanCubeRoot x := one_le_vaughanCubeRoot hx1
  have hsqrtq0 : 0 ≤ Real.sqrt q := Real.sqrt_nonneg q

    (ModuleCat.subsingleton_of_isZero htarget).elim _ _
  have htransfer := congrArg (fun f ↦ f x)
    (restriction_corestriction_degrees A H r)
  have hindex : H.index • x = 0 := by
    simpa [hres] using htransfer.symm

  have h0 : (0 : ℕ) ∉ ({1, 2} : Finset ℕ) := by simp
  have h1 : (1 : ℕ) ∉ ({2} : Finset ℕ) := by simp
  have hrange : Finset.range 3 = ({0, 1, 2} : Finset ℕ) := by
    ext j
    simp
    omega

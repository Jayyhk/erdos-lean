/-- The power-ratio schedule itself eventually forces the single global
divisor-box fit condition. -/
theorem eventually_two_mul_cfzDivisorBox_le_of_boundaryPower_tendsto_zero
    {k : ℕ}
    (hk : 2 ≤ k)
    (R Nseq : ℕ → ℕ)

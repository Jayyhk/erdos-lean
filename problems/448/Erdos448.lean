/-- The elementary dyadic series used to majorize every local tail. -/
lemma dyadic_shifted_weight_summable_and_tsum_le :
    Summable (fun j : ℕ => ((j + 2 : ℕ) : ℝ) * (1 / 2 : ℝ) ^ j) ∧

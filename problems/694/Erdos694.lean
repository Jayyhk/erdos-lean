    fun {q _d} hd ψ ↦ if P q then F hd ψ else 0
  rw [Finset.sum_filter, Finset.sum_filter]
  calc
    (∑ q ∈ Finset.Ioc 0 Q,
        if P q then
          ∑ d : q.divisors,
            ∑ ψ : primitiveCharacters d.1,
              F (Nat.dvd_of_mem_divisors d.2) ψ
        else 0) =
        ∑ q ∈ Finset.Ioc 0 Q,
          ∑ d : q.divisors,
            ∑ ψ : primitiveCharacters d.1,

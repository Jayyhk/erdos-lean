  toFun := crossedTransportFn i g hi c
  map_zero' := crossed_fn_zero i g hi c
  map_one' := crossed_fn_one i g hi c
  map_add' := crossed_fn_add i g hi c
  map_mul' := crossed_fn_mul i g hi c


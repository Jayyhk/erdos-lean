theorem residualPrimeBoundingSieve_rem_abs_le_max
    {U y z m d : ℕ} {hm : 0 < m} {hmEven : Even m}
    (hzU : z ≤ U / m) (hd : d ∣ residualSieveProduct y m) :
    |(residualPrimeBoundingSieve U y z m hm hmEven).rem d| ≤

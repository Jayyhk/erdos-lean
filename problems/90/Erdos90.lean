def empty_commutator_one
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    {ι : Type}
    (B A : SPFactor H ι)
    (hcommutator :
      ∀ e : ι → HEFam H,
        ⁅B.eval (n := n) e, A.eval (n := n) e⁆ = 1) :
    TSPkt n B A where
  factors := []
  listEval_eq e := by
    simpa using (hcommutator e).symm

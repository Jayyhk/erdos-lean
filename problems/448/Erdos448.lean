  by_cases hm : m = 0
  · subst m
    have hn : n = 1 := by simpa using hmn
    subst n
    simp
  by_cases hn : n = 0
  · subst n
    have hm1 : m = 1 := by simpa [Nat.coprime_comm] using hmn
    subst m
    simp
  simp only [tauInv, if_neg hm, if_neg hn, if_neg (Nat.mul_ne_zero hm hn)]
  rw [hmn.card_divisors_mul]
  push_cast
  simp only [one_div, mul_inv]


      · exact Or.inr ⟨by omega, hp.2.1, hp.2.2⟩
    · rintro (hp | hp)
      · exact ⟨hp.1, hp.2.1.trans hAB, hp.2.2⟩
      · exact ⟨lt_of_le_of_lt hyA hp.1, hp.2.1, hp.2.2⟩

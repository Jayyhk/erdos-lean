    (F : DFilt G) {m n k : ℕ} (h : m ≤ n) (hnk : n ≤ k) :
    termMapsKer (mapsOnto_id F) h (id_ker_le F k) hnk =
      MulEquiv.refl (F m ⧸ tSOf F h) := by
  ext q
  refine QuotientGroup.induction_on q ?_

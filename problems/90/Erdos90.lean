  (Ideal.primesOver p.asIdeal (𝓞 L)).ncard = Module.finrank K L ∧
    ∀ P ∈ Ideal.primesOver p.asIdeal (𝓞 L),
      Ideal.ramificationIdx p.asIdeal P = 1 ∧
        Ideal.inertiaDeg p.asIdeal P = 1


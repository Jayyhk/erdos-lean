    (concreteActionData (K := K) (L := L)).representation ⟶
      explicitIdeleRepresentation (K := K) (L := L) := by
  letI := idelesGaloisAction (K := K) (L := L)
  letI := ideleDistribAction (K := K) (L := L)
  exact Rep.ofHom
    { toLinearMap :=
        (MonoidHom.toAdditive
          (QuotientGroup.mk'

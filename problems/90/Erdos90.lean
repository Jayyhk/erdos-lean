    (input :
      EJInput
        (n := n) factor decomposition) :
    TJRecoll
      (n := n) factor decomposition :=
  TJRecoll.witt_strict_source
    decomposition input.left_isCommutator input.middle_isCommutator
      input.right_isCommutator input.strictTrace


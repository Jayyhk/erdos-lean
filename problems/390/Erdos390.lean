        subst A
        rw [sub_self]
        apply Finset.sum_eq_zero
        intro m hm
        unfold fourFiveAnchoredLogLogCellAtom
        rw [if_neg]
        have hmle : m <= n + 1 := by
          have hm' := Finset.mem_range.mp hm

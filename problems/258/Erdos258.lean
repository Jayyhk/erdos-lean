def oneCrossMoebiusTuple (H : Finset ℕ) :
    ∀ ab : H × H, ab ∈ offDiagonalPairs H → ℕ :=
  fun _ _ => 1

def nontrivialAuxiliaryMobiusSum
    (H : Finset ℕ) (D : Finset (H → ℕ))
    (lambda : (H → ℕ) → ℝ) : ℝ :=
  ∑ d ∈ D, ∑ e ∈ D,

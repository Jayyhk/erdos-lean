theorem fourFiveMovingSimplexTwoIntegratedHybridThree_sub_iterated
    {A Y y : Nat} {u : Real}
    (hy : 2 <= y) (hyA : y <= A) :
    fourFiveMovingSimplexTwoIntegratedHybridThree A Y y u -

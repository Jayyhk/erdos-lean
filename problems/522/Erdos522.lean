    indexMoment N 2 = ((N : ℝ) + 1) * (2 * N + 1) / (6 * (N : ℝ) ^ 2) := by
  have hn : (N : ℝ) ≠ 0 := by exact_mod_cast hN.ne'
  simp only [indexMoment, div_pow]
  rw [← Finset.sum_div, sum_index_sq]
  field_simp


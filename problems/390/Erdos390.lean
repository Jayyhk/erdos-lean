    add_sub_cancel_left, abs_one, mul_one] using hnorm

noncomputable def roughSaiasSelectorCellLedger (X m : ℕ) : ℝ :=
  (((X / m : ℕ) : ℝ) - ((X / (m + 1) : ℕ) : ℝ)) /
      Real.log (m : ℝ) +
    ((X / (m + 1) : ℕ) : ℝ) *
      (1 / Real.log (m : ℝ) -
        1 / Real.log ((m + 1 : ℕ) : ℝ))

theorem abs_sum_roughSaiasFullyRealBuchstabCellRemainder_le_selectorLedger
    {X M Z : ℕ} (hX : 0 < X) (hM2 : 2 ≤ M)
    (hupper : X ≤ M ^ 2) :

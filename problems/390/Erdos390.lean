    dsimp only [epsilon]
    rw [Finset.sum_mul]
  refine ⟨epsilon, hepsilon0, hepsilonRate, N₀, ?_⟩
  intro c n k p eta hN hpBand heta
  have hNc : Ncell c ≤ N₀ := by
    dsimp only [N₀]

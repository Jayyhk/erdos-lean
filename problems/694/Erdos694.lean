open scoped Topology

private local instance conductorNeZero_v7
    {q : ℕ} [NeZero q] (chi : DirichletCharacter ℂ q) :
    NeZero chi.conductor :=
  ⟨chi.conductor_ne_zero⟩

private lemma primitiveCharacter_ne_one_of_ne_one_v3

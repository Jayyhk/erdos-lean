          rw [MvPowerSeries.subst_comp_subst_apply
            (hasSubst_of_constantCoeff_zero
              (fun _ : Fin 1 ↦ by simp [FGLaw.binaryY])) hz h]
          congr 1
          funext k
          rw [FGLaw.binaryY, subst_X hz]
          rfl


/-- A purely finite dyadic crossover.  The hypotheses say that `Q` is
within a factor two of the real crossover `B/T`. -/
theorem dyadicMinSqrtCrossover_le {T B : ℝ} {Q i R : ℕ}
    (hT : 0 < T) (hB : 0 ≤ B) (hQ : 0 < Q)
    (hlow : T * Q ≤ B) (hhigh : B ≤ 2 * T * Q) :
    (∑ j ∈ Finset.Ico i R,
      min T (B / (2 : ℝ) ^ j) *
        Real.sqrt ((2 : ℝ) ^ (j + 1))) ≤
      80 * Real.sqrt (B * T) := by

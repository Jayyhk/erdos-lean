    linarith [hdev.1]
  rw [hfactor, abs_of_nonpos (sub_nonpos.mpr hprodLe), neg_sub]
  calc
    1 - ∏ p ∈ P, (1 - c p) ≤ ∑ p ∈ P, c p := hdev.2
    _ ≤ ∑ p ∈ P, primeTotientSquareWeight p := by
      apply Finset.sum_le_sum
      intro p hp

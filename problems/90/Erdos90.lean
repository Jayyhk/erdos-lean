    simpa using
      (List.eq_replicate_of_mem
        (a := F.recipe.erasedShape.eval (HPAtom.eval x y))
        (l := F.realizations.map
          fun w => (collapseWord w).eval (HPAtom.eval x y))
        (by
          intro z hz
          rcases List.mem_map.mp hz with ⟨w, hw, rfl⟩
          rw [F.collapse_word w hw]))

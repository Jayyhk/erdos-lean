graph in logarithmically many rounds. -/
structure LMConnectorSchedule (epsilon kappa : ℝ) (N D workspace : ℕ) where
  rounds : ℕ
  lower : ℕ → ℕ
  increment : ℕ → ℕ
  lower_zero : lower 0 ≤ D

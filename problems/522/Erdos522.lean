  rw [hbase] at hbin
  calc
    _ ≤ (Real.exp (σ * (x - a)) * M) *
        (2 ^ n * ((k + n).choose n : ℝ)) := by simpa only [n, mul_assoc] using hp
    _ ≤ (Real.exp (σ * L) * M) * (8 * Real.exp 1 * L / l) ^ n :=
      mul_le_mul (mul_le_mul_of_nonneg_right hexp hM) hbin (by positivity)
        (mul_nonneg (Real.exp_pos _).le hM)
    _ = _ := rfl

end

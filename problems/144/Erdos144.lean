          if Selects q M then
            (2 / (3 * (M.1 : ℝ))) * energyProfileWeight I q
          else 0 := by
      apply Finset.sum_congr rfl
      intro q _
      by_cases hqM : Selects q M
      · simp only [hqM, if_true, Finset.sum_const, nsmul_eq_mul,

    Real.log ‖L ↗ψ (polynomialHeightEulerPoint Y v)‖ + ∑' p, ‖g p‖
  change truncatedPolynomialHeightEulerLog ψ Y v +
      (∑' p, (g p).re) =
    Real.log ‖L ↗ψ (polynomialHeightEulerPoint Y v)‖ at hsplit

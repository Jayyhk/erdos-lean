theorem meromorphicOrderAt_ne_top_of_entire {f : ℂ → ℂ}
    (hf : AnalyticOnNhd ℂ f univ) (hne : f ≠ 0) (z : ℂ) :
    meromorphicOrderAt f z ≠ ⊤ := by
  rw [(hf z (mem_univ z)).meromorphicOrderAt_eq]

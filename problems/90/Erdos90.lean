      (∑ i ∈ s, (c.t0 : ℝ) ^ (k + i)) ≤
        (c.t0 : ℝ) ^ k / (1 - (c.t0 : ℝ)) := by
    calc
      (∑ i ∈ s, (c.t0 : ℝ) ^ (k + i)) ≤ ∑' i : ℕ, (c.t0 : ℝ) ^ (k + i) :=
        hshift.sum_le_tsum s (fun i _ => pow_nonneg ht0_nonneg_real (k + i))

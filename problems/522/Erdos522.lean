    {φ : EuclideanSpace ℝ (Fin d) → ℝ} (hφm : Measurable φ)
    {D : ℝ} (hD : 0 ≤ D) (hφ : ∀ x, |φ x| ≤ D)
    (p q : ℝ) (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (hq0 : 0 < q) (hq1 : q ≤ 1) :

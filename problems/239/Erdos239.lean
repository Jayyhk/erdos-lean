        (not_congr (ZMod.isUnit_iff_coprime (n / d) q)).mpr hnotcop
      rw [χ.map_nonunit hnonunit, mul_zero]
    · rw [naturalScaledCharacter_of_not_dvd χ hdn, mul_zero]
  · intro hgnot
    exact (hgnot (Nat.mem_divisors.mpr ⟨hgQ, hQ0⟩)).elim


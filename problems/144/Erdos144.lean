          ((fun n : ℕ => chi n) *
            fun n => (ArithmeticFunction.vonMangoldt n : ℂ))
          x (1 + 1 / Real.log x) U -
        dirichletPerronIntegral
          ((fun n : ℕ => chi n) *
            fun n => (ArithmeticFunction.vonMangoldt n : ℂ))
          1 (1 + 1 / Real.log x) U := by

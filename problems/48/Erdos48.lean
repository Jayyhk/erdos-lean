  rw [abs_mul, hsign, one_mul] at habs
  rw [← habs, hlocal, hzabs]

private theorem abs_cos_pi_eq_cos_pi_norm (x : ℝ) :
    |Real.cos (Real.pi * x)| =
      Real.cos (Real.pi * ‖(x : UnitAddCircle)‖) := by
  let z : ℝ := x - (round x : ℝ)

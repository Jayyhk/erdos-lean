  let C := 2 * Real.sqrt (q : ℝ) * L
  let f : ℝ → ℂ := fun y ↦
    dirichletCharacterIntervalSum 1 ⌊y⌋₊ q chi *
      (y : ℂ) ^ (-(s + 1))
  let g : ℝ → ℝ := fun y ↦ C * y ^ (-(s.re + 1))

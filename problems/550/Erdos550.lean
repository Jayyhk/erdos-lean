    (hN : 0 < N) (hbase : 0 ≤ base + 80 * η * N)
    (hup : ∀ i ∈ S, D i ≤ N)
    (havg : (base + 100 * η * N) * (S.card : ℝ) ≤ ∑ i ∈ S, D i) :
    (20 * η) * (S.card : ℝ) ≤
      ((heavyClusterFamily S D base η N).card : ℝ) := by

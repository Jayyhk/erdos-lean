lemma trimWalkBetween_dropLast_support_not_mem_end {V : Type*}
    {G : SimpleGraph V} {u v : V} {p : G.Walk u v} (hp : p.IsPath)
    (S T : V → Prop) (hu : S u) (hv : T v) :

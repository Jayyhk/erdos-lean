    IndepFun.variance_sum hmem hpair]
  calc
    (∑ i ∈ Finset.univ,
        variance (matchingCoordinate w i)
          (matchingBernoulliMeasure p hp))
        ≤ ∑ _i ∈ Finset.univ, (M / 2) ^ 2 := by

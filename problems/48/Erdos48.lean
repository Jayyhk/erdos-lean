    {A : Type*} [AddCommMonoid A] {X : ℕ}
    (s : Finset ℕ) (hs : ∀ t ∈ s, 2 ≤ t ∧ t ≤ X)
    (f : ℕ → A) :
    (∑ t ∈ s, f t) =
      ∑ alpha ∈ dyadicExponentRange X,
        ∑ t ∈ s.filter (fun t ↦ t ∈ dyadicBlock alpha), f t := by
  let exponent : ℕ → ℕ := fun t ↦ Nat.log 2 (t - 1)

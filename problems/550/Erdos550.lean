    {V ι : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (R : SimpleGraph ι) [DecidableRel R.Adj]
    (C : ι → Finset V)
    (hC : ∀ i, (C i).Nonempty)
    (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    (huni : ∀ i j, R.Adj i j → G.IsUniform ε (C i) (C j))

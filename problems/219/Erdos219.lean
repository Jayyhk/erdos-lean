    SmoothSieveCutoff.cutoffNormalizerSeparatedProduct
    SmoothSieveCutoff.cutoffNormalizerPairFactor
  calc
    (∏ i, χ.cutoffFourierTransform (t i)) *
          (∏ i, χ.cutoffFourierTransform (u i)) *
          (((((Real.log (R : ℝ))⁻¹ : ℝ) : ℂ) ^
              Fintype.card κ) *
            ∏ i,
              SmoothSieveCutoff.cutoffNormalizerKernel
                (t i) (u i)) =
        ((((Real.log (R : ℝ))⁻¹ : ℝ) : ℂ) ^
            Fintype.card κ) *
          (((∏ i, χ.cutoffFourierTransform (t i)) *
              ∏ i, χ.cutoffFourierTransform (u i)) *
            ∏ i,

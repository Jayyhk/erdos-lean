          exitPoint i t = AffineMap.lineMap (a i) (b i) x →
            0 ≤ α → α ≤ β → β ≤ 1 → e < x →
              (∀ ⦃p : EuclideanSpace ℝ (Fin 2)⦄,
                p ∈ segment ℝ (AffineMap.lineMap (a i) (b i) α)
                    (AffineMap.lineMap (a i) (b i) β) →
                  p ∈ (localArcAtParam i t).carrier →
                    β < e → False) ∧
                (∀ ⦃p : EuclideanSpace ℝ (Fin 2)⦄,
                  p ∈ segment ℝ (AffineMap.lineMap (a i) (b i) α)
                      (AffineMap.lineMap (a i) (b i) β) →
                    p ∈ (localArcAtParam i t).carrier →
                      β = e → p = entryPoint i t) ∧
                  (∀ ⦃p : EuclideanSpace ℝ (Fin 2)⦄,
                    p ∈ segment ℝ (AffineMap.lineMap (a i) (b i) α)

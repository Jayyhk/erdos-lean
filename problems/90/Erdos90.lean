/-!
# Polynomial bounds for concrete substituted Hall-Witt slots

The collision-aware concrete-slot package is an actual pair of bounded
repeated-block expansions.  This file exposes the resulting positive and
negative polynomial bounds and records the exact literal multiplicities
recovered on the two signed branches.

This file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace GSSlot

open WSTrace
open STSubsti
open TOCoordi
open PMExp
open
  GRExp
open
  GSExp

/--
The positive branch of every concrete substituted strict-tail slot is an
integer-valued polynomial with the uniform positive strict-tail degree bound.
-/
lemma natural_bind_filtered
    {β : Type*}
    [DecidableEq β]
    (wt : β → ℕ)
    (substitution : Atom → CWord β)
    (cutoff : ℕ)
    (word : CWord β) :
    IVMost
      (bindFilteredSlot
        wt substitution cutoff word).natural.eval
      (naturalStrictBound cutoff) := by
  simpa using
    (bindFilteredSlot
      wt substitution cutoff word).natural
        |>.integerValuedMost (by omega)

/--
The negative branch of every concrete substituted strict-tail slot is an
integer-valued polynomial with the uniform negative strict-tail degree bound.
-/
lemma negative_bind_filtered
    {β : Type*}
    [DecidableEq β]
    (wt : β → ℕ)
    (substitution : Atom → CWord β)
    (cutoff : ℕ)
    (word : CWord β) :
    IVMost
      (bindFilteredSlot
        wt substitution cutoff word).negative.eval
      (negativeStrictBound cutoff) := by
  simpa using
    (bindFilteredSlot
      wt substitution cutoff word).negative
        |>.integerValuedMost (by omega)

/--
The concrete positive signed-three-word slot polynomial evaluates to the
literal signed Hall-Witt strict-tail multiplicity.
-/
lemma natural_filtered_slot
    {β : Type*}
    [DecidableEq β]
    (wt : β → ℕ)
    (hwt : ∀ atom, 0 < wt atom)
    (x y z : CWord β)
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (multiplicity : ℕ)
    (word : CWord β) :
    (filteredSlotExpansion
        wt x y z cutoff word).natural.eval multiplicity =
      (Multiset.count word
        (↑(signedBelowTrace wt x y z cutoff (Int.ofNat multiplicity)) :
          Multiset (CWord β)) : ℤ) := by
  simpa [ISExp.eval] using
    filtered_concrete_slot
      wt hwt x y z cutoff hcutoff (Int.ofNat multiplicity) word

/--
The concrete negative signed-three-word slot polynomial evaluates at the
shifted positive magnitude to the literal signed Hall-Witt strict-tail
multiplicity.
-/
lemma filtered_slot_expansion
    {β : Type*}
    [DecidableEq β]
    (wt : β → ℕ)
    (hwt : ∀ atom, 0 < wt atom)
    (x y z : CWord β)
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (multiplicity : ℕ)
    (word : CWord β) :
    (filteredSlotExpansion
        wt x y z cutoff word).negative.eval (multiplicity + 1) =
      (Multiset.count word
        (↑(signedBelowTrace wt x y z cutoff (Int.negSucc multiplicity)) :
          Multiset (CWord β)) : ℤ) := by
  simpa [ISExp.eval] using
    filtered_concrete_slot
      wt hwt x y z cutoff hcutoff (Int.negSucc multiplicity) word

end GSSlot
end TCTex
end Submission


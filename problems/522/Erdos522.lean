  rw [radial_shift_eq hN m x]
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  apply div_le_div_of_nonneg_left (by positivity) (sq_pos_of_pos hn)
  push_cast
  nlinarith [(Nat.cast_nonneg m : (0 : ℝ) ≤ m)]


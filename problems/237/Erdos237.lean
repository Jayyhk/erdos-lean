      36 * (A : ℝ) * Real.log ((q : ℝ) * (T + 2)) := by
    apply cast_ncard_localBadOrdinates_le hAL hprimitive hzeta
      (Nat.le_max_left AL AZ) (Nat.le_max_right AL AZ) chi T (-m) hT
    change |-(T + 1 / 2)| = T + 1 / 2

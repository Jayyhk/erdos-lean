the resulting map is an isomorphism. -/
def InducesLocalReciprocity
    (φ : Kˣ →* AbsoluteAbelianGalois K)
    (L : FASubext K) : Prop :=
  ∃ e : (Kˣ ⧸ L.normGroup) ≃*
      Gal(L.finiteIntermediateField/K),
    ∀ x : Kˣ,
      e (QuotientGroup.mk' L.normGroup x) =
        localAbelianRestriction L (φ x)


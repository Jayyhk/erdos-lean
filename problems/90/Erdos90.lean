/-- Second nested projection after inverse quotient associator is target middle projection. -/
@[simp] theorem mFQuot.mapsnd_fstprod_assocsymm
    (G H K : Type*) [Group G] [Group H] [Group K]
    (x : mFQuot p (G × H × K)) :
    mFQuot.map (p := p) (MonoidHom.snd G H)
        (mFQuot.map (p := p) (MonoidHom.fst (G × H) K)

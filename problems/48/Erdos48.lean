            (∫ t : ℝ in Set.Ioc 0 u, Int.fract t) := by
      rw [show (∑ b ∈ Finset.Icc 1 (X / a),
          (1 - (a : ℝ) * (b : ℝ) / (X : ℝ))) =
          ∑ b ∈ Finset.Icc 1 (X / a),
            (1 - (b : ℝ) / u) by
        apply Finset.sum_congr rfl
        intro b hb
        exact hweight b]
      exact heuler

theorem weighted_ideal_coefficients
    (e : MDescen) {n : ℕ} (hn : 1 ≤ n)
    {f : MSeries R X} :
    f ∈ weightedIdeal (R := R) (X := X) e n ↔
      f 1 = 0 ∧
        ∀ w, 1 ≤ w.length → w.length ≤ n →

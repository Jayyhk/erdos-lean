def limitAssemblyHom :
    DirectLimit G f →* Multiplicative LocalInvariant :=
  directLimitMonoid f
    (fun r ↦ (invariantTorsionMul r).comp (e r).toMonoidHom)
    (by
      intro r s h x
      change Multiplicative.ofAdd

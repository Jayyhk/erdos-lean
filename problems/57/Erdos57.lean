/-- Named finite inequalities for the canonical Lemma 4.2 connector. -/
structure LM42CanonicalBounds (N d D m L : ℕ) : Prop where
  card_large : 32 ≤ N
  degree_pos : 1 ≤ d
  two_le_m : 2 ≤ m
  D_pos : 0 < D

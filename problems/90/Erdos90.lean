  simp only [infiniteDecompositionGalois,
    IsGaloisGroup.mulEquivAlgEquiv, infiniteCompletionStabilizer,
    MulEquiv.trans_apply, MulEquiv.symm_trans_apply, MulEquiv.symm_symm,

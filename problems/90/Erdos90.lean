    {d n inputWeight : ℕ}
    {H : ∀ s : ℕ, BCWta.{u} d s}
    (normalizer :
      TSNormalb
        (n := n) (inputWeight := inputWeight) (lowerWeight := 1) H)
    (coordinates : CCExpans H inputWeight)
    (factor : SPFactora H inputWeight)
    (hfactorTruncated :
      factor.word.weight PEAddres.weight < n) :

        (∑ k ∈ K b,
          (((C (cL k)).card : ℝ) + ((C (cR k)).card : ℝ))) ≤
          Fintype.card V := by
      simpa [K, C] using!
        matching_endpoint_card_sum_le_univ RD.P cL cR hinj (K b)

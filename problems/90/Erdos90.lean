        AdicCompletion.transitionMap I R (nat_le_mul e he m)
          (powerQuotientEquiv I e m
            (AdicCompletion.transitionMap (I ^ e) R hmn
              (Submodule.mkQ ((I ^ e) ^ n • (⊤ : Submodule R R)) a)))
      rw [power_quotient_mk]

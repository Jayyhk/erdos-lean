  simp only [Complex.ofReal_sub, Complex.ofReal_div, hraw]
  rw [Finset.mul_sum]
  simp_rw [mul_sub]
  rw [Finset.sum_sub_distrib]
  -- `centeredTwistedChebyshevSum` fixes its own `Classical.decEq` instance, so

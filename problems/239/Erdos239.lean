    intro m n hcop
    by_cases hm : m = 0
    · subst m
      have hn : n = 1 := by simpa using hcop
      subst n
      simp [h]
    by_cases hn : n = 0
    · subst n
      have hm1 : m = 1 := by simpa [Nat.coprime_comm] using hcop
      subst m

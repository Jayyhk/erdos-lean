@[simp] theorem relators_union_quotient
    (P : Presentation.{u}) (S T : Set P.Free)
    (hT : ∀ ⦃t : P.Free⦄, t ∈ T → t ∈ (P.withRelators S).rNClos)
    (w : P.Free) :
    relatorsSubsetClosure P S T hT
        ((P.withRelators S).quotientMap w) =
      (P.withRelators (S ∪ T)).quotientMap w := by
  exact union_left_hom P S T w

@[simp] theorem relators_union_right
    (P : Presentation.{u}) (S T : Set P.Free)
    (hS : ∀ ⦃s : P.Free⦄, s ∈ S → s ∈ (P.withRelators T).rNClos)
    (w : P.Free) :
    relatorsUnionClosure P S T hS
        ((P.withRelators T).quotientMap w) =

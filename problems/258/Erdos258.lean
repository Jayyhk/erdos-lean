/-- Concrete centered fourth-moment bound for the near-coordinate large
prime range. -/
theorem nearLargePrimeCenteredFourthMoment_le
    {A : ℝ} (hA : HasUniformWirsingBound A)
    {K k : ℕ} (hreg : NormalizationRegular A K)
    (hk1 : 1 ≤ k) (hkK : k ≤ K) :

            hvalues p,
        sum_bankPaperCanonicalActiveSeedAmbientWeight_mul_valuation_eq_tagged
          B.sampleData oldSeed
            (R.roughCanonicalGuardedRow certificate deltaStar K 1)
            hvalues p]


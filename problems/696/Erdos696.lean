      (m - 4 - 6 * K) * Real.log 2 ≤
        (m - 4 - 6 * K) * L :=
    mul_le_mul_of_nonneg_left hlogLower hcoefficient_pos.le
  have hcontradiction :
      3 * m * L + 3 * C < (4 * m - 4 - 6 * K) * L := by
    nlinarith
  linarith


/-- The bounded representation sought in Erdős problem 1148. -/
def HasBoundedRepresentation (n : ℤ) : Prop :=
  ∃ x y z : ℤ, n = x ^ 2 + y ^ 2 - z ^ 2 ∧
    max (x ^ 2) (max (y ^ 2) (z ^ 2)) ≤ n


open NPTail
open TACompos
open STSched
open DCSched
open BSRec
open BSPoly
open DASrc
open BDCross
open ECSched
open ESPoly

/-- Every ordered-subsequence coordinate of a crossed empty-orbit prefix is an
integer-valued polynomial whose degree retains the carried-weight sum of the
requested transition word. -/
lemma orderedSubsequenceCarried
    (cutoff : ℕ)
    (outer selected : CWord Atom)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (trace : List (CWord Atom)) :
    ∀ target : List SRTrans,
      IVMost
        (fun steps : ℕ =>
          (orderedSubsequenceMultiplicity target
            (boundedCrossingSchedule cutoff outer selected
              trace steps) : ℤ))
        ((target.map secondRouteCarried).sum +
          target.length * (trace.length + 1) + 1)
  | target => by
      let increment : ℕ → ℤ :=
        fun steps =>
          ∑ suffix ∈ target.tails.toFinset.erase [],
            (orderedSubsequenceMultiplicity
              (target.take (target.length - suffix.length))
              (boundedCrossingSchedule cutoff outer
                selected trace steps) : ℤ) *
              (orderedSubsequenceMultiplicity suffix
                (trace.flatMap fun right =>
                  depthCrossingSchedule cutoff outer selected right
                    steps) : ℤ)
      have hincrement :
          IVMost increment
            ((target.map secondRouteCarried).sum +
              target.length * (trace.length + 1)) := by
        apply IVMost.finsetSum
        intro suffix hsuffix
        have hsuffixData := Finset.mem_erase.mp hsuffix
        have hsuffixNe : suffix ≠ [] := hsuffixData.1
        have hsuffixMem :
            suffix <:+ target :=
          (List.mem_tails suffix target).mp
            (List.mem_toFinset.mp hsuffixData.2)
        have hsuffixPos : 0 < suffix.length := by
          cases suffix with
          | nil =>
              exact False.elim (hsuffixNe rfl)
          | cons head tail =>
              simp
        have hsuffixLength : suffix.length ≤ target.length := by
          rcases hsuffixMem with ⟨initial, htarget⟩
          rw [← htarget, List.length_append]
          omega
        have htakeLength :
            (target.take (target.length - suffix.length)).length =
              target.length - suffix.length := by
          rw [List.length_take, Nat.min_eq_left (Nat.sub_le _ _)]
        have hprefixLength :
            (target.take (target.length - suffix.length)).length <
              target.length := by
          rw [htakeLength]
          omega
        apply
          TCTex.IVMost.mono
            (degreeBound :=
              ((target.take (target.length - suffix.length)).map
                    secondRouteCarried).sum +
                  (target.take
                    (target.length - suffix.length)).length *
                    (trace.length + 1) +
                  1 +
                ((suffix.map secondRouteCarried).sum +
                  trace.length))
            (largerBound :=
              (target.map secondRouteCarried).sum +
                target.length * (trace.length + 1))
        · rcases hsuffixMem with ⟨initial, htarget⟩
          have hsuffixBudget :
              trace.length + 1 ≤
                suffix.length * (trace.length + 1) := by
            simpa using
              Nat.mul_le_mul_right (trace.length + 1)
                (Nat.succ_le_iff.mpr hsuffixPos)
          rw [← htarget]
          simp only [List.length_append, Nat.add_sub_cancel_right,
            List.take_append_of_le_length (Nat.le_refl initial.length),
            List.take_length, List.map_append, List.sum_append, Nat.add_mul]
          omega
        · exact
            TCTex.IVMost.mul
              (orderedSubsequenceCarried
                cutoff outer selected hselected trace
                  (target.take (target.length - suffix.length)))
              (multFlatCarried
                cutoff outer selected hselected trace suffix)
      rw [show
        (fun steps : ℕ =>
          (orderedSubsequenceMultiplicity target
            (boundedCrossingSchedule cutoff outer selected
              trace steps) : ℤ)) =
          (fun _steps : ℕ =>
            (orderedSubsequenceMultiplicity target [] : ℤ)) +
            (fun steps : ℕ =>
              ∑ depth ∈ Finset.range steps, increment depth) by
        funext steps
        simp only [Pi.add_apply]
        exact
          subsequence_mult_crossing
            cutoff outer selected trace target steps]
      exact
        (valued_most_const
          ((target.map secondRouteCarried).sum +
            target.length * (trace.length + 1) + 1)
            (orderedSubsequenceMultiplicity target [] : ℤ)).add
          hincrement.partialSum
termination_by target => target.length
decreasing_by
  exact hprefixLength

end ESWt

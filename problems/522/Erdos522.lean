  have hinnerEq : inner ℝ (rh - r) h = inner ℝ rh h - inner ℝ r h := by
    rw [inner_sub_left]
  rw [hdx, hdxh]
  apply abs_le.mpr
  constructor
  · rw [hinnerEq] at hinnerLow
    nlinarith
  · nlinarith


  rw [top_sup_eq, top_inf_eq] at hindex
  rw [Subgroup.relIndex_top_right] at hindex
  rw [show (B ⊓ U).relIndex U =
      (powMonoidHom n : localUnitSubgroup K →*
        localUnitSubgroup K).range.index by

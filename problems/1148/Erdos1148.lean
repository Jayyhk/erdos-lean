def conjugateForm (t : ℤ × ℤ × ℤ) : ℤ × ℤ × ℤ := (t.1, -t.2.1, t.2.2)

lemma discr_conjugateForm (t : ℤ × ℤ × ℤ) : discr (conjugateForm t) = discr t := by
  dsimp [conjugateForm, discr]
  ring


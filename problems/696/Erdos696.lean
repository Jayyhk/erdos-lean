    Function.support goldfeldLogKernel ⊆ Icc (-Real.log 2) 0 := by
  intro u hu
  by_contra hnot
  have hleft : u < -Real.log 2 ∨ 0 < u := by
    by_cases h₁ : u < -Real.log 2
    · exact Or.inl h₁
    · have h₁' : -Real.log 2 ≤ u := le_of_not_gt h₁

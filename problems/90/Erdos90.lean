/-- One outer crossing transition retains the exact Hall-Witt current-word
budget for both depths and the original right-hand word. -/
lemma packet_iterated_commutator
    (cutoff : ℕ)
    (crossed outer selected right : CWord Atom)
    (innerDepth outerDepth : ℕ)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (transition : SRTrans)
    (htransition :
      transition ∈
        strictCrossingPacket cutoff crossed outer
          (iteratedLeftCommutator selected innerDepth right) outerDepth) :
    3 * outerDepth + (3 * innerDepth + 3) ≤
      secondRouteCarried transition := by
  have hinnerRight :
      iteratedLeftCommutator selected innerDepth right ∈
        iteratedMoveTrace selected innerDepth [right] := by
    rw [iterated_correction_singleton]
    simp
  have hweight :=
    crossing_transition_packet
      cutoff crossed outer selected right
        (iteratedLeftCommutator selected innerDepth right) innerDepth outerDepth
          houter hselected hinnerRight transition htransition
  rw [or_second_current right hright] at hweight
  exact hweight

/-- Summing the exact current-word packet costs exposes the reserve left
after the recursive outer depth-word orbit. -/
lemma commutator_ne_zero
    (cutoff : ℕ)
    (crossed outer selected right : CWord Atom)
    (innerDepth : ℕ)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (source : List ℕ)
    (target : List SRTrans)
    (hcoefficient :
      activeCrossingSubsequence cutoff crossed outer
          (iteratedLeftCommutator selected innerDepth right) source target ≠
        0) :
    3 * source.sum + source.length * (3 * innerDepth + 3) ≤
      (target.map secondRouteCarried).sum := by
  have hcost :
      (source.map fun outerDepth =>
        3 * outerDepth + (3 * innerDepth + 3)).sum ≤
          (target.map secondRouteCarried).sum := by
    apply
      cost_target_expansions
        (fun outerDepth => 3 * outerDepth + (3 * innerDepth + 3))
        secondRouteCarried
        (strictCrossingPacket cutoff crossed outer
          (iteratedLeftCommutator selected innerDepth right))
    · intro outerDepth transition htransition
      exact
        packet_iterated_commutator
          cutoff crossed outer selected right innerDepth outerDepth houter
            hselected hright transition htransition
    · exact
        List.count_pos_iff.mp
          (Nat.pos_of_ne_zero hcoefficient)
  have hsum :
      ∀ source : List ℕ,
        (source.map fun outerDepth =>
          3 * outerDepth + (3 * innerDepth + 3)).sum =
            3 * source.sum + source.length * (3 * innerDepth + 3) := by
    intro source
    induction source with
    | nil =>
        simp
    | cons outerDepth source ih =>
        rw [List.map_cons, List.sum_cons, ih, List.sum_cons,
          List.length_cons, Nat.succ_mul]
        ring
  rw [hsum source] at hcost
  exact hcost

/-- A contributing nonempty outer coordinate leaves a
`3 * innerDepth + 2` reserve after paying for its recursive orbit. -/
lemma strict_depth_grade
    (cutoff : ℕ)
    (crossed outer selected right : CWord Atom)
    (innerDepth : ℕ)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (source : List ℕ)
    (target : List SRTrans)
    (htarget : target ≠ [])
    (hcoefficient :
      activeCrossingSubsequence cutoff crossed outer
          (iteratedLeftCommutator selected innerDepth right) source target ≠
        0) :
    strictDepthGrade source + (3 * innerDepth + 2) ≤
      (target.map secondRouteCarried).sum := by
  have hsourceNe : source ≠ [] := by
    intro hsource
    subst source
    simp [activeCrossingSubsequence,
      activeSubsequenceExpansions, htarget] at hcoefficient
  have hweight :=
    commutator_ne_zero
      cutoff crossed outer selected right innerDepth houter hselected hright
        source target hcoefficient
  have hgrade :
      ∀ source : List ℕ,
        strictDepthGrade source = source.sum + source.length := by
    intro source
    induction source with
    | nil =>
        rfl
    | cons outerDepth source ih =>
        simp only [strictDepthGrade, List.sum_cons, List.length_cons, ih]
        omega
  have hlengthPos :
      1 ≤ source.length :=
    List.length_pos_of_ne_nil hsourceNe
  have hreserve :
      source.length + (3 * innerDepth + 2) ≤
        source.length * (3 * innerDepth + 3) := by
    nlinarith
  rw [hgrade source]
  omega

/-- A nonempty outer schedule coordinate is polynomial of degree at most its
carried-weight sum minus the exact Hall-Witt reserve. -/
lemma subsequenceMultInner
    (cutoff : ℕ)
    (crossed outer selected right : CWord Atom)
    (innerDepth : ℕ)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (target : List SRTrans)
    (htarget : target ≠ []) :
    IVMost
      (fun steps : ℕ =>
        (orderedSubsequenceMultiplicity target
          (depthCrossingSchedule cutoff crossed outer
            (iteratedLeftCommutator selected innerDepth right) steps) : ℤ))
      ((target.map secondRouteCarried).sum -
        (3 * innerDepth + 2)) := by
  rw [show
    (fun steps : ℕ =>
      (orderedSubsequenceMultiplicity target
        (depthCrossingSchedule cutoff crossed outer
          (iteratedLeftCommutator selected innerDepth right) steps) : ℤ)) =
      fun steps : ℕ =>
        ∑ source ∈ (wordsUpLength cutoff target.length).toFinset,
          (activeCrossingSubsequence cutoff crossed outer
              (iteratedLeftCommutator selected innerDepth right) source
                target : ℤ) *
            (orderedSubsequenceMultiplicity source
              (boundedDepthSchedule cutoff steps) : ℤ) by
    funext steps
    exact_mod_cast
      (by
        simpa [nsmul_eq_mul, Nat.mul_comm] using
          subsequence_multiplicity_words
            cutoff steps crossed outer
              (iteratedLeftCommutator selected innerDepth right) target)]
  apply IVMost.finsetSum
  intro source hsource
  have hsourceMem :
      source ∈ wordsUpLength cutoff target.length :=
    List.mem_toFinset.mp hsource
  have hsourceLt :
      ∀ depth ∈ source, depth < cutoff :=
    fun depth hdepth =>
      words_up_length
        cutoff target.length source hsourceMem depth hdepth
  by_cases hcoefficient :
      activeCrossingSubsequence cutoff crossed outer
          (iteratedLeftCommutator selected innerDepth right) source target =
        0
  · simp only [hcoefficient, Int.ofNat_zero, zero_mul]
    exact
      TCTex.IVMost.zero
        ((target.map secondRouteCarried).sum -
          (3 * innerDepth + 2))
  · apply
      TCTex.IVMost.smul
    apply
      TCTex.IVMost.mono
    · exact Nat.le_sub_of_add_le
        (strict_depth_grade
          cutoff crossed outer selected right innerDepth houter hselected hright
            source target htarget hcoefficient)
    · exact
        subsequence_multiplicity_grade
          cutoff source hsourceLt

/-- Nonempty sublists of an outer current-word schedule inherit the exact
Hall-Witt reserve. -/
lemma nonemptySublistsInner
    (cutoff : ℕ)
    (crossed outer selected right : CWord Atom)
    (innerDepth : ℕ)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (target : List SRTrans) :
    IVMost
      (fun steps : ℕ =>
        ((nonemptySublists
          (depthCrossingSchedule cutoff crossed outer
            (iteratedLeftCommutator selected innerDepth right) steps)).count
              target : ℤ))
      ((target.map secondRouteCarried).sum -
        (3 * innerDepth + 2)) := by
  by_cases htarget : target = []
  · subst target
    rw [show
      (fun steps : ℕ =>
        ((nonemptySublists
          (depthCrossingSchedule cutoff crossed outer
            (iteratedLeftCommutator selected innerDepth right) steps)).count
              [] : ℤ)) =
          fun _steps : ℕ => 0 by
      funext steps
      norm_cast
      apply List.count_eq_zero.mpr
      intro hnil
      have hkeep := (List.mem_filter.mp hnil).2
      simp at hkeep]
    simpa using
      valued_most_constant 0 0
  · rw [show
      (fun steps : ℕ =>
        ((nonemptySublists
          (depthCrossingSchedule cutoff crossed outer
            (iteratedLeftCommutator selected innerDepth right) steps)).count
              target : ℤ)) =
        fun steps : ℕ =>
          (orderedSubsequenceMultiplicity target
            (depthCrossingSchedule cutoff crossed outer
              (iteratedLeftCommutator selected innerDepth right) steps) : ℤ) by
      funext steps
      simp [nonemptySublists, orderedSubsequenceMultiplicity, htarget]]
    exact
      subsequenceMultInner
        cutoff crossed outer selected right innerDepth houter hselected hright
          target htarget


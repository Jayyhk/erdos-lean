      ‖deriv riemannZeta₁ (sigma : ℂ) /
          riemannZeta₁ (sigma : ℂ)‖ ≤ max c 0 :=
    (hc _ (mem_image_of_mem _ hsigma_icc)).trans (le_max_left _ _)

variable [P : Parameters] [T : ShiftTuple]

def tupleCoordinateFiberSquareDiagonal
    (H : Finset ℕ) (alpha : ℝ) (N : ℕ) (m : H) : ℝ :=
  ∑ r ∈ (BoundedGaps.Maynard.maynardDivisorTupleSupport H

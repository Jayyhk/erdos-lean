set_option synthInstance.maxHeartbeats 100000 in
instance ring_integers_tower (i : ℕ) :
    IsScalarTower ℤ (𝓞 ↥(layerField i)) ↥(layerField i) := by
  refine IsScalarTower.of_algebraMap_eq ?_
  intro x

/-- The Magnus-order filtration is a descending central series. -/
theorem magnus_descending_series :
    Subgroup.IsDescendingCentralSeries
      (fun n => magnusOrderSubgroup (R := R) (X := X) (n + 1)) := by
  constructor
  · exact magnus_order_one

    constructor
    · simpa only [hrZero, zero_add, mul_one] using hnUpper
    · have hOneLe : 1 ≤ (2 * n) / p := by
        rw [hfloor]
        omega
      have hpLe := (Nat.le_div_iff_mul_le hpPrime.pos).1 hOneLe
      simpa only [one_mul] using hpLe

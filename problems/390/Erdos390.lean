        (6 * signedError n + 2 * Gf / L n) * (1 / (p : ℝ)) :=
      add_le_add (hcomponent c) (hcomponent c')
    _ = 2 * ((6 * signedError n + 2 * Gf / L n) *
        (1 / (p : ℝ))) := by ring
    _ = epsilon n / (p : ℝ) := by
      dsimp only [epsilon, tailCoefficient]
      ring

end


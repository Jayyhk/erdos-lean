    (reduceMod A B p z).re = (z.re : ZMod p) := rfl

@[simp]
theorem reduceMod_im (A B : ℤ) (p : ℕ) (z : QOrd A B) :
    (reduceMod A B p z).im = (z.im : ZMod p) := rfl


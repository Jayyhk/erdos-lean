        change ContinuousAt
          ((fun z : ℂ => (q : ℂ) ^ z) ∘
            (fun s : ℂ => (1 - s) - 1 / 2)) 0
        exact (continuousAt_const_cpow hqzero).comp (by fun_prop))
    have hcompleted : ContinuousAt
        (fun s : ℂ =>
          DirichletCharacter.completedLFunction chi⁻¹ (1 - s)) 0 :=

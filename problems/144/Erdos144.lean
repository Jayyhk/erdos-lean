  rw [← differentiableOn_univ]
  exact (Complex.differentiableOn_dslope Filter.univ_mem).2 <| by
    rw [Complex.exp_eq_exp_ℂ]
    simpa only [smul_eq_mul] using
      (differentiable_exp_smul_const ℂ (Real.log x : ℂ)).differentiableOn


            I.subtype (eI ((CyclicH2.generator (n := n)) ^ n)) := by
              exact congrArg I.subtype
                (map_pow eI (CyclicH2.generator (n := n)) n).symm
        _ = I.subtype (1 : I) := by
              congr 1
              rw [← map_one eI]
              congr 1

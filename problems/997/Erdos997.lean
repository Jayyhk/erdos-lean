      rw [Finset.sum_sigma']
    _ = ∑ ab ∈ positiveProductPairsSq Q,
        (1 : ℝ) / ((ab.1 : ℝ) ^ 2 * (ab.2 : ℝ) ^ 2) := by
      refine Finset.sum_bij'
        (fun x _ => (x.2, x.1 / x.2))

    apply reciprocalPrimeInterval_le_log_two_add hz
    · exact Nat.pow_le_pow_right (by omega : 0 < y) (by omega)
    · rw [← pow_mul]
      exact Nat.pow_le_pow_right (by omega : 0 < y) (by omega)

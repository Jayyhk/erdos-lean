            N ⧸ LinearMap.range f) =
        0 := by
    change
      (Submodule.Quotient.mk (a • y) :
          N ⧸ LinearMap.range f) =
        0
    rw [Submodule.Quotient.mk_eq_zero]
    exact hy
  have hyzero :
      (Submodule.Quotient.mk y :
          N ⧸ LinearMap.range f) =
        0 :=
    ha.smul_eq_zero_iff_right.mp hquot
  rw [Submodule.Quotient.mk_eq_zero] at hyzero
  exact hyzero


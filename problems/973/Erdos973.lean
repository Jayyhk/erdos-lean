      (by simp) hM0 hM htau).trans
    nlinarith [mul_le_mul_of_nonneg_left hM1 (Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
  have hEeval : ∀ w : ℂ, ‖w‖ ≤ 1 →
      ‖(G.derivative - C mu * G).eval w‖ ≤ (n + 1 : ℝ) * ((n : ℝ) * M) := by
    intro w hw

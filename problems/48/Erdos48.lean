      (4 * (x : ℝ)) * t ^ (-2 : ℝ) +
        2 * Real.sqrt (x : ℝ) +
        (6 * vaughanCubeRoot x ^ 2) * t ^ (-(1 / 2) : ℝ) +
        (5 * (Real.sqrt (x : ℝ) * vaughanCubeRoot x)) * t⁻¹ := by
  rw [show (-2 : ℝ) = -(2 : ℝ) by norm_num, Real.rpow_neg ht.le,
    Real.rpow_two, Real.rpow_neg ht.le, ← Real.sqrt_eq_rpow]

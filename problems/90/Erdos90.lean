@[simp]
lemma listEval_append
    {p : ℕ}
    {α : Type*}
    {G : Type*} [Group G]
    {f : α → G}
    {wt : α → ℕ}
    {cutoff : ℕ}
    (L M : List (WCFactor p f wt cutoff)) :

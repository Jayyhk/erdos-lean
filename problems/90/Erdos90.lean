          simp [Representation.norm, ← Module.End.mul_apply, ← map_mul]
        _ = _ := by
          simpa [quotientFiberEquiv, ← Module.End.mul_apply, ← map_mul] using
            ((quotientFiberEquiv H g).symm.sum_comp
              (fun z => A.ρ z.1 x))


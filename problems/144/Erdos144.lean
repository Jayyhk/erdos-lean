lemma neg_logDeriv_principal_LSeries_re_le_riemannZeta
    {N : ℕ} {sigma : ℝ} (hsigma : 1 < sigma) :
    (-logDeriv (LSeries (fun n : ℕ =>
      (1 : DirichletCharacter ℂ N) n)) (sigma : ℂ)).re ≤
      (-logDeriv riemannZeta (sigma : ℂ)).re := by

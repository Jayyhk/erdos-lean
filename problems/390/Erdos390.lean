      |∑ m ∈ Finset.Ico M Z,
          roughSaiasFullyRealNaturalBuchstabCellRemainder X m| ≤
        3 * (X : ℝ) / Real.log (y : ℝ) ^ 2 :=
    hupperBound.trans

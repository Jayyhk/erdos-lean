  have hsmall : μ E₁ ≤ ENNReal.ofReal (v / b ^ 2) := by
    have hgauss := circularGaussian_real_closedBall_le_sq (Real.exp (-T)) (Real.exp_pos _).le
    have hexp : Real.exp (-T) ^ 2 = Real.exp (-2 * T) := by rw [pow_two, ← Real.exp_add]; congr 1; ring

    (hr : (r : ZMod p) ^ 2 = (A : ZMod p) + (B : ZMod p) * (r : ZMod p))
    (z : QOrd A B) :
    evalMod A B p r hr z = (z.re : ZMod p) + (z.im : ZMod p) * (r : ZMod p) := by
  simp [evalMod]


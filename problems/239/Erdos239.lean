  have hj1 : j + 1 ≤ J := by omega
  have hJ : J = (j + 1) + (J - (j + 1)) := by omega
  rw [hJ, Finset.sum_range_add]
  have hleft :
      (∑ k ∈ Finset.range (j + 1),

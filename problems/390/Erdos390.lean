            fourMarkProfile x * fourMarkProfile z| ≤ C_K * x * z := by
  obtain ⟨C₀, hC₀pos, hlocal⟩ := kernel_product_bound
  let R : ℝ := 1 / rho U
  have hRpos : 0 < R := by
    dsimp [R]
    exact one_div_pos.mpr rho_U_pos
  let C_K : ℝ := C₀ + R + R * R + 1
  have hCKpos : 0 < C_K := by
    dsimp [C_K]
    nlinarith [mul_pos hRpos hRpos]
  refine ⟨C_K, hCKpos, ?_⟩

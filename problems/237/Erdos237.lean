  rw [sum_moebius_divisors_eq_one_iff]
  by_cases hq : q = 1
  · have hreEq : r = e := Nat.eq_of_dvd_of_div_eq_one hre hq
    simp [hq, hreEq]
  · have hreNe : r ≠ e := by
      intro h
      apply hq
      change e / r = 1
      rw [h]
      exact Nat.div_self (h ▸ hr)
    simp [hq, hreNe]


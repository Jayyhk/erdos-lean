  · rintro ⟨b, hbpow⟩
    have hbne : b ≠ 0 := by
      intro hb
      subst b
      have ha_ne : algebraMap K L (a : K) ≠ 0 :=
        (map_ne_zero (algebraMap K L)).2 (Units.ne_zero a)
      exact ha_ne (by simpa [hp.ne_zero] using hbpow.symm)

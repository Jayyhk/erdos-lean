      (y : QuadraticDiscrAlgebra d) - (c : QuadraticDiscrAlgebra d) *
      ((x * y - 1 : 𝓞 (QuadraticDiscrAlgebra d)) : QuadraticDiscrAlgebra d) = c := by
    push_cast
    ring
  rwa [heq] at hsub


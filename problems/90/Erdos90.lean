    relativeBrauerGroup K L →*
      invariantPowTorsion (Module.finrank K L) where
  toFun x := ⟨carryBrauerInvariant K (x : BrauerGroup K), by
    change (carryBrauerInvariant K (x : BrauerGroup K)) ^
      Module.finrank K L = 1
    rw [← map_pow]

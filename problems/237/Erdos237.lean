    ‖s‖ * ‖(∫ y in Ioc (1 : ℝ) q, f y) +
        (∫ y in Ioi (q : ℝ), f y)‖ ≤
      ‖s‖ * (‖∫ y in Ioc (1 : ℝ) q, f y‖ +
        ‖∫ y in Ioi (q : ℝ), f y‖) :=
      mul_le_mul_of_nonneg_left (norm_add_le _ _) (norm_nonneg s)
    _ ≤ 2 * (3 * Real.log (q : ℝ) + 4 * Real.log (q : ℝ)) := by
      gcongr
    _ ≤ 32 * Real.log (q : ℝ) := by nlinarith


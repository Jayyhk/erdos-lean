    (poles : ι → ℂ) {A y : ℝ} (hA : 0 ≤ A) (hy : 0 < y) :
    (volume.restrict (Set.Ioc (-A) A)).real
      {x : ℝ | y ≤ ‖cauchySum poles (x : ℂ)‖} ≤ 16 * Fintype.card ι / y := by
  let q : ι → ℂ := lowerPole ∘ poles
  have hq : ∀ i, (q i).im ≤ 0 := fun i ↦ neg_nonpos.mpr (abs_nonneg _)

    ‖natLogTwist n t‖ = 1 := by
  unfold natLogTwist
  have hphase : -Complex.I * ((t * Real.log (n : ℝ) : ℝ) : ℂ) =
      ((-(t * Real.log (n : ℝ)) : ℝ) : ℂ) * Complex.I := by

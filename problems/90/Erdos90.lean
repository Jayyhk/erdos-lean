    let W := CompletionPlacesAbove (L := L) v
    letI : Finite W := absolute_extensions_separable v
    letI : Nonempty W :=
      absolute_value_extension (K := K) (L := L) v
    letI : MulAction.IsPretransitive Gal(L/K) W :=
      above_pretr_nonar v hvna

    rw [hs_eq]
    symm
    apply Finset.sum_filter_of_ne
    intro m hm hgm
    by_contra hmCap
    have hmPos : 0 < m := (Finset.mem_Icc.mp
      (Finset.mem_filter.mp (by simpa only [source] using hm)).1).1
    have hzero : g m = 0 := by
      apply Finset.sum_eq_zero
      intro k hk
      rcases Finset.mem_filter.mp hk with ⟨hkIcc, hkV⟩

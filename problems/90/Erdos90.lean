/-- Nonempty subsequences of one emitted packet. -/
def nonemptySublists
    {α : Type*}
    (items : List α) :
    List (List α) :=
  items.sublists.filter fun selected =>
    decide (selected ≠ [])

/-- Output words obtained by choosing a nonempty subsequence from every
active source packet.  Duplicates are retained because they record distinct
ordered embeddings. -/
def activeSubsequenceExpansions
    {α β : Type*}
    (packet : α → List β) :
    List α → List (List β)
  | [] =>
      [[]]
  | item :: items =>
      (activeSubsequenceExpansions packet items).flatMap fun suffix =>
        (nonemptySublists (packet item)).map fun head =>
          head ++ suffix

/-- Rank used for the bounded depth-word triangular recurrence. -/
def depthWordRank
    (depths : List ℕ) :
    ℕ :=
  (depths.map fun depth => depth + 1).sum

@[simp]
lemma depth_rank_nil :
    depthWordRank [] = 0 := by
  rfl

@[simp]
lemma depth_rank_cons
    (depth : ℕ)
    (depths : List ℕ) :
    depthWordRank (depth :: depths) =
      depth + 1 + depthWordRank depths := by
  rfl

/-- Each active source packet contributes at least one output position. -/
lemma length_subsequence_expansions
    {α β : Type*}
    (packet : α → List β) :
    ∀ (source : List α) (target : List β),
      target ∈ activeSubsequenceExpansions packet source →
        source.length ≤ target.length
  | [], target, htarget => by
      simp [activeSubsequenceExpansions] at htarget
      subst target
      simp
  | item :: source, target, htarget => by
      simp only [activeSubsequenceExpansions] at htarget
      rcases List.mem_flatMap.mp htarget with
        ⟨suffix, hsuffix, htarget⟩
      rcases List.mem_map.mp htarget with
        ⟨head, hhead, rfl⟩
      have hheadNonempty : head ≠ [] :=
        of_decide_eq_true (List.mem_filter.mp hhead).2
      have hheadLength : 0 < head.length :=
        List.length_pos_iff_ne_nil.mpr hheadNonempty
      have hsuffixLength :
          source.length ≤ suffix.length :=
        length_subsequence_expansions
          packet source suffix hsuffix
      simp only [List.length_cons, List.length_append]

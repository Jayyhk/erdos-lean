          Real.log p / ((p : ℝ) * (p - 1 : ℕ))) =
          ∑ p ∈ Nat.primesLE D, f p := by
        apply Finset.sum_congr rfl
        intro p hp
        simp [f, Nat.prime_of_mem_primesLE hp]

  induction x using Quotient.inductionOn with
  | _ c => rfl

theorem restrictionHom_comp
    {J : Type*} [Group J] [MulDistribMulAction J M]
    (f : H →* G) (g : J →* H)
    (hf : ∀ h : H, ∀ m : M, h • m = f h • m)
    (hg : ∀ j : J, ∀ m : M, j • m = g j • m)
    (hfg : ∀ j : J, ∀ m : M, j • m = (f.comp g) j • m)
    (x : MHTwo G M) :

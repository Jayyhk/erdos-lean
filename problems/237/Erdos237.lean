              2 * (AL : ℝ) *
                Real.log ((d : ℝ) * (|t| + 2)))
    (hzeta :
      ∀ t : ℝ,
        ((MeromorphicOn.divisor riemannZeta₁
            (closedBall ((2 : ℂ) + t * I) 3)).support.ncard : ℝ) ≤
          12 * (AZ : ℝ) * Real.log (|t| + 2))
    (hALA : AL ≤ A) (hAZA : AZ ≤ A)
    {q : ℕ} [NeZero q]
    (chi : DirichletCharacter ℂ q) (T t : ℝ)
    (hT : 2 ≤ T) (ht : |t| = T + 1 / 2) :
    ((dirichletLocalBadOrdinates chi t).ncard : ℝ) ≤
      36 * (A : ℝ) * Real.log ((q : ℝ) * (T + 2)) := by

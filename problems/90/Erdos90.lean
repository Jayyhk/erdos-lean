  let MF := intermediateExponentSubextension K M
  letI : IsMulCommutative Gal(LF.toIntermediateField/K) := by
    change IsMulCommutative Gal(L.carrier/K)
    infer_instance
  letI : IsMulCommutative Gal(MF.toIntermediateField/K) := by
    change IsMulCommutative Gal(M.carrier/K)
    infer_instance

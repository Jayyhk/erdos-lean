/-- A lightweight topology record, avoiding commitment to mathlib's topology API at this stage. -/
structure bTopo (X : Type u) where
  IsOpen : Set X → Prop
  isOpen_univ : IsOpen Set.univ
  isOpen_empty : IsOpen ∅
  isOpen_inter : ∀ {U V}, IsOpen U → IsOpen V → IsOpen (U ∩ V)

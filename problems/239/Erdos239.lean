      0 ≤ Real.log (n : ℝ) * (n : ℝ) ^ (-sigma) := by positivity
  have hsq := (sq_le_sq₀ hcoeff0 hupper0).2 hcoeff
  have hden : 0 < Real.log (n : ℝ) / (n : ℝ) :=
    div_pos hlogpos (by exact_mod_cast hnpos)
  unfold gsA10PrimeLambdaSchurWeight
  rw [div_le_iff₀ hden]

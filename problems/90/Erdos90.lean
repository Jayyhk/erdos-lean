    [Fact p.Prime] (G : Type*) [Group G] (n : ℕ) (e f : MulAut G) :
    zLKern.congrLinear p G (e * f) n =
      (zLKern.congrLinear p G f n).trans
        (zLKern.congrLinear p G e n) := by

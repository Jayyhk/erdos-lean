/-- The Gaussian density coefficient after substitution of the mesh thresholds. -/
def annularJetDensityCoefficient (K S : ℝ) : ℝ :=
  9 / (1024 * S ^ 2 * (Real.exp (-4 * K) / 80) ^ 2)


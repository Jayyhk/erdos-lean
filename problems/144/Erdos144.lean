    intro hsZero
    have hre := congrArg Complex.re hsZero
    norm_num [s] at hre
  rw [show (((-1 / 2 : ℝ) : ℂ) + t * I) = s by rfl,
    dirichletExplicitFormulaKernel_eq_cpow_sub_one_div hxpos hs,
    norm_div]

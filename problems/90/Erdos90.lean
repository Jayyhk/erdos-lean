theorem truncation_finrank_rank [Finite G] (n : ℕ) :
    Module.finrank K (augmentationTruncation K G n) =
      ∑ i ∈ Finset.range n, augmentationLayerRank K G i := by
  induction n with
  | zero =>
      rw [augmentation_finrank_zero]
      simp

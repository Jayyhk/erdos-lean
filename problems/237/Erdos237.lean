    ‖vaughanTwistedSumTwo V y q χ‖ ≤
        Real.log y *
          ∑ d ∈ vaughanSecondTermIndices V y,
            dirichletCharacterSuffixMaximum y (y / d) q χ :=
      norm_vaughanTwistedSumTwo_le_log_mul_sum_suffixMaximum hy χ
    _ ≤ Real.log y *
        ∑ _d ∈ vaughanSecondTermIndices V y, C := by
      gcongr with d hd

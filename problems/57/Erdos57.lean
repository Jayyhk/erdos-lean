            dsimp [gain]
            omega
          exact (min_le_left _ _).trans (hgain.trans hnext)
  have hfinal := hind radius le_rfl
  have hmin : min (S.size radius) cap = cap := min_eq_right S.target
  rw [hmin] at hfinal
  exact hfinal


    algebraMap A B a ∈ nonZeroDivisors B := by
  rw [← isRegular_iff_mem_nonZeroDivisors]
  rw [Commute.isRegular_iff (fun b : B => mul_comm _ b)]
  change IsSMulRegular B (algebraMap A B a)
  rw [isSMulRegular_algebraMap_iff]

    [Finite (tateZero X.X₃)]
    [Finite (tateNegOne X.X₃)] :
    Finite (tateZero X.X₁) ∧
      Finite (tateNegOne X.X₁) := by
  let e₁₀ := tateCyclicEven X.X₁ g hg
  let e₁₁ := tateNegOdd X.X₁ g hg
  let e₂₀ := tateCyclicEven X.X₂ g hg
  let e₂₁ := tateNegOdd X.X₂ g hg
  let e₃₀ := tateCyclicEven X.X₃ g hg
  let e₃₁ := tateNegOdd X.X₃ g hg
  letI : Finite (cyclicTateEven X.X₂ g) :=
    Finite.of_equiv _ e₂₀.toEquiv
  letI : Finite (cyclicTateOdd X.X₂ g) :=
    Finite.of_equiv _ e₂₁.toEquiv
  letI : Finite (cyclicTateEven X.X₃ g) :=
    Finite.of_equiv _ e₃₀.toEquiv
  letI : Finite (cyclicTateOdd X.X₃ g) :=

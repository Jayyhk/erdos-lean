    {G₀ G₁ G₂ : Type*} [AddGroup G₀] [AddGroup G₁] [AddGroup G₂]
    [Finite G₀] [Finite G₁] [Finite G₂]
    (f : G₀ →+ G₁) (g : G₁ →+ G₂)
    (hinj : Injective f) (hexact : Exact f g) (hsurj : Surjective g) :
    addCardUnit G₁ =
      addCardUnit G₀ * addCardUnit G₂ := by
  rw [card_range_mul f g hexact]

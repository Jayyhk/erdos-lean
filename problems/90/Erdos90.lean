      (packet :
        PFSubsti.TAPkt.{u}
          d n)
      (hinputWeight : 0 < inputWeight)
      (B A : TWExp H inputWeight)
      (leftContext rightContext :
        List (SOTerm H inputWeight)) :
      TCStep H

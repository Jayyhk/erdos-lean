    r h = d h * divisorTupleQuotient d r h :=
      (divisorTuple_mul_quotient_coordinate hr h).symm
    _ = d h * divisorTupleQuotient d s h := by rw [hrs]
    _ = s h := divisorTuple_mul_quotient_coordinate hs h


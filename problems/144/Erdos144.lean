    (∑ M ∈ P, 1 / (M.1 : ℝ) ^ 2) =
        ∑ M ∈ P.image (fun M : ↑I ↦ M.1), 1 / (M : ℝ) ^ 2 := by
      symm
      exact Finset.sum_image hinj
    _ ≤ ∑ M ∈ B, 1 / (M : ℝ) ^ 2 := by
      exact Finset.sum_le_sum_of_subset_of_nonneg himage

  have hlogV : 0 ≤ Real.log V := Real.log_nonneg hV
  have hlogTwo : (2 / 3 : ℝ) < Real.log 2 := by
    convert Real.lt_log_one_add_of_pos (x := (1 : ℝ)) (by norm_num) using 1 <;>

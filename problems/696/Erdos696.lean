        have hk_ne : extract_idx i₁ ≠ extract_idx i₂ := fun h_eq => hi_ne (h_extract_idx_inj h_eq)
        have hmem₁ := selectedPrimeInBlock_mem
          (Finset.mem_filter.mp (h_extract_idx_mem i₁)).2
        have hmem₂ := selectedPrimeInBlock_mem
          (Finset.mem_filter.mp (h_extract_idx_mem i₂)).2

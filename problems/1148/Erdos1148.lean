    (hηpos : 0 < η) (hη : η ≤ 1 / 2) (hε : 0 < ε) :
    ∃ H₀ : ℝ, 1 < H₀ ∧ ∀ H : ℝ, H₀ ≤ H → ∃ C : ℝ, 0 < C ∧
      ∀ Y : ℝ, 1 ≤ Y → ∀ (n : ℕ) (A : ℝ),

/-- Continuity with respect to the lightweight topology records. -/
def basicContinuous {X : Type u} {Y : Type v} (TX : bTopo X) (TY : bTopo Y)
    (f : X → Y) : Prop :=
  ∀ U : Set Y, TY.IsOpen U → TX.IsOpen {x | f x ∈ U}


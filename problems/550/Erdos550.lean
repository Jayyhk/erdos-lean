        ∑ i ∈ Finset.univ \ K, wY i =
          (∑ i, wY i) - ∑ i ∈ K, wY i := by
      rw [← Finset.sum_sdiff (Finset.subset_univ K)]
      ring
    rw [htotal, ← hsumY]
    have heq :
        (∑ i, wY i) - Y ω -
            (1 - p.toReal) * ∑ i, wY i =
          -(Y ω - p.toReal * ∑ i, wY i) := by ring
    rw [heq, abs_neg]
    simpa [hEY] using! hdevY

end Coordinates


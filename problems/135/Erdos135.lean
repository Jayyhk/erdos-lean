      ∃ r K : ℝ, 0 < r ∧ 0 < K ∧
        baseChart '' {z | 0 < z 0 ∧ z 0 ^ 2 + z 1 ^ 2 < (r / ‖base‖) ^ 2 ∧
          -K * z 0 < z 1 ∧ z 1 < 0} ⊆ sector ∧

    (fun n : ℕ ↦ |K / L n| +
      2 * |omittedTiltMajorant B C c W n| *
        (1 + 1 / rho DickmanBasic.U + |K / L n|)) atTop (𝓝 0)
  simpa using hKL.abs.add hprod

end


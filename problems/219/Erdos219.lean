    (happroximationError : 0 ≤ approximationError)
    (hcutError : 0 ≤ cutError)
    (hf0 : ∀ x, 0 ≤ f x)
    (hfν : ∀ x, f x ≤ ν x)
    (hν0 : ∀ x, 0 ≤ ν x)
    (hp :
      ApproximatesPositivePartOnUnitInterval
        p approximationError)
    (hLF :
      HasLinearFormsCondition
        (r + 2) N ν linearFormsError)
    (hN : Nat.Coprime N (Nat.factorial (r + 1)))

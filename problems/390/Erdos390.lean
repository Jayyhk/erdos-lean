      (1 / (p : ℝ)) * physicalPowerCorrectionRowError epsilon G n W := by
  let e : ℝ := 8 * epsilon
  let H : ℝ := bandReciprocalSum n W
  let S : ℝ := bandReciprocalSquareSum n W
  let w : ℝ := 1 / (W : ℝ)

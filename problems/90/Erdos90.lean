      SPFactor
        (concreteBasicCommutators.{u} d) ι)
    (left right : HallTree (FreeGenerator.{u} d))
    (hleftBasic : left.IsBasic)
    (hrightBasic : right.IsBasic)
    (htree : tree factor.word = .commutator left right)
    (e : ι → HEFam (concreteBasicCommutators.{u} d)) :

    linarith
  have hprincipalRaw := hprincipal q sTwo
    (by simpa [sTwo] using hsigmaOne.le)
    (by simpa [sTwo] using hsigmaTwo.le) hsTwoNe
  have hsTwoSub : sTwo - 1 = (a : ℂ) + (2 * rho.im : ℝ) * I := by

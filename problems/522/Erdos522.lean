  have hO3 : MemLp O 3 ρ := memLp_replacementOriginal hXm hX3 k
  have hG3 : MemLp G 3 ρ := memLp_three_replacementGaussian hXm k
  have hBO3 : MemLp (fun ω ↦ B (O ω)) 3 ρ :=

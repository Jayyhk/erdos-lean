I.1.1. -/
def IsReciprocityMap
    (φ : Kˣ →* AbsoluteAbelianGalois K) : Prop :=
  (∀ (π : Kˣ), LocalPrimeElement K π →
    ∀ L : FASubext K, L.IsUnramified K →
      L.IsArithmeticFrobenius K (localAbelianRestriction L (φ π))) ∧

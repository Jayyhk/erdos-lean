      norm_num at hk1rR
      nlinarith
    · intro hrk
      have hrkR : (r : ℝ) ≤ (k : ℝ) := by exact_mod_cast hrk
      dsimp [y]
      nlinarith
  have hlogcutoff : Real.log (r : ℝ) < Real.log y ↔ r ≤ k :=
    (Real.log_lt_log_iff hrR hy).trans hcutoff

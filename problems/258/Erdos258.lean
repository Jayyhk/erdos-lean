    _ ≤ ∑ d : D, ∑ e : D.filter
          (fun e : H → ℕ => IsCrossCoordinateCoprime H d.1 e),
        |restrictedCompatiblePairShiftErrorInner
          (v := v) (N := N) (hD d.1 d.2)
          (hD e.1 (Finset.mem_filter.mp e.2).1)
          (show IsCrossCoordinateCoprime H d.1 e.1 from
            (Finset.mem_filter.mp e.2).2) lambda| := by

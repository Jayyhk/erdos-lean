  letI : Algebra C E :=
    adicIntegerAlgebra (K := K) (L := L) P hP Q
  letI : IsScalarTower C D E :=
    integer_scalar_tower
      (K := K) (L := L) P hP Q
  letI : Algebra C F := C.subtype.toAlgebra
  letI : IsScalarTower C F E :=

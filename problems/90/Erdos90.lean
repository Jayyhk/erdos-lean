      let w := completion.infiniteUpper v
      let hwv := infinite_lies_comap v w.1 w.2
      let w0 : CompletionPlacesAbove (L := L) v.1 := ⟨w.1.1, hwv⟩
      letI : Fact v.1.IsNontrivial := ⟨infinite_place_nontrivial v⟩

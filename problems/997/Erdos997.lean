        abs_of_pos (inv_pos.mpr (sub_pos.mpr hsigma))]
    _ ≤ (sigma - 1)⁻¹ + max c 0 := add_le_add (le_refl _) hresidual
    _ < (sigma - 1)⁻¹ + C := by
      dsimp [C]
      linarith


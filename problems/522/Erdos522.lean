    exact_mod_cast Nat.factorial_le_pow (2 * m)
  have ht : (2 : ℝ) ^ m ≤ 2 ^ (2 * m) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  have he : Real.exp 1 ≤ Real.exp 1 ^ (2 * m) := by
    simpa only [pow_one] using
      pow_le_pow_right₀ (Real.one_le_exp (by norm_num : (0 : ℝ) ≤ 1))

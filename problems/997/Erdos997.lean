      ‖LSeries.term f s n‖ ≤ ‖LSeries.term g (s.re : ℂ) n‖ := by
    calc
      ‖LSeries.term f s n‖ ≤ ‖LSeries.term g s n‖ :=
        LSeries.norm_term_le s (hcoeff n)
      _ = ‖LSeries.term g (s.re : ℂ) n‖ := by
        simp only [LSeries.norm_term_eq, Complex.ofReal_re]

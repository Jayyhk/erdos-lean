              ∑ i, ∫ ω,
                ‖(toEuclideanCLM (𝕜 := ℝ) (CFC.sqrt S)⁻¹) (X i ω)‖ ^ 3 ∂μ := by
  exact exists_bentkus_convex_set_constant_of_identity_covariance_bound

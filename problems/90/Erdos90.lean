    apply Additive.toMul.injective
    apply (QuotientGroup.eq_one_iff _).2
    refine ⟨1, ?_⟩
    apply Subtype.ext
    simp [uliftRepInvariant, FMAct.norm]
    rfl
  map_add' x y := by
    apply Additive.toMul.injective
    rfl


      (fun x : ℝ =>
        ‖deriv riemannZeta₁ (x : ℂ) / riemannZeta₁ (x : ℂ)‖)
      (Icc (1 : ℝ) 2) :=
    (ContinuousOn.div
      (differentiable_riemannZeta₁.deriv.continuous.comp
        Complex.continuous_ofReal |>.continuousOn)
      (differentiable_riemannZeta₁.continuous.comp
        Complex.continuous_ofReal |>.continuousOn)

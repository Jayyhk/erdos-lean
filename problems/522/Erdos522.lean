  filter_upwards [hω, ht.eventually_gt_atTop (2 * K)] with j hj hNj
  change (zeroCountIn (rademacherPolynomial (j ^ 8) (rademacherPrefix (j ^ 8) ω))
    {z | |‖z‖ - 1| ≤ (K : ℝ) / (j ^ 8 : ℕ)}ᶜ : ℝ) / ((j ^ 8 : ℕ) : ℝ) ≤ _
  apply radial_mass_le_variance_secant_envelope
    (rademacherPolynomial (j ^ 8) (rademacherPrefix (j ^ 8) ω)) (j ^ 8)
    (rademacherPolynomial_prefix_natDegree ω (j ^ 8)) hK' hNj

            linarith
          have hlog_pos : 0 ≤ Real.log y := Real.log_nonneg (by linarith)
          have h_kappa_log_le : ((Real.exp (-1) * 15) / 2) * Real.log y ≤ (15 / 2) * Real.log y :=
            mul_le_mul_of_nonneg_right h_kappa_le_half hlog_pos

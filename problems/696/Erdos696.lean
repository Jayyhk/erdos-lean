          -- ((e⁻¹·15)/2) ≈ 2.76, so κ log y + 1 ≤ 15 log y when 14 log y ≥ 1, i.e., log y ≥ 1/14.
          have hexp_le : Real.exp (-1) ≤ 1 := by
            rw [Real.exp_neg]
            exact inv_le_one_of_one_le₀ (Real.one_le_exp (by norm_num))

          ArithmeticFunction.vonMangoldt a *
        (Real.exp (-(alpha + 2 * beta) * Real.log (b : ℝ)) *
          ArithmeticFunction.vonMangoldt b) *
        Real.exp (-(alpha + 2 * beta) * Real.log (e : ℝ)) =

    normSubgroup K L ≤ normSubgroup K F := by
  rintro u ⟨v, rfl⟩
  refine ⟨normOnUnits F L v, ?_⟩
  apply Units.ext
  exact Algebra.norm_norm (R := K) (S := F) (A := L) (a := (v : L))


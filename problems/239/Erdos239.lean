        ∑ i ∈ s, ∫ beta : ℝ in 0..eta, F i alpha beta := by
    intro alpha
    apply intervalIntegral.integral_finsetSum
    intro i hi
    exact ((hF i hi).comp
      (continuous_const.prodMk continuous_id)).intervalIntegrable 0 eta
  simp_rw [hinnerSum]
  apply intervalIntegral.integral_finsetSum
  intro i hi
  exact (hinner i hi).intervalIntegrable 0 eta


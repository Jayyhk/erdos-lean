private theorem reciprocalTotientCorrection_local_tsum_le
    (W : ℕ) {p : ℕ} (hp : p.Prime) :
    (∑' i : ℕ, |reciprocalTotientCorrectionAF W (p ^ i)|) ≤
      1 + 2 * primeTotientSquareWeight p := by

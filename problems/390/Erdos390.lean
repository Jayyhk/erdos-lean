      have htri := abs_sub
        (((uniformOnFinset (S c) (hS c)).exponentialTilt
            (fun m : S c ↦ valuationScore (primeBand n W) eta (L n)
              (m : ℕ))).expect (fun m ↦ valuation p (m : ℕ)) - mainSum)
        (((uniformOnFinset (S c') (hS c')).exponentialTilt
            (fun m : S c' ↦ valuationScore (primeBand n W) eta (L n)
              (m : ℕ))).expect (fun m ↦ valuation p (m : ℕ)) - mainSum)

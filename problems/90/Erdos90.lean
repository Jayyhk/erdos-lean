def congruenceLPartial {m : Modulus K}
    {H : Subgroup (IdealsPrimeTo (NumberField.RingOfIntegers K) K m.finiteSupport)}
    (chi : CongruenceClassQuotient K m H →* ℂˣ)
    (s : ℂ) (N : ℕ) : ℂ :=
  ∑ n ∈ range N, congruenceLShell K chi s n


under complex conjugation. -/
theorem IsNonprincipalNontrivialLFunctionZero.conj_of_sq_eq_one
    {q : ℕ} [NeZero q] {chi : DirichletCharacter ℂ q} {rho : ℂ}
    (hrho : IsNonprincipalNontrivialLFunctionZero chi rho)
    (hsquare : chi ^ 2 = 1) :

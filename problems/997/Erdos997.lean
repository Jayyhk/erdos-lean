  refine ⟨K, hK, ?_⟩
  intro D P Q hP hSq
  let W : ℕ := primorial D * P
  let M : ℕ → ℝ := fun n => squarefreeCoprimeInvTotientMean W n
  let δ : ℝ := coprimeHarmonicDensity W
  let E : ℝ := K + Real.log D + primeLogDivisorMass P

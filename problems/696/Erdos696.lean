  rw [abs_of_nonneg hcutoff]
  constructor
  · rintro ⟨⟨hzero, _⟩, hwindow⟩
    exact ⟨hzero, hwindow⟩
  · rintro ⟨hzero, hwindow⟩
    refine ⟨⟨hzero, ?_⟩, hwindow⟩

    Finset.sum_singleton]
  rw [show p ^ 0 = 1 by simp, show p ^ 1 = p by simp,
    show p ^ 2 = p ^ 2 by rfl,
    show p ^ 2 / 1 = p ^ 2 by simp,
    show p ^ 2 / p = p by
      rw [pow_two]

          (fun m : S ↦ divInd (pairPower p q r s) m) =
        pairRestoredNumerator omitted (fun m : S ↦ (m : ℕ)) p q
            (valuationCutoff p (physicalBound C n))
            (valuationCutoff q (physicalBound C n))
            (eta p) (eta q) (L n) r s /
          pairRestoredNumerator omitted (fun m : S ↦ (m : ℕ)) p q

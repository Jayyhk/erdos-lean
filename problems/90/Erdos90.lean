/-!
# Reconstruct substituted Hall-Witt profiles from concrete recipes

The concrete physical vocabulary is deduplicated after substitution, and its
paired recipes already aggregate all formal-slot collisions.  Summing the
evaluated multiplicity of each physical slot therefore reconstructs the
complete physically truncated signed Hall-Witt strict-tail multiset.

This file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace WSRecons

open TOCoordi
open
  GSExp
open
  GSVector

/--
A multiset supported on the physical deduplicated cutoff vocabulary is
reconstructed by its finitely many physical-slot counts.
-/
lemma deduplicated_vocabulary_nsmul
    {β : Type*}
    [DecidableEq β]
    (x y z : CWord β)
    (cutoff : ℕ)
    (source : Multiset (CWord β))
    (hsource :
      ∀ word ∈ source,
        word ∈ signedDeduplicatedVocabulary x y z cutoff) :
    source =
      ∑ word ∈
          (signedDeduplicatedVocabulary x y z cutoff).toFinset,
        Multiset.count word source •
          ({word} : Multiset (CWord β)) := by
  calc
    source =
        ∑ word ∈ source.toFinset,
          Multiset.count word source •
            ({word} : Multiset (CWord β)) := by
      exact (Multiset.toFinset_sum_count_nsmul_eq source).symm
    _ =
        ∑ word ∈
            (signedDeduplicatedVocabulary
              x y z cutoff).toFinset,
          Multiset.count word source •
            ({word} : Multiset (CWord β)) := by
      apply Finset.sum_subset
      · intro word hword
        exact List.mem_toFinset.mpr
          (hsource word (Multiset.mem_toFinset.mp hword))
      · intro word _hwordVocabulary hwordSource
        have hwordNot : word ∉ source := by
          simpa only [Multiset.mem_toFinset] using hwordSource
        rw [Multiset.count_eq_zero_of_notMem hwordNot, zero_nsmul]

/--
Reconstruct the concrete retained signed strict-tail profile from one
collision-aware recipe per deduplicated physical slot.
-/
noncomputable def reconstructedBelowProfile
    {β : Type*}
    [DecidableEq β]
    (wt : β → ℕ)
    (x y z : CWord β)
    (cutoff : ℕ)
    (coefficient : ℤ) :
    Multiset (CWord β) :=
  ∑ word ∈
      (signedDeduplicatedVocabulary x y z cutoff).toFinset,
    Int.toNat
        ((filteredSlotExpansion
          wt x y z cutoff word).eval coefficient) •
      ({word} : Multiset (CWord β))

/--
The deduplicated physical-coordinate recipe family reconstructs the literal
physically retained signed strict-tail profile exactly.
-/
lemma reconstructed_concrete_profile
    {β : Type*}
    [DecidableEq β]
    (wt : β → ℕ)
    (hwt : ∀ atom, 0 < wt atom)
    (x y z : CWord β)
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (coefficient : ℤ) :
    reconstructedBelowProfile
        wt x y z cutoff coefficient =
      ↑(signedBelowTrace wt x y z cutoff coefficient) := by
  rw [deduplicated_vocabulary_nsmul
    x y z cutoff
      (↑(signedBelowTrace wt x y z cutoff coefficient) :
        Multiset (CWord β))]
  · unfold reconstructedBelowProfile
    apply Finset.sum_congr rfl
    intro word _hword
    rw [filtered_concrete_slot
      wt hwt x y z cutoff hcutoff coefficient word]
    simp
  · intro word hword
    apply
      deduplicated_vocabulary_below
        wt hwt x y z cutoff coefficient word
    simpa using hword

end WSRecons
end TCTex
end Submission


          (N := N) D forms).card : ℝ) /
          (trimToMultiple D N : ℝ) ^ t ≤
        ((C : ℝ) * (D : ℝ) *
            (N : ℝ) ^ (t - 1)) *
          (2 : ℝ) ^ t / (N : ℝ) ^ t := by
    exact
      div_trimToMultiple_pow_le_mul_two_pow_div
        hD hfit (by positivity) hbad
  unfold cfzCanonicalCarryCellBoundaryError
  simp only [Finset.prod_const, Finset.card_univ]

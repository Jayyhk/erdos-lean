    have hx : a * (-ε) + b * 0 = p 0 := by
      have hx' := congrArg (fun q : EuclideanSpace ℝ (Fin 2) => q 0) hcomb
      simpa [hLx i, hMx i] using hx'
    have ha0 : a = 0 := by nlinarith [ha, hε, hx, hp0]
    have hb1 : b = 1 := by nlinarith

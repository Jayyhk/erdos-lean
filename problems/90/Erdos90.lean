    adicFactorAlgebra
      (K := K) (L := L) P hP Q
  letI : Module.Finite (P.adicCompletion K) (q.adicCompletion L) :=
    finite_completion_module (K := K) (L := L) P Q
  letI : Algebra C D :=
    adicCompletionAlgebra
      (K := K) (L := L) P hP Q

      rw [div_neg, Real.arctan_neg]
    _ = -Real.arctan ((x / y)⁻¹) := by rw [hratio]
    _ = -Real.pi / 2 + Real.arctan (x / y) := by
      rw [Real.arctan_inv_of_pos hxy]

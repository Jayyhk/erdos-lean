theorem norm_le_pruned_pair {ι : Type*} (s : Finset ι) (c ζ : ι → ℂ)
    {a b : ℂ} {ρ : ℝ} (hρ : 0 < ρ) (hab : ‖b - a‖ = ρ) (z : ℂ) :

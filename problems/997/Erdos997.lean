  filter_upwards [hbound, eventually_tupleMaynardScale_pos
    (H := H) (sub_pos.mpr hdeltaTheta)] with N hbound hscale
  rw [abs_div, abs_of_pos hscale]
  exact div_le_div_of_nonneg_right hbound hscale.le


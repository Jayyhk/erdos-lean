      IntervalIntegrable (fun t : ℝ => F ((z.re : ℂ) + t * I))
        volume w.im z.im :=
    (intervalIntegrable_vertical_of_continuousOn_rectangle
      (x := z.re) hF.continuousOn left_mem_uIcc).symm

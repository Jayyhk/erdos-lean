namespace TCTex

/-- The ordered symbolic source factors in one fixed Hall-weight layer. -/
def symbolicWeightFactors
    {d : ℕ}
    (H : ∀ r : ℕ, BCWta.{u} d r)
    {ι : Type}
    (j : ι)
    (r : ℕ) :
    List (SCFactor H ι) :=
  (Finset.univ.sort fun i i' : (H r).index => i ≤ i').map fun i =>
    SCFactor.source j
      (⟨r, i⟩ : HEAddres H)


    {i : ℕ} {f : MonoidAlgebra R (FreeGroup X)}
    (hf :
      f ∈ Submission.GShafar.augmentationIdeal R (FreeGroup X) ^ i) :
    groupAlgebraMagnus (R := R) (X := X) f ∈
      MSeries.orderLeastIdeal (R := R) (X := X) i := by
  have hmap :
      groupAlgebraMagnus (R := R) (X := X) f ∈
        Ideal.map (groupAlgebraMagnus (R := R) (X := X))

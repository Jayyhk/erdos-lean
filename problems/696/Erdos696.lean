    (div_pos (mul_pos (by norm_num) hC) hlogTwo).trans hcoefficient
  have hcoefficientLog :
      3 * C < (m - 4 - 6 * K) * Real.log 2 := by
    calc
      3 * C = (3 * C / Real.log 2) * Real.log 2 := by
        field_simp
      _ < (m - 4 - 6 * K) * Real.log 2 :=
        mul_lt_mul_of_pos_right hcoefficient hlogTwo

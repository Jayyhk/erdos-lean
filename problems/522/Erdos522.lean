    calc
      _ ≤ 8 * ((j : ℝ) + 1) ^ 7 := by simpa using hp
      _ ≤ 8 * ((61 / 60 : ℝ) * j) ^ 7 := by gcongr
      _ = (8 * (61 / 60 : ℝ) ^ 7) * (j : ℝ) ^ 7 := by ring
      _ ≤ 9 * (j : ℝ) ^ 7 := by gcongr; norm_num

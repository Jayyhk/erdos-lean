      rw [Finset.sum_comm]
    _ = ∑ n ∈ s, c n *
        ∑ u : (ZMod q)ˣ,
          ψ.1⁻¹ (u : ZMod q) *
            ZMod.stdAddChar ((u : ZMod q) * (n : ZMod q)) := by
      apply Finset.sum_congr rfl
      intro n _hn
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro u _hu

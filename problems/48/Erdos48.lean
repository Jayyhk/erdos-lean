          (((k.factorial : ℕ) : ℝ) ^ 2 * Real.log 2) +
      4 * (2 : ℝ) ^ (2 * k) *
        ((2 : ℝ) ^ (4 * eta) * (2 * k).factorial) /
          (((k.factorial : ℕ) : ℝ) ^ 2 * Real.log 2))


    Function.Surjective (naturalModuleAlg k D ι) := by
  classical
  intro f
  let j := Classical.choice (inferInstance : Nonempty ι)
  let e : ι → D := Pi.single j 1
  let d : D := f e j
  refine ⟨MulOpposite.op d, ?_⟩
  ext v i

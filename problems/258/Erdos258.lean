    (d : H → ℕ) : ℝ :=
  if Nat.Coprime (divisorTupleProduct H d) W then
    (∏ h : H, (ArithmeticFunction.moebius (d h) : ℝ) * d h) *
      ∑ r ∈ maynardDivisorTupleBox H R,

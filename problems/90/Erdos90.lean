private theorem crossed_fn_one
    (i : L →+* E) (g : Gal(L/k) ≃* Gal(E/F))
    (hi : ∀ sigma : Gal(L/k), ∀ a : L,
      i (sigma a) = g sigma (i a))
    (c : NMCocycl₂ (G := Gal(L/k)) (M := Lˣ)) :

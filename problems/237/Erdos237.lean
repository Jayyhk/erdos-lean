      Squarefree (divisorTupleProduct H (divisorTupleQuotient d r)) := by
  have hmul : Squarefree
      (divisorTupleProduct H d *
        divisorTupleProduct H (divisorTupleQuotient d r)) := by
    rw [divisorTupleProduct_mul_quotient hdr]
    exact hr

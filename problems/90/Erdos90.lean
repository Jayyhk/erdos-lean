/-- Elements fixed by a finite group action. -/
def invariants : Subgroup M where
  carrier := {x | ∀ g : G, g • x = x}
  one_mem' := by simp
  mul_mem' := by
    intro x y hx hy g
    simp only [smul_mul', hx g, hy g]
  inv_mem' := by
    intro x hx g
    simp only [smul_inv', hx g]


  have hU_ne : U ≠ 0 := hU_pos.ne'
  have hQ_dvd : Q Y U ∣ U := Q_dvd_U Y U hU_ne
  rw [totient_a_eq Y U ℓ hℓ hU_pos hU_lt hQ_dvd, ← hAU]

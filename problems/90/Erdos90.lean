    (x : (P.withRelators (S ∪ T)).Group) (y : Q.Group) :
    x = (f.descre_union_kerna hT hker hf).symm y ↔
      (f.desc_relators_unionleft hT).toGroupHom x = y := by
  rw [eq_comm, Hom.descre_union_symmb, eq_comm]

/-- Alternate orientation of the right-union inverse characterization. -/
@[simp] theorem Hom.eqdesc_relauniorigh_equivsymmapply

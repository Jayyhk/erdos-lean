/-- A globally polynomial integer family automa satisfies the
missing-origin equation for its successor-precomposition. -/
lemma successor_polynomials_match
    {family : ℕ → ℤ}
    {degreeBound : ℕ}
    (hfamily :
      IVMost family degreeBound) :
    SuccessorPolynomialsOrigin family := by
  rcases hfamily with ⟨Q, _hQdegree, hQeval⟩
  intro P hPeval
  have hPQ :
      P = Q.comp (Polynomial.X + Polynomial.C 1) := by
    apply Polynomial.eq_of_infinite_eval_eq
    apply Set.infinite_of_injective_forall_mem
      (Nat.cast_injective :
        Function.Injective (fun steps : ℕ => (steps : ℚ)))
    intro steps
    change
      P.eval (steps : ℚ) =
        (Q.comp (Polynomial.X + Polynomial.C 1)).eval (steps : ℚ)
    rw [hPeval steps, Polynomial.eval_comp]
    simpa using (hQeval (steps + 1)).symm
  rw [hPQ, Polynomial.eval_comp]
  simpa using hQeval 0

/-- Slotwise global cutoff-profile polynomiality forces every exact
successor-origin equation. -/
lemma polynomials_match_origin
    {cutoff degreeBound : ℕ}
    {family : ℕ → Multiset (CWord Atom)}
    (hfamily : CPDataa cutoff degreeBound family) :
    CutoffMatchOrigin family := by
  intro slot
  exact successor_polynomials_match (hfamily.2 slot)

/-- Every complete positive strict-tail slot retains its exact formal
joint-weight degree bound across the missing origin. -/
theorem count_profile_natural
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (slot : CWord Atom) :
    IVMost
      (fun multiplicity =>
        (Multiset.count slot
          (cutoffProfile cutoff
            (NPTail.strictTrace
              multiplicity)) : ℤ))
      (slot.weight (fun _ => 1)) := by
  apply
    TCTex.IVMost.pred_match_origin
  · rw [show
      (fun steps : ℕ =>
        (Multiset.count slot
          (cutoffProfile cutoff
            (NPTail.strictTrace
              (steps + 1))) : ℤ)) =
        fun steps : ℕ =>
          (Multiset.count slot
            ((scheduleAffine cutoff
              (naturalFullSchedule cutoff (steps + 1))).apply 0) :
                ℤ) by
      funext steps
      rw [
        natural_affine_transition
          cutoff hcutoff (steps + 1)]]
    exact
      count_affine_natural
        cutoff (by omega) slot
  · exact
      (polynomials_match_origin
        (cutoff_profile_natural cutoff hcutoff)) slot


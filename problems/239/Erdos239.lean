        (N : ℝ) ^ (s : ℝ)⁻¹ / C ^ (s : ℝ)⁻¹ := by
    rw [le_div_iff₀ hCrpow]
    rw [← hpow]
    nlinarith [Real.rpow_nonneg hNR.le e]

    rw [segment_eq_image_lineMap]
    refine ⟨coord x, ⟨?_, ?_⟩, ?_⟩
    · linarith [ht0, hxcoord.1]
    · linarith [ht1, hxcoord.2]
    · rw [AffineMap.lineMap_apply_module]
      have hdecomp :

    R certificate fixed candidates bandOf cellIndex
      pointwiseUpper prefixUpper selector S
      (tangentRatioCellEarthmoverFlow lastCell
        (bankPaperCanonicalTangentResidual
          R certificate fixed candidates selector)
        bandOf cellIndex)

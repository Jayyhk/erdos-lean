private lemma isLittleO_sub_self_inv_of_tendsto_mul
    {g : ℂ → ℂ} {rho : ℂ}
    (h : Tendsto (fun s => (s - rho) * g s) (𝓝[≠] rho) (𝓝 0)) :
    (fun s => g s - g rho) =o[𝓝[≠] rho] fun s => (s - rho)⁻¹ := by
  have hsub : Tendsto (fun s => (s - rho) * (g s - g rho))

/-!
# Recollecting concrete Hall-Witt strict-tail residual sources

The concrete Hall-coordinate strict-tail theorem identifies the complete
fixed-weight Hall segment of a Hall-Witt tail and proves that the remaining
value starts one lower-central stratum higher.  An operational symbolic
collector still needs an exact symbolic source for that remaining value.

This file packages that boundary precisely.  A residual-source certificate
records such an exact symbolic source without pretending that the coarse
global Newton bound is already the physical Hall weight of each operational
factor.  Any semantic normalizer at the residual's physical support stratum
then recollects the certified source into an evaluation-equivalent source
supported one stratum higher.

The file is intentionally not imported by the existing collection proof.
-/

noncomputable section

namespace Submission
namespace TCTex
namespace RSRecol

open CWTrace
open STSubsti
open
  GPBasis
open
  PRResid
open
  RTResid

/--
An exact symbolic source for the residual left after removing the canonical
fixed-weight Hall segment from a complete signed Hall-Witt strict tail.

The coefficient may be any function of the symbolic repetition parameter.
The important operational facts are that the source is fixed, truncated,
physically supported in the residual layer, and has the required pointwise
evaluation.
-/
structure TWSrca
    {d n inputWeight : ℕ}
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (hparent :
      exponentAddressParent x y z + 1 < n)
    (coefficient : ℕ → ℤ) where
  source :
    List
      (SPFactora
        (concreteBasicCommutators.{u} d) inputWeight)
  source_isTruncated :
    SPFactora.IsTruncated n source
  source_weight_least :
    SPFactora.WordWeightLeast
      (exponentAddressParent x y z + 1) source
  list_eval_residual :
    ∀ q : ℕ,
      SPFactora.listEval (n := n) q source =
        ((concreteCommutatorsWeight.{u} d
          (exponentAddressParent x y z + 1)).collectedWeightProduct
            (n := n)
            (concreteAddressCoordinates
              d n x y z n (coefficient q) hparent))⁻¹ *
          wordListEval
            (PEAddres.freeLowerTruncation
              (n := n))
            (signedStrictTrace x y z (coefficient q))

/-- Positive-multiplicity residual-source certificates. -/
abbrev TruncatedWittNatural
    {d n inputWeight : ℕ}
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (hparent :
      exponentAddressParent x y z + 1 < n) :=
  TWSrca
    (inputWeight := inputWeight) x y z hparent Int.ofNat

/-- Shifted-negative-multiplicity residual-source certificates. -/
abbrev TruncatedWittNegative
    {d n inputWeight : ℕ}
    (x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d)))
    (hparent :
      exponentAddressParent x y z + 1 < n) :=
  TWSrca
    (inputWeight := inputWeight) x y z hparent Int.negSucc

namespace TWSrca

/--
A current-stratum semantic normalizer turns a certified Hall-Witt residual
source into an exact source supported one stratum higher.
-/
noncomputable def sourceRecollectionNormalizer
    {d n inputWeight : ℕ}
    {x y z :
      CWord
        (HEAddres (concreteBasicCommutators.{u} d))}
    {hparent :
      exponentAddressParent x y z + 1 < n}
    {coefficient : ℕ → ℤ}
    (residual :
      TWSrca
        (inputWeight := inputWeight) x y z hparent coefficient)
    (hn : 2 ≤ n)
    (normalizer :
      TSNormalb
        (n := n) (inputWeight := inputWeight)
        (lowerWeight :=
          exponentAddressParent x y z + 1)
        (concreteBasicCommutators.{u} d)) :
    TSRecol
      (n := n)
      (lowerWeight :=
        exponentAddressParent x y z + 1 + 1)
      (concreteBasicCommutators.{u} d) residual.source := by
  apply
    normalizer.source_recollection_series
      hn (concreteBasicCommutators.{u} d)
        (fun s hs hsn =>
          concrete_forms_associated d n s hs hsn)
        residual.source (by omega) hparent residual.source_isTruncated
        residual.source_weight_least
  intro q
  rw [residual.list_eval_residual]
  exact
    address_signed_next
      d n x y z hparent (coefficient q)

end TWSrca

end RSRecol

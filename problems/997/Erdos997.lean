  exact ArithmeticFunction.LSeriesHasSum_mul
    (ArithmeticFunction.LSeriesHasSum_mul
      (ArithmeticFunction.LSeriesHasSum_mul
        (ArithmeticFunction.LSeriesHasSum_zeta hs)
        (characterAF_LSeriesHasSum chi1 hs))
      (characterAF_LSeriesHasSum chi hs))

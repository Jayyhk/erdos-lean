theorem LFunction_ne_zero_on_dirichletExplicitFormulaVerticalEdges
    {q : ℕ} [NeZero q] (chi : DirichletCharacter ℂ q)
    (x : ℝ) (hx : 1 < x) (N : ℕ) (t : ℝ) :

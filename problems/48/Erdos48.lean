    -(∑ m ∈ s, g m) =
        ∑ alpha ∈ dyadicExponentRange ⌊(x : ℝ) / V⌋₊,
          -(∑ m ∈ s.filter (fun m ↦ m ∈ dyadicBlock alpha), g m) := by
      rw [sum_eq_sum_dyadicBlocks s hsupport g]
      rw [← Finset.sum_neg_distrib]

/-- Every vertex visited by a walk belongs to `S`. -/
private def _root_.SimpleGraph.Walk.SupportsIn (p : G.Walk x y) (S : Finset V) : Prop :=
  ∀ z : V, z ∈ p.support → z ∈ S

private theorem _root_.SimpleGraph.Walk.SupportsIn.start_mem {p : G.Walk x y} {S : Finset V}
    (h : p.SupportsIn S) : x ∈ S :=
  h x p.start_mem_support

private theorem _root_.SimpleGraph.Walk.SupportsIn.mono {p : G.Walk x y} {S T : Finset V}
    (h : p.SupportsIn S) (hST : S ⊆ T) : p.SupportsIn T :=
  fun z hz ↦ hST (h z hz)

private theorem _root_.SimpleGraph.Walk.SupportsIn.of_support_subset {p : G.Walk x y} {q : G.Walk x' y'}
    {S : Finset V} (h : p.SupportsIn S) (hqp : q.support ⊆ p.support) :
    q.SupportsIn S :=
  fun z hz ↦ h z (hqp hz)

@[simp] private theorem _root_.SimpleGraph.Walk.supportsIn_nil_iff (x : V) (S : Finset V) :
    (Walk.nil : G.Walk x x).SupportsIn S ↔ x ∈ S := by
  simp [SupportsIn]

private theorem _root_.SimpleGraph.Walk.SupportsIn.reverse {p : G.Walk x y} {S : Finset V}
    (h : p.SupportsIn S) : p.reverse.SupportsIn S := by
  intro z hz
  apply h z
  simpa [p.support_reverse] using hz

private theorem _root_.SimpleGraph.Walk.SupportsIn.append {p : G.Walk x y} {q : G.Walk y z}
    {S : Finset V} (hp : p.SupportsIn S) (hq : q.SupportsIn S) :
    (p.append q).SupportsIn S := by
  intro w hw
  rcases (p.mem_support_append_iff q).1 hw with hw | hw
  · exact hp w hw
  · exact hq w hw

private theorem _root_.SimpleGraph.Walk.SupportsIn.mapLe {G G' : SimpleGraph V} (hGG' : G ≤ G')
    {p : G.Walk x y} {S : Finset V} (h : p.SupportsIn S) :
    (p.mapLe hGG').SupportsIn S := by
  rw [SupportsIn, p.support_mapLe_eq_support]
  exact h


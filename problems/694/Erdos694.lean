    rw [Finset.sum_product]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro m hmm
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro n hnn
    simp only [c, r, symmetricPerronIntegrand]
    change (a m * b n * χ (m * n)) *
        (natLogTwist (m * n) t *

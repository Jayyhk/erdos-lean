  have hMcast : (2 : ℝ) ≤ M := by exact_mod_cast hM
  have hMsquare : (4 : ℝ) ≤ (M : ℝ) ^ 2 := by nlinarith
  have hMpos : (0 : ℝ) < M := zero_lt_two.trans_le hMcast

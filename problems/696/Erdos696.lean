    {q : ℕ} (chi : DirichletCharacter ℂ q) (X : ℕ) : ℂ :=
  (1 / (X : ℂ)) *
    ∫ t : ℝ in Set.Ioc 0 (X : ℝ),
      ((Int.fract t : ℝ) : ℂ) *
        ∑ a ∈ Finset.Icc 1 (quadraticEulerCutoff X t),

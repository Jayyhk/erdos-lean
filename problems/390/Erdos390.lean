only the displayed discrete BV norm of the sequence remains. -/
theorem abs_fourFiveReciprocalPrimeBVDefect_le_uniform
    (f : Nat -> Real) {A Y : Nat}
    (hA : fourFiveReciprocalBVSafeCutoff <= A) (hAY : A <= Y) :

open Complex Filter
open scoped ComplexConjugate Topology

private lemma conj_LSeries_conj_eq_inv
    {q : ℕ} (chi : DirichletCharacter ℂ q) (s : ℂ) :
    conj (LSeries (chi ·) (conj s)) = LSeries (chi⁻¹ ·) s := by

    {q : ℕ} [NeZero q]
    (chi : DirichletCharacter ℂ q) (hchi : chi.IsPrimitive)
    (N : ℕ) {s : ℂ} (hs : s.re = -(N : ℝ) - 1 / 2) :
    DirichletCharacter.LFunction chi s ≠ 0 := by
  have hs0 : s ≠ 0 := by
    intro h

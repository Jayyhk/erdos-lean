    exact mul_nonneg hq0
      (mul_nonneg (Real.sqrt_nonneg _) (vaughanCubeRoot_nonneg x))
  have hthreeCoeff :
      3 * ((q * Real.sqrt q) * vaughanCubeRoot x ^ 2) ≤

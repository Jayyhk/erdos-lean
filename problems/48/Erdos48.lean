      (powerSieveX n L : ℝ) /
        (100 * (Nat.totient (q * r) : ℝ) *
          Real.log (powerSieveX n L : ℝ)) := by
  have hx : 2 ≤ powerSieveX n L := by
    unfold powerSieveX
    exact hn.trans (Nat.le_pow (by omega : 0 < 240 * L))

omit [FiniteDimensional k L] [IsGalois k L] in
@[simp]
theorem diagonal_single_zero (sigma : Gal(L/k)) :
    diagonalSingleAction k L c d sigma 0 = 0 := by
  apply ext_bimodule_basis k L c d

        ArithmeticFunction.vonMangoldt aq.1 *
          (Real.log (H : ℝ))⁻¹ * (1 / 2) := by
      apply Finset.sum_le_sum
      intro aq haq
      apply mul_le_mul_of_nonneg_left
      · by_cases hq : aq.2 = 1
        · simp [hq]

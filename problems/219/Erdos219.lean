  rw [hrecenter]
  calc
    ‖∑ i ∈ s,
        (weight i : ℂ) * (correction i - 1)‖ ≤
        ∑ i ∈ s,
          ‖(weight i : ℂ) * (correction i - 1)‖ :=
      norm_sum_le _ _
    _ ≤
        ∑ i ∈ s, weight i * ε := by
      apply Finset.sum_le_sum
      intro i hi

      IntervalIntegrable (fun t : ℝ => G ((w.re : ℂ) + t * I))
        volume z.im w.im := by
    apply intervalIntegrable_vertical_principalPartSum P c
    intro rho hrho
    exact ne_of_gt (hP rho hrho).2.1
  have hGleft :
      IntervalIntegrable (fun t : ℝ => G ((z.re : ℂ) + t * I))

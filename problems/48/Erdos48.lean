    norm_num at hre
    have hnnonneg : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    by_cases hnzero : n = 0
    · subst n
      norm_num at hre
      linarith
    · have hnOne : (1 : ℝ) ≤ n := by
        exact_mod_cast Nat.one_le_iff_ne_zero.mpr hnzero
      linarith
  · rw [hodd.gammaFactor_def, Gammaℝ_eq_zero_iff] at hgamma
    obtain ⟨n, hn⟩ := hgamma
    have hre := congrArg Complex.re hn
    norm_num at hre

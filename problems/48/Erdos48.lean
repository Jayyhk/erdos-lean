            (fun b ↦ centeredProgressionDiscrepancy z q b)) hy
        (Finset.le_sup'_of_le (centeredProgressionDiscrepancy y q) ha le_rfl)
    have hrem := monotone_natCast_psi_sub_theta (Finset.mem_Icc.mp hy).2

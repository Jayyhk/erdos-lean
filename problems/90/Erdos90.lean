    (f : Gal(L/K) → resizedConcreteRepresentation K L)
    (hf : ∀ sigma, (f sigma).toMul ∈
      idelesAtPlaces (K := K) (L := L) S) :
    Gal(L/K) → resizedPlacesRepresentation (K := K) (L := L) S :=
  fun sigma => Additive.ofMul ⟨(f sigma).toMul, hf sigma⟩


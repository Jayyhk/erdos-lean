          maxCenteredProgressionDiscrepancyUpTo x q) +
        (Q : ℝ) *
          (Chebyshev.psi (x : ℝ) - Chebyshev.theta (x : ℝ)) := by
      rw [Finset.sum_add_distrib]
      simp [nsmul_eq_mul]
      ring

end


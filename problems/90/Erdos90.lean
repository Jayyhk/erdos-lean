`ℝˣ` has index one. -/
theorem real_odd_index
    {n : ℕ} (hn : Odd n) :
    (powMonoidHom n : ℝˣ →* ℝˣ).range.index = 1 := by
  rw [MonoidHom.range_eq_top.mpr (real_odd_monoid hn)]
  exact Subgroup.index_top


  obtain ⟨a, ha⟩ := Field.exists_primitive_element 𝓀[K] d
  obtain ⟨alpha, halpha⟩ :=
    (divisionMaximalIdeal K D).ringCon.mk'_surjective a
  let E : Subalgebra K D := Algebra.adjoin K ({(alpha : D)} : Set D)
  have hset : ∀ x ∈ ({(alpha : D)} : Set D),

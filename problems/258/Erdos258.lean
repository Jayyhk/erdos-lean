        2 * (8 * (K : ℝ) ^ 2 /
          ((tinyCutoff K + 1 : ℕ) : ℝ)) := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left
          (sum_mediumPrimes_primeLogDisplacement_sq_div_le m) (by norm_num)
      · exact mul_le_mul_of_nonneg_left
          (by simpa [a] using sum_mediumPrimes_K_div_pred_sq_div_le m)
          (by norm_num)

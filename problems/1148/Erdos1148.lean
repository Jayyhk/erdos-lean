  have hm₀₁ := congrArg (fun A : Matrix (Fin 2) (Fin 2) ℚ => A 0 1) hM
  have hm₁₀ := congrArg (fun A : Matrix (Fin 2) (Fin 2) ℚ => A 1 0) hM
  have hm₁₁ := congrArg (fun A : Matrix (Fin 2) (Fin 2) ℚ => A 1 1) hM

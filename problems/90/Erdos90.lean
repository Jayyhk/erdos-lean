transition maps. -/
theorem chinese_remainder_transition
    (P : ι → Ideal R) (hP : Pairwise (IsCoprime on P))
    {m n : ℕ} (hmn : m ≤ n)
    (x : ∀ i, R ⧸ (P i ^ n • (⊤ : Submodule R R))) :

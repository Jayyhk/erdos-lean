          commonTupleInvTotientMean H (primorial D) R :=
      abs_incompatibleSum_le_crossTail_mul_commonMean hR hB hyBound hy
    _ ≤ B ^ 2 *
        ((8 * Real.exp 8 / (D : ℝ)) *

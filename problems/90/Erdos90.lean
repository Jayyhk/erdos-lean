noncomputable def powGeneratorStep
    (L : Type*) [Field L] [NumberField L] [Algebra ℚ L]
    {r : ℕ}
    {P : Ideal (NumberField.RingOfIntegers L)}
    (hP0 : P ≠ ⊥)
    [P.IsPrime]
    (i : ℕ)
    (hi :
      i <
        Ideal.ramificationIdx (Ideal.rationalPrimeIdeal r) P) :
    (↥(Ideal.map

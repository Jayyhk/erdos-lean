    simpa only [sub_zero] using largeBoxWidth_pos)).ne'

theorem largePositiveBox_subset_simplex :
    largePositiveBox ⊆ BoundedGaps.Maynard.maynardSimplex largeK := by
  intro t ht
  have hK : (0 : ℝ) < largeK := Nat.cast_pos.mpr largeK_pos

  refine ⟨N₀, ?_⟩
  intro N hN
  apply coversShiftDifferencePrimes_of_diameter
  intro a b hab
  exact (engelsmaTuple_shiftDiameterBound hab).trans (hN₀ N hN)

end BoundedGaps.Maynard


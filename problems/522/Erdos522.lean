  have hA := measurable_levelOccupation ν X hX
  have hbound (p : ℝ × Ω) : ‖levelOccupation ν X p‖ ≤ 1 := by
    rw [Real.norm_eq_abs, abs_of_nonneg (levelOccupation_mem_Icc ν X p).1]

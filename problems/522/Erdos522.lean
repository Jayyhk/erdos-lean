theorem finiteBlaschkeProduct_apply {f : ℂ → ℂ} {R : ℝ}
    (hf : MeromorphicOn f (closedBall 0 R)) (z : ℂ) :
    finiteBlaschkeProduct f R z =
      ∏ u ∈ hf.divisor_ball_support_finite.toFinset,

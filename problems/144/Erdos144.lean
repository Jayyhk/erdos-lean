theorem regularBalancedProfileMass_le_concrete
    {D R s : ℕ} :
    regularBalancedProfileMass (Finset.Ioc (D / 8 ^ R) D) D R s ≤
      (∑ r ∈ Finset.range s, lowContribution D r) +
        ∑ k ∈ Finset.range (R - s), highContribution D s k := by

    change eval₂
      ((divisionIntegerSubring K D).subtype.comp
        (baseDivision K D)) (alpha : D) pR = 0
    change eval₂ _ _ (p.map normIntegerToRelInteger) = 0
    rw [eval₂_map]
    simpa [ON, OR, integerDivision, baseDivision,
      normIntegerToRelInteger] using hpRootD

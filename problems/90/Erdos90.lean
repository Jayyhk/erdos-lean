    q hq hcentral phi hfixed lift hliftRight
  intro z
  change (lift.comp N.subtype) ⟨z.1, hkerN z.property⟩ =
    SemidirectProduct.inl (phi z)
  rw [hliftN]
  exact hfnKernel z


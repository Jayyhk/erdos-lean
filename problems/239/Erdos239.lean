/-- The integers in `(L,U]` whose residues modulo `g` lie in `A`. -/
def modularPreimageIoc (L U g : ℕ) (A : Finset ℕ) : Finset ℕ :=
  (Finset.Ioc L U).filter fun n => n % g ∈ A


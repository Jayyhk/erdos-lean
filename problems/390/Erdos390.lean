    (Rhead : HeadSimplexReserve P)
    (Kphysical : PhysicalInterpolationTarget I)
    (hdelta : 0 < delta) (hn : 1 < D.n) (hW : D.W ≠ 0)
    (S : ScaleSeparation M D.n D.W) (hw : 0 < delta + eta) :
    BridgeData (PaperHeadSimplex.Tag P)

  induction x using Representation.Coinvariants.induction_on with
  | _ y =>
      apply Subtype.ext
      change B.ρ.norm (e.hom y) = e.hom (A.ρ.norm y)
      exact congrArg (fun q : A ⟶ B => q.hom y) (Rep.norm_comm e.hom)


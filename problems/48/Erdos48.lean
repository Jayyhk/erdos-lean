theorem abs_integral_mul_sinc_sub_sign_pi_div_two_le_inv
    {T Y : ℝ} (hT : 0 < T) (hY : Y ≠ 0) :
    |(∫ t in (0 : ℝ)..T, Y * Real.sinc (Y * t)) -
      Real.sign Y * (Real.pi / 2)| ≤ (T * |Y|) ^ (-1 : ℤ) := by
  have hTY : T * Y ≠ 0 := mul_ne_zero hT.ne' hY

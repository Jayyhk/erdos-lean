        intro c
        simpa [pulledAction, MulAction.compHom_smul_def] using x.2 (e c) ⟩
      left_inv := fun x ↦ by apply Subtype.ext; rfl
      right_inv := fun x ↦ by apply Subtype.ext; rfl
      map_mul' := fun x y ↦ by apply Subtype.ext; rfl }


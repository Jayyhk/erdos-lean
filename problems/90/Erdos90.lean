    (_hcompat : βA.comp quotientMap = π.comp αE)
    (β₀ : rationalTameGalois S →* E)
    (hβ₀_continuous : Continuous β₀)
    (hβ₀_lift : π.comp β₀ = βA)
    (χ : rationalTameGalois S →* π.ker)
    (hχ_continuous : Continuous χ)
    (hχ_values :
      ∀ i : Fin d,

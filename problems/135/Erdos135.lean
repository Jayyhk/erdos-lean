    intro q
    exact (Classical.choose_spec (pair_separation q)).1
  have pairSep_le_dist :
      ∀ q : PairIndex,
        ∀ a, a ∈ residualPieceData.originalPiece q.1.1 →
          ∀ b, b ∈ residualPieceData.originalPiece q.1.2 →
            pairSep q ≤ dist a b := by

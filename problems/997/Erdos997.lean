    (fun h => largeFiberProfile
      (BoundedGaps.Maynard.normalizedDivisorLogTuple H R d h))
    (Finset.mem_univ m)]
  have hm : BoundedGaps.Maynard.normalizedDivisorLogTuple H R d m =

    {d n inputWeight : ℕ}
    {H : ∀ s : ℕ, BCWta.{u} d s}
    (builder :
      TDBuild
        (n := n) (inputWeight := inputWeight) H) :
    RIDeriva
      (n := n) (inputWeight := inputWeight) H where
  insert lowerWeight hnonterminal normalizer :=
    builder.insert lowerWeight hnonterminal normalizer

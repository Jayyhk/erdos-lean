    rw [← Real.rpow_add hpR]
    norm_num [Real.rpow_two]
  rw [le_div_iff₀ (Real.rpow_pos_of_pos hpR _)]
  calc
    ((1 : ℝ) / ((p : ℝ) * (p - 1 : ℕ))) *
          (p : ℝ) ^ (1 / 2 : ℝ) * (p : ℝ) ^ (3 / 2 : ℝ) =
        ((1 : ℝ) / ((p : ℝ) * (p - 1 : ℕ))) * (p : ℝ) ^ 2 := by
      rw [mul_assoc, hpow]

    {p d k : ℕ} {Q : Type u} [Group Q]
    (S : FSBound p d k Q) :
    Finset S.fp.toPresentation.Relator :=
  by
    classical
    letI : Fintype S.fp.toPresentation.Relator := S.fintype_relator

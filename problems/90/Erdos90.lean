/-!
# Concrete substituted profile vectors for global Hall-Witt recipes

Formal Hall-Witt slots are deduplicated before substitution, but distinct
formal slots may still bind to the same concrete commutator word.  Deduplicate
once more after substitution, then attach the collision-aware paired expansion
to each physical slot.  This produces a finite concrete-coordinate vector
independent of the evaluated integral coefficient.

This file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace GSVector

open WSTrace
open STSubsti
open TOCoordi
open STVocabu
open PMExp
open
  GRExp
open
  GSExp
open
  GSSlot

/--
The physical cutoff vocabulary, deduplicated after signed substitution.
-/
def signedDeduplicatedVocabulary
    {β : Type*}
    [DecidableEq β]
    (x y z : CWord β)
    (cutoff : ℕ) :
    List (CWord β) :=
  (signedOrderedVocabulary x y z cutoff).dedup

/--
Every retained signed strict-tail occurrence belongs to the finite physical
vocabulary deduplicated after substitution.
-/
lemma deduplicated_vocabulary_below
    {β : Type*}
    [DecidableEq β]
    (wt : β → ℕ)
    (hwt : ∀ atom, 0 < wt atom)
    (x y z : CWord β)
    (cutoff : ℕ)
    (coefficient : ℤ)
    (word : CWord β)
    (hword : word ∈ signedBelowTrace wt x y z cutoff coefficient) :
    word ∈ signedDeduplicatedVocabulary x y z cutoff := by
  simpa [signedDeduplicatedVocabulary] using
    signed_vocabulary_below
      wt hwt x y z cutoff coefficient word hword

end GSVector
end TCTex
end Submission


    BoundedGaps.Maynard.normalizedDivisorLogTuple_mem_cube_and_sum_lt_one_of_mem_support
      hR hd
  refine ⟨?_, hdata.2.le⟩
  rw [BoundedGaps.Maynard.maynardCubeOf, Set.mem_pi]
  intro h hh
  exact hdata.1 h

end

end Erdos6.Maynard


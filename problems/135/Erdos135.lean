        rw [hassembledVertices_def i]
        simp [EndpointUnitDiskAlternatingVertexList]]
      rw [List.getLast?_append_of_ne_nil [a i] (by simp :
        (orderedLocalVertexBlocks i).flatten ++ [b i] ≠ [])]
      simp

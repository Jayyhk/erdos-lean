norm at most `2 * log x`. -/
theorem norm_dirichletExplicitFormulaShallowMainTermCorrection_le_two_mul_log
    {q : ℕ} [NeZero q] (chi : DirichletCharacter ℂ q)
    {x : ℝ} (hx : 2 ≤ x) :
    ‖dirichletExplicitFormulaShallowMainTermCorrection chi x‖ ≤
      2 * Real.log x := by

/-- Promote a list of factors to a new cutoff after proving the weighted-degree bound for every
entry. -/
def listRebase
    {p : ℕ}
    {α : Type*}
    {G : Type*} [Group G]
    {f : α → G}
    {wt : α → ℕ}
    {cutoff cutoff' : ℕ} :

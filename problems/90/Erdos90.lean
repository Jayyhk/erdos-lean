    b * a ∈ cyclicExtendJ W.J x w (r + m) := by
  let Y : denseGroupAlgebra p G := groupAlgebraSub p G x
  dsimp [cyclicExtendJ] at ha
  refine
    Submodule.iSup_induction
      (fun e : Fin p =>
        (W.J (m - (e : ℕ) * w)).map
          (rightMulLinear (Y ^ (e : ℕ))))
      (motive := fun a =>
        b * a ∈ cyclicExtendJ W.J x w (r + m))

/-- A concrete boundedness predicate for subsets of `ℂ^d`. -/
def IsBoundedSet {d : ℕ} (Ω : Set (ComplexSpace d)) : Prop :=
  ∃ R : ℝ, ∀ z ∈ Ω, ‖z‖ ≤ R

/-- The translate `t + Ω` of a subset of `ℂ^d`. -/
def translateSet {d : ℕ} (t : ComplexSpace d) (Ω : Set (ComplexSpace d)) :
    Set (ComplexSpace d) :=

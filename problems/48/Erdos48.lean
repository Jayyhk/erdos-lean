    ((MeromorphicOn.divisor f K).support.ncard : ℝ) ≤
      ((∑ᶠ z : 𝕜, MeromorphicOn.divisor f K z : ℤ) : ℝ) := by
  let D : 𝕜 → ℤ := MeromorphicOn.divisor f K

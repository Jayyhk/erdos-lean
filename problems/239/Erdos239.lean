    (z * (p : ℂ) ^ (-((sigma : ℂ) + Complex.I * (t : ℂ)))).re =
      (p : ℝ) ^ (-sigma) * (z * conj (archimedeanTwist t p)).re := by
  rw [nat_cpow_neg_sigma_add_I_mul hp]
  rw [show z * ((((p : ℝ) ^ (-sigma) : ℝ) : ℂ) *
        conj (archimedeanTwist t p)) =
      (((p : ℝ) ^ (-sigma) : ℝ) : ℂ) *
        (z * conj (archimedeanTwist t p)) by ring]
  simp


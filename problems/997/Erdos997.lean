        (tendsto_id : Tendsto (fun T : ℝ => T) atTop atTop))
  have hsquare : Tendsto (fun T : ℝ => (1 + T) ^ 2) atTop atTop := by
    have h := tendsto_mul_self_atTop.comp hlinear

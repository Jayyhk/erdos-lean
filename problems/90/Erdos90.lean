    (v : NumberField.InfinitePlace K) :
    (InfiniteAdeleRing L)ˣ →* v.1.Completionˣ := by
  classical
  exact
    { toFun := fun x => ∏ w : InfinitePlacesAbove (K := K) (L := L) v,
        infiniteCompletionNorm (K := K) (L := L) v w
          (MulEquiv.piUnits x w.1)

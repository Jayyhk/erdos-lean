    _ = (P.asIdeal.map (algebraMap R A)).map f :=
      (Ideal.map_map (algebraMap R A) f).symm
    _ = (IsLocalRing.maximalIdeal A).map f := by rw [hloc]
    _ = IsLocalRing.maximalIdeal D :=
      maximal_completion_integers (K := L) q


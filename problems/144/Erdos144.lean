  | zero => simp
  | succ q ih =>
      let B := 8 ^ q * A
      have hB : 0 < B := by positivity
      have h16B : 16 ∣ B := by
        rcases h16 with ⟨m, rfl⟩
        exact ⟨8 ^ q * m, by simp [B]; ring⟩

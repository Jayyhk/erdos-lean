  ⟨completionPlaceRaw (K := K) (L := L) P w, rfl⟩

private noncomputable def extensionRingHom
    (P : HeightOneSpectrum (NumberField.RingOfIntegers K))
    (w : CompletionPlacesAbove (L := L) (FinitePlace.mk P).val) :
    P.adicCompletion K →+*

  have hlogy : 0 < Real.log (y : ℝ) :=
    Real.log_pos (by exact_mod_cast (show 1 < y by omega))
  have hpR : (0 : ℝ) < p := by
    exact_mod_cast Nat.zero_lt_of_lt hp
  have hpowR : (y : ℝ) ^ (j + 1) ≤ (p : ℝ) := by

          (((R.filter fun r ↦
            (x : ℝ) / 10 < primitiveEndpointMass x r).card : ℕ) : ℝ) *
              ((x : ℝ) / 10) +
        ((((Q.product R).filter fun qr ↦
          (x : ℝ) / 10 <

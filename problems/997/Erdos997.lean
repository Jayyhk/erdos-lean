theorem sum_linear_cutoff_eq_half_sub_fractIntegral
    {u : ℝ} (hu : 0 < u) :
    (∑ b ∈ Finset.Icc 1 ⌊u⌋₊,
      (1 - (b : ℝ) / u)) =
      u / 2 - (1 / u) *
        (∫ t : ℝ in Set.Ioc 0 u, Int.fract t) := by
  rw [integral_fract_formula hu]
  rw [Finset.sum_sub_distrib, Finset.sum_const]

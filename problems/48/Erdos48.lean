  have hpoly0 : 0 ≤ t - t ^ 3 / 6 := by
    nlinarith [sq_nonneg t, mul_self_le_mul_self ht0 ht_two]
  have hsq : (t - t ^ 3 / 6) ^ 2 ≤ Real.sin t ^ 2 := by
    nlinarith

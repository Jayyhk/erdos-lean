/-- First nested projection after inverse quotient associator is target first projection. -/
@[simp] theorem mFQuot.mapfst_fstprod_assocsymm
    (G H K : Type*) [Group G] [Group H] [Group K]
    (x : mFQuot p (G × H × K)) :

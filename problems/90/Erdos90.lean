        (M : ℤ) (N : ℤ) =
      (schedulerIndexCount raw branch M N index : ℤ) := by
  rw [schedulerIdxProfile]
  rw [
    (branch.profiledObstructionBranch raw)
      |>.profiledIndexFamily
      |>.kernel
      |>.profiles_nat_count]
  exact_mod_cast
    (FISchedu.IOBranch.idxPermScheduler
      raw branch M N).count_eq index


            (n := n) later.address,
          PEAddres.freeLowerTruncation
            (n := n) earlier.address⁆ ^
          ((later.coefficient * earlier.coefficient) *
            (Nat.choose q 2 : ℤ)) := by
            simp [pairCorrection, SPFactora.eval,
              SPFactora.wordValue, SPFactora.exponent,

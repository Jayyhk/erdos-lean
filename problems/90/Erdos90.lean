      Subgroup.normalClosure ((P.withRelators S).quotientMap '' T))
    (hf : Function.Surjective f.toGroupHom) (w : P.Free) :
    f.descre_union_kerna hT hker hf
        ((P.withRelators (S ∪ T)).quotientMap w) =
      f.toGroupHom ((P.withRelators S).quotientMap w) := by
  rw [Hom.descrelators_unionleft_equivapply,
    Hom.descre_union_homqu]


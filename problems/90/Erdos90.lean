    (builder :
      TDBuild
        (n := n) (inputWeight := inputWeight) H)
    (lowerWeight : ℕ) :
    TSNormalb
      (n := n) (inputWeight := inputWeight) (lowerWeight := lowerWeight) H :=
  reachable_rec_insertion hn H hH
    (builder.reachableRecursiveDerivation
      |>.reachableRecursiveSemantic)

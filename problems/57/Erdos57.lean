  cube_warm : 2 * lmGrowthDivisor N ≤ m ^ 3 * D
  square_workspace : lm42SquareWorkspace D m L ≤
    lmGrowthGain N (m ^ 2 * D)
  cube_workspace : lm42CubeWorkspace D m L ≤
    lmGrowthGain N (m ^ 3 * D)

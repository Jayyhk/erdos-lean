/-!
# Functional count states for bounded Hall-Witt terms

The bounded ordered-subsequence expansion admits a direct coordinate state:
assign to every ordered constant term its integer multiplicity.  The scalar
step recurrence becomes an explicit affine transformer on those states, with
no choice of a realizing list.

This file folds the transformer across fixed transition schedules, proves
that it computes the literal bounded expansion exactly, and shows that every
fixed schedule preserves coordinatewise integer-valued polynomiality.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace SCState

open STSched
open SSExp
open STRec
open SSCoord

/-- Integer-valued multiplicity state indexed by all bounded-term shapes. -/
abbrev BoundedCountState :=
  OCTerm → ℤ

/-- Literal multiplicity state of a bounded-term list. -/
def boundedCountState
    (terms : List OCTerm) :
    BoundedCountState :=
  fun target => terms.count target

/-- Coordinate inherited from the unique strict-prepend predecessor, when
that predecessor exists and survives the cutoff. -/
def strictPredecessorCount
    (cutoff : ℕ)
    (transition : SRTrans)
    (state : BoundedCountState)
    (target : OCTerm) :
    ℤ :=
  if target.strictTransitions.length < cutoff then
    match removePrepended? transition target with
    | none =>
        0
    | some previous =>
        state previous
  else
    0

/-- Constant empty-subsequence contribution of one affine transition. -/
def singletonConstantCount
    (cutoff : ℕ)
    (transition : SRTrans)
    (target : OCTerm) :
    ℤ :=
  if 0 < cutoff ∧ singletonConstantTerm cutoff transition = target then
    1
  else
    0

/-- Explicit affine transformer on bounded-term count states. -/
def boundedStateStep
    (cutoff : ℕ)
    (transition : SRTrans)
    (state : BoundedCountState) :
    BoundedCountState :=
  fun target =>
    strictPredecessorCount cutoff transition state target +
      state target +
        singletonConstantCount cutoff transition target

/-- The explicit integer state transformer computes the literal list update. -/
lemma count_state_step
    (cutoff : ℕ)
    (transition : SRTrans)
    (terms : List OCTerm) :
    boundedCountState
        (boundedConstantStep cutoff transition terms) =
      boundedStateStep cutoff transition
        (boundedCountState terms) := by
  funext target
  unfold boundedCountState boundedStateStep
    strictPredecessorCount singletonConstantCount
  have hcount :=
    count_constant_step cutoff transition terms target
  by_cases hlength : target.strictTransitions.length < cutoff
  · rw [if_pos hlength] at hcount ⊢
    cases hprevious : removePrepended? transition target with
    | none =>
        rw [hprevious] at hcount
        simp only at hcount ⊢
        by_cases hconstant :
            0 < cutoff ∧ singletonConstantTerm cutoff transition = target
        · rw [if_pos hconstant] at hcount ⊢
          exact_mod_cast hcount
        · rw [if_neg hconstant] at hcount ⊢
          exact_mod_cast hcount
    | some previous =>
        rw [hprevious] at hcount
        simp only at hcount ⊢
        by_cases hconstant :
            0 < cutoff ∧ singletonConstantTerm cutoff transition = target
        · rw [if_pos hconstant] at hcount ⊢
          exact_mod_cast hcount
        · rw [if_neg hconstant] at hcount ⊢
          exact_mod_cast hcount
  · rw [if_neg hlength] at hcount ⊢
    simp only at hcount ⊢
    by_cases hconstant :
        0 < cutoff ∧ singletonConstantTerm cutoff transition = target
    · rw [if_pos hconstant] at hcount ⊢
      exact_mod_cast hcount
    · rw [if_neg hconstant] at hcount ⊢
      exact_mod_cast hcount

/-- Fold explicit bounded-term count transformers across a schedule. -/
def boundedStateFold
    (cutoff : ℕ) :
    List SRTrans →
      BoundedCountState →
        BoundedCountState
  | [], state =>
      state
  | transition :: transitions, state =>
      boundedStateStep cutoff transition
        (boundedStateFold cutoff transitions state)

/-- The explicit state fold computes the literal bounded-term list fold. -/
lemma count_state_fold
    (cutoff : ℕ) :
    ∀ (transitions : List SRTrans)
      (terms : List OCTerm),
      boundedCountState
          (boundedConstantFold cutoff transitions terms) =
        boundedStateFold cutoff transitions
          (boundedCountState terms)
  | [], _terms => by
      rfl
  | transition :: transitions, terms => by
      rw [boundedConstantFold,
        count_state_step,
        count_state_fold cutoff transitions terms]
      rfl

/-- Coordinatewise integer-valued polynomiality for a family of explicit
bounded-term count states. -/
def BSData
    (degreeBound : ℕ)
    (family : ℕ → BoundedCountState) :
    Prop :=
  ∀ target,
    IVMost
      (fun steps => family steps target) degreeBound

/-- Every fixed integer-valued constant family is polynomial at every larger
degree bound. -/
lemma valued_most_const
    (degreeBound : ℕ)
    (value : ℤ) :
    IVMost
      (fun _steps : ℕ => value) degreeBound := by
  exact
    ⟨Polynomial.C value, by simp, fun steps => by simp⟩

/-- A fixed strict-predecessor projection preserves coordinatewise
polynomiality. -/
lemma BSData.apply_strict_predececount
    {degreeBound : ℕ}
    {family : ℕ → BoundedCountState}
    (hfamily : BSData degreeBound family)
    (cutoff : ℕ)
    (transition : SRTrans) :
    BSData degreeBound
      (fun steps target =>
        strictPredecessorCount cutoff transition (family steps) target) := by
  intro target
  by_cases hlength : target.strictTransitions.length < cutoff
  · cases hprevious : removePrepended? transition target with
    | none =>
        simpa [strictPredecessorCount, hlength, hprevious] using
          valued_most_const degreeBound 0
    | some previous =>
        simpa [strictPredecessorCount, hlength, hprevious] using
          hfamily previous
  · simpa [strictPredecessorCount, hlength] using
      valued_most_const degreeBound 0

/-- Applying one fixed bounded-term state transition preserves
coordinatewise polynomiality and its common degree bound. -/
lemma BSData.step
    {degreeBound : ℕ}
    {family : ℕ → BoundedCountState}
    (hfamily : BSData degreeBound family)
    (cutoff : ℕ)
    (transition : SRTrans) :
    BSData degreeBound
      (fun steps =>
        boundedStateStep cutoff transition (family steps)) := by
  intro target
  unfold boundedStateStep
  exact
    ((hfamily.apply_strict_predececount cutoff transition) target).add
      (hfamily target) |>.add
        (valued_most_const degreeBound
          (singletonConstantCount cutoff transition target))

end SCState
end TCTex

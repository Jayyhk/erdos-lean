    calc
      3 * C = (3 * C / Real.log 2) * Real.log 2 := by field_simp
      _ < (m / 2 - 4 - 4 * K - 2 * J) * Real.log 2 :=
        mul_lt_mul_of_pos_right hmargin hlogTwo
      _ ≤ (m / 2 - 4 - 4 * K - 2 * J) * L :=
        mul_le_mul_of_nonneg_left hlogLower hmarginPos.le
  by_cases hlarge : a ≤ 2 * |rho.im|

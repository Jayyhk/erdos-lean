    (hmiddleRight_sectorA : ∃ i, (middleRight ∩ sectorA i).Nonempty)
    (hmiddleLeft_sectorB : ∃ i, (middleLeft ∩ sectorB i).Nonempty)
    (hmiddleRight_sectorB : ∃ i, (middleRight ∩ sectorB i).Nonempty) :

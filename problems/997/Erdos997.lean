      (fun T : ℝ => ‖∫ sigma in (-1)..2,
        goldfeldContourIntegrand chi1 chi beta x
          ((sigma : ℂ) + T * I)‖) atTop (𝓝 0) := by
    apply squeeze_zero' (g := fun T : ℝ => K / (1 + T) ^ 2)
    · exact Eventually.of_forall fun _ => norm_nonneg _

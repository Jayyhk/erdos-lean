    · have heven : Even s.length := Nat.not_odd_iff_even.mp hodd
      by_cases hA : A (p :: s)
      · simp [upperTerm, upperBoundaryTerm, hadm, heven, hA,
          heven.neg_one_pow, chainWeight_cons]
        ring
      · simp [upperTerm, upperBoundaryTerm, hadm, heven, hA,
          heven.neg_one_pow]
        ring

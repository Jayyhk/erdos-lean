      simp only [Finset.mem_Ioc, Finset.mem_Ico]
      omega
    have hA1mem : A + 1 ∈ Finset.Icc A Y :=
      Finset.mem_Icc.mpr ⟨by omega, hsuccAY⟩
    have hYmem : Y ∈ Finset.Icc A Y :=
      Finset.mem_Icc.mpr ⟨hAY, le_rfl⟩
    by_cases hYR : Y <= R
    · have hvariation :
          (∑ n ∈ Finset.Ioc A (Y - 1),

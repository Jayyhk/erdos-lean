    {S T : Set ℕ} {s t : ℝ} (hS : HasDensity S s)
    (hT : HasDensity T t) (hdisj : Disjoint S T) :
    HasDensity (S ∪ T) (s + t) := by
  rw [HasDensity] at hS hT ⊢
  apply (hS.add hT).congr'
  filter_upwards with n
  simp only [partialDensity, Set.inter_univ, Set.univ_inter]
  have hST : Disjoint (S ∩ Set.Iio n) (T ∩ Set.Iio n) :=
    hdisj.mono inter_subset_left inter_subset_left

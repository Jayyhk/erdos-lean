        epsilonSecond * (1 / (p : ℝ)) ^ 2 := by positivity
    calc
      _ ≤ (Csup * w) *
          (epsilonDiag * (1 / (p : ℝ)) +
            epsilonSecond * (1 / (p : ℝ)) ^ 2) :=
        mul_le_mul_of_nonneg_right hcp hdiagNonneg

          exact Nat.mul_le_mul_right _ (by omega)
        _ = (j + 3) ^ 3 := by ring
    have hcubic : 1 ≤ (j + 3) ^ 3 := Nat.one_le_pow _ _ (by omega)
    have hscaled :
        18 * (917504 * ((j + 1) * (j + 3) ^ 2)) ≤

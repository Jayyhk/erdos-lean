theorem selectedRankTowerHierarchy_zero
    {G : Type*} [Fintype G] [DecidableEq G]
    {k r : ℕ}
    {initial : OrderedPartitionComplex G k r}
    {initialBound : Fin (r + 1) → ℕ}
    {F : NatGrowthFunction}
    {γ : Fin r → ℝ}
    {stage : ℕ}
    (R : GrowthFunctionOrderedComplexRegularityCertificate

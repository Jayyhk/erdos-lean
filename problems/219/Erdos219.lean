noncomputable def pairedFourierPrimeCoefficient
    (R p : ℕ) (t u : ℝ) : ℂ :=
  SmoothSieveCutoff.divisorMultiplicativePhase R p t +
    SmoothSieveCutoff.divisorMultiplicativePhase R p u -
      SmoothSieveCutoff.divisorMultiplicativePhase R p t *
        SmoothSieveCutoff.divisorMultiplicativePhase R p u


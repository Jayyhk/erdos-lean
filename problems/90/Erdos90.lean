/-- Finite sums preserve a common integer-valued polynomial degree bound. -/
private lemma polynomial_finsetSum
    {ι : Type*}
    {degreeBound : ℕ}
    (slots : Finset ι)
    (family : ι → ℕ → ℤ)
    (hfamily :
      ∀ slot ∈ slots,
        IVMost
          (family slot) degreeBound) :
    IVMost
      (fun steps : ℕ => ∑ slot ∈ slots, family slot steps)
      degreeBound := by
  classical
  induction slots using Finset.induction_on with
  | empty =>
      simpa using
        TCTex.IVMost.zero
          degreeBound
  | @insert slot slots hslot ih =>
      simpa [Finset.sum_insert hslot] using
        TCTex.IVMost.add
          (hfamily slot (by simp))
          (ih (fun next hnext => hfamily next (by simp [hnext])))

/-- Every positive associated-graded additive coordinate has the exact
physical next-layer degree bound. -/
lemma addressNaturalPhysical
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (cutoff inputWeight : ℕ)
    (hcutoff : 3 < cutoff)
    (hinputWeight : 0 < inputWeight)
    (hx : inputWeight ≤ x.weight PEAddres.weight)
    (hy : inputWeight ≤ y.weight PEAddres.weight)
    (hz : inputWeight ≤ z.weight PEAddres.weight)
    (coordinate :
      AddressParentLayer (n := n) x y z →+ ℤ) :
    IVMost
      (addressGradedFunctional
        x y z cutoff coordinate)
      ((exponentAddressParent x y z + 1) /
        inputWeight) := by
  unfold
    addressGradedFunctional
  apply polynomial_finsetSum
  intro word _hword
  by_cases hweight :
      word.weight PEAddres.weight ≤
        exponentAddressParent x y z + 1
  · simpa only [Pi.smul_apply, smul_eq_mul] using
      TCTex.IVMost.smul
        (coordinate
          (addressSlotClass
            (n := n) x y z word))
        ((address_natural_physical
          x y z cutoff inputWeight hcutoff hinputWeight hx hy hz word).mono
            (Nat.div_le_div_right hweight))
  · have hclass :
        addressSlotClass
            (n := n) x y z word = 0 :=
      address_slot_parent
        x y z word (Nat.lt_of_not_ge hweight)
    simpa [hclass] using
      TCTex.IVMost.zero
        ((exponentAddressParent x y z + 1) /
          inputWeight)

/-- Every shifted-negative associated-graded additive coordinate has the
exact physical next-layer degree bound. -/
lemma addressNegativePhysical
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (cutoff inputWeight : ℕ)
    (hcutoff : 3 < cutoff)
    (hinputWeight : 0 < inputWeight)
    (hx : inputWeight ≤ x.weight PEAddres.weight)
    (hy : inputWeight ≤ y.weight PEAddres.weight)
    (hz : inputWeight ≤ z.weight PEAddres.weight)
    (coordinate :
      AddressParentLayer (n := n) x y z →+ ℤ) :
    IVMost
      (associatedGradedFunctional
        x y z cutoff coordinate)
      ((exponentAddressParent x y z + 1) /
        inputWeight) := by
  unfold
    associatedGradedFunctional
  apply polynomial_finsetSum
  intro word _hword
  by_cases hweight :
      word.weight PEAddres.weight ≤
        exponentAddressParent x y z + 1
  · simpa only [Pi.smul_apply, smul_eq_mul] using
      TCTex.IVMost.smul
        (coordinate
          (addressSlotClass
            (n := n) x y z word))
        ((address_slot_physical
          x y z cutoff inputWeight hcutoff hinputWeight hx hy hz word).mono
            (Nat.div_le_div_right hweight))
  · have hclass :
        addressSlotClass
            (n := n) x y z word = 0 :=
      address_slot_parent
        x y z word (Nat.lt_of_not_ge hweight)
    simpa [hclass] using
      TCTex.IVMost.zero
        ((exponentAddressParent x y z + 1) /
          inputWeight)

/-- Applying any additive coordinate to the positive retained correction
product preserves the exact physical next-layer degree bound. -/
lemma lowerPolyPhysical
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (cutoff inputWeight : ℕ)
    (hcutoff : 3 < cutoff)
    (hinputWeight : 0 < inputWeight)
    (hx : inputWeight ≤ x.weight PEAddres.weight)
    (hy : inputWeight ≤ y.weight PEAddres.weight)
    (hz : inputWeight ≤ z.weight PEAddres.weight)
    (coordinate :
      AddressParentLayer (n := n) x y z →+ ℤ) :
    IVMost
      (fun multiplicity : ℕ =>
        coordinate
          (TBluepr.lowerCentralClass
            (exponentAddressParent x y z)
            (addressBelowTerms
              (n := n) x y z cutoff (Int.ofNat multiplicity)).prod))
      ((exponentAddressParent x y z + 1) /
        inputWeight) := by
  rw [← funext fun multiplicity =>
    address_natural_prod
      x y z cutoff hcutoff coordinate multiplicity]
  exact
    addressNaturalPhysical
      x y z cutoff inputWeight hcutoff hinputWeight hx hy hz coordinate

/-- Applying any additive coordinate to the shifted-negative retained
correction product preserves the exact physical next-layer degree bound. -/
lemma negPolyPhysical
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (cutoff inputWeight : ℕ)
    (hcutoff : 3 < cutoff)
    (hinputWeight : 0 < inputWeight)
    (hx : inputWeight ≤ x.weight PEAddres.weight)
    (hy : inputWeight ≤ y.weight PEAddres.weight)
    (hz : inputWeight ≤ z.weight PEAddres.weight)
    (coordinate :
      AddressParentLayer (n := n) x y z →+ ℤ) :
    IVMost
      (fun magnitude : ℕ =>
        coordinate
          (TBluepr.lowerCentralClass
            (exponentAddressParent x y z)
            (addressBelowTerms
              (n := n) x y z cutoff (Int.negSucc magnitude)).prod))
      ((exponentAddressParent x y z + 1) /
        inputWeight) := by
  rw [← funext fun magnitude =>
    address_negative_prod
      x y z cutoff hcutoff coordinate magnitude]
  exact
    addressNegativePhysical
      x y z cutoff inputWeight hcutoff hinputWeight hx hy hz coordinate


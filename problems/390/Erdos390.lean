    [DecidableEq Iota]
    (mu : Erdos390.Full.FiniteProbability Omega) (P : Finset Iota)
    (I J : Iota -> Omega -> Real) (t u rowScale : Iota -> Real)
    (C epsilon invW HT H1 H2 remRow : Real)
    (rJI rIJ rJJ : Iota -> Iota -> Real) (rD : Iota -> Real)
    (hC : 0 <= C) (hepsilon : 0 <= epsilon)

          (Real.log n - E)) := by
      have hmul := mul_le_mul_of_nonneg_left hMupper ha
      calc
        V n + (Real.log (n + 1) - Real.log n) * M n ≤
            V n + (Real.log (n + 1) - Real.log n) *

/-- Unassociating product factors and then associating is identity on Frattini quotients. -/
@[simp] theorem mFQuot.mapprod_assocmap_prodassocsymm
    (G H K : Type*) [Group G] [Group H] [Group K]
    (x : mFQuot p (G × H × K)) :

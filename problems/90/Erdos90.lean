          (augmentationAddFiltration (R := R) (X := X)).weightedGenerator_mem
            e hi hin
              (Ideal.mul_mem_left
                (Submission.GShafar.augmentationIdeal
                  R (FreeGroup X) ^ i) a hy)
    | zero => simp
    | add f g _ _ hf hg =>
        change a * (f + g) ∈ _
        rw [mul_add]
        exact AddSubgroup.add_mem _ hf hg
    | neg f _ hf =>
        change a * -f ∈ _
        rw [mul_neg]
        exact AddSubgroup.neg_mem _ hf


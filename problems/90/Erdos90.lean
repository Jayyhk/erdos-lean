    {d : ℕ}
    (H : ∀ r : ℕ, BCWta.{u} d r)
    (inputWeight n : ℕ) :
    List (SPFactora H inputWeight) →
      List (SPFactora H inputWeight) → Prop where
  | obstruction
      (P S : List (SPFactora H inputWeight))
      (B A : SPFactora H inputWeight)
      (C : SHPkt n B A) :
      SCStepa H inputWeight n
        (P ++ [B, A] ++ S)
        (P ++ C.factors ++ [A, B] ++ S)


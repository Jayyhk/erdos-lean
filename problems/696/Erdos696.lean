          rw [hK_eq]
          unfold compositeGoodBlockThreshold
          have hpos : 0 ≤ ((Real.exp (-1) * 15) / 2) * Real.log y := by
            apply mul_nonneg (by positivity)
            exact Real.log_nonneg (by linarith)
          have hceil := Nat.ceil_lt_add_one hpos

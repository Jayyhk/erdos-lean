    change n • zmodLocalInvariant n z = 0
    rw [← map_nsmul]
    simp
  · intro hx
    let xt : localInvariantTorsion n := ⟨x, hx⟩
    obtain ⟨z, hz⟩ := (zmod_torsion_bijective n).2 xt
    refine ⟨z, ?_⟩
    exact congrArg Subtype.val hz


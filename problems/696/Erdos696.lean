  intro M q _ chi rho hexceptional
  obtain ⟨_, _, _, _, psi, hpsi, hchi, hsquare, him, _, _⟩ :=
    hexceptional
  subst psi
  have hzeroData :=
    (isNonprincipalNontrivialLFunctionZero_iff chi rho).mp hpsi

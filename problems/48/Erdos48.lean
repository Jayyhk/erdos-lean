        ((2 : ℂ) + t * I) 6
    have hDnonneg : 0 ≤ D := by
      intro rho
      exact (divisor_LFunction_nonneg hchiNe
        (closedBall ((2 : ℂ) + t * I) 6)) rho
    have hDsep : ∀ rho ∈ D.support, delta ≤ ‖s - rho‖ := by

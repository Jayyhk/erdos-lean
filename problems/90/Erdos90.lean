  {p | SplitsCompletelyAt K L p}

omit [NumberField K] [NumberField L] in
@[simp]
theorem splitting_primes (p : HeightOneSpectrum (𝓞 K)) :
    p ∈ splittingPrimes K L ↔ SplitsCompletelyAt K L p :=
  Iff.rfl


    (x * y) ^ q =
      ⁅x, ⁅y, x⁆⁆ ^ leftTripleMultiplicity q *
        ⁅y, ⁅y, x⁆⁆ ^ Nat.choose q 3 *
          ⁅y, x⁆ ^ Nat.choose q 2 *
            x ^ q * y ^ q := by
  let C := ⁅y, x⁆
  let D := ⁅x, C⁆
  let E := ⁅y, C⁆
  have hx :
      x ∈ Subgroup.lowerCentralSeries
        (LowerCentralTruncation (FreeGroup (FreeGenerator.{u} d)) n) 0 := by
    simp
  have hy :
      y ∈ Subgroup.lowerCentralSeries
        (LowerCentralTruncation (FreeGroup (FreeGenerator.{u} d)) n) 0 := by
    simp
  have hC :

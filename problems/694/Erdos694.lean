    simpa only [M, Lq] using hnear
  have hnearUnique :
      1 - 1 / ((Munique : ℝ) ^ 2 * Lq) ≤ rho.re := by
    apply near_one_of_le_of_scale_le_v2 (one_le_two.trans hMunique)
      ((le_max_right Mshape Munique).trans (le_max_right Mprincipal _))
      hLqPos le_rfl

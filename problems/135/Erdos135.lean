  have hGoodTerminal :
      ∃ C L R : Set E,
        endpointCapsGood γ controlRadii middleSegments forbiddenMargins sep
          vertexLocalPieces r₀ r₁ K₀ K₁ chart0 chartT C0 L0 R0 CT LT RT
          ⟨lastJ + 1, hlastJ⟩ C L R := by

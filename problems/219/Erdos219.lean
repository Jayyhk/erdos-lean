      (∏ p ∈ smallPrimeFinset w,
          (1 - (p : ℂ)⁻¹)) =
        ∏ p ∈ Nat.primesLE w,
          (1 - (p : ℂ)⁻¹) := by
    rw [smallPrimeFinset, Finset.prod_map]

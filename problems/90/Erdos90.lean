    LinearEquiv.ofBijective (fullLatticeRealization M) hfull.2
  apply Representation.Equiv.mk e
  intro g
  apply LinearMap.ext
  intro z
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul r m =>
      change fullLatticeRealization M

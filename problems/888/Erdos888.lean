    rw [mul_pow, mul_pow, hsquareBT, hsquareQ]
    nlinarith
  have hlo : (∑ j ∈ slo,
      min T (B / (2 : ℝ) ^ j) * Real.sqrt ((2 : ℝ) ^ (j + 1))) ≤
      8 * Real.sqrt (B * T) := by

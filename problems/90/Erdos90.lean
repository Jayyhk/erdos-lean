@[simp] theorem relators_union_subset
    (P : Presentation.{u}) (S T : Set P.Free)
    (hS : ∀ ⦃s : P.Free⦄, s ∈ S → s ∈ (P.withRelators T).rNClos)
    (w : P.Free) :
    (relatorsUnionClosure P S T hS).symm

def allLiftSatisfies
    {d n : ℕ}
    {layer : NRLayer n 1 1}
    (kernel :
      GMInduct
        layer (by simp) (by simp))
    (hlistEval :
      GMInduct.SatisfiesTruncEval.{u}
        (d := d) kernel) :

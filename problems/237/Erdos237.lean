    {u : H → ℕ}
    {s : ∀ ab : H × H, ab ∈ offDiagonalPairs H → ℕ}
    {B : ℝ} (hB : 0 ≤ B)
    (hyBound : ∀ r,
      IsMaynardDivisorTuple H R (primorial D) r → r m = 1 →
      |maynardS2RestrictedYFromCoefficients H
          (maynardDivisorTupleSupport H R (primorial D))

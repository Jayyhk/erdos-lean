    (r₁ := radialSecantRadii K N 0) (r₂ := radialSecantRadii K N 1)
    (r₃ := radialSecantRadii K N 2) (r₄ := radialSecantRadii K N 3)
    (by rw [hr₀]; linarith) (by rw [hr₀, hr₁]; linarith)
    (by rw [hr₂]; linarith) (by rw [hr₂, hr₃]; linarith)
    (he 0) (he 1) (he 2) (he 3)

      |Real.log n * M n - 2 * abstractVolterraIncrement M n| ≤
        E * M n := by
    intro n hn
    have h₀ := hbalance (D := D) (P := P) (Q := n) hP hn
    have hM : 0 ≤ squarefreeCoprimeInvTotientMean W n := hMnonneg n
    have hKle : K₀ + Real.log D + primeLogDivisorMass P ≤ E := by
      dsimp [E, K]
      linarith

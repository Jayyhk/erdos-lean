-- Merged from JacobiIntegralPowerStrictTailCutoffOrderedOuterPacketBoundedDepthExpansion.lean

/-!
# Bounded strict-depth expansions for Hall-Witt local substitutions

One filtered local move packet emits its strict correction branch before its
retained branch.  Iterating the packet therefore has an exact ordered binary
depth schedule.  Below a fixed cutoff, every schedule entry at depth at least
the cutoff vanishes for a Hall-Witt current selected word.

This file records the resulting coefficient-independent bounded-depth
expansion without forgetting the order of occurrences.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace BDExp

open CWTrace
open WSTrace
open NPTail
open RMRecb
open TBProf
open OFProgra
open OTSubsti
open OTDecomp
open TODepth

/-- Repeated left bracketing by one selected word. -/
def iteratedLeftCommutator
    (selected : CWord Atom) :
    ℕ → CWord Atom → CWord Atom
  | 0, right =>
      right
  | depth + 1, right =>
      .commutator selected (iteratedLeftCommutator selected depth right)

/-- Literal iterated strict correction of a singleton remains a singleton. -/
lemma iterated_correction_singleton
    (selected right : CWord Atom) :
    ∀ depth : ℕ,
      iteratedMoveTrace selected depth [right] =
        [iteratedLeftCommutator selected depth right]
  | 0 => by
      rfl
  | depth + 1 => by
      rw [iteratedMoveTrace,
        iterated_correction_singleton selected right depth]
      rfl

/-- Filtered iterated strict correction of a singleton is the filtered
singleton of its repeated left bracket. -/
lemma iterated_below_singleton
    (cutoff depth : ℕ)
    (selected right : CWord Atom) :
    iteratedCutoffTrace cutoff selected depth
        (unitBelowTrace cutoff [right]) =
      unitBelowTrace cutoff
        [iteratedLeftCommutator selected depth right] := by
  rw [iterated_cutoff_below,
    iterated_correction_singleton]

/-- On a filtered singleton, one full local move is its strict branch followed
by its retained branch. -/
lemma cutoff_move_singleton
    (cutoff : ℕ)
    (selected right : CWord Atom) :
    cutoffMoveTrace cutoff selected (unitBelowTrace cutoff [right]) =
      cutoffCorrectionTrace cutoff selected
          (unitBelowTrace cutoff [right]) ++
        unitBelowTrace cutoff [right] := by
  by_cases hright : right.weight (fun _ => 1) < cutoff
  · simp [unitBelowTrace, hright, cutoffMoveTrace,
      cutoffCorrectionTrace,
      move_append_singleton
        cutoff selected right hright]
  · simp [unitBelowTrace, hright, cutoffMoveTrace,
      cutoffCorrectionTrace]

/-- Moving one repeatedly corrected singleton emits the next strict depth
before retaining its current depth. -/
lemma move_iterated_singleton
    (cutoff depth : ℕ)
    (selected right : CWord Atom) :
    cutoffMoveTrace cutoff selected
        (iteratedCutoffTrace cutoff selected depth
          (unitBelowTrace cutoff [right])) =
      iteratedCutoffTrace cutoff selected (depth + 1)
          (unitBelowTrace cutoff [right]) ++
        iteratedCutoffTrace cutoff selected depth
          (unitBelowTrace cutoff [right]) := by
  rw [iteratedCutoffTrace,
    iterated_below_singleton]
  exact
    cutoff_move_singleton cutoff selected
      (iteratedLeftCommutator selected depth right)

/-- The homogeneous local substitution distributes through a flattened
family of traces. -/
lemma cutoff_move_flat
    (cutoff : ℕ)
    (selected : CWord Atom)
    {α : Type*}
    (source : List α)
    (packetAt : α → List (CWord Atom)) :
    cutoffMoveTrace cutoff selected (source.flatMap packetAt) =
      source.flatMap fun item =>
        cutoffMoveTrace cutoff selected (packetAt item) := by
  simp [cutoffMoveTrace, List.flatMap_assoc]

/-- Ordered strict-depth schedule of a repeated two-branch local move. -/
def strictDepthSchedule : ℕ → List ℕ
  | 0 =>
      [0]
  | steps + 1 =>
      (strictDepthSchedule steps).flatMap fun depth =>
        [depth + 1, depth]

/-- Iterating one filtered singleton local packet has the exact ordered
strict-depth schedule. -/
lemma iterated_move_singleton
    (cutoff : ℕ)
    (selected right : CWord Atom) :
    ∀ steps : ℕ,
      iteratedCutoffMove cutoff selected steps
          (unitBelowTrace cutoff [right]) =
        (strictDepthSchedule steps).flatMap fun depth =>
          iteratedCutoffTrace cutoff selected depth
            (unitBelowTrace cutoff [right])
  | 0 => by
      simp [iteratedCutoffMove, strictDepthSchedule,
        iteratedCutoffTrace]
  | steps + 1 => by
      rw [iteratedCutoffMove,
        iterated_move_singleton
          cutoff selected right steps,
        cutoff_move_flat]
      simp [strictDepthSchedule,
        move_iterated_singleton,
        List.flatMap_assoc]

/-- A strict local branch at depth at least the cutoff vanishes for a
Hall-Witt current selected word. -/
lemma iterated_singleton_nil
    (cutoff depth : ℕ)
    (selected right : CWord Atom)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hdepth : cutoff ≤ depth) :
    iteratedCutoffTrace cutoff selected depth
        (unitBelowTrace cutoff [right]) =
      [] := by
  apply
    iterated_below_nil
      0 cutoff selected hselected [right]
  · intro next _hnext
    exact Nat.zero_le (next.weight (fun _ => 1))
  · omega

/-- Removing strict depths at or above cutoff does not change a flattened
singleton expansion. -/
lemma filter_flat_trace
    (cutoff : ℕ)
    (selected right : CWord Atom)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true) :
    ∀ depths : List ℕ,
      (depths.filter fun depth =>
        decide (depth < cutoff)).flatMap (fun depth =>
          iteratedCutoffTrace cutoff selected depth
            (unitBelowTrace cutoff [right])) =
        depths.flatMap fun depth =>
        iteratedCutoffTrace cutoff selected depth
          (unitBelowTrace cutoff [right])
  | [] => by
      rfl
  | depth :: depths => by
      by_cases hdepth : depth < cutoff
      · simp [hdepth,
          filter_flat_trace cutoff selected
            right hselected depths]
      · have hnil :
            iteratedCutoffTrace cutoff selected depth
                (unitBelowTrace cutoff [right]) =
              [] :=
          iterated_singleton_nil
            cutoff depth selected right hselected (Nat.le_of_not_gt hdepth)
        simp [hdepth, hnil,
          filter_flat_trace cutoff selected
            right hselected depths]

/-- Removing strict depths at or above cutoff does not change the flattened
singleton depth-schedule expansion. -/
lemma filter_flat_iterated
    (cutoff steps : ℕ)
    (selected right : CWord Atom)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true) :
    ((strictDepthSchedule steps).filter fun depth =>
        decide (depth < cutoff)).flatMap (fun depth =>
          iteratedCutoffTrace cutoff selected depth
            (unitBelowTrace cutoff [right])) =
      (strictDepthSchedule steps).flatMap fun depth =>
        iteratedCutoffTrace cutoff selected depth
          (unitBelowTrace cutoff [right]) := by
  exact
    filter_flat_trace cutoff selected right
      hselected (strictDepthSchedule steps)

/-- The exact ordered local expansion has a coefficient-independent
strict-depth alphabet `Fin cutoff`. -/
lemma iterated_move_schedule
    (cutoff steps : ℕ)
    (selected right : CWord Atom)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true) :
    iteratedCutoffMove cutoff selected steps
        (unitBelowTrace cutoff [right]) =
      ((strictDepthSchedule steps).filter fun depth =>
          decide (depth < cutoff)).flatMap (fun depth =>
        iteratedCutoffTrace cutoff selected depth
          (unitBelowTrace cutoff [right])) := by
  rw [
    iterated_move_singleton]
  exact
    (filter_flat_iterated
      cutoff steps selected right hselected).symm

/-- Iterated homogeneous local substitution distributes over a flattened
family of source traces. -/
lemma iterated_move_flat
    (cutoff steps : ℕ)
    (selected : CWord Atom)
    {α : Type*}
    (source : List α)
    (packetAt : α → List (CWord Atom)) :
    iteratedCutoffMove cutoff selected steps (source.flatMap packetAt) =
      source.flatMap fun item =>
        iteratedCutoffMove cutoff selected steps (packetAt item) := by
  induction steps with
  | zero =>
      rfl
  | succ steps ih =>
      rw [iteratedCutoffMove, ih, cutoff_move_flat]
      rfl

/-- Filtering a trace below cutoff is the flattened family of its filtered
singletons. -/
lemma below_flat_singleton
    (cutoff : ℕ) :
    ∀ trace : List (CWord Atom),
      unitBelowTrace cutoff trace =
        trace.flatMap fun right =>
          unitBelowTrace cutoff [right]
  | [] => by
      rfl
  | right :: rights => by
      rw [show right :: rights = [right] ++ rights by rfl,
        unit_below_append,
        below_flat_singleton cutoff rights]
      rfl

/-- The ordered bounded strict-depth expansion extends pointwise across an
arbitrary source trace. -/
lemma iterated_below_schedule
    (cutoff steps : ℕ)
    (selected : CWord Atom)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (trace : List (CWord Atom)) :
    iteratedCutoffMove cutoff selected steps
        (unitBelowTrace cutoff trace) =
      trace.flatMap fun right =>
        ((strictDepthSchedule steps).filter fun depth =>
            decide (depth < cutoff)).flatMap (fun depth =>
          iteratedCutoffTrace cutoff selected depth
            (unitBelowTrace cutoff [right])) := by
  rw [below_flat_singleton,
    iterated_move_flat]
  apply List.flatMap_congr
  intro right _hright
  exact
    iterated_move_schedule
      cutoff steps selected right hselected

end BDExp
end TCTex
end Submission

-- Merged from JacobiIntegralPowerStrictTailCutoffOrderedOuterPacketEmptyOrbitPrefix.lean

/-!
# Explicit empty-tail orbit prefixes for Hall-Witt outer packets

The inhomogeneous part of a triangular outer-packet trace substitution is the
orbit emitted from the empty tail.  It is the ordered concatenation of the
homogeneous iterates of the fixed emitted prefix.  This file records that
range-based normal form and specializes it to the positive and negative
Hall-Witt packet traces.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace EOPrefix

open CWTrace
open WSTrace
open WHNorm
open WNTrace
open NPTail
open OFProgra
open OFProgra.FRProgra
open OTSubsti
open OTDecomp
open BDExp

/-- Ordered homogeneous-orbit prefix emitted before a fixed triangular
substitution tail. -/
def cutoffMovePrefix
    (cutoff : ℕ)
    (selected : CWord Atom)
    (emittedPrefix : List (CWord Atom))
    (steps : ℕ) :
    List (CWord Atom) :=
  (List.range steps).flatMap fun depth =>
    iteratedCutoffMove cutoff selected depth emittedPrefix

/-- Splitting the initial homogeneous iterate from a finite orbit prefix. -/
lemma flat_iterated_move
    (cutoff : ℕ)
    (selected : CWord Atom)
    (emittedPrefix : List (CWord Atom)) :
    ∀ steps : ℕ,
      (List.range (steps + 1)).flatMap (fun depth =>
          iteratedCutoffMove cutoff selected depth emittedPrefix) =
        emittedPrefix ++
          (List.range steps).flatMap (fun depth =>
            iteratedCutoffMove cutoff selected (depth + 1)
              emittedPrefix)
  | 0 => by
      rfl
  | steps + 1 => by
      rw [List.range_succ, List.flatMap_append, List.flatMap_singleton,
        flat_iterated_move cutoff selected
          emittedPrefix steps,
        List.range_succ, List.flatMap_append, List.flatMap_singleton,
        List.append_assoc]

/-- Adding one triangular substitution step prepends the fixed emitted prefix
and advances every homogeneous orbit block once. -/
lemma move_prefix_succ
    (cutoff : ℕ)
    (selected : CWord Atom)
    (emittedPrefix : List (CWord Atom))
    (steps : ℕ) :
    cutoffMovePrefix cutoff selected emittedPrefix (steps + 1) =
      emittedPrefix ++
        cutoffMoveTrace cutoff selected
          (cutoffMovePrefix cutoff selected emittedPrefix steps) := by
  rw [cutoffMovePrefix,
    flat_iterated_move]
  unfold cutoffMovePrefix
  rw [cutoff_move_flat]
  apply congrArg (emittedPrefix ++ ·)
  apply List.flatMap_congr
  intro depth _hdepth
  rfl

/-- The trace emitted from an empty tail is exactly its finite homogeneous
orbit prefix. -/
lemma iterate_substitution_nil
    (emittedPrefix : List (CWord Atom))
    (cutoff : ℕ)
    (selected : CWord Atom) :
    ∀ steps : ℕ,
      iteratePrefixSubstitution emittedPrefix
          (cutoffMovePacket cutoff selected) steps [] =
        cutoffMovePrefix cutoff selected emittedPrefix steps
  | 0 => by
      rfl
  | steps + 1 => by
      rw [iteratePrefixSubstitution,
        iterate_substitution_nil
          emittedPrefix cutoff selected steps,
        move_prefix_succ]
      rfl

/-- Every triangular trace substitution is its explicit emitted orbit prefix
followed by the homogeneous orbit of the original tail. -/
lemma iterate_substitution_append
    (emittedPrefix : List (CWord Atom))
    (cutoff : ℕ)
    (selected : CWord Atom)
    (steps : ℕ)
    (tail : List (CWord Atom)) :
    iteratePrefixSubstitution emittedPrefix
        (cutoffMovePacket cutoff selected) steps tail =
      cutoffMovePrefix cutoff selected emittedPrefix steps ++
        iteratedCutoffMove cutoff selected steps tail := by
  rw [
    iterate_substitution_move,
    iterate_substitution_nil]

/-- Positive outer-packet traces split into their explicit emitted orbit prefix
and the homogeneous orbit of the original program tail. -/
lemma prepend_move_append
    (cutoff steps : ℕ)
    (tail : FRProgra) :
    (iteratePrepend cutoff isFirstCurrent WNTrace.trace
      steps tail).trace cutoff =
        cutoffMovePrefix cutoff firstConventionalInverse
            (positiveFilteredPrefix cutoff) steps ++
          iteratedCutoffMove cutoff firstConventionalInverse steps
            (tail.trace cutoff) := by
  rw [
    prepend_prefix_substitution,
    iterate_substitution_append]

/-- Negative outer-packet traces split into their explicit emitted orbit prefix
and the homogeneous orbit of the original program tail. -/
lemma iterate_prepend_append
    (cutoff steps : ℕ)
    (tail : FRProgra) :
    (iteratePrepend cutoff isFirstCurrent
      NNPower.inverseNormalizedTrace
        steps tail).trace cutoff =
      cutoffMovePrefix cutoff firstConventionalWord
          (negativeFilteredPrefix cutoff) steps ++
        iteratedCutoffMove cutoff firstConventionalWord steps
          (tail.trace cutoff) := by
  rw [
    iterate_prepend_substitution,
    iterate_substitution_append]

end EOPrefix
end TCTex
end Submission

-- Merged from JacobiIntegralPowerStrictTailCutoffOrderedSecondRouteAffineProgram.lean

/-!
# Ordered second-route affine programs for Hall-Witt strict tails

The filtered first-route program retains the literal order required by the
second Hall-Witt pass.  Compile that order structurally.  Moving one
first-family word across one retained right word emits the ordered packet

`[commutator left right, right]`.

Its second-pass affine action is a fixed transition.  Moving across a list is
the ordered composition of those transitions.  High-weight rights may be
discarded before this compilation, and the recursive first-route program
compiles exactly to the affine action of its emitted trace.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace SAProgra

open CWTrace
open WSTrace
open NPTail
open RMRecb
open TBProf
open ARProfa
open ARProfa.CPAffine
open ASFilt
open OFProgra
open OFProgra.FRProgra

/-- Affine second-pass transition emitted by crossing one first-family word
over one retained right word. -/
def crossedSecondPacket
    (cutoff : ℕ)
    (left right : CWord Atom) :
    CPAffine :=
  ofTrace cutoff isSecondCurrent
    (unitBelowTrace cutoff [.commutator left right, right])

/-- Ordered affine second-pass action emitted by moving one first-family word
over a retained right trace. -/
def crossedSecondAffine
    (cutoff : ℕ)
    (left : CWord Atom) :
    List (CWord Atom) → CPAffine
  | [] =>
      CPAffine.one
  | right :: rights =>
      (crossedSecondPacket cutoff left right).comp
        (crossedSecondAffine cutoff left rights)

@[simp]
lemma crossed_affine_nil
    (cutoff : ℕ)
    (left : CWord Atom) :
    crossedSecondAffine cutoff left [] =
      CPAffine.one := by
  rfl

@[simp]
lemma crossed_affine_cons
    (cutoff : ℕ)
    (left right : CWord Atom)
    (rights : List (CWord Atom)) :
    crossedSecondAffine cutoff left (right :: rights) =
      (crossedSecondPacket cutoff left right).comp
        (crossedSecondAffine cutoff left rights) := by
  rfl

/-- The ordered crossing compiler is exactly the affine action of the literal
filtered crossing trace. -/
lemma crossed_affine_trace
    (cutoff : ℕ)
    (left : CWord Atom) :
    ∀ rights : List (CWord Atom),
      crossedSecondAffine cutoff left rights =
        ofTrace cutoff isSecondCurrent
          (unitBelowTrace cutoff (moveHigherTrace left rights))
  | [] => by
      rfl
  | right :: rights => by
      rw [crossed_affine_cons,
        show
          moveHigherTrace left (right :: rights) =
            [.commutator left right, right] ++
              moveHigherTrace left rights by
          rfl,
        unit_below_append, ofTrace_append,
        crossed_affine_trace cutoff left rights]
      rfl

/-- Structural second-pass affine interpreter for a first-route program. -/
def compileSecond
    (cutoff : ℕ) :
    FRProgra → CPAffine
  | .empty =>
      CPAffine.one
  | .retained word tail =>
      (ofTrace cutoff isSecondCurrent (unitBelowTrace cutoff [word])).comp
        (compileSecond cutoff tail)
  | .moved left tail =>
      crossedSecondAffine cutoff left (tail.trace cutoff)

/-- The structural interpreter is exactly the affine action of the emitted
ordered first-route trace. -/
lemma compile_second_affine
    (cutoff : ℕ) :
    ∀ program : FRProgra,
      compileSecond cutoff program =
        program.secondAffine cutoff
  | .empty => by
      rfl
  | .retained word tail => by
      rw [compileSecond, FRProgra.secondAffine,
        FRProgra.trace_retained, ofTrace_append,
        compile_second_affine cutoff tail,
        FRProgra.secondAffine]
  | .moved left tail => by
      rw [compileSecond, FRProgra.secondAffine,
        FRProgra.trace_moved,
        crossed_affine_trace]

/-- Positive Hall-Witt strict-tail profiles are evaluated by the structural
ordered second-pass interpreter. -/
lemma natural_compile_second
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (multiplicity : ℕ) :
    cutoffProfile cutoff
        (NPTail.strictTrace multiplicity) =
      (compileSecond cutoff
        (naturalRouteProgram cutoff multiplicity)).apply 0 := by
  rw [natural_second_affine cutoff hcutoff,
    compile_second_affine]

/-- Negative Hall-Witt strict-tail profiles are evaluated by the structural
ordered second-pass interpreter. -/
lemma negative_compile_second
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (multiplicity : ℕ) :
    cutoffProfile cutoff
        (NNPower.strictTrace
          multiplicity) =
      (compileSecond cutoff
        (negativeRouteProgram cutoff multiplicity)).apply 0 := by
  rw [negative_second_affine cutoff hcutoff,
    compile_second_affine]

end SAProgra
end TCTex
end Submission

-- Merged from JacobiIntegralPowerStrictTailCutoffOrderedSecondRouteFiniteTransitionSchedule.lean

/-!
# Finite transition schedules for ordered Hall-Witt second routes

Externalize the structural second-pass interpreter as an ordered transition
schedule.  There are two transition forms:

* retain one below-cutoff first-route word;
* cross one first-family current word over one below-cutoff right word.

Every transition in the positive and negative Hall-Witt schedules belongs to
one fixed finite alphabet depending only on the cutoff.  Folding the affine
interpretation of the schedule recovers the exact strict-tail cutoff profile.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace STSched

open CWTrace
open WSTrace
open WHNorm
open WSTail
open NPTail
open STVocabu
open RMRecb
open TBProf
open ARProfa
open ARProfa.CPAffine
open ASFilt
open OFProgra
open OFProgra.FRProgra
open SAProgra
open SARec

/-- One ordered transition consumed by the second-pass affine interpreter. -/
inductive SRTrans where
  | retained
      (word : CWord Atom)
  | crossed
      (left right : CWord Atom)
deriving DecidableEq

namespace SRTrans

/-- Affine interpretation of one ordered second-route transition. -/
def affine
    (cutoff : ℕ) :
    SRTrans → CPAffine
  | .retained word =>
      secondAtomAffine cutoff word
  | .crossed left right =>
      crossedSecondPacket cutoff left right

end SRTrans

/-- Fold an ordered transition schedule into its affine action. -/
def scheduleAffine
    (cutoff : ℕ) :
    List SRTrans → CPAffine
  | [] =>
      CPAffine.one
  | transition :: transitions =>
      (transition.affine cutoff).comp
        (scheduleAffine cutoff transitions)

/-- Schedule interpretation composes across concatenation. -/
lemma scheduleAffine_append
    (cutoff : ℕ)
    (left right : List SRTrans) :
    scheduleAffine cutoff (left ++ right) =
      (scheduleAffine cutoff left).comp
        (scheduleAffine cutoff right) := by
  induction left with
  | nil =>
      exact (one_comp (scheduleAffine cutoff right)).symm
  | cons transition left ih =>
      simp only [List.cons_append, scheduleAffine]
      rw [ih, comp_assoc]

/-- A schedule of ordinary retained words is the ordinary second-pass affine
compiler. -/
lemma schedule_affine_retained
    (cutoff : ℕ) :
    ∀ words : List (CWord Atom),
      scheduleAffine cutoff (words.map SRTrans.retained) =
        ofTrace cutoff isSecondCurrent words
  | [] => by
      rfl
  | word :: words => by
      rw [List.map_cons, scheduleAffine, schedule_affine_retained,
        second_current_cons]
      rfl

/-- A schedule of crossings is the ordered crossing compiler. -/
lemma schedule_affine_crossed
    (cutoff : ℕ)
    (left : CWord Atom) :
    ∀ rights : List (CWord Atom),
      scheduleAffine cutoff
          (rights.map (SRTrans.crossed left)) =
        crossedSecondAffine cutoff left rights
  | [] => by
      rfl
  | right :: rights => by
      rw [List.map_cons, scheduleAffine, schedule_affine_crossed,
        crossed_affine_cons]
      rfl

/-- Ordered transition schedule extracted from one recursive first-route
program. -/
def transitionSchedule
    (cutoff : ℕ) :
    FRProgra → List SRTrans
  | .empty =>
      []
  | .retained word tail =>
      (unitBelowTrace cutoff [word]).map
          SRTrans.retained ++
        transitionSchedule cutoff tail
  | .moved left tail =>
      (tail.trace cutoff).map (SRTrans.crossed left)

/-- Folding the extracted transition schedule is exactly the structural
second-pass interpreter. -/
lemma schedule_affine_transition
    (cutoff : ℕ) :
    ∀ program : FRProgra,
      scheduleAffine cutoff (transitionSchedule cutoff program) =
        compileSecond cutoff program
  | .empty => by
      rfl
  | .retained word tail => by
      rw [transitionSchedule, scheduleAffine_append,
        schedule_affine_retained,
        schedule_affine_transition cutoff tail]
      rfl
  | .moved left tail => by
      rw [transitionSchedule, schedule_affine_crossed]
      rfl

/-- The two possible first-family current words. -/
def firstCurrentVocabulary :
    List (CWord Atom) :=
  [firstConventionalInverse, firstConventionalWord]

/-- Every recognized first-family current word belongs to its two-word
vocabulary. -/
lemma current_vocabulary_true
    (word : CWord Atom)
    (hword : isFirstCurrent word = true) :
    word ∈ firstCurrentVocabulary := by
  simp only [isFirstCurrent, decide_eq_true_eq] at hword
  simpa [firstCurrentVocabulary] using hword

/-- Fixed finite alphabet of all retained and crossed second-route transitions
that may survive below one cutoff. -/
def secondRouteAlphabet
    (cutoff : ℕ) :
    List SRTrans :=
  (orderedCutoffVocabulary cutoff).map SRTrans.retained ++
    firstCurrentVocabulary.flatMap fun left =>
      (orderedCutoffVocabulary cutoff).map
        (SRTrans.crossed left)

/-- Every below-cutoff retained transition belongs to the fixed transition
alphabet. -/
lemma route_alphabet_retained
    (cutoff : ℕ)
    (word : CWord Atom)
    (hword : word ∈ orderedCutoffVocabulary cutoff) :
    SRTrans.retained word ∈
      secondRouteAlphabet cutoff := by
  apply List.mem_append_left
  exact List.mem_map.mpr ⟨word, hword, rfl⟩

/-- Every first-family crossing over a below-cutoff right word belongs to the
fixed transition alphabet. -/
lemma transition_alphabet_crossed
    (cutoff : ℕ)
    (left right : CWord Atom)
    (hleft : isFirstCurrent left = true)
    (hright : right ∈ orderedCutoffVocabulary cutoff) :
    SRTrans.crossed left right ∈
      secondRouteAlphabet cutoff := by
  apply List.mem_append_right
  apply List.mem_flatMap.mpr
  exact
    ⟨left, current_vocabulary_true left hleft,
      List.mem_map.mpr ⟨right, hright, rfl⟩⟩

/-- A first-route program is well formed when every moved node records a
recognized first-family current word. -/
def FirstCurrentMoves :
    FRProgra → Prop
  | .empty =>
      True
  | .retained _word tail =>
      FirstCurrentMoves tail
  | .moved left tail =>
      isFirstCurrent left = true ∧ FirstCurrentMoves tail

/-- Prefixing with the first-family selector preserves well-formed moved-node
provenance. -/
lemma first_moves_prepend
    (cutoff : ℕ)
    (source : List (CWord Atom))
    (tail : FRProgra)
    (htail : FirstCurrentMoves tail) :
    FirstCurrentMoves (prepend cutoff isFirstCurrent source tail) := by
  induction source with
  | nil =>
      exact htail
  | cons word source ih =>
      simp only [prepend]
      by_cases hword : isFirstCurrent word = true
      · rw [if_pos hword]
        exact ⟨hword, ih⟩
      · rw [if_neg hword]
        exact ih

/-- Every generated first-family program has well-formed moved-node
provenance. -/
lemma first_current_moves
    (cutoff : ℕ)
    (source : List (CWord Atom)) :
    FirstCurrentMoves
      (FRProgra.ofSource cutoff isFirstCurrent source) := by
  exact first_moves_prepend cutoff source .empty trivial

/-- Every occurrence in an arbitrary first-route program trace belongs to the
fixed cutoff word vocabulary. -/
lemma ordered_vocabulary_program
    (cutoff : ℕ)
    (program : FRProgra)
    (word : CWord Atom)
    (hword : word ∈ program.trace cutoff) :
    word ∈ orderedCutoffVocabulary cutoff := by
  apply
    ordered_vocabulary_below
      cutoff (program.trace cutoff) word
  rw [FRProgra.unit_below_trace]
  exact hword

/-- Every transition extracted from a well-formed program belongs to the fixed
finite transition alphabet. -/
lemma transition_alphabet_schedule
    (cutoff : ℕ) :
    ∀ (program : FRProgra),
      FirstCurrentMoves program →
        ∀ transition ∈ transitionSchedule cutoff program,
          transition ∈ secondRouteAlphabet cutoff
  | .empty, _hprogram, transition, htransition => by
      simp [transitionSchedule] at htransition
  | .retained word tail, hprogram, transition, htransition => by
      rw [transitionSchedule, List.mem_append] at htransition
      rcases htransition with htransition | htransition
      · rcases List.mem_map.mp htransition with ⟨retained, hretained, rfl⟩
        apply route_alphabet_retained
        exact
          ordered_vocabulary_below
            cutoff [word] retained hretained
      · exact
          transition_alphabet_schedule
            cutoff tail hprogram transition htransition
  | .moved left tail, hprogram, transition, htransition => by
      rcases hprogram with ⟨hleft, _htail⟩
      rw [transitionSchedule] at htransition
      rcases List.mem_map.mp htransition with ⟨right, hright, rfl⟩
      exact
        transition_alphabet_crossed cutoff left right hleft
          (ordered_vocabulary_program
            cutoff tail right hright)

/-- Every positive Hall-Witt schedule transition belongs to one fixed finite
cutoff alphabet. -/
lemma alphabet_natural_schedule
    (cutoff multiplicity : ℕ)
    (transition : SRTrans)
    (htransition :
      transition ∈
        transitionSchedule cutoff
          (naturalRouteProgram cutoff multiplicity)) :
    transition ∈ secondRouteAlphabet cutoff := by
  exact
    transition_alphabet_schedule
      cutoff (naturalRouteProgram cutoff multiplicity)
        (first_current_moves cutoff
          (NPTail.naturalResidualTrace
            multiplicity))
        transition htransition

/-- Every negative Hall-Witt schedule transition belongs to one fixed finite
cutoff alphabet. -/
lemma alphabet_negative_schedule
    (cutoff multiplicity : ℕ)
    (transition : SRTrans)
    (htransition :
      transition ∈
        transitionSchedule cutoff
          (negativeRouteProgram cutoff multiplicity)) :
    transition ∈ secondRouteAlphabet cutoff := by
  exact
    transition_alphabet_schedule
      cutoff (negativeRouteProgram cutoff multiplicity)
        (first_current_moves cutoff
          (NNPower.naturalResidualTrace
            multiplicity))
        transition htransition

/-- The positive strict-tail cutoff profile is the affine fold of a schedule
over the fixed finite transition alphabet. -/
lemma profile_natural_affine
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (multiplicity : ℕ) :
    cutoffProfile cutoff
        (NPTail.strictTrace multiplicity) =
      (scheduleAffine cutoff
        (transitionSchedule cutoff
          (naturalRouteProgram cutoff multiplicity))).apply 0 := by
  rw [schedule_affine_transition,
    natural_compile_second cutoff hcutoff]

/-- The negative strict-tail cutoff profile is the affine fold of a schedule
over the fixed finite transition alphabet. -/
lemma profile_negative_affine
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (multiplicity : ℕ) :
    cutoffProfile cutoff
        (NNPower.strictTrace
          multiplicity) =
      (scheduleAffine cutoff
        (transitionSchedule cutoff
          (negativeRouteProgram cutoff multiplicity))).apply 0 := by
  rw [schedule_affine_transition,
    negative_compile_second cutoff hcutoff]

end STSched
end TCTex
end Submission

-- Merged from JacobiIntegralPowerStrictTailCutoffOrderedSecondRouteBoundedSubsequenceExpansion.lean

/-!
# Bounded ordered-subsequence expansion for Hall-Witt second routes

The affine fold of a variable ordered second-route schedule cannot be
recovered from transition multiplicities alone: the linear corrections do not
commute.  Expand it without forgetting order.

Every transition has linear part `1 + N`, where `N` is a strict
weight-raising endomorphism.  Applying a schedule fold to zero is therefore a
sum indexed by affine constants together with ordered subsequences of earlier
strict transitions.  Any term containing at least `cutoff` strict transitions
vanishes.  Thus the exact endpoint depends only on bounded ordered
subsequences.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace SSExp

open WSTrace
open NPTail
open RMRecb
open TBProf
open ARProfa
open ARProfa.CPAffine
open ARUnipot
open SARec
open SAProgra
open STSched

namespace TExp

/-- Fixed source packet whose strict linear correction is carried by one
ordered second-route transition. -/
def strictPacket
    (cutoff : ℕ) :
    SRTrans → List (CWord Atom)
  | .retained word =>
      [word]
  | .crossed left right =>
      unitBelowTrace cutoff [.commutator left right, right]

/-- Strict linear correction carried by one ordered second-route transition. -/
def strictLinear
    (cutoff : ℕ)
    (transition : SRTrans) :
    ProfileEnd :=
  packetCorrectionEnd cutoff isSecondCurrent
    (strictPacket cutoff transition)

/-- Every transition linear part is identity plus its strict correction. -/
lemma affine_linear_strict
    (cutoff : ℕ) :
    ∀ transition : SRTrans,
      (transition.affine cutoff).linear =
        strictLinear cutoff transition + 1
  | .retained word => by
      simp only [SRTrans.affine, strictLinear, strictPacket]
      rw [← trace_linear_end
        cutoff isSecondCurrent [word]]
      simp [ofTrace, secondAtomAffine, CPAffine.comp,
        CPAffine.one]
  | .crossed left right => by
      rw [SRTrans.affine, crossedSecondPacket, strictLinear,
        strictPacket,
        trace_linear_end]

/-- Each transition strict correction raises unit weight by at least one. -/
lemma strict_linear_raises
    (cutoff : ℕ)
    (transition : SRTrans) :
    RUWt 1 (strictLinear cutoff transition) :=
  packet_end_raises cutoff isSecondCurrent
    (strictPacket cutoff transition)

/-- Each transition strict correction emits only terms below cutoff. -/
lemma strict_outputs_below
    (cutoff : ℕ)
    (transition : SRTrans) :
    OBCutoff cutoff (strictLinear cutoff transition) :=
  end_outputs_below cutoff isSecondCurrent
    (strictPacket cutoff transition)

end TExp

/-- Ordered product of heterogeneous strict transition corrections. -/
def orderedStrictProduct
    (cutoff : ℕ) :
    List SRTrans → ProfileEnd
  | [] =>
      1
  | transition :: transitions =>
      TExp.strictLinear cutoff transition *
        orderedStrictProduct cutoff transitions

/-- An ordered product of strict transition corrections raises weight by its
number of selected transitions. -/
lemma ordered_raises_length
    (cutoff : ℕ) :
    ∀ transitions : List SRTrans,
      RUWt transitions.length
        (orderedStrictProduct cutoff transitions)
  | [] => by
      simpa [orderedStrictProduct] using RUWt.one
  | transition :: transitions => by
      simpa [orderedStrictProduct, Nat.add_comm] using
        RUWt.mul
          (TExp.strict_linear_raises
            cutoff transition)
          (ordered_raises_length cutoff transitions)

/-- A nonempty ordered strict product emits only below-cutoff terms. -/
lemma outputs_below_cutoff
    (cutoff : ℕ) :
    ∀ transitions : List SRTrans,
      transitions ≠ [] →
        OBCutoff cutoff (orderedStrictProduct cutoff transitions)
  | [], htransitions => by
      exact False.elim (htransitions rfl)
  | transition :: transitions, _htransitions => by
      rw [orderedStrictProduct]
      exact
        OBCutoff.mul_left
          (TExp.strict_outputs_below
            cutoff transition)

/-- Any heterogeneous ordered product containing at least `cutoff` strict
transitions vanishes below a positive cutoff. -/
lemma ordered_strict_length
    (cutoff : ℕ)
    (hcutoff : 0 < cutoff)
    (transitions : List SRTrans)
    (htransitions : cutoff ≤ transitions.length) :
    orderedStrictProduct cutoff transitions = 0 := by
  have hnonempty : transitions ≠ [] := by
    intro hnil
    rw [hnil] at htransitions
    simp at htransitions
    omega
  apply AddMonoidHom.ext
  intro source
  apply Multiset.ext.mpr
  intro emitted
  change
    Multiset.count emitted (orderedStrictProduct cutoff transitions source) =
      Multiset.count emitted 0
  rw [Multiset.count_zero]
  apply Multiset.count_eq_zero.mpr
  intro hemitted
  rcases
      ordered_raises_length cutoff transitions
        source emitted hemitted with
    ⟨original, _horiginal, hweight⟩
  have hemittedCutoff :=
    outputs_below_cutoff cutoff transitions hnonempty
      source emitted hemitted
  have horiginalPositive :
      0 < original.weight (fun _ => 1) :=
    CWord.weight_pos (fun _ => 1) (fun _ => by simp) original
  omega

/-- One ordered-subsequence summand in the affine constant expansion. -/
structure OCTerm where
  strictTransitions : List SRTrans
  constant : Multiset (CWord Atom)
deriving DecidableEq

namespace OCTerm

/-- Add one earlier strict transition to an ordered-subsequence summand. -/
def prepend
    (transition : SRTrans)
    (term : OCTerm) :
    OCTerm where
  strictTransitions := transition :: term.strictTransitions
  constant := term.constant

/-- Evaluate one ordered-subsequence summand. -/
def eval
    (cutoff : ℕ)
    (term : OCTerm) :
    Multiset (CWord Atom) :=
  orderedStrictProduct cutoff term.strictTransitions term.constant

/-- An empty strict subsequence leaves its affine constant unchanged. -/
@[simp]
lemma eval_empty
    (cutoff : ℕ)
    (constant : Multiset (CWord Atom)) :
    OCTerm.eval cutoff
        { strictTransitions := [], constant := constant } =
      constant := by
  rfl

/-- Prepending a strict transition applies its correction after the previous
ordered strict product. -/
@[simp]
lemma eval_prepend
    (cutoff : ℕ)
    (transition : SRTrans)
    (term : OCTerm) :
    (term.prepend transition).eval cutoff =
      TExp.strictLinear cutoff transition
        (term.eval cutoff) := by
  rfl

/-- A summand with at least `cutoff` selected strict transitions vanishes. -/
lemma eval_cutoff_length
    (cutoff : ℕ)
    (hcutoff : 0 < cutoff)
    (term : OCTerm)
    (hterm : cutoff ≤ term.strictTransitions.length) :
    term.eval cutoff = 0 := by
  rw [eval, ordered_strict_length
    cutoff hcutoff term.strictTransitions hterm]
  rfl

end OCTerm

/--
Ordered affine-constant expansion of a transition schedule.

For a current transition, each existing term contributes once through its
strict correction and once through the identity part of the linear action.
The current affine constant contributes one new empty-subsequence term.
-/
def orderedConstantTerms
    (cutoff : ℕ) :
    List SRTrans → List OCTerm
  | [] =>
      []
  | transition :: transitions =>
      (orderedConstantTerms cutoff transitions).map
          (OCTerm.prepend transition) ++
        orderedConstantTerms cutoff transitions ++
          [{ strictTransitions := []
             constant := (transition.affine cutoff).constant }]

/-- Additive endomorphisms distribute over the evaluated sum of a list. -/
lemma map_sum_list
    (transform : ProfileEnd)
    (sources : List (Multiset (CWord Atom))) :
    transform sources.sum =
      (sources.map transform).sum := by
  induction sources with
  | nil =>
      exact map_zero transform
  | cons source sources ih =>
      simp only [List.sum_cons, List.map_cons, map_add, ih]

/-- The affine fold of an ordered schedule, applied to zero, is exactly the
sum of its ordered-subsequence constant terms. -/
lemma schedule_affine_terms
    (cutoff : ℕ) :
    ∀ transitions : List SRTrans,
      (scheduleAffine cutoff transitions).apply 0 =
        ((orderedConstantTerms cutoff transitions).map
          (OCTerm.eval cutoff)).sum
  | [] => by
      rfl
  | transition :: transitions => by
      rw [scheduleAffine, CPAffine.apply_comp,
        schedule_affine_terms cutoff
          transitions]
      rw [CPAffine.apply,
        TExp.affine_linear_strict]
      change
        (TExp.strictLinear cutoff transition
            (((orderedConstantTerms cutoff transitions).map
              (OCTerm.eval cutoff)).sum) +
          ((orderedConstantTerms cutoff transitions).map
              (OCTerm.eval cutoff)).sum) +
            (transition.affine cutoff).constant =
          _
      rw [map_sum_list]
      simp only [orderedConstantTerms, List.map_append, List.sum_append,
        List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero,
        OCTerm.eval_empty, List.map_map]
      ac_rfl

/-- Discard all summands whose ordered strict subsequence is already too long
to survive one cutoff. -/
def boundedConstantTerms
    (cutoff : ℕ)
    (transitions : List SRTrans) :
    List OCTerm :=
  (orderedConstantTerms cutoff transitions).filter fun term =>
    decide (term.strictTransitions.length < cutoff)

/-- Filtering away cutoff-long strict subsequences does not change the exact
evaluated sum. -/
lemma constant_terms_bounded
    (cutoff : ℕ)
    (hcutoff : 0 < cutoff) :
    ∀ terms : List OCTerm,
      (terms.map (OCTerm.eval cutoff)).sum =
        ((terms.filter fun term =>
          decide (term.strictTransitions.length < cutoff)).map
            (OCTerm.eval cutoff)).sum
  | [] => by
      rfl
  | term :: terms => by
      by_cases hterm : term.strictTransitions.length < cutoff
      · have htermDecide :
          decide (term.strictTransitions.length < cutoff) = true :=
        decide_eq_true hterm
        simp [htermDecide,
          constant_terms_bounded
            cutoff hcutoff terms]
      · have htermDecide :
          decide (term.strictTransitions.length < cutoff) = false :=
        decide_eq_false_iff_not.mpr hterm
        have htermZero :
            term.eval cutoff = 0 :=
          term.eval_cutoff_length cutoff hcutoff (by omega)
        simp [htermDecide, htermZero,
          constant_terms_bounded
            cutoff hcutoff terms]

/-- Exact cutoff-bounded ordered-subsequence expansion of a variable affine
transition schedule. -/
lemma affine_constant_terms
    (cutoff : ℕ)
    (hcutoff : 0 < cutoff)
    (transitions : List SRTrans) :
    (scheduleAffine cutoff transitions).apply 0 =
      ((boundedConstantTerms cutoff transitions).map
        (OCTerm.eval cutoff)).sum := by
  rw [schedule_affine_terms,
    constant_terms_bounded
      cutoff hcutoff]
  rfl

/-- Every retained ordered-subsequence term has length strictly below the
cutoff. -/
lemma length_constant_terms
    (cutoff : ℕ)
    (transitions : List SRTrans)
    (term : OCTerm)
    (hterm : term ∈ boundedConstantTerms cutoff transitions) :
    term.strictTransitions.length < cutoff := by
  exact of_decide_eq_true (List.mem_filter.mp hterm).2

end SSExp
end TCTex
end Submission

-- Merged from JacobiIntegralPowerStrictTailCutoffOrderedSecondRouteBoundedTermAlphabet.lean

/-!
# Finite bounded-term alphabets for Hall-Witt second routes

The bounded ordered-subsequence expansion of a second-route schedule still
produces a coefficient-dependent list of summands.  Its summand *types* are
nevertheless drawn from one finite cutoff-dependent alphabet:

* a strict-transition word of length below `cutoff`;
* the affine constant of one transition in the fixed transition alphabet.

This file constructs that alphabet and proves support for arbitrary
well-formed first-route programs, then specializes it to the positive and
negative Hall-Witt programs.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace STAlphab

open WSTrace
open NPTail
open TBProf
open OFProgra
open OFProgra.FRProgra
open STSched
open SSExp

/-- Enumerate all words of one fixed length over a finite transition alphabet. -/
def transitionWordsLength
    (alphabet : List SRTrans) :
    ℕ → List (List SRTrans)
  | 0 =>
      [[]]
  | length + 1 =>
      alphabet.flatMap fun transition =>
        (transitionWordsLength alphabet length).map
          (List.cons transition)

/-- Every word over an alphabet belongs to the enumeration at its own length. -/
lemma transition_words_forall
    (alphabet : List SRTrans) :
    ∀ transitions : List SRTrans,
      (∀ transition ∈ transitions, transition ∈ alphabet) →
        transitions ∈ transitionWordsLength alphabet transitions.length
  | [], _htransitions => by
      simp [transitionWordsLength]
  | transition :: transitions, htransitions => by
      simp only [transitionWordsLength]
      apply List.mem_flatMap.mpr
      refine ⟨transition, htransitions transition (by simp), ?_⟩
      apply List.mem_map.mpr
      exact
        ⟨transitions,
          transition_words_forall alphabet transitions
            (fun next hnext =>
              htransitions next (by simp [hnext])),
          rfl⟩

/-- Enumerate all transition words whose length is strictly below one cutoff. -/
def wordsBelowLength
    (alphabet : List SRTrans)
    (cutoff : ℕ) :
    List (List SRTrans) :=
  (List.range cutoff).flatMap (transitionWordsLength alphabet)

/-- Every alphabet-supported word shorter than the cutoff belongs to the
bounded word enumeration. -/
lemma words_below_forall
    (alphabet : List SRTrans)
    (cutoff : ℕ)
    (transitions : List SRTrans)
    (hlength : transitions.length < cutoff)
    (htransitions : ∀ transition ∈ transitions, transition ∈ alphabet) :
    transitions ∈ wordsBelowLength alphabet cutoff := by
  apply List.mem_flatMap.mpr
  exact
    ⟨transitions.length, List.mem_range.mpr hlength,
      transition_words_forall alphabet transitions
        htransitions⟩

/--
One fixed finite alphabet containing every surviving ordered-subsequence
constant term below a cutoff.
-/
def boundedConstantAlphabet
    (cutoff : ℕ) :
    List OCTerm :=
  (wordsBelowLength
      (secondRouteAlphabet cutoff) cutoff).flatMap
    fun strictTransitions =>
      (secondRouteAlphabet cutoff).map fun transition =>
        { strictTransitions := strictTransitions
          constant := (transition.affine cutoff).constant }

/-- Support predicate for a bounded constant term relative to one transition
alphabet. -/
def TermSupportedBy
    (cutoff : ℕ)
    (alphabet : List SRTrans)
    (term : OCTerm) :
    Prop :=
  (∀ transition ∈ term.strictTransitions, transition ∈ alphabet) ∧
    ∃ transition ∈ alphabet,
      term.constant = (transition.affine cutoff).constant

/-- Every constant term expanded from an alphabet-supported schedule is
supported by that same transition alphabet. -/
lemma supported_constant_terms
    (cutoff : ℕ)
    (alphabet : List SRTrans) :
    ∀ schedule : List SRTrans,
      (∀ transition ∈ schedule, transition ∈ alphabet) →
        ∀ term ∈ orderedConstantTerms cutoff schedule,
          TermSupportedBy cutoff alphabet term
  | [], _hschedule, term, hterm => by
      simp [orderedConstantTerms] at hterm
  | transition :: schedule, hschedule, term, hterm => by
      simp only [orderedConstantTerms, List.mem_append] at hterm
      rcases hterm with (hterm | hterm) | hterm
      · rcases List.mem_map.mp hterm with ⟨tailTerm, htailTerm, rfl⟩
        rcases
            supported_constant_terms
              cutoff alphabet schedule
                (fun next hnext => hschedule next (by simp [hnext]))
                tailTerm htailTerm with
          ⟨hstrict, hconstant⟩
        constructor
        · intro next hnext
          simp only [OCTerm.prepend, List.mem_cons] at hnext
          rcases hnext with rfl | hnext
          · exact hschedule next (by simp)
          · exact hstrict next hnext
        · exact hconstant
      · exact
          supported_constant_terms
            cutoff alphabet schedule
              (fun next hnext => hschedule next (by simp [hnext]))
              term hterm
      · rw [List.mem_singleton] at hterm
        subst term
        exact
          ⟨by simp,
            ⟨transition, hschedule transition (by simp), rfl⟩⟩

/-- Every bounded term expanded from an alphabet-supported schedule belongs
to the fixed bounded-term alphabet generated by that transition alphabet. -/
lemma constant_alphabet_terms
    (cutoff : ℕ)
    (schedule : List SRTrans)
    (hschedule :
      ∀ transition ∈ schedule,
        transition ∈ secondRouteAlphabet cutoff)
    (term : OCTerm)
    (hterm : term ∈ boundedConstantTerms cutoff schedule) :
    term ∈ boundedConstantAlphabet cutoff := by
  have hlength :
      term.strictTransitions.length < cutoff :=
    length_constant_terms
      cutoff schedule term hterm
  have hordered :
      term ∈ orderedConstantTerms cutoff schedule :=
    (List.mem_filter.mp hterm).1
  rcases
      supported_constant_terms
        cutoff (secondRouteAlphabet cutoff)
          schedule hschedule term hordered with
    ⟨hstrict, ⟨constantTransition, hconstantTransition, hconstant⟩⟩
  apply List.mem_flatMap.mpr
  refine
    ⟨term.strictTransitions,
      words_below_forall
        (secondRouteAlphabet cutoff) cutoff
          term.strictTransitions hlength hstrict,
      ?_⟩
  apply List.mem_map.mpr
  refine ⟨constantTransition, hconstantTransition, ?_⟩
  cases term with
  | mk strictTransitions constant =>
      simp only at hconstant ⊢
      rw [hconstant]

/-- Every positive Hall-Witt bounded second-route term lies in the fixed
cutoff-dependent term alphabet. -/
lemma alphabet_natural_terms
    (cutoff multiplicity : ℕ)
    (term : OCTerm)
    (hterm :
      term ∈ boundedConstantTerms cutoff
        (transitionSchedule cutoff
          (naturalRouteProgram cutoff multiplicity))) :
    term ∈ boundedConstantAlphabet cutoff := by
  exact
    constant_alphabet_terms
      cutoff
        (transitionSchedule cutoff
          (naturalRouteProgram cutoff multiplicity))
        (alphabet_natural_schedule
          cutoff multiplicity)
        term hterm

/-- Every negative Hall-Witt bounded second-route term lies in the fixed
cutoff-dependent term alphabet. -/
lemma alphabet_negative_terms
    (cutoff multiplicity : ℕ)
    (term : OCTerm)
    (hterm :
      term ∈ boundedConstantTerms cutoff
        (transitionSchedule cutoff
          (negativeRouteProgram cutoff multiplicity))) :
    term ∈ boundedConstantAlphabet cutoff := by
  exact
    constant_alphabet_terms
      cutoff
        (transitionSchedule cutoff
          (negativeRouteProgram cutoff multiplicity))
        (alphabet_negative_schedule
          cutoff multiplicity)
        term hterm

end STAlphab
end TCTex
end Submission

-- Merged from JacobiIntegralPowerStrictTailCutoffOrderedOuterPacketTransitionSchedule.lean

/-!
# Transition schedules for factored Hall-Witt outer packets

The normalized Hall-Witt outer packet has one first-family selected word.
At the affine level its second-pass action factors into one fixed prefix and
one dynamic swap.  Retain the finer transition schedule: one outer packet
contributes a fixed schedule followed by crossings of the selected word over
the previously emitted ordered tail.

This is the schedule recurrence needed by the bounded ordered-subsequence
counter.  It keeps the coefficient-dependent order explicit while isolating
all packet-local transitions in one fixed list.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace OTSched

open WSTrace
open WHNorm
open WNTrace
open NPTail
open RMRecb
open OFProgra
open OFProgra.FRProgra
open TOFact
open STSched

/-- Prefixing a wholly unselected source emits retained transitions before
the existing schedule. -/
lemma transition_prepend_current
    (cutoff : ℕ) :
    ∀ (source : List (CWord Atom))
      (tail : FRProgra),
      (∀ word ∈ source, isFirstCurrent word ≠ true) →
        transitionSchedule cutoff
            (prepend cutoff isFirstCurrent source tail) =
          (unitBelowTrace cutoff source).map
              SRTrans.retained ++
            transitionSchedule cutoff tail
  | [], tail, _hsource => by
      rfl
  | word :: words, tail, hsource => by
      have hword : isFirstCurrent word ≠ true :=
        hsource word (by simp)
      have hwords :
          ∀ next ∈ words, isFirstCurrent next ≠ true := by
        intro next hnext
        exact hsource next (by simp [hnext])
      rw [prepend, if_neg hword, transitionSchedule]
      rw [
        transition_prepend_current
          cutoff words tail hwords]
      simp only [unitBelowTrace, List.filter_cons]
      split <;> simp

/-- Prefixing a wholly unselected source emits its filtered trace before the
existing ordered tail. -/
lemma prepend_forall_current
    (cutoff : ℕ)
    (source : List (CWord Atom))
    (tail : FRProgra)
    (hsource : ∀ word ∈ source, isFirstCurrent word ≠ true) :
    (prepend cutoff isFirstCurrent source tail).trace cutoff =
      unitBelowTrace cutoff source ++ tail.trace cutoff := by
  rw [trace_prepend]
  rw [route_forall_current
    isFirstCurrent source (tail.trace cutoff) hsource]
  rw [unit_below_append, unit_below_trace]

/-- Packet-local schedule contributed by one factored outer packet before its
selected word crosses the previously emitted tail. -/
def fixedTransitionPrefix
    (cutoff : ℕ)
    (before : List (CWord Atom))
    (selected : CWord Atom)
    (suffix : List (CWord Atom)) :
    List SRTrans :=
  (unitBelowTrace cutoff before).map SRTrans.retained ++
    (unitBelowTrace cutoff suffix).map
      (SRTrans.crossed selected)

/-- One factored outer packet emits its fixed packet-local schedule followed
by crossings over the previously emitted ordered tail. -/
lemma prepend_prefix_append
    (cutoff : ℕ)
    (packet before suffix : List (CWord Atom))
    (selected : CWord Atom)
    (hpacket : packet = before ++ [selected] ++ suffix)
    (hselected : isFirstCurrent selected = true)
    (hbefore : ∀ word ∈ before, isFirstCurrent word ≠ true)
    (hsuffix : ∀ word ∈ suffix, isFirstCurrent word ≠ true)
    (tail : FRProgra) :
    transitionSchedule cutoff (prepend cutoff isFirstCurrent packet tail) =
      fixedTransitionPrefix cutoff before selected suffix ++
        (tail.trace cutoff).map (SRTrans.crossed selected) := by
  rw [hpacket, prepend_append, prepend_append]
  rw [
    transition_prepend_current
      cutoff before _ hbefore]
  simp only [prepend, if_pos hselected, transitionSchedule]
  rw [
    prepend_forall_current
      cutoff suffix tail hsuffix,
    List.map_append]
  simp [fixedTransitionPrefix, List.append_assoc]

/-- One more iteration of a factored outer packet satisfies the same exact
transition-schedule recurrence. -/
lemma transition_prepend_append
    (cutoff : ℕ)
    (packet before suffix : List (CWord Atom))
    (selected : CWord Atom)
    (hpacket : packet = before ++ [selected] ++ suffix)
    (hselected : isFirstCurrent selected = true)
    (hbefore : ∀ word ∈ before, isFirstCurrent word ≠ true)
    (hsuffix : ∀ word ∈ suffix, isFirstCurrent word ≠ true)
    (steps : ℕ)
    (tail : FRProgra) :
    transitionSchedule cutoff
        (iteratePrepend cutoff isFirstCurrent packet (steps + 1) tail) =
      fixedTransitionPrefix cutoff before selected suffix ++
        ((iteratePrepend cutoff isFirstCurrent packet steps tail).trace
          cutoff).map (SRTrans.crossed selected) := by
  rw [iteratePrepend]
  exact
    prepend_prefix_append
      cutoff packet before suffix selected hpacket hselected hbefore hsuffix _

/-- Fixed positive normalized outer-packet transition prefix. -/
noncomputable def positiveFixedPrefix
    (cutoff : ℕ) :
    List SRTrans :=
  fixedTransitionPrefix cutoff
    positiveOuterFactorization.before firstConventionalInverse
      positiveOuterFactorization.suffix

/-- Fixed negative inverted outer-packet transition prefix. -/
noncomputable def negativeFixedPrefix
    (cutoff : ℕ) :
    List SRTrans :=
  fixedTransitionPrefix cutoff
    negativeOuterFactorization.before firstConventionalWord
      negativeOuterFactorization.suffix

/-- Each positive outer-packet iteration emits one fixed transition prefix
followed by crossings over the previously emitted tail trace. -/
lemma transition_prepend_succ
    (cutoff steps : ℕ)
    (tail : FRProgra) :
    transitionSchedule cutoff
        (iteratePrepend cutoff isFirstCurrent WNTrace.trace
          (steps + 1) tail) =
      positiveFixedPrefix cutoff ++
        ((iteratePrepend cutoff isFirstCurrent
          WNTrace.trace steps tail).trace cutoff).map
            (SRTrans.crossed firstConventionalInverse) := by
  apply
    transition_prepend_append
      cutoff WNTrace.trace
        positiveOuterFactorization.before
          positiveOuterFactorization.suffix
            firstConventionalInverse
  · exact positiveOuterFactorization.packet_eq
  · simp
  · exact positiveOuterFactorization.before_not_current
  · exact positiveOuterFactorization.suffix_not_current

/-- Each negative outer-packet iteration emits one fixed transition prefix
followed by crossings over the previously emitted tail trace. -/
lemma iterate_prepend_negative
    (cutoff steps : ℕ)
    (tail : FRProgra) :
    transitionSchedule cutoff
        (iteratePrepend cutoff isFirstCurrent
          NNPower.inverseNormalizedTrace
            (steps + 1) tail) =
      negativeFixedPrefix cutoff ++
        ((iteratePrepend cutoff isFirstCurrent
          NNPower.inverseNormalizedTrace
            steps tail).trace cutoff).map
              (SRTrans.crossed firstConventionalWord) := by
  apply
    transition_prepend_append
      cutoff
        NNPower.inverseNormalizedTrace
          negativeOuterFactorization.before
            negativeOuterFactorization.suffix firstConventionalWord
  · exact negativeOuterFactorization.packet_eq
  · simp
  · exact negativeOuterFactorization.before_not_current
  · exact negativeOuterFactorization.suffix_not_current

end OTSched
end TCTex
end Submission

-- Merged from JacobiIntegralPowerStrictTailCutoffOrderedSecondRouteBoundedTermRecurrence.lean

/-!
# Finite recurrences for bounded Hall-Witt second-route terms

The ordered-subsequence expansion can discard cutoff-long terms after every
transition rather than only after expanding the whole schedule.  Package that
one-transition update and its right fold.  Concatenating transition schedules
then becomes composition of finite bounded-term updates.

Combining this fold with the factored outer-packet schedule recurrence gives
an exact finite-state recurrence for the surviving positive and negative
Hall-Witt outer terms.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace STRec

open WSTrace
open WHNorm
open WNTrace
open NPTail
open OFProgra
open OFProgra.FRProgra
open OTSched
open STSched
open SSExp

/-- The new empty-subsequence term contributed by one affine transition. -/
def singletonConstantTerm
    (cutoff : ℕ)
    (transition : SRTrans) :
    OCTerm where
  strictTransitions := []
  constant := (transition.affine cutoff).constant

/-- One transition updates an already bounded list of ordered-subsequence
terms.  Terms lengthened past the cutoff are immediately discarded. -/
def boundedConstantStep
    (cutoff : ℕ)
    (transition : SRTrans)
    (terms : List OCTerm) :
    List OCTerm :=
  (terms.map (OCTerm.prepend transition)).filter (fun term =>
      decide (term.strictTransitions.length < cutoff)) ++
    terms ++
      ([singletonConstantTerm cutoff transition].filter (fun term =>
        decide (term.strictTransitions.length < cutoff)))

/-- A term surviving after prepending one strict transition already survived
before that transition was prepended. -/
lemma length_prepend
    (cutoff : ℕ)
    (transition : SRTrans)
    (term : OCTerm)
    (hterm :
      (term.prepend transition).strictTransitions.length < cutoff) :
    term.strictTransitions.length < cutoff := by
  simp only [OCTerm.prepend, List.length_cons] at hterm
  omega

/-- Filtering bounded terms before mapping a strict prepend does not change
the filtered mapped result. -/
lemma filter_prepend
    (cutoff : ℕ)
    (transition : SRTrans) :
    ∀ terms : List OCTerm,
      (terms.map (OCTerm.prepend transition)).filter
          (fun term => decide (term.strictTransitions.length < cutoff)) =
        ((terms.filter fun term =>
            decide (term.strictTransitions.length < cutoff)).map
              (OCTerm.prepend transition)).filter
                (fun term =>
                  decide (term.strictTransitions.length < cutoff))
  | [] => by
      rfl
  | term :: terms => by
      have ih :=
        filter_prepend cutoff transition terms
      by_cases hterm : term.strictTransitions.length < cutoff
      · by_cases hprepend :
            (term.prepend transition).strictTransitions.length < cutoff
        · simp [hterm, hprepend, ih]
        · simp [hterm, hprepend, ih]
      · have hprepend :
            ¬(term.prepend transition).strictTransitions.length < cutoff := by
          intro hprepend
          exact hterm
            (length_prepend cutoff transition term hprepend)
        simp [hterm, hprepend, ih]

/-- The global bounded expansion obeys the local one-transition update. -/
lemma constant_terms_cons
    (cutoff : ℕ)
    (transition : SRTrans)
    (transitions : List SRTrans) :
    boundedConstantTerms cutoff (transition :: transitions) =
      boundedConstantStep cutoff transition
        (boundedConstantTerms cutoff transitions) := by
  unfold boundedConstantTerms boundedConstantStep
  simp only [orderedConstantTerms, List.filter_append]
  rw [filter_prepend]
  rfl

/-- Fold a transition schedule through the finite bounded-term update. -/
def boundedConstantFold
    (cutoff : ℕ) :
    List SRTrans →
      List OCTerm →
        List OCTerm
  | [], terms =>
      terms
  | transition :: transitions, terms =>
      boundedConstantStep cutoff transition
        (boundedConstantFold cutoff transitions terms)

/-- The bounded expansion of a schedule is its finite update fold from the
empty term state. -/
lemma constant_terms_fold
    (cutoff : ℕ) :
    ∀ transitions : List SRTrans,
      boundedConstantTerms cutoff transitions =
        boundedConstantFold cutoff transitions []
  | [] => by
      rfl
  | transition :: transitions => by
      rw [constant_terms_cons,
        boundedConstantFold,
        constant_terms_fold cutoff transitions]

/-- Folding concatenated schedules composes their finite bounded-term
updates. -/
lemma constant_fold_append
    (cutoff : ℕ) :
    ∀ (left right : List SRTrans)
      (terms : List OCTerm),
      boundedConstantFold cutoff (left ++ right) terms =
        boundedConstantFold cutoff left
          (boundedConstantFold cutoff right terms)
  | [], right, terms => by
      rfl
  | transition :: transitions, right, terms => by
      rw [List.cons_append, boundedConstantFold,
        boundedConstantFold,
        constant_fold_append cutoff transitions right terms]

/-- The bounded expansion of concatenated schedules is obtained by folding
the left prefix over the bounded expansion of the right suffix. -/
lemma constant_terms_append
    (cutoff : ℕ)
    (left right : List SRTrans) :
    boundedConstantTerms cutoff (left ++ right) =
      boundedConstantFold cutoff left
        (boundedConstantTerms cutoff right) := by
  rw [constant_terms_fold,
    constant_fold_append,
    ← constant_terms_fold]

end STRec
end TCTex
end Submission


lemma auxTrimmedConnector_length_le {V : Type*} [Fintype V]
    {A : Finset (PackedSubgraph V)} {T : ℕ}
    {D : (P : ↥A) → FlexiblePathData T P.1}
    {z : FamilyAuxVertex V A} (c : (familyAuxGraph D).Walk z z)

    {H : Type*} [Group H] (f : G →* H) (hf : Function.Surjective f) (n : ℕ) :
    Subgroup.map f (Subgroup.lowerCentralSeries G n) = Subgroup.lowerCentralSeries H n := by
  apply le_antisymm
  · exact Subgroup.lowerCentralSeries.map f n
  · induction n with

    (k q : ℕ) (χ : DirichletCharacter ℂ q)
    (sm sn : Finset ℕ) (a b : ℕ → ℂ) : ℂ :=
  ∑ m ∈ sm, ∑ n ∈ sn.filter (fun n => m * n ≤ k),

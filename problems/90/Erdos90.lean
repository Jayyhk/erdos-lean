    (hm : 1 ≤ m) (hmn : m ≤ n)
    {f : MSeries R X}
    (hf : f ∈ weightedIdeal (R := R) (X := X) e n)
    {w : FreeMonoid X} (hw : w.length = m) :
    ((e n m : ℕ) : R) ∣ f w := by
  have hn := hm.trans hmn
  simpa [hw] using
    (weighted_ideal_coefficients e hn).mp hf
      |>.2 w (by omega) (by omega)

end MSeries
end EChapma


  representative := galoisConjugator k L A i
  factorSet := galoisFactor k L A i hdim
  commute_scalar sigma a := by
    apply Units.ext
    exact conjugator_mul_scalar k L A i sigma (a : L)
  mul_representative := galoisConjugator_mul k L A i hdim


theorem length_factors
    {G : Type u}
    [Group G]
    (right : G) :
    ∀ left : List G,
      (factors right left).length = 3 * left.length := by
  intro left
  induction left with
  | nil =>
      simp
  | cons head tail ih =>
      simp [ih]
      omega


/-- The fibre of the norm on unit groups over a base-field unit. -/
def normUnitFiber (K : Type u) (L : Type v)
    [CommRing K] [Ring L] [Algebra K L] (a : Kˣ) : Set Lˣ :=
  {y | normOnUnits K L y = a}


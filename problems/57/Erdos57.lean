theorem lm42CanonicalSeedDichotomy
    {d D m L : ℕ} (hm : 2 ≤ m) (hD : 0 < D) (hL : L ≤ m) :
    lm311AdaptiveSeed d ≤ m ^ 2 * D ∨
      lm311AdaptiveSeed d +

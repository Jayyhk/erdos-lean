      (n : ℝ) ^ 2 * (40 * s * V) ≤
        (n : ℝ) ^ 2 * (q * A * x) := by
    calc
      (n : ℝ) ^ 2 * (40 * s * V) =
          40 * s * ((n : ℝ) ^ 2 * V) := by ring
      _ ≤ 40 * s *
          (322 * K * x * ((Q : ℝ) * C) * Real.log x ^ 4) := by
        gcongr
      _ = 12880 * K * s * x * (Q : ℝ) * C * Real.log x ^ 4 := by
        ring
      _ ≤ 12880 * K * s * x * (s * q) * C * Real.log x ^ 4 := by
        gcongr
      _ ≤ 12880 * K * s * x * (s * q) *
          (2 * (D * L : ℕ) * A) * Real.log x ^ 4 := by
        gcongr
      _ = (B * Real.log (n : ℝ) ^ 4) * (n : ℝ) * (q * A * x) := by
        rw [hlogx, mul_pow, ← hsSq]
        dsimp [B]
        push_cast

        ∑ d : q.divisors,
          ∑ ψ : primitiveCharacters d.1,
            F (Nat.dvd_of_mem_divisors d.2) ψ) =
        ∑ q ∈ Finset.Ioc 0 Q,
          ∑ d ∈ q.divisors, f q d := by
    apply Finset.sum_congr rfl
    intro q hq

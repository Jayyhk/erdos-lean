                (leftTerms.map fun term => term.eval e).sum) *
              right.eval e
        rw [List.map_append, List.sum_append]
        rw [hrow, ih', add_mul]

/-- Every finite signed formula lies in the Claim 8 integer span. -/
lemma combination_weighted_monomials
    {d targetWeight : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}

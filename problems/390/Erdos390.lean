    (hJpDiff : ∀ c,
      |(nu c).expect (JpNu c) - (mu c).expect (JpMu c)| ≤ dJp)
    (hIqDiff : ∀ c, ∑ i,
      |(nu c).expect (IqNu c i) - (mu c).expect (IqMu c i)| ≤ dIrow)
    (hJqDiff : ∀ c, ∑ i,
      |(nu c).expect (JqNu c i) - (mu c).expect (JqMu c i)| ≤ dJrow)

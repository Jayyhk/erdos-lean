lemma even_middle_sub_discr (t : ℤ × ℤ × ℤ) : Even (t.2.1 - discr t) := by
  have hb : t.2.1 % 2 = 0 ∨ t.2.1 % 2 = 1 := by omega
  rcases hb with hb | hb <;>
    simp [Int.even_iff, discr, pow_two, Int.sub_emod, Int.mul_emod, hb]


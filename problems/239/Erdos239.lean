                (hblock M (2 * M) le_rfl htwoH.le hM (by omega) le_rfl)
                hrec
            _ = ((Nat.log 2 H - Nat.log 2 M + 1 : ℕ) : ℝ) * B := by
              rw [hlogTwo]

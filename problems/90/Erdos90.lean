        t ^ S.depth ((Fintype.equivFin S.RelatorIndex).symm i)) =
      ∑ r : S.RelatorIndex, t ^ S.depth r := by
  classical
  exact
    Fintype.sum_equiv (Fintype.equivFin S.RelatorIndex).symm _ _
      (fun _ => rfl)


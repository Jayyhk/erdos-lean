  · have hsq1 : chi1 n ^ 2 = 1 := by
      rw [← chi1.pow_apply' two_ne_zero, hsquare1,
        MulChar.one_apply hunit]
    have hsq2 : chi2 n ^ 2 = 1 := by
      rw [← chi2.pow_apply' two_ne_zero, hsquare2,
        MulChar.one_apply hunit]

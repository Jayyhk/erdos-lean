/-- The low-deletion series on the positive half-plane. -/
theorem LSeries_gsA9LowDeletion_eq_finiteEulerProduct_of_pos_re
    {f : ℕ → ℂ} (hmul : IsMultiplicativeOnPositiveNat f)
    (hbound : ∀ n, 0 < n → ‖f n‖ ≤ 1)
    (Q : ℕ → Prop) [DecidablePred Q] (y : ℕ)

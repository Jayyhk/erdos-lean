      _ ≤ |C| * Real.sqrt (powerSieveX n L : ℝ) :=
        mul_le_mul_of_nonneg_right (le_abs_self C) (Real.sqrt_nonneg _)
      _ = |C| * (n : ℝ) ^ (120 * L) := by rw [hsqrt]
  have hscale :
      100 * (Nat.totient d : ℝ) *
          (|C| * (n : ℝ) ^ (120 * L)) ≤

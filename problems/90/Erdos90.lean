/-- Inverse quotient associator sends first-factor insertion to nested left-left insertion. -/
@[simp] theorem mFQuot.map_prodassoc_symminl
    (G H K : Type*) [Group G] [Group H] [Group K]
    (x : mFQuot p G) :
    mFQuot.map (p := p)
        (MulEquiv.prodAssoc (M := G) (N := H) (P := K)).symm.toMonoidHom

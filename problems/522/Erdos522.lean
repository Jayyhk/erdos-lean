open _root_.MeasureTheory
open scoped BigOperators Classical

/-- The average norm on a measurable cell, using zero for a zero-mass cell. -/
def normCellAverage {Ω E : Type*} [MeasurableSpace Ω] [NormedAddCommGroup E]

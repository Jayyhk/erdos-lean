        (ψ.1 (n : ZMod q) * gaussSum ψ.1⁻¹ ZMod.stdAddChar) := by
      apply Finset.sum_congr rfl
      intro n _hn
      rw [sum_units_invCharacter_mul_stdAddChar_eq_sum_zmod]
      rw [primitive_fourier_expansion (χ := ψ.1) ψ.2 (n : ZMod q)]

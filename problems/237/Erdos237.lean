                  shiftedPrimeProgressionIntervalDiscrepancy N
                    (compatiblePairShiftModulus H W (de, h))
                    (compatiblePairShiftCrtResidue H D R W v hD (de, h)) h.1
              else 0
          else 0 :=
      Finset.sum_filter
        (fun de : (H → ℕ) × (H → ℕ) =>
          IsCrossCoordinateCoprime H de.1 de.2) _

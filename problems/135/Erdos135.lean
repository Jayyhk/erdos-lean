        edgeParam e (leftParam hx) ∈
            Metric.sphere x.1 (controlDisks.intersectionRadius x) ∧
          edgeParam e (leftParam hx) ∈ D.edgeCarrier e ∧
            edgeParam e (rightParam hx) ∈
                Metric.sphere x.1 (controlDisks.intersectionRadius x) ∧

      SPFactora.WordWeightLeast (lowerWeight + 1)
        (coordinates.tailFactors (n := n) lowerWeight ++ [factor]) := by
    intro x hx
    rcases List.mem_append.mp hx with hx | hx
    · exact htailSupported x hx
    · rcases List.mem_singleton.mp hx with rfl
      omega

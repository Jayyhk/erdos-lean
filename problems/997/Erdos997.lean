    _ ≤ 2 ^ 512 := pow_le_pow_right₀ (by norm_num) (by norm_num)

/-! ## The inner face integral on the good region -/

def largeShortMass : ℝ :=
  ∫ x : ℝ in Set.Icc (0 : ℝ) (1 / 8 : ℝ),
    largeG ((largeK : ℝ) * x)

theorem largeShortMass_eq :
    largeShortMass =

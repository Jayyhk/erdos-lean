        -logDeriv (DirichletCharacter.LFunction chi) s = LSeries a s := by
      rw [neg_logDeriv_LFunction_eq_LSeries chi hs,
        logDeriv_apply, ← neg_div,
        ← DirichletCharacter.LSeries_twist_vonMangoldt_eq chi hs]

    simpa [P, Q, qend, s] using hendpoint
  have hδq : δ ≤ qend := by
    linarith
  have hq0 : 0 ≤ qend := by
    have hQ' : 1 < Q := by simpa [Q, P] using hQ
    have hQpos : 0 < Q := by omega
    exact div_nonneg (Real.log_nonneg (by exact_mod_cast hQpos))
      (Real.log_pos (by exact_mod_cast hR)).le
  have hmono :
      (∫ x in (0 : ℝ)..δ,

  let cP := centralExtensionSet p hp hpc
  let cQ := centralExtensionSet q hq hcentral
  let sP : H → CentralExtensionPullback q f := normalizedSurjInv p hp
  let sQ : G → Q := normalizedSurjInv q hq
  let t : H → Q := fun h => (sP h).1.2

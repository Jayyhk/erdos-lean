    {d : ℕ}
    (H : ∀ r : ℕ, BCWta.{u} d r)
    {ι : Type}
    (j : ι)
    (k : ℕ) :
    List (SCFactor H ι) :=
  (List.range k).flatMap fun q =>
    symbolicWeightFactors H j (q + 1)


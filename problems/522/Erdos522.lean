open _root_.ProbabilityTheory in
private lemma _root_.ProbabilityTheory.iUnion_image_negativeSupportingNormalPatch_closedBall_eq_ball {d : ℕ}
    {v : EuclideanSpace ℝ (Fin d)} (hv : ‖v‖ = 1) :

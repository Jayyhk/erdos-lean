private def crossedSingleLinear
    (c : NMCocycl₂ (G := Gal(L/k)) (M := Lˣ))
    (sigma : Gal(L/k)) : L →ₗ[k] CProduc c where
  toFun a := CProduc.single c sigma a
  map_add' a b := CProduc.single_add c sigma a b
  map_smul' r a := by
    simp only [RingHom.id_apply]
    rw [Algebra.smul_def]

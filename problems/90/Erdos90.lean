the tensor-product calculation of Lemma 3.15. -/
def hBrauerMonoid
    (hcompat : ∀ c d : NMCocycl₂
      (G := Gal(L/k)) (M := Lˣ), TensorCompatibility k L c d) :
    MHTwo (Gal(L/k)) Lˣ →*

    intro v hv
    exact Finset.mem_union_left _
      (Finset.mem_union_left _ (Finset.mem_union_left _ hv))
  · intro b
    apply s_places_subset
    intro v hv
    apply Finset.mem_union_right
    exact Finset.mem_biUnion.mpr ⟨b, Finset.mem_univ _, hv⟩

end


structure SCFactor
    {d : ℕ}
    (H : ∀ r : ℕ, BCWta.{u} d r)
    (ι : Type) where
  word :
    CWord (HEAddres H)
  coefficient :
    WHMono H ι
      (word.weight HEAddres.weight)

namespace SCFactor

/-- A raw source Hall exponent before any collection swaps. -/
def source
    {d : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    {ι : Type}
    (j : ι)
    (a : HEAddres H) :
    SCFactor H ι where
  word := .atom a
  coefficient :=
    WHMono.single j a (by
      simp [HEAddres.weight])


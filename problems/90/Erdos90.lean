      basicCoordinatesWeight
        (commutator (commutator u v) w) rfl
    let first : BasicIndex (α := α) r →₀ ℤ :=
      basicCoordinatesWeight
        (commutator (commutator u w) v) (by
          dsimp only [r]
          simp only [weight_commutator]
          omega)
    let second : BasicIndex (α := α) r →₀ ℤ :=
      basicCoordinatesWeight
        (commutator (commutator v w) u) (by
          dsimp only [r]
          simp only [weight_commutator]
          omega)

    (∫ z : ℝ × ℝ,
        χ.cutoffNormalizerPairFactor z) =
        ∫ t : ℝ, ∫ u : ℝ,
          χ.cutoffFourierTransform t *
            χ.cutoffFourierTransform u *
            cutoffNormalizerKernel t u := by
      exact
        (integral_integral
          hintegrable).symm

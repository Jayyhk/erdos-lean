  have hlogTnonneg : 0 ≤ Real.log T := Real.log_nonneg hTone
  have hlow : ‖∑ n ∈ Finset.Icc 1 M, f n‖ ≤
      1 + 2 * Real.log Q + Real.log 2 + e * Real.log T / 8 := by
    calc

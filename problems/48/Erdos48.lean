        (n : ℝ) * (((((sigma : ℂ) + rho.im * I) - z)⁻¹).re)) -
        (16 * (A : ℝ) + 3) * L / 3 ≤
      (logDeriv (DirichletCharacter.LFunction chi)
        ((sigma : ℂ) + rho.im * I)).re at hpairRaw
    rw [hZpairSum, hresidual] at hpairRaw
    have hpoleCancel :
        a / (a ^ 2 + 4 * rho.im ^ 2) ≤

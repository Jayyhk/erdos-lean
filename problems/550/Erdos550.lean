lemma hpGoodLeft_compl_lt
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    {ε : ℝ} (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    {s t SQ : Finset V} (hs : s.Nonempty)
    (hSQ : SQ ⊆ t) (hSQsig : ε * (t.card : ℝ) ≤ (SQ.card : ℝ))

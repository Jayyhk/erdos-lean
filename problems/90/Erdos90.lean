      freeAssociativeRealization ℤ X p.1 -
          (a : MonoidAlgebra ℤ (FreeGroup X)) ∈
        GroupAlgebra.augmentationPower ℤ (FreeGroup X) (n + 1) := by
    exact
      (Submodule.Quotient.eq
        (GroupAlgebra.augmentationLayerDenom
          ℤ (FreeGroup X) n)).mp hlayer

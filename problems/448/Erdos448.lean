      have hmul := mul_le_mul_of_nonneg_left hinvM (show 0 ≤ (3 / 4 : ℝ) by norm_num)
      have hleft : 3 / (4 * Mscale N) = (3 / 4 : ℝ) * (1 / Mscale N) := by

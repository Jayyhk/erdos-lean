  · rw [abs_le] at hre
    linarith
  constructor
  · rw [abs_le] at hre
    linarith
  constructor
  · linarith [abs_nonneg t]
  · linarith [abs_nonneg t]

private lemma exists_pos_norm_riemannZeta₁_closedBall_one_le :
    ∃ C : ℝ, 0 < C ∧ ∀ z ∈ closedBall (0 : ℂ) 1,

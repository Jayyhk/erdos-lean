    (N : ℝ) ^ t ≤
        (2 * (trimToMultiple D N : ℝ)) ^ t :=
      pow_le_pow_left₀ (by positivity) hside t
    _ = (2 : ℝ) ^ t *
        (trimToMultiple D N : ℝ) ^ t := by
      rw [mul_pow]


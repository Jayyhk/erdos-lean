    ‖(∑ m ∈ Finset.Ioc 0 (N / d),
        LogPhaseSum.natLogTwist m t) - main z‖ =
        ‖((∑ m ∈ Finset.Ioc 0 (N / d),
          LogPhaseSum.natLogTwist m t) - main M) +
            (main M - main z)‖ := by ring_nf
    _ ≤ ‖(∑ m ∈ Finset.Ioc 0 (N / d),
          LogPhaseSum.natLogTwist m t) - main M‖ +
        ‖main M - main z‖ := norm_add_le _ _

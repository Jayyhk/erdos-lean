positive prefix but chosen to fit the global HR theorem exactly. -/
def gsA10ShiuWeight (y : ℕ) (eta : ℝ) (n : ℕ) : ℝ :=
  if n = 0 then 0 else
    (primeBandPart (fun p ↦ ¬ p ≤ y) n : ℝ) ^ (-eta)


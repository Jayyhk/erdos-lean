theorem collection_n_four
    (p d n : ℕ) [Fact p.Prime]
    (hn4 : n ≤ 4) :
    Nonempty (PGColl.{u} p d n) := by
  by_cases hn : n ≤ 1
  · exact
      Nonempty.map
        FSColl.toCollection
        (p_collection_one p d n hn)
  by_cases hd : d ≤ 1
  · exact
      Nonempty.map
        FSColl.toCollection
        (p_collection_generators
          (p := p) (d := d) (n := n) hd)

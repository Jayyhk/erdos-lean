/-- Characterize the inverse of a left-union descent equivalence. -/
@[simp] theorem Hom.descre_union_symmb
    {P Q : Presentation.{u}} {S T : Set P.Free}
    (f : Hom (P.withRelators S) Q)
    (hT : ∀ ⦃t : P.Free⦄, t ∈ T → f.freeMap t ∈ Q.rNClos)
    (hker : MonoidHom.ker f.toGroupHom ≤
      Subgroup.normalClosure ((P.withRelators S).quotientMap '' T))
    (hf : Function.Surjective f.toGroupHom) (y : Q.Group)
    (x : (P.withRelators (S ∪ T)).Group) :
    (f.descre_union_kerna hT hker hf).symm y = x ↔
      y = (f.desc_relators_unionleft hT).toGroupHom x := by
  rw [MulEquiv.symm_apply_eq]
  rfl


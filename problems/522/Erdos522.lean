    (1 / (q : ℝ)) = _
  rw [integral_Ico_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (unitIntervalCell_endpoints hq j).2.1.le]
  rw [one_div, div_inv_eq_mul, mul_comm]


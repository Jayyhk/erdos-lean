        ¬ ((∑ i, fourFiveLogCoordinate y (q i)) <
          fourFiveRealLogCoordinate y t - 1) := by
      intro h
      exact hactive (hsupport.mpr h)
    rw [if_neg hactiveLog, if_neg hactive]

          eM (c (eG.symm g, eG.symm (h * j))) := map_mul eM _ _
      _ = g • eM (c (eG.symm h, eG.symm j)) *
          eM (c (eG.symm g, eG.symm (h * j))) := by rw [hs]
  map_one_fst g := by simp
  map_one_snd g := by simp

@[simp]
theorem cocycleMap_apply (eG : G ≃* H) (eM : M ≃* N)

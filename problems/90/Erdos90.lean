    (S : Finset (NumberFieldPlace K))
    (Q : primesAbovePlaces (K := K) (L := L) S) :
    0 < placeLogScale (K := K) (L := L) S Q :=
  (Classical.choose_spec (AbsoluteValue.isEquiv_iff_exists_rpow_eq.mp
    (upper_place_equiv (K := K) (L := L) S Q))).1


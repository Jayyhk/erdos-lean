private abbrev obstructionCompletionGal
    [FiniteDimensional Kc M] [IsGalois Kc M]
    (v : AbsoluteValue Kc ℝ)
    (w : Submission.CField.ICohomo.CompletionPlacesAbove
      (L := M) v) :=

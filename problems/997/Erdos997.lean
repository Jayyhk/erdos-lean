set_option maxRecDepth 5000 in
theorem outerCollisionWeightSum_le_roughScalarFactorSum
    (H : Finset ℕ) (R D : ℕ) :
    (∑ u ∈ preSievedSimplexCollisionSupport H R (primorial D),
      outerTupleWeight H (primorial D) u) ≤
      ∑ x ∈ collisionPairPrimeIndex H D R,

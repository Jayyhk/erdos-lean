    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (ε d : ℝ) (endpoint headCore : Finset V) :
    hpRetainedSet G ε d endpoint headCore ⊆ endpoint :=
  open scoped Classical in
  Finset.filter_subset _ _


      ‖BoundedGaps.Maynard.twistedChebyshevSum x 1
            (1 : DirichletCharacter ℂ 1) -
          BoundedGaps.Maynard.dirichletExplicitFormulaMainZeroTerms
            (1 : DirichletCharacter ℂ 1) (x : ℝ) T‖ ≤

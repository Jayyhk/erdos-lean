    w.freeCentralLayer ∈
      basicTreeSpan (α := α) w.weight := by
  induction w with
  | atom a =>
      exact
        free_tree_span
          (atom a) (isBasic_atom a) rfl
  | commutator u v ihu ihv =>
      rw [free_layer_commutator]
      exact
        bracket_tree_indexed
          u.weight_pos v.weight_pos (fun x y => hcommutator x y) ihu ihv


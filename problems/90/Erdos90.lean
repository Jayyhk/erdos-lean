    {G M N : Type*} [Group G] [CommGroup M] [CommGroup N]
    [MulDistribMulAction G M] [MulDistribMulAction G N]
    (f : M →* N) (hf : ∀ g : G, ∀ m : M, f (g • m) = g • f m) :
    NMCocycl₂ (G := G) (M := M) →*
      NMCocycl₂ (G := G) (M := N) where
  toFun := mapCoefficients f hf

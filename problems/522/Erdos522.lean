    dsimp [Q]
    apply (le_div_iff₀ hl).mpr
    exact mul_le_mul_of_nonneg_left hlL (Nat.cast_nonneg _)
  have hQ1 : 1 ≤ Q := hnR.trans hQ
  have hk : 0 < k := by dsimp [k]; omega
  have hkR : (0 : ℝ) < k := by exact_mod_cast hk
  have hklo : Q ≤ (k : ℝ) := by
    dsimp [k]
    push_cast

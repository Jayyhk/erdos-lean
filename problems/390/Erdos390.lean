        ∑ r ∈ highExponents (valuationCutoff p M),
          (((2 * r - 3 : ℕ) : ℝ) *
            (K * (((r : ℝ) + 1) / (p : ℝ) ^ r) + e r)) := by
      apply Finset.sum_le_sum

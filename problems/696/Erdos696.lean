                (fun q => q.Prime ∧ q % p = 1 ∧ (256 : ℝ) * (p : ℝ) ^ 9 < (q : ℝ) ∧ (q : ℝ) ≤ Q)
                (Finset.Iic ⌊Q⌋₊), (1 : ℝ) / (q : ℝ))) :=
              add_le_add hlow hhigh_split

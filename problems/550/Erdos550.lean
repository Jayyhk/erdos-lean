      = SimpleGraph.connectedComponentMk (seedDeleted T S) v := by
    simpa [seedComponent, SimpleGraph.ConnectedComponent.mem_supp_iff] using hw
  obtain ⟨p⟩ := (SimpleGraph.ConnectedComponent.eq.mp h1).symm

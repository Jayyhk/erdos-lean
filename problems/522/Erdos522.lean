      _ ≤ ‖v‖ + ‖u - v‖ := norm_add_le _ _
      _ ≤ ‖v‖ + r := by gcongr
  nlinarith [norm_nonneg u, norm_nonneg v, sq_nonneg (‖v‖ - r)]


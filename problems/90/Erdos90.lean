    refine ⟨rfl, ?_⟩
    intro w hw hwn
    exact dvd_zero _
  add_mem' hf hg := by
    refine ⟨by simp [hf.1, hg.1], ?_⟩
    intro w hw hwn
    exact dvd_add (hf.2 w hw hwn) (hg.2 w hw hwn)

      (Submission.CField.LFTheory.localUnitSubgroup F) (by
        intro c
        change ValuativeRel.valuation F ((phi c : Fˣ) : F) = 1
        apply (pow_eq_one_iff_of_nonneg
          (bot_le : 0 ≤ ValuativeRel.valuation F ((phi c : Fˣ) : F))

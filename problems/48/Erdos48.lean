      simp only [List.nodup_cons] at hnodup
      refine ⟨?_, ih hle.2 hnodup.2⟩
      intro b hb
      exact lt_of_le_of_ne (hle.1 b hb) (Ne.symm (fun hab ↦ hnodup.1 (hab ▸ hb)))


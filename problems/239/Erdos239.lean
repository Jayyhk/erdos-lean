        (1 + (2 * Real.log 2 * beta)⁻¹) := by
      exact mul_le_mul_of_nonneg_left hgeom
        gsA10PrimeLogHarmonicFactorFourConstant_nonneg

/-- Beta-sensitive diagonal budget for the actual symmetric source lines

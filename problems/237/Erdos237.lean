    {r a : ℕ} (ha : Squarefree a) (hr : 0 < r) (hra : r ∣ a) :
    (∑ d ∈ upperDivisorInterval r a,
      (ArithmeticFunction.moebius d : ℝ) * (d : ℝ) / Nat.totient d) =
      (ArithmeticFunction.moebius a : ℝ) * (r : ℝ) / Nat.totient a := by

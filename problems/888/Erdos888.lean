theorem occupiedBlockIndices_snd_le_log {A : Finset ℕ} {n : ℕ}
    (hA : RequiredCondition A n) {ij : ℕ × ℕ}
    (hij : ij ∈ occupiedBlockIndices A) : ij.2 ≤ Nat.log 2 n := by
  obtain ⟨a, haRich, hindex⟩ := mem_occupiedBlockIndices.1 hij

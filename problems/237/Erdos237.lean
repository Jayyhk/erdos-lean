open scoped BigOperators

noncomputable def dyadicSquareMass (L k : ℕ) (j : Fin L) : ℝ :=
  dyadicHeight L j ^ 2 * dyadicLength L k j

noncomputable def dyadicLinearMass (L k : ℕ) (j : Fin L) : ℝ :=
  dyadicHeight L j * dyadicLength L k j


theorem prod_B_eq_factorial {k : ℕ} (B : Fin k → ℕ) (hpos : ∀ j, 0 < B j)
    (hval : ∀ p, p.Prime →
        (∏ j, B j).factorization p = k.factorial.factorization p) :

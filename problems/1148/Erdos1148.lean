    (hinv : ∀ t : ℝ, Measure.map (modularRightTranslate (diagonalFlow t)) μ = μ)
    {η δ : ℝ} (hη0 : 0 ≤ η) (hη : η ≤ 1 / 2) (hδ : 0 < δ) (hδ1 : δ ≤ 1) :

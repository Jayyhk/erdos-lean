    (x b q : ℕ) (χ : DirichletCharacter ℂ q) : ℝ :=
  if hx : 1 ≤ x then
    (Finset.Icc 1 x).sup'
      ⟨1, Finset.mem_Icc.mpr ⟨le_rfl, hx⟩⟩
      (fun a ↦ ‖dirichletCharacterIntervalSum a b q χ‖)

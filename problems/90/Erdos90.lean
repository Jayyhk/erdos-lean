lemma nil_terms_below
    {d inputWeight lowerWeight s : ℕ}
    {H : ∀ t : ℕ, BCWta.{u} d t}
    (R : CCExpans H inputWeight)
    (hR : R.NTBelow lowerWeight)
    (hs : s < lowerWeight) :
    R.weightFactors s = [] := by
  rw [weightFactors]
  apply List.flatMap_eq_nil_iff.2
  intro i _hi
  unfold BCExp.symbolicPowerFactors
  rw [hR s i hs]
  rfl


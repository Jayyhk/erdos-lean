    (hroots : (primitiveRoots n K).Nonempty)
    (sigma : Gal(L.carrier/K)) :
    radicalPowerClasses K Omega n L.carrier →* Kˣ :=
  (rootsOfUnity n K).subtype.comp
    (radicalRootCharacter K Omega n L hn hroots sigma)


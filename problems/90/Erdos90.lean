    ⟨w.1, infinite_lies_comap v w rfl⟩⟩

private theorem upper_place_equiv
    (S : Finset (NumberFieldPlace K))
    (Q : primesAbovePlaces (K := K) (L := L) S) :
    (upperPlacePrime (K := K) (L := L) S Q).2.1.IsEquiv
      (FinitePlace.mk Q.1).val := by

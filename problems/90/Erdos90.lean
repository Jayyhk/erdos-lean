    {M N K : ℕ}
    {B A : BFam M N}
    {left right : List (DFTerm M N K)}
    (ledger : PTLedger B A left right)
    (hleft : RPFor B left)
    (hright : RPFor A right) :
    (ledger.packetWorkItem hleft hright).ledger =
      ledger.toWordLedger :=
  rfl


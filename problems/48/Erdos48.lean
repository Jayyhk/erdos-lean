    {k : ℕ} {L T : ℝ}
    (hk : 0 < k) (hL : 0 < L) (hkL : (k : ℝ) ≤ L) (hT : 0 < T)
    (hmPos : ∀ m ∈ sm, 0 < m)
    (hnPos : ∀ n ∈ sn, 0 < n)

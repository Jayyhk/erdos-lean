    {H : Subgroup (IdealsPrimeTo (NumberField.RingOfIntegers K) K m.finiteSupport)}
    (chi : CongruenceClassQuotient K m H →* ℂˣ) : ℂ :=
  limUnder atTop (fun N ↦ congruenceLPartial K chi 1 N)


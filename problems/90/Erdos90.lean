    inertia_ramification_idx (L := L) hq P
  have hCardOne :
      Nat.card (P.inertia (Gal(L/ℚ))) = 1 := by
    rw [hInertia, Subgroup.card_bot]
  rw [← hCard]
  exact hCardOne


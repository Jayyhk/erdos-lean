      have hdData := Finset.mem_filter.mp hd
      have hrd : r ∣ d := hdData.2
      have hquotDvd : d / r ∣ q := by
        rw [Nat.dvd_div_iff_mul_dvd hra]
        rw [Nat.mul_div_cancel' hrd]

      Subgroup.normalClosure ((P.withRelators S).quotientMap '' T))
    (hf : Function.Surjective f.toGroupHom) (w : P.Free) :
    (f.descre_union_kerna hT hker hf).symm
        (f.toGroupHom ((P.withRelators S).quotientMap w)) =
      (P.withRelators (S ∪ T)).quotientMap w := by
  rw [← Hom.descrelators_unionleft_equivquotmap f hT hker hf w]
  exact (f.descre_union_kerna hT hker hf).left_inv _


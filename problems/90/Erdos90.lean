def fullLatticeRealization
    {V : Type u} [AddCommGroup V] [Module ℝ V]
    (M : Submodule ℤ V) : ℝ ⊗[ℤ] M →ₗ[ℝ] V :=
  TensorProduct.AlgebraTensorModule.lift

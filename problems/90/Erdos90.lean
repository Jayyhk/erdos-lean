  have hpRootOD :
      eval₂ (baseDivision K D) alpha pR = 0 := by
    apply Subtype.ext
    change (divisionIntegerSubring K D).subtype
      (eval₂ (baseDivision K D) alpha pR) =
        (divisionIntegerSubring K D).subtype 0

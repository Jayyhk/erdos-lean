        vaughanFourthDyadicBlockMaximum U V x q alpha chi := by
      apply Finset.sum_le_sum
      intro alpha halpha
      exact norm_vaughanTwistedSumFourDyadicBlock_le_maximum
        hV halpha hy chi

end

end BoundedGaps.Maynard


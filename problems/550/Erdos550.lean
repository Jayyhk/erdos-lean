                ((C (cR k)).card : ℝ))) ≤
        ∑ k ∈ K,
          (hpTrimmedThreshold
              (hpHeadEndpointWeight G R C head (cL k))
              ε ((C (cL k)).card : ℝ) +
            hpTrimmedThreshold
              (hpHeadEndpointWeight G R C head (cR k))
              ε ((C (cR k)).card : ℝ)) := by
    calc
      _ = Finset.sum K (fun k =>
          hpHeadMatchingWeight G R C head cL cR k -

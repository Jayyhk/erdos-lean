    (ν : Measure Θ) [IsProbabilityMeasure ν] (X : Θ × Ω → ℝ)
    (hX : Measurable X) (hX0 : ∀ p, 0 ≤ X p) (T : ℝ) (hT : 0 ≤ T) :

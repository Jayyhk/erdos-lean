    {m y A B : Nat} {q : Fin m -> Nat}
    (hq : q ∈ fourFiveOrderedPrimePrefixSet m y B)
    (hLU : fourFiveLastPrimeLower q y A <=
      fourFiveLastPrimeUpper q B) :

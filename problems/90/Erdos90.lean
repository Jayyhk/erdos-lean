    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (coefficient : ℤ)
    (word : CWord (HEAddres H))
    (hword : word ∈ signedStrictTrace x y z coefficient) :
    word.eval
          (PEAddres.freeLowerTruncation (n := n)) ∈

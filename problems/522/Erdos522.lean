    {a b : ℂ} {ρ : ℝ} (hρ : 0 < ρ) (hab : ‖b - a‖ = ρ) (z : ℂ) :
    ‖complexExponentialSum s c ζ z‖ / 2 ≤ ‖exponentialPruning s c ζ a ρ z‖ ∨
      ‖complexExponentialSum s c ζ z‖ / 2 ≤ ‖exponentialPruning s c ζ b ρ z‖ := by
  have h := norm_le_pruned_pair s c ζ hρ hab z
  by_contra! hbad
  linarith


    (Finset.Icc 1 y).filter (fun m : ℕ ↦ U < (m : ℝ))
  let s : Finset ℕ :=
    (Finset.Icc 1 y).filter (fun m : ℕ ↦
      U < (m : ℝ) ∧ (m : ℝ) ≤ (x : ℝ) / V)
  let f : ℕ → ℕ → ℂ := fun m k ↦
    ((ArithmeticFunction.vonMangoldt m : ℝ) : ℂ) *
      ((vaughanFourthCoefficient V k : ℝ) : ℂ) * chi (m * k)

              C * ((x : ℝ) * Real.exp (-c * Real.sqrt (Real.log (x : ℝ)))) := by
  obtain ⟨C, c, hC, hc, X₀, hX₀, hbound⟩ :=
    exists_siegelWalfisz_primitiveCenteredEndpointMaximum_le A hA

  have hprimitiveK : IsPrimitiveRoot ζ p :=
    (mem_primitiveRoots hp.pos).mp hζ
  have hprimitiveR : IsPrimitiveRoot (v.embedding_of_isReal hv ζ) p :=
    hprimitiveK.map_of_injective (v.embedding_of_isReal hv).injective

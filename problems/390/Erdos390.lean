  rw [h₂] at hConv
  calc
    (∑ m ∈ Finset.Ioc 0 n,
        naguraLowerWeight m * Chebyshev.psi ((n / m : ℕ) : ℝ)) =
      ∑ m ∈ Finset.Ioc 0 n,

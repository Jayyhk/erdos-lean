the finite signed Newton recipe family. -/
noncomputable def reconstructedIntegralProfile
    (cutoff : ℕ)
    (coefficient : ℤ) :
    Multiset (CWord Atom) :=
  ∑ slot ∈ (orderedCutoffVocabulary cutoff).toFinset,
    Int.toNat
        ((strictSlotExpansion cutoff slot).eval coefficient) •
      ({slot} : Multiset (CWord Atom))

/-- The finite signed Newton recipe family reconstructs the literal retained
Hall-Witt strict-tail cutoff profile exactly. -/
lemma reconstructed_integral_profile
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)

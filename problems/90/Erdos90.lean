    apply le_antisymm
    · refine iSup_le fun i => iSup_le fun hi => ?_
      exact le_iSup_of_le ⟨i, hi⟩ le_rfl
    · refine iSup_le fun i => ?_
      exact le_iSup_of_le i.1 (le_iSup_of_le i.2 le_rfl)

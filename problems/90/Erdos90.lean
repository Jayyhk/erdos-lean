      (NumberField.RingOfIntegers K ⧸ v.asIdeal) ≃+*
        v.asIdeal.ResidueField :=
    RingEquiv.ofBijective
      (algebraMap
        (NumberField.RingOfIntegers K ⧸ v.asIdeal)
        v.asIdeal.ResidueField)
      v.asIdeal.bijective_algebraMap_quotient_residueField

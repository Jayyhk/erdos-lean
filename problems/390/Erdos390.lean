            epsilonSecond * (1 / (p : ℝ)) ^ 2) ≤
        (epsilonDiag * Csup +
            epsilonSecond * Csup * (1 / (B.sampleData.W : ℝ))) *
          w * (1 / (p : ℝ)) := by

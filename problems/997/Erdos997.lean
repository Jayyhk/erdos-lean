theorem tupleVariableOuterProfile_nonneg_le_one
    {H : Finset ℕ} {A : ℝ} (hA : 0 < A)
    {R W : ℕ} (m : H) {r : H → ℕ}
    (hr : BoundedGaps.Maynard.IsMaynardDivisorTuple H R W r)
    (hR : 1 < R) :
    0 ≤ tupleVariableOuterProfile A R m r ∧
      tupleVariableOuterProfile A R m r ≤ 1 := by

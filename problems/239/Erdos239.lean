theorem sum_quadraticLocalTerm_le_primeQuadraticConstant (N : ℕ) :
    (∑ p ∈ (N + 1).primesBelow,
      1 / ((p : ℝ) * ((p : ℝ) - 1))) ≤ primeQuadraticConstant := by

  ∀ a,
    a ∈ bankPaperCanonicalStructuredActiveValues B.sampleData ->
    a ∉ R.roughCanonicalGuardedBroadCorrectionPool certificate
      deltaStar B.sampleData.W K 1 ->
    bankPaperCanonicalGlobalCorrectedOutsideSelectorWithTop (K := K)

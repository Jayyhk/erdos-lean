        (PowerSeries.X ^ Fintype.card k) := by rw [hfmap]
    _ = (MvPowerSeries.map rho phi) ^ Fintype.card k := by
      rw [PowerSeries.subst_pow (hphiSubst.map rho),
        PowerSeries.subst_X (hphiSubst.map rho)]

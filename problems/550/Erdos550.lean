      (fun k => matchingSideLoad P f (right k))
      leftThreshold rightThreshold
      (fun k => ((rootPoolL k).card : ℝ))
      (fun k => ((rootPoolR k).card : ℝ))
      a b cap margin τ err (Lnat : ℝ) (Lnat : ℝ)

    ShortComplex.isoMk (Iso.refl _) (Iso.refl _)
      (Abelian.coimageIsoImage f)
      (by simp [S, imageShortComplex])
      (by
        dsimp [S, imageShortComplex]
        rw [← cancel_mono (Abelian.image.ι f)]
        simp [Category.assoc])

  rw [LSeries, Complex.ofReal_tsum]
  apply tsum_congr
  intro n
  by_cases hn : n = 0
  · subst n
    simp
  · rw [LSeries.term_of_ne_zero hn]
    push_cast
    rw [Complex.ofReal_cpow (Nat.cast_nonneg n) sigma]

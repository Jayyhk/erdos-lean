  letI : IsGaloisGroup H D L :=
    IsGaloisGroup.subgroup Gal(L/K) K L H
  letI : FiniteDimensional D L := IsGaloisGroup.finiteDimensional H D L
  letI : IsGalois D L := IsGaloisGroup.isGalois H D L

@[simp]
private theorem integer_lattice_coe
    (S : Finset (NumberFieldPlace K))
    (f : upperPlacesAt (K := K) (L := L) S → ℤ)
    (j : upperPlacesAt (K := K) (L := L) S) :
    ((upperIntegerLattice (K := K) (L := L) S f :

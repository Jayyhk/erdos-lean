theorem tendsto_normalizedTupleS1
    {H : Finset ℕ} {alpha I : ℝ} (halpha : 0 < alpha)
    (halphaQuarter : alpha < 1 / 4) (v : ℕ → ℕ)
    (F : (H → ℝ) → ℝ) {B : ℝ} (hB : 0 ≤ B)
    (hF : ∀ t, |F t| ≤ B)

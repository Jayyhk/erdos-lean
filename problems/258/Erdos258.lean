    rw [maynardCoefficientFromY_div_product_eq_sum hy hdBox]
    apply Finset.sum_eq_zero
    intro e heBox
    by_cases hcond : divisorTupleProduct H e < R ∧
        (∀ h : H, d h ∣ e h)
    · rw [if_pos hcond]
      by_cases hye : y e = 0
      · simp [hye]

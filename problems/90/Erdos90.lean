    C (C × augmentationIdeal G) _ _ C.hV2 (splittingModule C φ hφ).hV2
    { toFun := fun c ↦ (c, 0)
      map_add' := fun _ _ ↦ rfl }
    (fun n x ↦ by
      change (C.hV2.smul n x, 0) =
        (splittingModule C φ hφ).hV2.smul n (x, 0)
      rw [int_smul_eq_zsmul C.hV2 n x,

      have hxT : (xT : Gal(L/K) × Gal(L/K) →
          resizedPlacesRepresentation (K := K) (L := L) T) ∈
          coboundaries₂ (resizedPlacesRepresentation
            (K := K) (L := L) T) := by
        refine ⟨aT, ?_⟩

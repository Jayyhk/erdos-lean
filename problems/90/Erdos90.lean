theorem factor_set_left (pi : M) (b : ZMod n) :
    factorSet pi 0 b = 1 := by
  simp [factorSet, carry, ZMod.val_lt]

@[simp]
theorem factor_set_right (pi : M) (a : ZMod n) :
    factorSet pi a 0 = 1 := by
  simp [factorSet, carry, ZMod.val_lt]


      _ ≤ |z.im - t| + |t| := abs_add_le _ _
      _ ≤ 4 + |t| := by linarith
      _ = |t| + 4 := by ring
  have hcenter : ‖(2 : ℂ) + t * I‖ ≤ 2 + |t| := by
    calc
      ‖(2 : ℂ) + t * I‖ ≤ ‖(2 : ℂ)‖ + ‖t * I‖ := norm_add_le _ _
      _ = 2 + |t| := by simp [Real.norm_eq_abs]

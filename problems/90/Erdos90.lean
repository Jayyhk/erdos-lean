    NMCocycl₂ (G := G) (M := M) where
  toFun p := c p * d p
  isMulCocycle₂ g h j := by
    calc
      (c (g * h, j) * d (g * h, j)) * (c (g, h) * d (g, h)) =
          (c (g * h, j) * c (g, h)) *
            (d (g * h, j) * d (g, h)) := by ac_rfl

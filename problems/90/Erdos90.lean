/-- The unpowered group value represented by one source atom. -/
def value
    {d n inputWeight : ℕ}
    {H : ∀ s : ℕ, BCWta.{u} d s}
    (atom : SSAtom H inputWeight) :
    LowerCentralTruncation (FreeGroup (FreeGenerator.{u} d)) n :=
  PEAddres.freeLowerTruncation atom.address ^
    atom.coefficient


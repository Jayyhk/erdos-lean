      rw [Finset.sum_add_distrib]
      congr 1
      · rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro p hp
        ring
      · rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro p hp
        ring

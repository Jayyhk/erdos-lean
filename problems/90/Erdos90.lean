/-!
# Associated-graded semantics for concrete Hall-Witt profile recipes

The physical Hall-Witt profile reconstruction is a multiset statement, so it
forgets the order of the retained factors.  This is safe after projecting to
the relevant lower-central associated-graded layer: its additive group is
commutative.  The resulting finite sum is indexed by the fixed deduplicated
physical vocabulary and has the concrete recipe evaluations as coefficients.

This file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace SAGraded

open STSubsti
open TOCoordi
open TEAddres
open
  GSExp
open
  GSVector
open
  WSRecons

/--
Projecting a product of lower-central representatives to its associated-graded
layer turns the product into an additive sum.
-/
lemma lower_central_prod
    {G : Type*}
    [Group G]
    (layer : ℕ)
    (terms : List (Subgroup.lowerCentralSeries G layer)) :
    TBluepr.lowerCentralClass layer terms.prod =
      (terms.map (TBluepr.lowerCentralClass layer)).sum := by
  induction terms with
  | nil =>
      simp
  | cons term terms ih =>
      simp [ih]

/--
Map the concrete reconstructed profile into any additive commutative monoid.
The result is the finite sum of concrete recipe evaluations against the fixed
physical vocabulary.
-/
lemma reconstructed_below_profile
    {β M : Type*}
    [DecidableEq β]
    [AddCommMonoid M]
    (wt : β → ℕ)
    (x y z : CWord β)
    (cutoff : ℕ)
    (coefficient : ℤ)
    (value : CWord β → M) :
    ((reconstructedBelowProfile
        wt x y z cutoff coefficient).map value).sum =
      ∑ word ∈
          (signedDeduplicatedVocabulary x y z cutoff).toFinset,
        Int.toNat
            ((filteredSlotExpansion
              wt x y z cutoff word).eval coefficient) •
          value word := by
  unfold reconstructedBelowProfile
  let aggregate : Multiset (CWord β) →+ M :=
    Multiset.sumAddMonoidHom.comp (Multiset.mapAddMonoidHom value)
  change
    aggregate
        (∑ word ∈
            (signedDeduplicatedVocabulary x y z cutoff).toFinset,
          Int.toNat
              ((filteredSlotExpansion
                wt x y z cutoff word).eval coefficient) •
            ({word} : Multiset (CWord β))) =
      _
  rw [map_sum aggregate]
  apply Finset.sum_congr rfl
  intro word _hword
  change
    ((Multiset.mapAddMonoidHom value)
      (Int.toNat
          ((filteredSlotExpansion
            wt x y z cutoff word).eval coefficient) •
        ({word} : Multiset (CWord β)))).sum =
      _
  rw [map_nsmul]
  simpa using
    (map_nsmul Multiset.sumAddMonoidHom
      (Int.toNat
        ((filteredSlotExpansion
          wt x y z cutoff word).eval coefficient))
      ({value word} : Multiset M))

/--
Map the literal retained signed Hall-Witt trace into any additive commutative
monoid.  Exact physical-profile reconstruction supplies a finite recipe sum.
-/
lemma below_concrete_profile
    {β M : Type*}
    [DecidableEq β]
    [AddCommMonoid M]
    (wt : β → ℕ)
    (hwt : ∀ atom, 0 < wt atom)
    (x y z : CWord β)
    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (coefficient : ℤ)
    (value : CWord β → M) :
    ((↑(signedBelowTrace wt x y z cutoff coefficient) :
        Multiset (CWord β)).map value).sum =
      ∑ word ∈
          (signedDeduplicatedVocabulary x y z cutoff).toFinset,
        Int.toNat
            ((filteredSlotExpansion
              wt x y z cutoff word).eval coefficient) •
          value word := by
  rw [← reconstructed_concrete_profile
    wt hwt x y z cutoff hcutoff coefficient]
  exact
    reconstructed_below_profile
      wt x y z cutoff coefficient value

/--
Attach each retained word to its proof that its evaluation belongs to the
expected lower-central layer.
-/
noncomputable def addressBelowTerms
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (cutoff : ℕ)
    (coefficient : ℤ) :
    List
      (Subgroup.lowerCentralSeries
        (LowerCentralTruncation (FreeGroup (FreeGenerator.{u} d)) n)
        (x.weight PEAddres.weight +
            y.weight PEAddres.weight +
          z.weight PEAddres.weight)) :=
  (signedBelowTrace PEAddres.weight
    x y z cutoff coefficient).attach.map fun entry =>
      ⟨entry.1.eval
          (PEAddres.freeLowerTruncation (n := n)),
        series_strict_trace
          x y z coefficient entry.1 (List.mem_filter.mp entry.2).1⟩

end SAGraded
end TCTex
end Submission


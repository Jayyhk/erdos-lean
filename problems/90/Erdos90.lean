  letI := IsIntegralClosure.MulSemiringAction (𝓞 K) K L (𝓞 L)
  letI : IsGaloisGroup Gal(L/K) (𝓞 K) (𝓞 L) :=
    IsGaloisGroup.of_isFractionRing Gal(L/K) (𝓞 K) (𝓞 L) K L

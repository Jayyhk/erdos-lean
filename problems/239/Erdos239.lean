    a ^ 2 = (a * Real.exp (-R / 2)) ^ 2 * Real.exp R := by
      rw [mul_pow]
      nlinarith
    _ ≤ Real.exp (z / 2 + 8 * V) ^ 2 * Real.exp R := by
      gcongr
    _ = Real.exp (R + 20 * V) * Real.exp (z - 4 * V) := by
      rw [pow_two, ← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
      congr 1
      ring
    _ ≤ Real.exp (R + 20 * V) * p := by gcongr


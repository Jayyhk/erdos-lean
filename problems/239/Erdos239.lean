    have hnX : (n : ℝ) ≤ X := by exact_mod_cast hnle
    have hexp0 : 0 ≤ 1 - rho := by linarith
    have hpow : (n : ℝ) ^ (1 - rho) ≤ (X : ℝ) ^ (1 - rho) :=
      Real.rpow_le_rpow hnR.le hnX hexp0
    rw [LSeries.norm_term_eq, LSeries.norm_term_eq,
      if_neg hn0, if_neg hn0]

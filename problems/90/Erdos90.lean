      freeAssociativeRealization ℤ X p.1 -
          (a : MonoidAlgebra ℤ (FreeGroup X)) ∈
        Submission.GShafar.augmentationIdeal
            ℤ (FreeGroup X) ^ (n + 1) := by
    simpa [GroupAlgebra.augmentationPower,
      ← GAWt.augmentation_ideal_algebra] using hdiff

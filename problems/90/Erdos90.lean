noncomputable def completionPlaceStabilizer
    (v : AbsoluteValue K ℝ)
    (w0 : CompletionPlacesAbove (L := L) v)
    [MulAction.IsPretransitive Gal(L/K)
      (CompletionPlacesAbove (L := L) v)] :
    (Σ _w : CompletionPlacesAbove (L := L) v,

theorem exists_global_cutoff_eventually_canonical_referenceSlowRow_le :
    ∃ CF Cprod : ℝ, 0 ≤ CF ∧ 0 ≤ Cprod ∧
      ∃ W₀ : ℕ, ∀ W : ℕ, W₀ ≤ W →
      ∀ {delta eta : ℝ} (hdelta : 0 < delta)
        (M : RegularRelativeMesh.Mesh delta eta),

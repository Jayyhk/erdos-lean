    {N : ℕ} [NeZero N] {chi : DirichletCharacter ℂ N}
    {z w rho : ℂ} :
    rho ∈ dirichletExplicitFormulaCandidateSingularities chi z w ↔
      rho ∈ Complex.Rectangle z w ∧

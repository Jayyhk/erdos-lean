    Finset.not_subset.mp hnotSubset
  have hpR : R < (p : ℕ) := by
    apply Nat.lt_of_not_ge
    intro hpLe
    exact hpNotSmall ((mem_primesLEAsPrimes_iff R p).2 hpLe)

absolute value. -/
theorem nonarchimedean_equiv
    {v w : AbsoluteValue K ℝ} (h : v.IsEquiv w) :
    IsNonarchimedean v ↔ IsNonarchimedean w := by
  rw [nonarchimedean_nat_cast,
    nonarchimedean_nat_cast]
  exact forall_congr' fun _ => h.le_one_iff


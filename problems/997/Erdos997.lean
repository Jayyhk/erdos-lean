        (preSievedCoordinateOuterMass (primorial D) R) ^
          (Fintype.card H - 2) := by
      have hsum : ∀ h : H,
          (∑ n ∈
            (if h = x.1.1 ∨ h = x.1.2 then
              squarefreeCoprimePrimeDivisorSupport (primorial D) R x.2

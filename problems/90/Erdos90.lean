theorem compositum_component_normal
    (T : Finset ProThreeComponent)
    (i : {E // E ∈ T}) :
    Normal ℚ ↥(initialProComponent T i) := by
  letI : IsGalois ℚ ↥(initialProComponent T i) :=
    compositum_component_galois T i
  infer_instance


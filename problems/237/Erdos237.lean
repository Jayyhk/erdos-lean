    · rw [if_pos ⟨hdiv, hm⟩, if_pos]
      exact ⟨rightCrossLowerTuple_dvd_iff.mp hdiv, hm⟩
    · rw [if_neg (by exact fun h => hm h.2), if_neg]
      intro h
      exact hm h.2
  · rw [if_neg (by exact fun h => hdiv h.1), if_neg]
    intro h
    exact hdiv (rightCrossLowerTuple_dvd_iff.mpr h.1)


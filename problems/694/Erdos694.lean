    rw [← hbin] at hbb
    have : |ca - cb| < δ := by rw [abs_lt]; constructor <;> nlinarith
    linarith
  · exfalso
    simp [packingKey, ca, cb, ha, hb] at hab
  · exfalso
    simp [packingKey, ca, cb, ha, hb] at hab

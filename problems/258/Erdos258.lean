    (hp : p.Prime) (hpP : p ∉ P) (hP : ∀ q ∈ P, q.Prime) :
    Nat.Coprime p (∏ q ∈ P, q) := by
  rw [Nat.coprime_prod_right_iff]
  intro q hq
  exact (Nat.coprime_primes hp (hP q hq)).2 fun hpq =>
    hpP (hpq ▸ hq)


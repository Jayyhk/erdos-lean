theorem innerB_pos (k : ℕ) (a : ℕ → ℕ) (j : ℕ) : 0 < innerB k a j := by
  unfold innerB
  apply Finset.prod_pos
  intro p hp
  rw [Finset.mem_filter] at hp
  exact Nat.pos_of_ne_zero (pow_ne_zero _ hp.2.ne_zero)

theorem scaffold_prod_pos (k : ℕ) (a : ℕ → ℕ) (j : ℕ) :

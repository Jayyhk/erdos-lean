  classical
  unfold coprimeHarmonicSum
  rw [Finset.sum_filter]
  calc
    (∑ n ∈ Finset.Icc 1 Q,
        if Nat.Coprime n W then (1 : ℝ) / n else 0) =
        ∑ n ∈ Finset.Icc 1 Q, ∑ d ∈ W.divisors,
          if d ∣ n then (ArithmeticFunction.moebius d : ℝ) / n else 0 := by
      apply Finset.sum_congr rfl
      intro n hn

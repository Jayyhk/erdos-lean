/-- The largest change of the scaled radial target in a finite degree block. -/
def maximalRadialShift (N M : ℕ) (x : ℝ) : ℝ :=
  (Finset.range (M + 1)).sup' (Finset.nonempty_range_iff.mpr (by omega))
    (fun m => |(1 + x / (N + m : ℕ)) - (1 + x / N)|)


    dsimp only [t]
    have he : (6 : ℝ) * 3 / (1 / (2 * A ^ ((6 : ℝ)⁻¹))) * p =
        36 * A ^ ((6 : ℝ)⁻¹) * p := by rw [one_div, div_inv_eq_mul]; ring
    rw [he]
    gcongr
  exact Real.rpow_le_rpow (by positivity) hconstant (by linarith)


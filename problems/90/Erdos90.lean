/-- The kernel of the power-class map is exactly `E`, viewed as a subgroup of
`I_(S ∪ T)`. -/
theorem local_class_ker
    (K : Type u) [Field K] [NumberField K]
    (p : ℕ) (S : Finset (NumberFieldPlace K))
    (T : Finset (FinitePrime K)) :

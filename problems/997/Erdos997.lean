noncomputable def vaughanTwistedSumOne
    (U : ℝ) (y q : ℕ) (χ : DirichletCharacter ℂ q) : ℂ :=
  ∑ n ∈ (Finset.Icc 1 y).filter (fun n : ℕ ↦ (n : ℝ) ≤ U),

/-- Projecting after the right-inclusion map on Zassenhaus layer kernels is the identity. -/
@[simp] theorem zLKern.map_snd_compinr (H : Type*) [Group H] (n : ℕ) :
    (zLKern.map p (G × H) (MonoidHom.snd G H) n).comp

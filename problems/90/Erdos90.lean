/-- The natural inclusion `q ↦ Int.ofNat q` is affine. -/
lemma valued_degree_most
    {degreeBound : ℕ}
    (hdegree : 1 ≤ degreeBound) :
    IVMost Int.ofNat degreeBound := by
  refine ⟨Polynomial.X, ?_, ?_⟩
  · simpa only [Polynomial.natDegree_X] using hdegree
  · intro q
    simp only [Polynomial.eval_X, Int.ofNat_eq_natCast, Int.cast_natCast]


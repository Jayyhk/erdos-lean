  carrier := {a |
    (∀ P, a.1 P ∈ IdeleUnitSubgroup (OK_v128 K) K P) ∧
    (∀ P, P ∈ T →
      a.1 P ∈ (finiteCompletionNorm (K := K) (L := L) P (Q P)).range)}
  one_mem' := by
    exact ⟨fun P ↦ (IdeleUnitSubgroup (OK_v128 K) K P).one_mem,
      fun P _ ↦ (finiteCompletionNorm (K := K) (L := L) P (Q P)).range.one_mem⟩

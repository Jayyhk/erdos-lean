/-! ## Erdős Problem 90 -/

open LeanEval.Combinatorics

/-- `νn n` is the largest number of unit distances realised by `n` points of the plane,
matching the `ν(n)` of the problem statement. -/
noncomputable def νn (n : ℕ) : ℕ :=
  sSup {k | ∃ P : Finset (EuclideanSpace ℝ (Fin 2)), P.card = n ∧ unitDist P = k}

private lemma unitDist_le_card_mul_card (P : Finset (EuclideanSpace ℝ (Fin 2))) :
    unitDist P ≤ P.card * P.card := by
  unfold unitDist
  refine le_trans (Nat.div_le_self _ 2) ?_
  refine le_trans (Finset.card_filter_le _ _) ?_
  rw [Finset.offDiag_card]
  exact Nat.sub_le _ _

private lemma bddAbove_unitDist (n : ℕ) :
    BddAbove {k | ∃ P : Finset (EuclideanSpace ℝ (Fin 2)), P.card = n ∧ unitDist P = k} := by
  refine ⟨n * n, ?_⟩
  rintro k ⟨P, hcard, rfl⟩
  simpa [hcard] using unitDist_le_card_mul_card P

private lemma unitDist_le_νn (P : Finset (EuclideanSpace ℝ (Fin 2))) :
    unitDist P ≤ νn P.card :=
  le_csSup (bddAbove_unitDist _) ⟨P, rfl, rfl⟩

/-- The `n^(1+o(1))` form of the conjecture is false.

`Submission.erdos_unit_distance_conjecture_false` is the lean-eval challenge statement,
proved here without assumptions: it produces a `δ > 0` and, above every `N`, an `n`-point
set with at least `n^(1+δ)` unit distances.  Taking `ε = δ` in the conjecture contradicts
that. -/
private lemma nu_not_subpolynomial :
    ¬ ∀ ε : ℝ, 0 < ε →
        ∀ᶠ n in Filter.atTop, (νn n : ℝ) < (n : ℝ) ^ (1 + ε) := by
  intro hconj
  obtain ⟨δ, hδ, hinf⟩ := Submission.erdos_unit_distance_conjecture_false
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp (hconj δ hδ)
  obtain ⟨n, P, hNn, hcard, hlow⟩ := hinf N
  have hle : unitDist P ≤ νn n := by
    have h := unitDist_le_νn P
    rwa [hcard] at h
  have h1 : (n : ℝ) ^ (1 + δ) ≤ (νn n : ℝ) := hlow.trans (by exact_mod_cast hle)
  exact absurd h1 (not_le.mpr (hN n hNn))

/-- **Erdos problem 90** (disproved).

Erdos conjectured in 1946 that every set of `n` distinct points in the plane spans at most
`n^(1+O(1/log log n))` pairs at distance one -- that is, that the lattice construction is
best possible.  This is false.

It follows from the sharper failure of the `n^(1+o(1))` bound (`nu_not_subpolynomial`):
that supplies a fixed `δ > 0` which is exceeded infinitely often, whereas `C / log log n`
tends to `0` and so eventually falls below `δ`, for any constant `C`. -/
theorem erdos_90 :
    ¬ ∃ C : ℝ, 0 < C ∧ ∀ᶠ n in Filter.atTop,
        (νn n : ℝ) ≤ (n : ℝ) ^ (1 + C / Real.log (Real.log n)) := by
  rintro ⟨C, hC, hub⟩
  refine nu_not_subpolynomial (fun ε hε => ?_)
  have hll : Filter.Tendsto (fun n : ℕ => Real.log (Real.log n)) Filter.atTop Filter.atTop :=
    Real.tendsto_log_atTop.comp (Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop)
  have hsmall : ∀ᶠ n : ℕ in Filter.atTop, C / Real.log (Real.log n) < ε := by
    filter_upwards [hll.eventually_gt_atTop (C / ε), hll.eventually_gt_atTop 0] with n hn hpos
    rw [div_lt_iff₀ hpos]
    have h : C / ε * ε < Real.log (Real.log n) * ε := by nlinarith
    calc C = C / ε * ε := by field_simp
      _ < Real.log (Real.log n) * ε := h
      _ = ε * Real.log (Real.log n) := by ring
  have hn1 : ∀ᶠ n : ℕ in Filter.atTop, (1 : ℝ) < (n : ℝ) := by
    filter_upwards [Filter.eventually_gt_atTop 1] with n hn
    exact_mod_cast hn
  filter_upwards [hub, hsmall, hn1] with n hn hs h1
  calc (νn n : ℝ) ≤ (n : ℝ) ^ (1 + C / Real.log (Real.log n)) := hn
    _ < (n : ℝ) ^ (1 + ε) := by
        apply (Real.rpow_lt_rpow_left_iff h1).mpr
        linarith


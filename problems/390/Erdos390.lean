    (Nat.coprime_primes hp hrPrime).mpr hrEraseP.1.symm
  have hqr : Nat.Coprime q r :=
    (Nat.coprime_primes hq hrPrime).mpr hrEraseQ.1.symm
  unfold pairPower
  exact (hpr.pow_left a).mul_left (hqr.pow_left b)


/-- A representative one level deeper than its associated-graded layer maps
to zero. -/
lemma lower_class_succ
    {G : Type*}
    [Group G]
    (layer : ℕ)
    (element : Subgroup.lowerCentralSeries G layer)
    (helement :
      (element : G) ∈ Subgroup.lowerCentralSeries G (layer + 1)) :
    TBluepr.lowerCentralClass layer element = 0 := by
  change TBluepr.lowerClassHom layer element = 1
  exact (QuotientGroup.eq_one_iff _).mpr helement

/-- A concrete strict-tail slot above the next physical layer vanishes after
projection to the parent associated-graded layer. -/
lemma address_slot_parent
    {d n : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (word : CWord (HEAddres H))
    (hword :
      x.weight PEAddres.weight +
              y.weight PEAddres.weight +
            z.weight PEAddres.weight + 1 <
        word.weight PEAddres.weight) :
    addressSlotClass
        (n := n) x y z word = 0 := by
  unfold addressSlotClass
  rw [dif_pos (by omega)]
  apply lower_class_succ
  exact
    Subgroup.lowerCentralSeries_antitone (by omega)
      (CWord.eval_lower_series
        (PEAddres.freeLowerTruncation
          (n := n))
        PEAddres.weight
        PEAddres.weight_pos
        PEAddres.free_truncation_series
        word)

/-- If the three signed substitution roots weigh at least `inputWeight`, then
all six substituted Hall-Witt labels do too. -/
lemma input_signed_substitution
    {β : Type*}
    (wt : β → ℕ)
    (x y z : CWord β)
    (inputWeight : ℕ)
    (hx : inputWeight ≤ x.weight wt)
    (hy : inputWeight ≤ y.weight wt)
    (hz : inputWeight ≤ z.weight wt) :
    ∀ atom,
      inputWeight ≤ (signedWordSubstitution x y z atom).weight wt := by
  intro atom
  rw [weight_signed_substitution]
  rcases atom with atom | atom
  · refine Fin.cases ?_ (fun atom => ?_) atom
    · change
        inputWeight ≤
          signedWeight (x.weight wt) (y.weight wt) (z.weight wt) xAtom
      simpa only [signedWeight_x] using hx
    · refine Fin.cases ?_ (fun atom => ?_) atom
      · change
          inputWeight ≤
            signedWeight (x.weight wt) (y.weight wt) (z.weight wt) xInvAtom
        simpa only [signed_x_inv] using hx
      · refine Fin.cases ?_ (fun atom => ?_) atom
        · change
            inputWeight ≤
              signedWeight (x.weight wt) (y.weight wt) (z.weight wt) zAtom
          simpa only [signedWeight_z] using hz
        · exact
            Fin.cases
              (by
                change
                  inputWeight ≤
                    signedWeight (x.weight wt) (y.weight wt) (z.weight wt)
                      zInvAtom
                simpa only [signed_z_inv] using hz)
              (fun atom => Fin.elim0 atom) atom
  · refine Fin.cases ?_ (fun atom => ?_) atom
    · change
        inputWeight ≤
          signedWeight (x.weight wt) (y.weight wt) (z.weight wt) yAtom
      simpa only [signedWeight_y] using hy
    · exact
        Fin.cases
          (by
            change
              inputWeight ≤
                signedWeight (x.weight wt) (y.weight wt) (z.weight wt)
                  yInvAtom
            simpa only [signed_y_inv] using hy)
          (fun atom => Fin.elim0 atom) atom

/-- Positive scalar coordinates of one physical Hall-address word satisfy
their own physical repeated-block degree bound. -/
lemma address_natural_physical
    {d : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    (x y z : CWord (HEAddres H))
    (cutoff inputWeight : ℕ)
    (hcutoff : 3 < cutoff)
    (hinputWeight : 0 < inputWeight)
    (hx : inputWeight ≤ x.weight PEAddres.weight)
    (hy : inputWeight ≤ y.weight PEAddres.weight)
    (hz : inputWeight ≤ z.weight PEAddres.weight)
    (word : CWord (HEAddres H)) :
    IVMost
      (addressNaturalSlot
        x y z cutoff word)
      (word.weight PEAddres.weight / inputWeight) := by
  unfold addressNaturalSlot
  unfold filteredSlotExpansion
  exact
    natural_bind_physical
      PEAddres.weight (signedWordSubstitution x y z)
        cutoff inputWeight hcutoff hinputWeight
          (input_signed_substitution
            PEAddres.weight x y z inputWeight hx hy hz)
        word


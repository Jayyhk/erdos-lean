        BoundedGaps.Maynard.maxProgressionDiscrepancy z d := by
  have hdpos : 0 < d :=
    Nat.pos_of_dvd_of_pos hd (residualSieveProduct_pos y m)
  let hcop := cofactor_coprime_of_dvd_residualSieveProduct hd

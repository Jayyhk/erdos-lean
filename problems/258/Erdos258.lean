    intro a ha b hb hab
    have haData := Finset.mem_filter.mp ha
    have hbData := Finset.mem_filter.mp hb
    have haMul : p * (a / p) = a := Nat.mul_div_cancel' haData.2.2.2
    have hbMul : p * (b / p) = b := Nat.mul_div_cancel' hbData.2.2.2

    (pow_pos (by norm_num : (0 : ℝ) < 2) (Nat.log 2 X + 1)) hpowReal
  rw [Real.log_pow] at hlog
  rw [dyadicExponentRange, Finset.card_range]
  exact (le_div_iff₀ (Real.log_pos (by norm_num))).2 hlog


theorem chosen_crossed_compatibility
    (completion : HasseCompletionData K L)
    (v : InfinitePlace K)
    (c : NMCocycl₂ (G := Gal(L/K)) (M := Lˣ)) :
    ((((resizedChosen2
          K L completion (.inr v)).symm
        (resizedGlobalChosen
          (K := K) (L := L) completion (.inr v)
          (relativeBrauerResized K L
            (Additive.ofMul

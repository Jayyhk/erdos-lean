        (Cmass / density) / B.L := by
  intro m
  let Tpost :=
    bankPaperCanonicalSectionNinePostHeightTarget B I hlo hhi H
  let qn := bankPaperCanonicalSectionNinePostHeightActiveMass q0 d
  let cell := B.sampleData.cellOf m

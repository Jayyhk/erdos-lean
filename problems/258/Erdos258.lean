    {K : ℕ} (m : nearShifts K) {P : Finset ℕ} (hcard : P.card ≤ 4)
    (hPprime : ∀ p ∈ P, p.Prime)
    (hPcut : ∀ p ∈ P, tinyCutoff K < p)
    (hPradius : ∀ p ∈ P, shiftRadius K m ≤ p)
    (hPsep : ∀ p ∈ P, ∀ h : nearShifts K,

  letI :
      Module.Finite
        ℤ
        (NumberField.RingOfIntegers L ⧸ P ^ e) := hfinZ
  letI :
      Module.Finite
        (ℤ ⧸ Ideal.rationalPrimeIdeal r)
        (NumberField.RingOfIntegers L ⧸ P ^ e) :=
    @Module.Finite.of_restrictScalars_finite
      ℤ

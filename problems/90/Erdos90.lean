theorem PSRel.infinite
    {p d k : ℕ} {Q : Type u} [Group Q]
    (S : PSRel p d k Q)
    (c : StrictGSParameters d)
    (_hkTwo : 2 ≤ k)
    (hk : CuttingTailBound c k) :
    Infinite Q := by
  apply not_finite_iff_infinite.mp
  intro hfinite
  letI : Finite Q := hfinite

noncomputable def inflationCoordinateAction
    (alpha : Gal(F/K)) (a : F) (rho : Gal(F/K)) :
    E →ₗ[K] (Gal(F/K) →₀ E) :=
  (Finsupp.lsingle (R := K) (M := E) (rho * alpha)).comp
    (LinearMap.mulRight K
      (concreteInflationCoefficient (E := E) K c alpha rho a))


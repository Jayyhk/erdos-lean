lemma ArcCrossingSegmentOccurrenceParameters
    (γ : PolygonalArc) (α : PolygonalPath)
    (i : ℕ) (hi : i + 1 < α.vertices.length) :
    Set.Finite (α.carrier ∩ γ.carrier) →
      (∀ v : EuclideanSpace ℝ (Fin 2), v ∈ α.vertices → v ∉ γ.carrier) →
        ∃ params : List ℝ,
          params.Nodup ∧
            params.SortedLT ∧

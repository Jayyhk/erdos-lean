  have hq_dvd : q ∣ a := by
    refine ⟨(blockCoordinates a).core * (blockCoordinates a).left, ?_⟩
    calc
      a = (blockCoordinates a).core * (blockCoordinates a).left * q :=
        blockCoordinates_value haData
      _ = q * ((blockCoordinates a).core * (blockCoordinates a).left) := by
        ring

structure FSBound
    (p d k : ℕ) (Q : Type u) [Group Q] where
  fp : FPres.{u} p
  [fact_prime : Fact p.Prime]
  [finite_gen : Finite fp.Gen]
  [fintype_relator : Fintype fp.toPresentation.Relator]
  groupEquiv : fp.Group ≃* Q

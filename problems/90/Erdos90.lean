    (right : Fin R.linear.rightDegree ↪o Fin N) :
    PolynomialEquivalent (R.instantiate left right) R := by
  constructor
  · simp [instantiate, blockRecipe, BRecipe.ofLinear]
  constructor
  · simp [instantiate, blockRecipe, BRecipe.ofLinear]
  · simp [instantiate, blockRecipe, BRecipe.erased_shape_linear]


      1 / Real.pi *
        (∫ t in -T..T,
          perronEnvelope
              (Real.log (2 * (((m0 + M) * (n0 + N) : ℕ) : ℝ))) t *
            ∑ q ∈ Finset.Ioc 0 Q,

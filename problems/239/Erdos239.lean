      -(∑' p, (g p).re) ≤ ∑' p, ‖g p‖ := by
    calc
      -(∑' p, (g p).re) = ∑' p, -(g p).re := by rw [tsum_neg]
      _ ≤ ∑' p, ‖g p‖ := by
        apply Summable.tsum_le_tsum
        · intro p
          exact (neg_le_abs (g p).re).trans (Complex.abs_re_le_norm (g p))
        · exact (Complex.hasSum_re hg.hasSum).summable.neg
        · exact hg.norm

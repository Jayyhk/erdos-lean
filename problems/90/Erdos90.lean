  hpacketed.collapsedPacketed.collapsed_list_realization x y

/-- One Cartesian correction grid is a singleton canonical packet endpoint. -/
lemma correctionGrid
    {M N K : ℕ}
    {B A : BFam M N}
    {left right : List (DFTerm M N K)}
    (hleft : RPFor B left)
    (hright : RPFor A right) :
    RPBy [B.correction A]

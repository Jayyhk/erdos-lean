    toIsLocalRing := inferInstance
    is_henselian := by
      intro p hp a ha hpa
      exact @HenselianRing.is_henselian (Valued.integer K) _
        (maximalIdeal (Valued.integer K))
        (IsAdicComplete.henselianRing (Valued.integer K)
          (maximalIdeal (Valued.integer K)))

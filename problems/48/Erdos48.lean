    DirichletCharacter.LFunction chi s ≠ 0 := by
  have hs1 : s ≠ 1 := by
    intro h
    have hre := congrArg Complex.re h
    simp only [one_re] at hre
    rw [hs] at hre
    have hN : (0 : ℝ) ≤ N := Nat.cast_nonneg N

        Finset.sum_union] <;> norm_num [
      hj0, hi0₁]; all_goals grind;
    · rw [show
          (Finset.filter (fun j => I' j = h) Finset.univ) =
            Finset.filter (fun j => I j = h) Finset.univ \ { j0 }
          from ?_,
        Finset.sum_eq_sum_sdiff_singleton_add
          (show j0 ∈ Finset.filter (fun j => I j = h) Finset.univ from
            Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj0⟩)]
      · aesop
      · grind
  have hI'_potential :
      (∑ j ∈ Finset.filter (fun j => I j = i0) Finset.univ, (s j : ℝ)) < (min ω 1 / 16) * n := by
    have hI'_potential :
        (∑ j ∈ Finset.filter (fun j => I j = i0) Finset.univ, (s j : ℝ)) +
            (∑ j ∈ Finset.filter (fun j => I j = h) Finset.univ, (s j : ℝ)) ≤
          (n - 1 : ℝ) := by
      have hI'_potential :
          (∑ j ∈ Finset.filter (fun j => I j = i0) Finset.univ, (s j : ℝ)) +
              (∑ j ∈ Finset.filter (fun j => I j = h) Finset.univ, (s j : ℝ)) ≤
            (∑ j, (s j : ℝ)) := by

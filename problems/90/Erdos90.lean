/-- Enumerate subsequences of a packet-substituted word one source packet at
a time.  Duplicate entries are retained: they record distinct ordered
embeddings. -/
def packetSubsequenceExpansions
    {α β : Type*}
    (packet : α → List β) :
    List α → List (List β)
  | [] =>
      [[]]
  | item :: items =>
      (packetSubsequenceExpansions packet items).flatMap fun suffix =>
        (packet item).sublists.map fun head =>
          head ++ suffix


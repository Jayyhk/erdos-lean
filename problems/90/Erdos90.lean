          let nextNormalizer :=
            builder.semanticCoordinateNormalizer
              hn hinputWeight hrecipes (lowerWeight + 1)
          by_cases hfactorStrict :
              lowerWeight <
                factor.word.weight PEAddres.weight
          · exact

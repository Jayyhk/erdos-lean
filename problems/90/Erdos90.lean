    kernel.raw
  flat_programs_coalesce M N :=
    (flat_program
      (guardedSchedulerProgram
        (multiplicityProfileShape
          kernel.raw)
        M N)).symm.trans
      ((kernel.program_coalesces_schedule M N).trans

open _root_.ProbabilityTheory in
private theorem _root_.ProbabilityTheory.ballRadialAux_eq_tsum_integrals (n : ℕ) (t : ℝ) :
    ballRadialAux n t = ballGaussianNormalization n *
      ∑' k, ∫ θ in (0 : ℝ)..Real.pi / 2,
        ballRadialAuxSeriesIntegrand n t k θ := by
  rw [ballRadialAux]
  congr 1

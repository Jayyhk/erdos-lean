    (cutoff : ℕ)
    (hcutoff : 3 < cutoff)
    (slot : CWord Atom)
    (coefficient : ℤ) :
    0 ≤
      (strictSlotExpansion cutoff slot).eval coefficient := by
  rw [eval_slot_expansion
    cutoff hcutoff slot coefficient]

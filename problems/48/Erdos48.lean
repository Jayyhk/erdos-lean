            ((sigma : ℂ) + rho.im * I)).re +
          (logDeriv (DirichletCharacter.LFunction (chi ^ 2))
            ((sigma : ℂ) + ((2 * rho.im : ℝ) : ℂ) * I)).re := by
    nlinarith

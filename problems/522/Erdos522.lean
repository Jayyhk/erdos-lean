    ext y
    constructor
    · rintro ⟨⟨z, ⟨x, hx, hzx⟩⟩, -, rfl⟩
      refine ⟨x, hx, ?_⟩
      subst z
      simp [g, linearRangeReparam, e]
    · rintro ⟨x, hx, rfl⟩
      refine ⟨⟨e x, ⟨x, hx, rfl⟩⟩, Set.mem_univ _, ?_⟩
      simp [g, linearRangeReparam, e]

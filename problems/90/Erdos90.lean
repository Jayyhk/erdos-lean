  | add x y hx hy =>
      calc
        augmentation G ((Rep.leftRegular ℤ G).ρ g (x + y)) =
            augmentation G ((Rep.leftRegular ℤ G).ρ g x +
              (Rep.leftRegular ℤ G).ρ g y) :=
          congrArg (augmentation G) (map_add _ x y)

  constructor
  · intro label hlabelMem hactive
    calc
      (∑ a ∈ R.roughCanonicalGuardedRow certificate deltaStar K label,
          bankPaperCanonicalTopFrozenRoundedSourceSelector (K := K)
            B R certificate T deltaStar betaProt alpha betaTotal

    have hdeltaLtC : delta < c :=
      hdeltaNear.trans_le (mul_le_of_le_one_right hcPos.le hqPowLeOne)
    have hbeta1Half : 1 / 2 < beta1 := by
      have hbase : 1 - c ≤

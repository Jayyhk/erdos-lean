    (A : Matrix (Fin (N + 1)) (Fin (N + 1)) ℂ)
    (q : SignVector N × AddCircle (1 : ℝ)) : ℂ :=
  complexQuadraticSignSum (fun i j => A i j * fourier ((i : ℤ) - (j : ℤ)) q.2) q.1


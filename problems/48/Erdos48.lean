                (960000000000 * (L : ℝ) ^ 4) := by
        have hk : (((120 * L - 6 : ℕ) : ℝ)) ≤
            120 * (L : ℝ) := by
          exact_mod_cast (Nat.sub_le (120 * L) 6)
        let F : ℝ :=
          2 * A * C * (240 * (L : ℝ)) * (Real.log 2)⁻¹ *
            Real.log (n : ℝ) ^ 2 * (n : ℝ) ^ (1 / 4 : ℝ) *
              (Real.sqrt (n : ℝ))⁻¹
        calc
          C * (n : ℝ) ^ (1 / 4 : ℝ) *
                ((((120 * L - 6 : ℕ) : ℝ) * Real.log (n : ℝ)) /
                  Real.log 2 * (2 * (A / Real.sqrt (n : ℝ)))) *

    rw [hsqrtU, ← vaughanCubeRoot_cube x]
    field_simp [ne_of_gt hcpos, ne_of_gt hsqrtqpos]
  have hcollect :
      vaughanPrimitiveMeanAlgebraicScale
          (vaughanCubeRoot x ^ 2 / q)

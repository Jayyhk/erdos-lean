          [MOD divisorPairModulus H W d e] ∧ (n + h).Prime) := by
    constructor
    · rintro ⟨hres, hpair, hprime⟩
      exact ⟨(modEq_divisorPairCrtResidue_iff hd he hcross n).mpr
          ⟨hres, hpair⟩, hprime⟩
    · rintro ⟨hmod, hprime⟩
      obtain ⟨hres, hpair⟩ :=

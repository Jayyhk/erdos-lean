    simpa using Real.exp_monotone hKnonneg
  have hthree : (3 : ℝ) ≤ 3 * Real.exp K := by nlinarith
  have hM : 1 ≤ M := by
    calc
      (1 : ℝ) ≤ 3 * ‖riemannZeta₁ c‖ := honeCenter
      _ ≤ (3 * Real.exp K) * ‖riemannZeta₁ c‖ :=

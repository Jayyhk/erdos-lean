  have hj : Summable (fun j : ℕ => (j : ℝ) * (1 / 2 : ℝ) ^ j) :=
    (hasSum_coe_mul_geometric_of_norm_lt_one hrnorm).summable
  have hg : Summable (fun j : ℕ => (1 / 2 : ℝ) ^ j) :=
    summable_geometric_two
  have hsplit : (fun j : ℕ => ((j + 2 : ℕ) : ℝ) * (1 / 2 : ℝ) ^ j) =
      fun j : ℕ => (j : ℝ) * (1 / 2 : ℝ) ^ j +

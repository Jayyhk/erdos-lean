        Real.sqrt (∑ i ∈ S, E i) := by
  have hcauchy := Real.sum_mul_le_sqrt_mul_sqrt S
    (fun i => w i * Real.sqrt (E i)) (fun i => Real.sqrt (E i))
  have hfirst :
      (∑ i ∈ S, (w i * Real.sqrt (E i)) ^ 2) ≤
        X * ∑ i ∈ S, (w i) ^ 2 / φ i := by
    calc
      (∑ i ∈ S, (w i * Real.sqrt (E i)) ^ 2) =
          ∑ i ∈ S, (w i) ^ 2 * E i := by
        apply Finset.sum_congr rfl
        intro i hi

            (B.nuisanceResidualScore (B.effectiveParamEquiv z)
              (B.canonicalEffectiveNuisanceGamma_pos
                I U (3 * (a : ℝ)) T)
              (B.canonicalEffectiveNuisanceGap_on_closedBall I a hU

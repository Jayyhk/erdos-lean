@[simp] theorem completed_prefix_rank
    (p : ℕ) [Fact p.Prime] (Q : Type u) [Group Q] :
    completedPrefixRank p Q 0 = 1 := by
  simp [completedPrefixRank,
    GroupAlgebra.augmentation_rank_zero]


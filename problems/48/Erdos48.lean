theorem coverQuotient_dvd_term (D : CoverFactorization n k) {i : ℕ} (hi : i < k) :
    (n - i) / D.g i ∣ n - i := by
  exact Nat.div_dvd_of_dvd (D.divides_term i hi)

/-- Residual factors supported on distinct shifts are coprime as soon as all

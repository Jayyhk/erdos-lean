    ‖(∑ i ∈ s, (weight i : ℂ) * correction i) - 1‖ ≤ ε := by
  have hsumComplex :
      (∑ i ∈ s, (weight i : ℂ)) = 1 := by
    exact_mod_cast hsum
  have hrecenter :
      (∑ i ∈ s, (weight i : ℂ) * correction i) - 1 =
        ∑ i ∈ s,
          (weight i : ℂ) * (correction i - 1) := by
    calc

  intro h
  have hN := N.2 h
  have hN' := congrArg Prod.fst hN
  change C.ρ h N.1.1 + splittingTwist C φ h N.1.2 = N.1.1 at hN'
  rw [hN₂, map_zero, add_zero] at hN'
  exact hN'


def modularBowenPairs (η δ : ℝ) : Set (ModularOrbitSpace × ModularOrbitSpace) :=
  {z | ∃ g h : SL(2, ℝ), z = (modularMk g, modularMk h) ∧ EntryBowenTube η δ (g⁻¹ * h)}


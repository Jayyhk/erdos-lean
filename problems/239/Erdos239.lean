    have hsle : ((X % g : ℕ) : ℝ) / g ≤ 1 :=
      (div_le_one hgReal).mpr (by exact_mod_cast hslt.le)
    calc
      (A.card : ℝ) * (X % g : ℕ) / g =
          (A.card : ℝ) * (((X % g : ℕ) : ℝ) / g) := by ring
      _ ≤ (A.card : ℝ) * 1 := by gcongr
      _ = A.card := by ring

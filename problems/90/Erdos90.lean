      (localClassSubgroup K n hn hζ).carrier := by
    intro x hx
    simp [localClassSubgroup]
  have hLM : L.carrier ≤ M.carrier := kummerField_mono hn hsub
  let rL := cyclicKummerRadical K n hn hζ a
  let rM := localRadicalEquiv K n hn hζ a
  let sigma := fullKummerArtin K n hn hζ b
  have hartin :
      galoisRestrictionHom K (F := LF) (E := MF) hLM sigma =
        cyclicKummerArtin K n hn hζ a b := by
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective
      (powMonoidHom n : Kˣ →* Kˣ).range b

            mul_le_mul_of_nonneg_left hinv hdNonneg
          _ = (d.divisors.card : ℝ) / (d : ℝ) ^ 2 := by ring
      · rw [if_neg hsq]
        positivity
    _ ≤ 4 := sum_card_divisors_div_sq_le_four Q

end


  rw [fourFiveLastPrimeFiber_eq_primeInterval
    (fourFiveOrderedPrimePrefix_prod_pos hq)]
  exact Erdos390.WholePaper.SafePrimeCounting.prime_Ioc_card_eq_primeCounting_sub hLU


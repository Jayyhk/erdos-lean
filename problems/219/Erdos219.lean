    {κ : Type*} [Fintype κ]
    (χ : SmoothSieveCutoff) :
    Integrable
      (χ.cutoffNormalizerSeparatedProduct :
        ((κ → ℝ) × (κ → ℝ)) → ℂ)
      (volume.prod volume) := by
  let e :=
    MeasurableEquiv.arrowProdEquivProdArrow ℝ ℝ κ

    (inputWeight k : ℕ)
    (hk : 0 < k) :
    PBRecipe inputWeight where
  indices := [k]
  indices_pos := by
    intro j hj
    simp only [List.mem_singleton] at hj
    simpa [hj] using hk
  outputWeight := inputWeight * k
  weighted_degree_le := by simp


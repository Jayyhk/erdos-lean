namespace TCTex

namespace CCExpans

/-- Normalized endpoint factors in weights strictly above `lowerWeight`. -/
def tailFactors
    {d n inputWeight : ℕ}
    {H : ∀ s : ℕ, BCWta.{u} d s}
    (R : CCExpans H inputWeight)
    (lowerWeight : ℕ) :
    List (SPFactora H inputWeight) :=
  (List.range' lowerWeight (n - 1 - lowerWeight)).flatMap fun s =>
    R.weightFactors (s + 1)


          (MulEquiv.prodAssoc (M := G) (N := H) (P := K)).toMonoidHom x) = x := by
  refine QuotientGroup.induction_on x ?_
  intro a
  rcases a with ⟨ab, c⟩
  rcases ab with ⟨a, b⟩

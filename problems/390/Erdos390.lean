          (∑ q : BandPrime B.sampleData.n B.sampleData.W,
            |B.primeDeviation q *
              covarianceKernel
                (tPrime B.sampleData.n p.1)
                (tPrime B.sampleData.n q.1) /
                  ((p.1 : ℝ) * (q.1 : ℝ))|) ≤
            ∑ q : BandPrime B.sampleData.n B.sampleData.W,
              (tPrime B.sampleData.n p.1 / (p.1 : ℝ)) *
                (CKernel *

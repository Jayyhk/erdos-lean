  have huPositive : 0 < u h :=
    Nat.pos_of_ne_zero huSquarefree.ne_zero
  exact ⟨Finset.mem_range.mpr huBounds.2,
    ⟨huPositive, ⟨huSquarefree, huSupport.coordinate_coprime_W h⟩⟩⟩


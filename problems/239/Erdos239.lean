def ScaledRationalApproximation (α : ℝ) (Q : ℕ) (a : ℤ) (q : ℕ) : Prop :=
  0 < q ∧ q ≤ Q ∧ |(q : ℝ) * α - (a : ℝ)| ≤ 1 / ((Q : ℝ) + 1)

/-- The usual unscaled form `|α-a/q| ≤ δ`. -/
def RationalApproximation (α : ℝ) (a : ℤ) (q : ℕ) (δ : ℝ) : Prop :=
  0 < q ∧ |α - (a : ℝ) / (q : ℝ)| ≤ δ


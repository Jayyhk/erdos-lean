  simp [indexMoment, div_eq_mul_inv, mul_comm]

theorem indexMoment_one (N : ℕ) (hN : 0 < N) :
    indexMoment N 1 = ((N : ℝ) + 1) / (2 * N) := by
  have hn : (N : ℝ) ≠ 0 := by exact_mod_cast hN.ne'
  simp only [indexMoment, pow_one]
  rw [← Finset.sum_div, sum_index]
  field_simp


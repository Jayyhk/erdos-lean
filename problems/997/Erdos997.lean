  simpa [goldfeldShiftedLFunctionDividedSlope, smul_eq_mul] using
    (sub_smul_dslope_of_zero (f := fun z : ℂ =>
      DirichletCharacter.LFunction chi1 (z + (beta : ℂ)))
      (a := (0 : ℂ)) (by simpa using hzero) s)


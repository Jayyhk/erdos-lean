  haveI : C.Normal := by
    dsimp [C]
    infer_instance
  haveI : Ha.Normal := by
    dsimp [Ha]
    infer_instance
  haveI : Hb.Normal := by
    dsimp [Hb]
    infer_instance
  haveI : La.Normal := by
    dsimp [La]
    infer_instance
  haveI : Lb.Normal := by
    dsimp [Lb]
    infer_instance
  haveI : K.Normal := by
    dsimp [K]
    infer_instance
  have hLb_commute
      {x : G} (hx : x ∈ Lb) (g : G) :
      Commute (q x) (q g) := by
    rw [← commutatorElement_eq_one_iff_commute,
      ← map_commutatorElement]
    apply (QuotientGroup.eq_one_iff _).mpr
    apply (show ⁅Lb, (⊤ : Subgroup G)⁆ ≤ K by
      simp [K, relativePowerCommutator])
    exact Subgroup.commutator_mem_commutator hx trivial

    have hpge : k ≤ p := hrough i hi p hp hpqi
    omega
  intro i hi j hj hij
  rcases lt_or_gt_of_ne hij with hij' | hji
  · exact ordered i hi j hj hij'
  · exact (ordered j hj i hi hji).symm


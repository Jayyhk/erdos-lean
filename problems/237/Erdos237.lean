theorem norm_vaughanThirdCoefficient_le_log
    (U V : ℝ) (t : ℕ) :
    ‖((vaughanThirdCoefficient U V t : ℝ) : ℂ)‖ ≤ Real.log t := by
  rw [Complex.norm_real, Real.norm_eq_abs]

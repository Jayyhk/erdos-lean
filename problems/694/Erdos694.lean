      2 * L / (T * Real.log (4 / 3 : ℝ)) *
        (∑ m ∈ sm, ‖a m‖) * (∑ n ∈ sn, ‖b n‖) := by
  classical
  let s := sm ×ˢ sn
  let r : ℕ × ℕ → ℕ := fun x => x.1 * x.2
  let c : ℕ × ℕ → ℂ := fun x => a x.1 * b x.2 * χ (x.1 * x.2)

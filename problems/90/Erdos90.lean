  have hOdd₁ := card_unit_iso
    (cyclicOddIso X.X₁ g hg)
  have hEven₁ := card_unit_iso
    (cyclicEvenIso X.X₁ g hg)
  have hOdd₂ := card_unit_iso
    (cyclicOddIso X.X₂ g hg)
  have hEven₂ := card_unit_iso
    (cyclicEvenIso X.X₂ g hg)
  have hOdd₃ := card_unit_iso
    (cyclicOddIso X.X₃ g hg)
  have hEven₃ := card_unit_iso
    (cyclicEvenIso X.X₃ g hg)
  simpa only [herbrandQuotient, hOdd₁, hEven₁, hOdd₂, hEven₂, hOdd₃, hEven₃]

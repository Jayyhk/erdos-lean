  have hballRect : Metric.closedBall rho R ⊆ Complex.Rectangle z w :=
    (hcontained rho hrho).trans interior_subset
  by_cases hchi : chi = 1
  · subst chi
    by_cases hrhoOne : rho = 1
    · subst rho

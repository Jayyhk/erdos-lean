    {q : IntegralFormOrbits d} {g : SL(2, ℝ)}
    (hg : modularMk g ∈ (packetOrbit hd hns q).carrier) {u v : ℤ} (huv : u ≠ 0 ∨ v ≠ 0) :
    2 ≤ Real.sqrt (d : ℝ) * modularVectorLengthSq g u v := by
  obtain ⟨t, _, ht⟩ := integral_form_of_mem_packet_carrier hd hns hg

  let a : ℕ → ℂ := twistVonMangoldt chi
  have hxPos : 0 < x := zero_lt_one.trans hx
  have halphaOne : 1 < alpha := one_lt_perronAbscissa hx
  have halpha : 0 < alpha := zero_lt_one.trans halphaOne

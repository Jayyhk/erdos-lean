    (IsCompact.bddAbove_image isCompact_Icc hcont)
  let C : ℝ := max c 0 + 1
  have hC : 0 < C := by
    dsimp [C]
    linarith [le_max_right c 0]
  refine ⟨C, hC, ?_⟩

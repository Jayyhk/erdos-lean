    · simp [P, e, Matrix.Module.smul_apply, hr]
  have hfP : f e = P • f e := by
    calc
      f e = f (P • e) := congrArg f hPe.symm
      _ = P • f e := LinearMap.map_smul f P e
  have hfi (r : ι) : f e r = if r = j then d else 0 := by
    rw [hfP]
    by_cases hr : r = j

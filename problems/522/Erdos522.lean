theorem indexMoment_quadratic_lower (N : ℕ) (hN : 0 < N) (x y : ℝ) :
    (x ^ 2 + y ^ 2) / 16 ≤
      indexMoment N 0 * x ^ 2 + 2 * indexMoment N 1 * x * y + indexMoment N 2 * y ^ 2 := by
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  have hn0 : (N : ℝ) ≠ 0 := hn.ne'

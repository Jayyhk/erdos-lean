theorem quadratic_nonneg_of_minor {a b c : ℝ} (ha : 0 < a)
    (hdet : 0 ≤ a * c - b ^ 2) (x y : ℝ) :
    0 ≤ a * x ^ 2 + 2 * b * x * y + c * y ^ 2 := by
  have hp : 0 ≤ (a * x + b * y) ^ 2 + (a * c - b ^ 2) * y ^ 2 := by positivity
  have he : a * (a * x ^ 2 + 2 * b * x * y + c * y ^ 2) =
      (a * x + b * y) ^ 2 + (a * c - b ^ 2) * y ^ 2 := by ring
  nlinarith


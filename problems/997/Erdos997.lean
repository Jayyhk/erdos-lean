    (maynardS2ReciprocalGCorrectionAF_isMultiplicative W).map_one
  rw [maynardS2ReciprocalGCorrectionAF_apply_two,
    maynardS2ReciprocalGCorrectionAF_apply_prime_sq W Nat.prime_two, hOne]

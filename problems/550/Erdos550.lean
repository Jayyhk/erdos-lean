    {ι : Type*} [DecidableEq ι]
    (S : Finset ι) (D : ι → ℝ) (base η N : ℝ) (i : ι) :
    i ∈ heavyClusterFamily S D base η N ↔
      i ∈ S ∧ base + 80 * η * N ≤ D i := by
  simp [heavyClusterFamily]


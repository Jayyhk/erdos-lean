          QuotientGroup.mk' (FMAct.norm G M).range
              (uliftRepInvariant G M
                (normCoinvariantsInvariants
                  (uliftMulRepresentation (G := G) (M := M))
                  (Coinvariants.mk
                    (uliftMulRepresentation (G := G) (M := M)).ρ y))) =
              QuotientGroup.mk' (FMAct.norm G M).range
                (FMAct.norm G M y.toMul) := by
                  simpa using congrArg

    (((riemannZeta (s t + (beta : ℂ)) *
      DirichletCharacter.LFunction chi1 (s t + (beta : ℂ))) *
      DirichletCharacter.LFunction chi (s t + (beta : ℂ))) *
      DirichletCharacter.LFunction (DirichletCharacter.mul chi1 chi)

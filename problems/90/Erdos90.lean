    {H : ∀ r : ℕ, BCWta.{u} d r}
    {ι : Type}
    (left right : WBForm H ι targetWeight)
    (e : ι → HEFam H) :
    (left.append right).eval e = left.eval e + right.eval e := by
  simp [append, eval]

@[simp]
lemma eval_weaken
    {d targetWeight largerWeight : ℕ}
    {H : ∀ r : ℕ, BCWta.{u} d r}
    {ι : Type}
    (formula : WBForm H ι targetWeight)

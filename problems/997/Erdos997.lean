            maxCenteredThetaProgressionDiscrepancyUpTo x q := by
      apply Finset.sum_le_sum
      intro q hq
      exact
        maxProgressionDiscrepancy_le_inv_log_two_mul_maxCenteredThetaUpTo
          hx (Finset.mem_Icc.mp hq).1

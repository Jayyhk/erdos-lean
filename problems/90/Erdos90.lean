        pthPowerSubgroup p (P.1.adicCompletionIntegers K)ˣ ↔
      PthPowerCompletion K p (a : Kˣ) P.1 := by
  let C := P.1.adicCompletion K
  let B := P.1.adicCompletionIntegers K

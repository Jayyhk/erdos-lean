    dsimp only [w]
    rw [← Complex.ofReal_natCast,
      Complex.norm_cpow_eq_rpow_re_of_pos hpPos]
    rw [← Real.rpow_neg_one]
    exact Real.rpow_le_rpow_of_exponent_le hpOne (by simp; linarith)

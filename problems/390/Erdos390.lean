    (Kphysical : PhysicalInterpolationTarget I)
    (hpattern : B.sampleData.pattern =
      PaperHeadSimplex.pattern P hprime Rhead.exponent)
    {c : Real} {depth K : Nat}
    (R : BankPaperRealization B.sampleData.n

    (hvw : BBRed n (commutator v w) u) :
    BBRed n (commutator u v) w := by
  intro hweight
  apply
    free_tree_jacobi
      u v w hweight
  · exact huw (by
      simp only [weight_commutator] at hweight ⊢
      omega)
  · exact hvw (by
      simp only [weight_commutator] at hweight ⊢
      omega)


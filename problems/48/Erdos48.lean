        ∑ n ∈ Finset.Icc 1 (2 ^ m),
          weightedVonMangoldtMajorant eta (j - 1) n :=
      Finset.sum_nonneg fun _ _ ↦ by
        unfold weightedVonMangoldtMajorant
        positivity

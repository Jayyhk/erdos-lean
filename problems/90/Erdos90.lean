      homogeneousComponent 1 (subst x (mvLinearForm a)) :=
    homogeneous_component_nat
      (show (1 : ℕ∞) < (subst x phi - subst x (mvLinearForm a)).order by
        exact (show (1 : ℕ∞) < 2 by norm_num).trans_le hsubst)

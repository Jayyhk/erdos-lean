        _ = m.succ + 2 * m.succ.choose 2 := by
          rw [show (2 : ℕ) = Nat.succ 1 by rfl, Nat.choose_succ_succ,
            Nat.choose_one_right]
          simp only [Nat.succ_eq_add_one]
          ring


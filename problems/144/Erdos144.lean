    rw [intervalIntegral.integral_congr (f := w)
      (g := fun t : ℝ => (t + 1)⁻¹)]
    · rw [intervalIntegral.integral_comp_add_right (fun t : ℝ => t⁻¹) 1,
        integral_inv_of_pos (by norm_num) (by linarith)]
      simp
    · intro t ht

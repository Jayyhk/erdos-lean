    (∑ q ∈ Finset.Icc 1 Q,
        maxWeightedProgressionDiscrepancyUpTo x q) ≤
        (∑ q ∈ Finset.Icc 1 Q,
          BoundedGaps.Maynard.maxCenteredProgressionDiscrepancyUpTo x q) +
          BoundedGaps.Maynard.reciprocalTotientPrefix Q *

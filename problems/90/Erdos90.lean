      (IsGalois.card_aut_eq_finrank K E.carrier).symm
    _ = Nat.card (Kˣ ⧸ normSubgroup K E.carrier) :=
      Nat.card_congr (abelianLocalArtin K E.carrier).symm.toEquiv

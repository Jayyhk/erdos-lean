              (fun T : ℝ => ∫ sigma in (-1)..2,
                goldfeldContourIntegrand chi1 chi beta x
                  ((sigma : ℂ) + T * I)) atTop (𝓝 0) ∧
            Tendsto
              (fun T : ℝ => -(∫ sigma in (-1)..2,
                goldfeldContourIntegrand chi1 chi beta x
                  ((sigma : ℂ) - T * I))) atTop (𝓝 0) := by
  obtain ⟨A, hA, C, hC, hbound⟩ :=
    exists_norm_intervalIntegral_goldfeldContourIntegrand_horizontal_le
  refine ⟨A, hA, C, hC, ?_⟩

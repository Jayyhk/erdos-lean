      { toFun := fun x ↦ e2 (e1 x)
        invFun := fun x ↦ e1.symm (e2.symm x)
        left_inv := fun x ↦ by simp
        right_inv := fun x ↦ by simp
        map_add' := fun x y ↦ by
          rw [map_add]

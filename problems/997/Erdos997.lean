    have hdenE : 0 < Real.log n - E := by
      have : E ≤ F := by dsimp [F]; linarith [hlog2]
      linarith
    have hMupper : M n ≤ 2 * V n / (Real.log n - E) :=
      (le_div_iff₀ hdenE).2 (by simpa [mul_comm] using hlower)

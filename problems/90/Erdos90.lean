lemma inv_of_mem
    {G : Type*} [Group G]
    (K : Subgroup G) [K.Normal]
    {x x' y y' : G}
    (hx : x * x'⁻¹ ∈ K)
    (hy : y * y'⁻¹ ∈ K) :
    (x * y) * (x' * y')⁻¹ ∈ K := by
  rw [mul_inv_quotient K] at hx hy ⊢
  simp only [map_mul]
  rw [hx, hy]


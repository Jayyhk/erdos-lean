  rcases s.eq_empty_or_nonempty with hs | hs
  · exact Or.inl hs
  · exact Or.inr (Subsingleton.eq_univ_of_nonempty hs)

open _root_.ProbabilityTheory in
/-- Every outer shell in dimension zero has zero standard-Gaussian mass. -/

      refine ⟨1, ?_, ?_⟩
      · simpa [e0] using W.one_mem
      · simp [rightMulLinear, e0, Y]
    exact Submodule.mem_iSup_of_mem e0 hmap
  mul_mem := by
    intro r s a b ha hb
    exact
      extend_j_mul
        (p := p) (G := G) W
        (x := x) (w := w) (r := r) (s := s)
        hpow hconj herror ha hb


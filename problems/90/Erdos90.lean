    (hCrit : HMRGSCuttingCriterion c)
    {k : ℕ}
    (hk : 2 ≤ k)
    (hkTail : HMRCuttingBound c k)
    (x : HMRCutSequence)
    (hAdm : HMRCutAdmissible k x) :
    Infinite (hmrCutQuotient (K := ℚ) (KS := initialProExtension) x) := by

namespace BoundedGaps.Maynard

open Complex

private lemma re_inv_same_height_v3 (sigma : ℝ) (rho : ℂ) :
    (((((sigma : ℂ) + rho.im * I) - rho)⁻¹).re) =
      (sigma - rho.re)⁻¹ := by

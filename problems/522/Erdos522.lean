      Convexity.IsConvexSet ℝ A →
      |((μ.map (fun ω ↦ ∑ i, X i ω)) A).toReal -
          (stdGaussian (EuclideanSpace ℝ (Fin d)) A).toReal| ≤
        C * (d : ℝ) ^ (1 / 4 : ℝ) *
          ∑ i, ∫ ω, ‖X i ω‖ ^ 3 ∂μ


    {F : NatGrowthFunction} {depth : ℕ}
    (H : DescendingGrowthHierarchy F depth) :
    Antitone H.level := by
  rw [Fin.antitone_iff_succ_le]
  intro i
  exact (H.lower_le_growth i).trans_eq
    (H.growth_eq_upper i)


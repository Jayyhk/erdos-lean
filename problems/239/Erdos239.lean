theorem scaledCharacter_one {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (a : ZMod q) :
    scaledCharacter χ 1 a = χ a := by
  simp only [scaledCharacter, one_dvd, ↓reduceDIte, Nat.div_one]
  rw [a.natCast_zmod_val]


private theorem norm_intervalIntegral_le_const_of_intervalIntegrable
    {f : ℝ → ℂ} {a b M : ℝ} (hab : a ≤ b)
    (hf : IntervalIntegrable f volume a b)
    (hpoint : ∀ x ∈ Icc a b, ‖f x‖ ≤ M) :

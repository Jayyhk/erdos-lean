  intro m n hmn
  by_cases hm : m = 0
  · by_cases hn : n = 0
    · simp [baseJ, hm, hn]
    · simp [baseJ, hm, hn]
  · have hn : n ≠ 0 := by omega
    simp [baseJ, hm, hn]


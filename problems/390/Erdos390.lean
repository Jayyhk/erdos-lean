        (B.effectiveParamEquiv z) hgammaNuisance
        (by intro v; exact hGamma z hz v) (e z hz))
    (htarget : ∀ (z : B.EffectiveParamSpace)
      (hz : z ∈ closedBall (0 : B.EffectiveParamSpace) (a : ℝ)),

  let P := erasePair (primeBand n W) p q
  have hPsub : P ⊆ primeBand n W :=
    erasePair_subset (primeBand n W) p q
  have hDcop : ∀ u ∈ P, Nat.Coprime (pairPower p q r s) u := by

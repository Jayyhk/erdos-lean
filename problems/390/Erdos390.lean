def arithmeticDiagonal (z : ℝ) (lower upper : Band → ℕ)
    (i : Band) : ℝ :=
  normalizedDiagonalPrimeCell z (lower i) (upper i)

def continuumDiagonal (z : ℝ) (lower upper : Band → ℕ)
    (i : Band) : ℝ :=
  normalizedDiagonalContinuumCell z (lower i) (upper i)


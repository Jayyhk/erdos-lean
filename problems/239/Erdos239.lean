  ⟨fun n => if n = 0 then 0 else f n, by simp⟩

@[simp] theorem positiveArithmeticFunction_zero (f : ℕ → ℂ) :
    positiveArithmeticFunction f 0 = 0 := by
  simp [positiveArithmeticFunction]


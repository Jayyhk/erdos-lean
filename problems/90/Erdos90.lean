        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (emittedPrefix : List (CWord Atom))
    (slot : CWord Atom) :
    IVMost
      (fun steps : ℕ =>
        (Multiset.count slot
          ((scheduleAffine cutoff
            (fixedPrefix ++
              middleSuccessorSkew cutoff
                crossed outer selected right emittedPrefix steps)).apply 0) :
            ℤ))
      (slot.weight (fun _ => 1)) := by
  rw [show
    (fun steps : ℕ =>
      (Multiset.count slot
        ((scheduleAffine cutoff
          (fixedPrefix ++
            middleSuccessorSkew cutoff
              crossed outer selected right emittedPrefix steps)).apply 0) :
          ℤ)) =
      fun steps : ℕ =>
        (Multiset.count slot
          (evaluatedConstantProfile cutoff
            (boundedConstantTerms cutoff
              (fixedPrefix ++
                middleSuccessorSkew
                  cutoff crossed outer selected right emittedPrefix steps))) :
          ℤ) by
    funext steps
    rw [affine_constant_terms
      cutoff hcutoff]
    rfl]
  have hsupport :
      ∀ steps,
        SCAlphab cutoff
          (boundedConstantTerms cutoff
            (fixedPrefix ++
              middleSuccessorSkew cutoff
                crossed outer selected right emittedPrefix steps)) := by
    intro steps
    apply
      supported_alphabet_terms
    intro transition htransition
    rcases List.mem_append.mp htransition with htransition | htransition
    · exact hfixedPrefix transition htransition
    · exact
        middle_successor_skew
          cutoff steps crossed outer selected right hcrossed emittedPrefix
            transition htransition
  rw [show
    (fun steps : ℕ =>
      (Multiset.count slot
        (evaluatedConstantProfile cutoff
          (boundedConstantTerms cutoff
            (fixedPrefix ++
              middleSuccessorSkew cutoff
                crossed outer selected right emittedPrefix steps))) : ℤ)) =
      fun steps : ℕ =>
        ∑ term ∈ (boundedConstantAlphabet cutoff).toFinset,

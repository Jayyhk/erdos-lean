instance : Neg (MSeries R X) := ⟨fun f => ⟨fun w => -f w⟩⟩
instance : Sub (MSeries R X) := ⟨fun f g => ⟨fun w => f w - g w⟩⟩
instance : SMul ℕ (MSeries R X) := ⟨fun n f => ⟨fun w => n • f w⟩⟩
instance : SMul ℤ (MSeries R X) := ⟨fun n f => ⟨fun w => n • f w⟩⟩


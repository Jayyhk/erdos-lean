    _ = _ := by
      simp only [phase]
      congr 3 <;> push_cast <;> ring_nf

private lemma offDiagonal_eq_endpoint_forms
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (y : ι → ℝ) (v : ι → ℂ)
    (hneq : ∀ r s, r ≠ s →
      ((y r - y s : ℝ) : UnitAddCircle) ≠ 0)
    (m0 N : ℕ) :

theorem tsum_abs_reciprocalTotientCorrectionAF_le (W : ℕ) :
    (∑' n : ℕ, |reciprocalTotientCorrectionAF W n|) ≤ Real.exp 16 := by
  exact Real.tsum_le_of_sum_range_le (fun n => abs_nonneg _)

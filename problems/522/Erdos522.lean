    exact div_nonneg (mul_nonneg hC hβ) hε.le
  have hthree := bentkus_three_coordinate_pieces
    (S := S) (L := L) (R := Q) (T := T)
    (Ks := 61440) (Kl := 16128 * H) (Kr := 896 * H)
    (d14 := d14) (q := q) (βk := βk)
    (by positivity) (by positivity) hd14 hq hβk hdecomp

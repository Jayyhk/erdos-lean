    {p : ℕ} [Fact p.Prime]
    {Γ : Type u} [Group Γ]
    {d : ℕ} (s : Fin d → Γ)
    (n : ℕ) :
    Type u where
  representative : Γ → Γ
  representative_mem_closure :
    ∀ g : Γ, representative g ∈ Subgroup.closure (Set.range s)
  quotient_error_mem :
    ∀ g : Γ, (representative g)⁻¹ * g ∈ zassenhausFiltration p Γ n


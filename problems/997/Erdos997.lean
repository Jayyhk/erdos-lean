      rw [Nat.cast_sub hpPrime.two_le]
      norm_num
    have hc' : maynardS2ReciprocalGSingularCorrection p ≤
        2 * primeTotientSquareWeight p := by
      simpa [maynardS2ReciprocalGSingularCorrection, hcast] using hc.2
    exact hc'

    intro i hi j hj hij
    apply Nat.coprime_of_dvd
    intro p hp hpqi hpqj
    have hpti : p ∣ n - i := hpqi.trans (coverQuotient_dvd_term D hi)
    have hptj : p ∣ n - j := hpqj.trans (coverQuotient_dvd_term D hj)

private theorem zero_retract {C : Type u} [Category C]
    {X Y : C} (h : Retract X Y) (hY : Limits.IsZero Y) :
    Limits.IsZero X := by
  refine ⟨fun Z ↦ ⟨⟨⟨h.i ≫ hY.to_ Z⟩, ?_⟩⟩,
    fun Z ↦ ⟨⟨⟨hY.from_ Z ≫ h.r⟩, ?_⟩⟩⟩

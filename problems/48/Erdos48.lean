      dsimp [Zpair]
      rw [Finsupp.sum_single_add_single rho (conj rho) 1 1 _ hdist]
      · simp only [Nat.cast_one, one_mul]
        rw [re_inv_same_height_v2, re_inv_conjugate_height]
      · intro z

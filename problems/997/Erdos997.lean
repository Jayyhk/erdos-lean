  rw [hswap]
  apply Finset.sum_congr rfl
  intro m hm
  unfold restrictedMainArithmeticCoefficient
  simp only [Finset.univ_eq_attach]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro d hd
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro e he
  by_cases hme : d.1 m = 1 ∧ e.1 m = 1
  · simp [term, hme, shiftedPrimeProgressionIntervalMainTerm]

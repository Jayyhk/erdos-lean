      principalIdeles (OK_v58 K) K ⊔ idelesAtPlaces K S :=
    (le_sup_right : idelesAtPlaces K S ≤
      principalIdeles (OK_v58 K) K ⊔ idelesAtPlaces K S) hy
  have hxy :=
    (principalIdeles (OK_v58 K) K ⊔ idelesAtPlaces K S).mul_mem
      hpmem hymem
  simpa [p, y] using hxy


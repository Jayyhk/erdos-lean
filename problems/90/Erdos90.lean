    rw [hidentity]
    exact vanishes_below_right hg _

@[simp]
theorem magnus_order_subgroup
    {g : FreeGroup X} {n : ℕ} :
    g ∈ magnusOrderSubgroup (R := R) (X := X) n ↔
      VanishesBelow (magnusDifference (R := R) g) n :=
  Iff.rfl

theorem magnus_order_one :
    magnusOrderSubgroup (R := R) (X := X) 1 = ⊤ := by
  apply top_unique
  intro g _

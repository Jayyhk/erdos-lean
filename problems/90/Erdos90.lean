                    HerbrandQuotientValue N q))) := by
  intro G _ _ _ M N _ _ hMN
  obtain ⟨f, hker, hcoker⟩ := hintegral G M N hMN
  constructor
  · rintro ⟨q, hMq⟩
    exact ⟨q, hMq, (hherbrand G M N f hker hcoker q).mp hMq⟩
  · rintro ⟨q, hNq⟩
    exact ⟨q, (hherbrand G M N f hker hcoker q).mpr hNq, hNq⟩

end


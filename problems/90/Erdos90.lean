open TCDiscou

/-- A nonempty selected subword of an outer current-word schedule carries
enough weight to pay its preceding inner depth and one reserve unit. -/
lemma inner_ne_zero
    (cutoff steps : ℕ)
    (crossed outer selected right : CWord Atom)
    (innerDepth : ℕ)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true)
    (target : List SRTrans)
    (hcount :
      (nonemptySublists
        (depthCrossingSchedule cutoff crossed outer
          (iteratedLeftCommutator selected innerDepth right) steps)).count
            target ≠
        0) :
    innerDepth + 1 ≤
      (target.map secondRouteCarried).sum := by
  have htarget :=
    List.count_pos_iff.mp
      (Nat.pos_of_ne_zero hcount)
  have htargetSublist :
      List.Sublist target
        (depthCrossingSchedule cutoff crossed outer
          (iteratedLeftCommutator selected innerDepth right) steps) :=
    List.mem_sublists.mp (List.mem_filter.mp htarget).1
  have htargetNe :
      target ≠ [] :=
    of_decide_eq_true (List.mem_filter.mp htarget).2
  cases target with
  | nil =>
      exact False.elim (htargetNe rfl)
  | cons transition target =>
      have htransition :
          transition ∈
            depthCrossingSchedule cutoff crossed outer
              (iteratedLeftCommutator selected innerDepth right) steps :=
        htargetSublist.subset (by simp)
      have hweight :=
        inner_iterated_commutator
          cutoff steps crossed outer selected right innerDepth houter hselected
            transition htransition
      rw [or_second_current right hright] at hweight
      simp only [List.map_cons, List.sum_cons]
      omega

/-- A nonzero fixed nested coefficient has enough carried weight to pay its
total inner-depth orbit and one reserve unit for every active inner packet. -/
lemma length_nested_subsequence
    (cutoff steps : ℕ)
    (crossed outer selected right : CWord Atom)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (source : List ℕ)
    (target : List SRTrans)
    (hcoefficient :
      crossingSubsequenceCoefficient cutoff crossed
          outer selected right source target steps ≠
        0) :
    source.sum + source.length ≤
      (target.map secondRouteCarried).sum := by
  have hweight :=
    active_subsequence_coeff
      cutoff steps crossed outer selected right houter hselected source target
        hcoefficient
  omega

/-- Fixed active inner-source coefficients are discounted by their total
inner depth and by the number of active packets. -/
lemma activeNestedLength
    (cutoff : ℕ)
    (crossed outer selected right : CWord Atom)
    (houter :
      isFirstCurrent outer = true ∨
        isSecondCurrent outer = true)
    (hselected :
      isFirstCurrent selected = true ∨
        isSecondCurrent selected = true)
    (hright :
      isFirstCurrent right = true ∨
        isSecondCurrent right = true) :
    ∀ (source : List ℕ) (target : List SRTrans),
      IVMost
        (fun steps : ℕ =>
          (crossingSubsequenceCoefficient cutoff crossed
            outer selected right source target steps : ℤ))
        ((target.map secondRouteCarried).sum -
          (source.sum + source.length))
  | [], target => by
      simpa [crossingSubsequenceCoefficient,
        activeSubsequenceExpansions] using
          valued_most_constant
            ((target.map secondRouteCarried).sum)
            (([[]].count target : ℕ) : ℤ)
  | innerDepth :: source, target => by
      rw [show
        (fun steps : ℕ =>
          (crossingSubsequenceCoefficient cutoff crossed
            outer selected right (innerDepth :: source) target steps : ℤ)) =
        fun steps : ℕ =>
          ∑ suffix ∈ target.tails.toFinset,
            ((nonemptySublists
              (depthCrossingSchedule cutoff crossed outer
                (iteratedLeftCommutator selected innerDepth right)
                steps)).count
                  (target.take (target.length - suffix.length)) : ℤ) *
              (crossingSubsequenceCoefficient cutoff
                crossed outer selected right source suffix steps : ℤ) by
        funext steps
        exact_mod_cast
          (by
            simpa [crossingSubsequenceCoefficient,
              activeSubsequenceExpansions, Nat.mul_comm] using
              (count_flat_tails
                (nonemptySublists
                  (depthCrossingSchedule cutoff crossed outer
                    (iteratedLeftCommutator selected innerDepth right) steps))
                (activeSubsequenceExpansions
                  (fun nextDepth =>
                    depthCrossingSchedule cutoff crossed outer
                      (iteratedLeftCommutator selected nextDepth right) steps)
                  source)
                target))]
      apply IVMost.finsetSum
      intro suffix hsuffix
      have hsuffixMem :
          suffix <:+ target :=
        (List.mem_tails suffix target).mp (List.mem_toFinset.mp hsuffix)
      rcases hsuffixMem with ⟨initial, rfl⟩
      simp only [List.length_append, Nat.add_sub_cancel_right,
        List.take_append_of_le_length (Nat.le_refl initial.length),
        List.take_length, List.map_append, List.sum_append, List.sum_cons,
        List.length_cons]
      let outerFactor : ℕ → ℤ :=
        fun steps =>
          ((nonemptySublists
            (depthCrossingSchedule cutoff crossed outer
              (iteratedLeftCommutator selected innerDepth right) steps)).count
                initial : ℤ)
      let recursiveFactor : ℕ → ℤ :=
        fun steps =>
          (crossingSubsequenceCoefficient cutoff crossed
            outer selected right source suffix steps : ℤ)
      by_cases houterActive :
          ∃ steps,
            (nonemptySublists
              (depthCrossingSchedule cutoff crossed outer
                (iteratedLeftCommutator selected innerDepth right) steps)).count
                  initial ≠
              0
      · rcases houterActive with ⟨outerSteps, houterCount⟩
        have hinnerDepth :
            innerDepth + 1 ≤
              (initial.map secondRouteCarried).sum :=
          inner_ne_zero
            cutoff outerSteps crossed outer selected right innerDepth houter
              hselected hright initial houterCount
        by_cases hrecursiveActive :
            ∃ steps,
              crossingSubsequenceCoefficient cutoff
                  crossed outer selected right source suffix steps ≠
                0
        · rcases hrecursiveActive with ⟨recursiveSteps, hrecursiveCoefficient⟩
          have hsourceCost :
              source.sum + source.length ≤
                (suffix.map secondRouteCarried).sum :=
            length_nested_subsequence
              cutoff recursiveSteps crossed outer selected right houter
                hselected source suffix hrecursiveCoefficient
          apply
            (TCTex.IVMost.mul
              (nonemptySublistsInner
                cutoff crossed outer selected right innerDepth houter hselected
                  hright initial)
              (activeNestedLength
                cutoff crossed outer selected right houter hselected hright
                  source suffix)).mono
          omega
        · rw [show
            (fun steps : ℕ =>
              outerFactor steps * recursiveFactor steps) =
              fun _steps : ℕ => 0 by
            funext steps
            have hzero :
                crossingSubsequenceCoefficient cutoff
                    crossed outer selected right source suffix steps =
                  0 := by
              by_contra hne
              exact hrecursiveActive ⟨steps, hne⟩
            simp [recursiveFactor, hzero]]
          exact
            TCTex.IVMost.zero
              ((initial.map secondRouteCarried).sum +
                  (suffix.map secondRouteCarried).sum -
                ((innerDepth + source.sum) + (source.length + 1)))
      · rw [show
          (fun steps : ℕ =>
            outerFactor steps * recursiveFactor steps) =
            fun _steps : ℕ => 0 by
          funext steps
          have hzero :
              (nonemptySublists
                (depthCrossingSchedule cutoff crossed outer
                  (iteratedLeftCommutator selected innerDepth right)
                    steps)).count
                  initial =
                0 := by
            by_contra hne
            exact houterActive ⟨steps, hne⟩
          simp [outerFactor, hzero]]
        exact
          TCTex.IVMost.zero
            ((initial.map secondRouteCarried).sum +
                (suffix.map secondRouteCarried).sum -
              ((innerDepth + source.sum) + (source.length + 1)))

end CDCoeff

    congr 1
    apply integral_congr_ae
    filter_upwards with ω
    rw [bentkusRotatedSum_eq_leaveOneOut_add α
      (fun i ↦ replacementOriginal (d := d) i)
      (fun i ↦ replacementGaussian (d := d) i) k ω]

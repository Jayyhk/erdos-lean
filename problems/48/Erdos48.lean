    nlinarith [mul_le_mul hqTwo hx (by norm_num : (0 : ℝ) ≤ 2) hq0]
  have hQ0 : 0 ≤ Q := by
    dsimp [Q]
    exact Real.log_nonneg (by linarith)
  have hLQ : L ≤ 3 * Q := by
    calc
      L = Real.log ((q : ℝ) * (U + 2)) := rfl
      _ ≤ Real.log (((q : ℝ) * x) ^ 3) :=
        Real.log_le_log (by positivity) hleftArg

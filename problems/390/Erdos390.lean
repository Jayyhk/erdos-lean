        (hN := hN) (hscaleDom := hscaleDom)
        (hMertens := hMertens) (hPNT := hPNT) (hprime := hprime)
        (hTwo := hTwo) (Hmoment := HmomentReady S) (Hpost := Hpost)
        (hKh := hKh) (hdensity := hdensity) (hsigma := hsigma)
        (hscale := hscale) (hchargeDvd := hchargeDvd)

theorem _root_.ProbabilityTheory.transverseSupportingNormalPoints_eq_positive_union_negative {d : ℕ}
    (C : Set (EuclideanSpace ℝ (Fin d))) (θ : EuclideanSpace ℝ (Fin d)) :

lemma padicInt_valuation_intCast (p : ℕ) [Fact p.Prime] (n : ℤ) :
    (n : PadicInt p).valuation = n.natAbs.factorization p := by
  simp [PadicInt.valuation, padicValInt, Nat.factorization_def _ (Fact.out : p.Prime)]


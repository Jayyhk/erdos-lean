    IVMost Int.negSucc degreeBound := by
  refine ⟨-(Polynomial.X + Polynomial.C 1), ?_, ?_⟩
  · rw [Polynomial.natDegree_neg, Polynomial.natDegree_X_add_C]
    exact hdegree
  · intro q
    simp only [Polynomial.eval_neg, Polynomial.eval_add, Polynomial.eval_X,
      Polynomial.eval_C, Int.negSucc_eq, Int.cast_neg, Int.cast_add,
      Int.cast_natCast, Int.cast_one]


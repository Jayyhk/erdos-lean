    _ = (∑' n : ℕ, ‖LSeries.term a (sigma : ℂ) n‖) *
        ∑' n : ℕ, ‖LSeries.term b (sigma : ℂ) n‖ := rfl

/-- A real coefficient shift simply translates the real line on which the

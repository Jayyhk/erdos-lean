noncomputable def vaughanTwistedSumTwo
    (V : ℝ) (y q : ℕ) (χ : DirichletCharacter ℂ q) : ℂ :=
  ∑ n ∈ Finset.Icc 1 y,
    χ n *
      ((∑ hd ∈ n.divisorsAntidiagonal.filter
          (fun hd : ℕ × ℕ ↦ (hd.2 : ℝ) ≤ V),
          (ArithmeticFunction.moebius hd.2 : ℝ) * Real.log hd.1 : ℝ) : ℂ)


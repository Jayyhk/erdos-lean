@[simp]
theorem splitting_module_inclusion (C : Rep ℤ G)
    (φ : cocycles₂ C) (hφ : φ (1, 1) = 0) (c : C) :
    splittingModuleInclusion C φ hφ c = (c, 0) :=
  rfl


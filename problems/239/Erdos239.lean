the half-plane of convergence because both sides are the same `tsum`. -/
theorem LSeries_gsRealShift
    (rho : ℝ) (a : ArithmeticFunction ℂ) (s : ℂ) :
    LSeries (gsRealShift rho a) s = LSeries a (s + (rho : ℂ)) := by
  unfold LSeries

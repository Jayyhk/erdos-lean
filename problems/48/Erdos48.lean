  · rintro ⟨⟨hzero, hupper⟩, hnotLower⟩
    refine ⟨hzero, ?_, hupper⟩
    by_contra hlower
    exact hnotLower ⟨hzero, le_of_not_gt hlower⟩
  · rintro ⟨hzero, hlower, hupper⟩

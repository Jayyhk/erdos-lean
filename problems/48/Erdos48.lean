      Real.sqrt (x : ℝ) * vaughanCubeRoot x ^ 2 ≤
        q * (Real.sqrt (x : ℝ) * vaughanCubeRoot x) := by
    calc
      Real.sqrt (x : ℝ) * vaughanCubeRoot x ^ 2 =

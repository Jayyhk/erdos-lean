    rw [map_ofNat]]
  ring_nf

private lemma sum_phase_norm_sq_expand
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (S : Finset ℕ) (y : ι → ℝ) (v : ι → ℂ) :
    (((∑ n ∈ S, ‖∑ r, phase ((n : ℝ) * y r) * v r‖ ^ 2 : ℝ) : ℂ)) =
      ∑ r, ∑ s,
        v r * star (v s) *
          ∑ n ∈ S, phase ((n : ℝ) * (y r - y s)) := by
  calc
    (((∑ n ∈ S, ‖∑ r, phase ((n : ℝ) * y r) * v r‖ ^ 2 : ℝ) : ℂ)) =

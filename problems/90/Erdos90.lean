  letI : Q.asIdeal.IsMaximal := Q.isMaximal
  letI : Q.asIdeal.LiesOver P.asIdeal := by
    refine ⟨?_⟩
    rfl
  letI : Field (OK_v95 K ⧸ P.asIdeal) := Ideal.Quotient.field P.asIdeal
  letI : Field (OK_v95 M ⧸ Q.asIdeal) := Ideal.Quotient.field Q.asIdeal
  letI : Finite (OK_v95 K ⧸ P.asIdeal) :=
    Ring.HasFiniteQuotients.finiteQuotient P.ne_bot
  letI : Finite (OK_v95 M ⧸ Q.asIdeal) :=
    Ring.HasFiniteQuotients.finiteQuotient Q.ne_bot
  letI : Algebra.IsSeparable (OK_v95 K ⧸ P.asIdeal) (OK_v95 M ⧸ Q.asIdeal) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  letI : IsGaloisGroup Gal(M/K) (OK_v95 K) (OK_v95 M) :=

            (Real.log n - F)^2 ≤
          V n * (Real.log (n + 1) - F)^2 := by
      have hc := volterraCrossUpper (t := Real.log n) (E := E) (F := F)
        (a := Real.log (n + 1) - Real.log n) (V := V n)
        (X := V n + (Real.log (n + 1) - Real.log n) * M n)
        hEF hnF ha (by simpa [V] using hVnonneg n) hstep

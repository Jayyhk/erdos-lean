set_option maxRecDepth 5000 in
theorem outerTupleWeight_sum_primeCollision_le_scalarFactors
    {H : Finset ℕ} {R D : ℕ} {x : (H × H) × ℕ}
    (hx : x ∈ collisionPairPrimeIndex H D R) :
    (∑ u ∈ collisionPairPrimeTupleSupport H R (primorial D) x,

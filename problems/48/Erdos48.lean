  have hlarge : ∀ᶠ n : ℕ in atTop,
      1000 * (|C| + Real.log 3 + 1) ≤ Real.log (n : ℝ) :=
    (Real.tendsto_log_atTop.comp
      tendsto_natCast_atTop_atTop).eventually_ge_atTop _

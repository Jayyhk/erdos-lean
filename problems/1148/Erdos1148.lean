    Matrix.SpecialLinearGroup.map_apply_coe, mapCoeffs_transform]
  rfl

lemma formAction_smul {R : Type*} [CommRing R] (g : SL(2, R)) (c : R) (t : R × R × R) :
    formAction g (c • t) = c • formAction g t :=
  (formActionEquiv g).map_smul c t


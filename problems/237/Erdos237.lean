  intro C hC q _ hq chi hchi x T U hT hTx hU hclear
  let a : ℝ := -1 / 2
  let b : ℝ := 1 + 1 / Real.log x
  let L : ℝ := Real.log ((q : ℝ) * (T + 2))
  let Q : ℝ := Real.log ((q : ℝ) * x)

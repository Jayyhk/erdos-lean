          (Real.rpow_nonneg hy.le R) halpha hden)
    _ = (y ^ R / alpha) * (2 * |U|) := by
      rw [show |U - (-U)| = 2 * |U| by
        rw [show U - (-U) = 2 * U by ring, abs_mul]
        norm_num]

private lemma norm_dirichletPerronQuotient_vertical_le
    {y alpha U : ℝ} (hy : 0 < y) (hyOne : y < 1)

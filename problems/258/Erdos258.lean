          2 * Real.log 2 + primeLogPredecessorCorrection Q) * M := by
      dsimp [E]
      ring
    _ ≤ (K + Real.log D + primeLogDivisorMass P) * M := by
      apply mul_le_mul_of_nonneg_right _ hM
      dsimp [K]
      linarith


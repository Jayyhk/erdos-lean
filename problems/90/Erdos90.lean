    dTSubgro.inclusion (R := R) (G := G) hmn hnk x =
        dTSubgro.inclusion (R := R) (G := G) hmn hnk y ↔ x = y := by
  constructor
  · intro h
    exact dTSubgro.inclusion_injective (R := R) (G := G) hmn hnk h

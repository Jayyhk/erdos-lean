      (chi1 p * chi p) ^ k := by
  rw [characterAF_prime_pow _ hp, goldfeldCrossLevelMul_apply]

private theorem zeta_prime_pow {p k : ℕ} (hp : p.Prime) :
    (ArithmeticFunction.zeta : ArithmeticFunction ℂ) (p ^ k) = 1 := by
  have hpow : p ^ k ≠ 0 := pow_ne_zero k hp.ne_zero

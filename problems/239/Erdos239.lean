/-- Exact finite Euler product on `re s > 0`. -/
theorem LSeries_primeBandCoefficient_eq_finiteEulerProduct_of_pos_re
    {f : ℕ → ℂ} (hmul : IsMultiplicativeOnPositiveNat f)
    (hbound : ∀ n, 0 < n → ‖f n‖ ≤ 1)
    (P : ℕ → Prop) [DecidablePred P] (y : ℕ)

    PrimeEstimates.primeReciprocals Z ≤
        (139 / 100 : ℝ) * Real.log L := by simpa only [L] using hprime
    _ ≤ L := by nlinarith [sq_nonneg (Real.sqrt L - 4)]
    _ = Real.log (Z : ℝ) := rfl

end


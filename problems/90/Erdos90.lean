    {d n inputWeight : ℕ}
    (H : ∀ s : ℕ, BCWta.{u} d s)
    (builder :
      TDBuild
        (n := n) (inputWeight := inputWeight) H)
    (lowerWeight : ℕ) :
    TSFtrya
      (n := n) (inputWeight := inputWeight) H lowerWeight :=
  if hclassTwo : n ≤ 3 * lowerWeight then
    TSFtrya.of_classTwo
      H hclassTwo
  else
    builder.correctionFactory lowerWeight hclassTwo


/-!
# Support-sensitive polynomial bounds for bounded depth schedules

The retained- and crossing-schedule polynomial theorems use a coarse uniform
bound obtained by ranging over every bounded source-depth word.  For later
physical-weight arguments it is useful to retain the sharper finite bound:
the supremum of the grades of source words whose fixed transition coefficient
is actually nonzero.

This file packages that support-sensitive interface.  The previous
cutoff-wide estimate is recovered as an upper bound, while future callers may
prove a smaller physical-weight bound for the active-source supremum.

The file is intentionally not imported by the existing collection proof.
-/

namespace Submission
namespace TCTex
namespace ASGrade

open CWTrace
open WSTrace
open NPTail
open TACompos
open STSched
open DRSched
open DCSched
open DSReca
open DSRec
open BSRec
open BSPoly
open BDSubseq
open DRSubseq
open DSPoly

/-- Maximum grade of a finite family of source-depth words with nonzero fixed
coefficient. -/
def sourceGradeBound
    (sources : Finset (List ℕ))
    (coefficient : List ℕ → ℕ) :
    ℕ :=
  (sources.filter fun source => coefficient source ≠ 0).sup
    fun source => strictDepthGrade source + 1

/-- Every active source word lies below the support-sensitive grade bound. -/
lemma strict_grade_bound
    (sources : Finset (List ℕ))
    (coefficient : List ℕ → ℕ)
    (source : List ℕ)
    (hsource : source ∈ sources)
    (hcoefficient : coefficient source ≠ 0) :
    strictDepthGrade source + 1 ≤
      sourceGradeBound sources coefficient := by
  unfold sourceGradeBound
  exact
    Finset.le_sup
      (s := sources.filter fun next => coefficient next ≠ 0)
      (f := fun next => strictDepthGrade next + 1)
      (Finset.mem_filter.mpr ⟨hsource, hcoefficient⟩)

/-- A pointwise estimate for active source grades bounds their finite
supremum. -/
lemma active_grade_bound
    (sources : Finset (List ℕ))
    (coefficient : List ℕ → ℕ)
    (degreeBound : ℕ)
    (hdegree :
      ∀ source ∈ sources,
        coefficient source ≠ 0 →
          strictDepthGrade source + 1 ≤ degreeBound) :
    sourceGradeBound sources coefficient ≤ degreeBound := by
  unfold sourceGradeBound
  apply Finset.sup_le
  intro source hsource
  exact
    hdegree source (Finset.mem_filter.mp hsource).1
      (Finset.mem_filter.mp hsource).2

/-- Active-source grade bound for one crossing transition schedule. -/
def crossingGradeBound
    (cutoff : ℕ)
    (outer selected right : CWord Atom)
    (target : List SRTrans) :
    ℕ :=
  sourceGradeBound
    (wordsUpLength cutoff target.length).toFinset
    fun source =>
      activeCrossingSubsequence
        cutoff outer selected right source target

/-- Crossing transition-subword multiplicity has the exact finite
active-source grade bound. -/
lemma subsequenceMultGrade
    (cutoff : ℕ)
    (outer selected right : CWord Atom)
    (target : List SRTrans) :
    IVMost
      (fun steps : ℕ =>
        (orderedSubsequenceMultiplicity target
          (depthCrossingSchedule cutoff outer selected right
            steps) : ℤ))
      (crossingGradeBound
        cutoff outer selected right target) := by
  rw [show
    (fun steps : ℕ =>
      (orderedSubsequenceMultiplicity target
        (depthCrossingSchedule cutoff outer selected right steps) :
          ℤ)) =
      fun steps : ℕ =>
        ∑ source ∈ (wordsUpLength cutoff target.length).toFinset,
          (activeCrossingSubsequence
              cutoff outer selected right source target : ℤ) *
            (orderedSubsequenceMultiplicity source
              (boundedDepthSchedule cutoff steps) : ℤ) by
    funext steps
    exact_mod_cast
      (by
        simpa [nsmul_eq_mul, Nat.mul_comm] using
          subsequence_multiplicity_words
            cutoff steps outer selected right target)]
  apply IVMost.finsetSum
  intro source hsource
  have hsourceMem :
      source ∈ wordsUpLength cutoff target.length :=
    List.mem_toFinset.mp hsource
  have hsourceLt :
      ∀ depth ∈ source, depth < cutoff :=
    fun depth hdepth =>
      words_up_length
        cutoff target.length source hsourceMem depth hdepth
  by_cases hcoefficient :
      activeCrossingSubsequence
        cutoff outer selected right source target =
      0
  · simp only [hcoefficient, Int.ofNat_zero, zero_mul]
    exact
      TCTex.IVMost.zero
        (crossingGradeBound
          cutoff outer selected right target)
  · apply
      TCTex.IVMost.smul
    apply
      TCTex.IVMost.mono
    · exact
        strict_grade_bound
          (wordsUpLength cutoff target.length).toFinset
          (fun next =>
            activeCrossingSubsequence
              cutoff outer selected right next target)
          source hsource hcoefficient
    · exact
        subsequence_multiplicity_strict
          cutoff source hsourceLt

/-- Any later bound on the active crossing-source grade supremum gives the
corresponding polynomial degree theorem immediately. -/
lemma subsequence_mult_grade
    (cutoff degreeBound : ℕ)
    (outer selected right : CWord Atom)
    (target : List SRTrans)
    (hdegree :
      crossingGradeBound
          cutoff outer selected right target ≤
        degreeBound) :
    IVMost
      (fun steps : ℕ =>
        (orderedSubsequenceMultiplicity target
          (depthCrossingSchedule cutoff outer selected right
            steps) : ℤ))
      degreeBound := by
  exact
    TCTex.IVMost.mono
      hdegree
      (subsequenceMultGrade
        cutoff outer selected right target)


    Ideal.span {a} ⊔ C = ⊤ := by
  apply (Ideal.eq_top_iff_one _).mpr
  exact Submodule.mem_sup.mpr
    ⟨a, Ideal.subset_span (Set.mem_singleton a), -(a - 1), C.neg_mem ha, by ring⟩


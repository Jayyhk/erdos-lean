  dsimp [LayerLocalArtin] at hphi
  rcases hphi with ⟨w, hwv, hwq, M, e, rec, hrec, hformula⟩
  let wAbove :
      Submission.CField.ICohomo.CompletionPlacesAbove
        (L := L.1) v := ⟨w, hwv⟩
